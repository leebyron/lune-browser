+// The Dock has one tile for the process. Use the active profile's browser
+// appearance, including its underlying preference for off-the-record windows.
+class LuneIconAppearanceObserver : public ProfileObserver,
+                                   public ThemeServiceObserver,
+                                   public ui::NativeThemeObserver {
+ public:
+  explicit LuneIconAppearanceObserver(Profile* profile) {
+    native_theme_observation_.Observe(ui::NativeTheme::GetInstanceForNativeUi());
+    SetProfile(profile);
+  }
+
+  void SetProfile(Profile* profile) {
+    if (profile) {
+      profile = profile->GetOriginalProfile();
+    }
+    if (profile != profile_observation_.GetSource()) {
+      theme_observation_.Reset();
+      profile_observation_.Reset();
+      if (profile) {
+        profile_observation_.Observe(profile);
+        if (auto* service = ThemeServiceFactory::GetForProfile(profile)) {
+          theme_observation_.Observe(service);
+        }
+      }
+    }
+    UpdateIcon();
+  }
+
+ private:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    SetProfile(nullptr);
+  }
+
+  void OnThemeChanged() override { UpdateIcon(); }
+  void OnNativeThemeUpdated(ui::NativeTheme* theme) override { UpdateIcon(); }
+
+  void UpdateIcon() {
+    const auto* service = theme_observation_.GetSource();
+    const auto system_scheme =
+        native_theme_observation_.GetSource()->preferred_color_scheme();
+    const bool dark = service ? service->BrowserUsesDarkColors()
+                              : system_scheme ==
+                                    ui::NativeTheme::PreferredColorScheme::kDark;
+    if (dark_ == dark) {
+      return;
+    }
+
+    NSString* name = dark ? @"app-dark" : @"app-light";
+    NSString* path = [NSBundle.mainBundle pathForResource:name ofType:@"icns"];
+    NSImage* icon = path ? [[NSImage alloc] initWithContentsOfFile:path] : nil;
+    if (icon) {
+      [DockIcon setApplicationIconImage:icon];
+      dark_ = dark;
+    }
+  }
+
+  std::optional<bool> dark_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::ScopedObservation<ThemeService, ThemeServiceObserver> theme_observation_{
+      this};
+  base::ScopedObservation<ui::NativeTheme, ui::NativeThemeObserver>
+      native_theme_observation_{this};
+};
+
 }  // namespace
 
