+void OnboardingMessageHandler::HandleSetAppearance(const base::ListValue& args) {
+  if (args.size() != 1 || !args[0].is_bool()) {
+    return;
+  }
+  if (!args[0].GetBool()) {
+    CloseAppearance();
+    return;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents());
+  if (!tab) {
+    return;
+  }
+  auto* controller = customize_chrome::SidePanelController::Get(
+      tab->GetUnownedUserDataHost());
+  if (controller) {
+    AllowJavascript();
+    controller->OpenSidePanel(SidePanelOpenTrigger::kUnknown,
+                              CustomizeChromeSection::kAppearance);
+    appearance_opened_ = true;
+  }
+}
+
+void OnboardingMessageHandler::CloseAppearance() {
+  if (!appearance_opened_ || !web_contents()) {
+    return;
+  }
+  appearance_opened_ = false;
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents());
+  if (tab) {
+    auto* controller = customize_chrome::SidePanelController::Get(
+        tab->GetUnownedUserDataHost());
+    if (controller) {
+      controller->CloseSidePanel();
+    }
+  }
+}
+
+void OnboardingMessageHandler::DidStartNavigation(
+    content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    CloseAppearance();
+  }
+}
+
+void OnboardingMessageHandler::OnJavascriptDisallowed() {
+  theme_observation_.Reset();
+  CloseAppearance();
+}
+
+base::DictValue OnboardingMessageHandler::GetAppearanceDict() {
+  auto* service = ThemeServiceFactory::GetForProfile(profile_);
+  std::string selected = "lune";
+  if (service->UsingDeviceTheme()) {
+    selected = "system";
+  } else if (service->GetIsGrayscale()) {
+    selected = "grayscale";
+  } else if (service->GetUserColor().has_value() ||
+             service->UsingExtensionTheme()) {
+    selected = "custom";
+  }
+  base::ListValue colors;
+  for (const auto& color : kDynamicCustomizeChromeColors) {
+    colors.Append(base::DictValue()
+                      .Set("value", base::NumberToString(color.id))
+                      .Set("label", l10n_util::GetStringUTF8(color.label_id)));
+    if (selected == "custom" &&
+        service->GetUserColor() == color.color &&
+        service->GetBrowserColorVariant() == color.variant) {
+      selected = base::NumberToString(color.id);
+    }
+  }
+  return base::DictValue()
+      .Set("scheme", static_cast<int>(service->GetBrowserColorScheme()))
+      .Set("theme", selected)
+      .Set("colors", std::move(colors));
+}
+
+void OnboardingMessageHandler::HandleGetAppearance(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  if (!theme_observation_.IsObserving()) {
+    theme_observation_.Observe(ThemeServiceFactory::GetForProfile(profile_));
+  }
+  ResolveJavascriptCallback(args[0], GetAppearanceDict());
+}
+
+void OnboardingMessageHandler::OnThemeChanged() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("onboarding-appearance-changed", GetAppearanceDict());
+  }
+}
+
+void OnboardingMessageHandler::HandleSetColorScheme(const base::ListValue& args) {
+  if (args.size() != 1 || !args[0].is_int()) {
+    return;
+  }
+  const int scheme = args[0].GetInt();
+  if (scheme < 0 || scheme > 2) {
+    return;
+  }
+  ThemeServiceFactory::GetForProfile(profile_)->SetBrowserColorScheme(
+      static_cast<ThemeService::BrowserColorScheme>(scheme));
+}
+
+void OnboardingMessageHandler::HandleSetTheme(const base::ListValue& args) {
+  if (args.size() != 1 || !args[0].is_string()) {
+    return;
+  }
+  auto* service = ThemeServiceFactory::GetForProfile(profile_);
+  const auto& selected = args[0].GetString();
+  if (selected == "system") {
+    service->UseDeviceTheme(true);
+  } else if (selected == "lune") {
+    service->SetUserColor(std::nullopt);
+    service->UseDeviceTheme(false);
+  } else if (selected == "grayscale") {
+    service->SetIsGrayscale(true);
+    service->UseDeviceTheme(false);
+  } else {
+    for (const auto& color : kDynamicCustomizeChromeColors) {
+      if (selected == base::NumberToString(color.id)) {
+        service->SetUserColorAndBrowserColorVariant(color.color, color.variant);
+        service->UseDeviceTheme(false);
+        break;
+      }
+    }
+  }
+}
