+
+/* Locally bundled website typography. */
+@font-face { font-family: Inter; font-style: normal; font-weight: 400 500; font-display: swap; src: url(/inter-latin.woff2) format("woff2"); }
+@font-face { font-family: Syne; font-style: normal; font-weight: 800; font-display: swap; src: url(/syne-latin.woff2) format("woff2"); }
+body, button { font-family: Inter, sans-serif; }
+
+:root { --font: Inter, sans-serif; }
+/* Served from the browser resource pack, including when offline.
+   Precompose each theme's wallpaper tint, then fade the complete layer over
+   its sampled 64x64 center average. The center stays steady during the fade. */
+:root {
+    --setup-background: light-dark(#E7EDE4, #0A2B44);
+    --wallpaper-wash: light-dark(rgb(231 237 227 / .9), rgb(16 53 79 / .55));
+    --wallpaper-shade: light-dark(transparent, rgb(0 0 0 / .3));
+}
+body { background: var(--setup-background); }
+main::before {
+    content: ''; position: absolute; inset: -16px;
+    background-image: linear-gradient(var(--wallpaper-wash), var(--wallpaper-wash)),
+        linear-gradient(var(--wallpaper-shade), var(--wallpaper-shade)), url('/wallpaper.jpg');
+    background-color: light-dark(#E7EDE3, #10354F);
+    background-position: center; background-size: cover;
+    opacity: 1; transform: scale(1.05); pointer-events: none;
+    animation: wallpaper-in 1600ms cubic-bezier(.25,.1,.25,1) 1300ms both,
+        wallpaper-rise 3500ms cubic-bezier(.45,0,.55,1) both;
+}
+@media (prefers-color-scheme: light) {
+    main::before { background-blend-mode: normal, normal, screen; }
+}
+@keyframes wallpaper-rise { from { translate: 0 12px; } to { translate: 0 -4px; } }
+@keyframes wallpaper-in { from { opacity: 0; transform: scale(1); } to { opacity: 1; transform: scale(1.05); } }
+@media (prefers-reduced-motion: reduce) { main::before { animation: none; } }
