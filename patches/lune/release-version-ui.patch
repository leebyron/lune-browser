 namespace {
 
+std::string GetLuneReleaseVersion() {
+#if BUILDFLAG(IS_MAC)
+  // Read the signed outer app's distribution version; keep Chromium's version
+  // and framework layout independent. Development bundles retain Helium's value.
+  const auto path = base::apple::OuterBundlePath().value();
+  base::apple::ScopedCFTypeRef<CFURLRef> url(CFURLCreateFromFileSystemRepresentation(
+      kCFAllocatorDefault, reinterpret_cast<const UInt8*>(path.data()),
+      path.size(), true));
+  base::apple::ScopedCFTypeRef<CFBundleRef> bundle(
+      url ? CFBundleCreate(kCFAllocatorDefault, url.get()) : nullptr);
+  if (bundle) {
+    auto value = base::apple::CFCast<CFStringRef>(CFBundleGetValueForInfoDictionaryKey(
+        bundle.get(), CFSTR("LuneReleaseVersion")));
+    if (value) {
+      return base::SysCFStringRefToUTF8(value);
+    }
+  }
+#endif
+  return std::string(version_info::GetHeliumVersionNumber());
+}
