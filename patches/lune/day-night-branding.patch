+// The static bundle icon is Pelagic Signal; the running Dock icon follows
+// macOS appearance without changing the user's browser theme preference.
+@interface LuneIconAppearanceObserver : NSObject
+@end
+
+@implementation LuneIconAppearanceObserver
+- (void)updateIcon {
+  NSAppearanceName appearance =
+      [NSApp.effectiveAppearance bestMatchFromAppearancesWithNames:@[
+        NSAppearanceNameAqua, NSAppearanceNameDarkAqua
+      ]];
+  NSString* name = [appearance isEqual:NSAppearanceNameDarkAqua]
+                       ? @"app-dark" : @"app-light";
+  NSString* path = [NSBundle.mainBundle pathForResource:name ofType:@"icns"];
+  NSImage* icon = path ? [[NSImage alloc] initWithContentsOfFile:path] : nil;
+  if (icon) {
+    NSApp.applicationIconImage = icon;
+  }
+}
+
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    [NSApp addObserver:self forKeyPath:@"effectiveAppearance"
+               options:0 context:nullptr];
+    [self updateIcon];
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [NSApp removeObserver:self forKeyPath:@"effectiveAppearance"];
+}
+
+- (void)observeValueForKeyPath:(NSString*)keyPath
+                    ofObject:(id)object
+                      change:(NSDictionary*)change
+                     context:(void*)context {
+  [self updateIcon];
+}
+@end
+
