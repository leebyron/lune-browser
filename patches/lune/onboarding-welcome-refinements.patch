+<!-- Copyright 2026 The Lune Authors. SPDX-License-Identifier: GPL-3.0-or-later -->
+<script lang="ts">
+    import { Link } from "@imput/helium-prism";
+    import { s } from "../lib/strings";
+    import { parseLocalizedString } from "../lib/i18n";
+    const creditParts = parseLocalizedString(s.welcome.upstreamCredit);
+    const termsParts = parseLocalizedString(s.welcome.terms);
+</script>
+
+<footer id="welcome-footer">
+    <p class="upstream-credit">{#each creditParts as part}{#if part.kind === "linkHelium"}<Link href="https://helium.computer/">{part.text}</Link>{:else if part.kind === "linkUngoogled"}<Link href="https://github.com/ungoogled-software/ungoogled-chromium">{part.text}</Link>{:else}{part.text}{/if}{/each}</p>
+    <p class="policy">{#each termsParts as part}{#if part.kind === "linkPrivacy"}<Link href="https://helium.computer/privacy">{part.text}</Link>{:else if part.kind === "linkTerms"}<Link href="https://helium.computer/terms">{part.text}</Link>{:else}{part.text}{/if}{/each}</p>
+</footer>
+
+<style>
+    footer { width: min(760px, calc(100vw - 40px)); text-align: center; }
+    p { font: 400 11px/1.2 Inter,sans-serif; color: var(--secondary); margin: 0; text-wrap: balance; }
+    .upstream-credit { font-size: 13px; line-height: 20px; margin-bottom: 8px; }
+    :global(#welcome-footer a) { font: inherit; color: inherit; }
+</style>
