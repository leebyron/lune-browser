+    auto& mixer = provider->AddMixer();
+    mixer[ui::kColorSysBase] = {SystemColor(NSColor.windowBackgroundColor)};
+    mixer[ui::kColorSysHeader] = {SystemColor(NSColor.windowBackgroundColor)};
+    mixer[ui::kColorSysHeaderInactive] = {SystemColor(NSColor.windowBackgroundColor)};
+    mixer[ui::kColorSysBaseContainer] = {SystemColor(NSColor.windowBackgroundColor)};
