+#pragma mark - Preparing to check for updates
+
+- (void)fireUpdateShownHandlerIfNeeded SPU_OBJC_DIRECT
+{
+    if (_updateShownHandler != nil) {
+        _updateShownHandler();
+        _updateShownHandler = nil;
+    }
+}
