+
+void ProfileNetworkContextService::OnTrackingQuerySettingsChanged() {
+  tracking_query_refresh_timer_.Stop();
+  tracking_query_loader_.reset();
+  UpdateTrackingQueryRules();
+  ScheduleTrackingQueryRefresh(base::TimeDelta());
+}
+
+void ProfileNetworkContextService::ScheduleTrackingQueryRefresh(
+    base::TimeDelta delay) {
+  if (!GetTrackingQueryCatalogURL().is_valid()) {
+    return;
+  }
+  tracking_query_refresh_timer_.Start(
+      FROM_HERE, delay,
+      base::BindOnce(&ProfileNetworkContextService::RefreshTrackingQueryRules,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ProfileNetworkContextService::RefreshTrackingQueryRules() {
+  const GURL catalog = GetTrackingQueryCatalogURL();
+  if (!catalog.is_valid()) {
+    return;
+  }
+  FetchTrackingQueryResource(
+      catalog, kMaxTrackingQueryCatalogSize,
+      base::BindOnce(&ProfileNetworkContextService::OnTrackingQueryCatalogDownloaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ProfileNetworkContextService::FetchTrackingQueryResource(
+    const GURL& url,
+    size_t max_size,
+    base::OnceCallback<void(std::optional<std::string>)> callback) {
+  constexpr auto traffic_annotation = net::DefineNetworkTrafficAnnotation(
+      "helium_tracking_query_rules", R"(
+        semantics {
+          sender: "Lune link tracking protection"
+          description: "Updates the public rules for removing tracking parameters from links."
+          trigger: "With filter updates and link cleanup enabled, when consent is granted and periodically thereafter."
+          data: "A request for the filter-list catalog or the public URL Tracking Protection file. No browsing URLs or identifiers are included."
+          destination: OTHER
+          destination_other: "Helium services or the service instance chosen in settings."
+          internal {
+            contacts { email: "lee@leebyron.com" }
+          }
+          user_data { type: NONE }
+          last_reviewed: "2026-11-17"
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Set Update privacy filter lists through Helium in Privacy settings."
+          policy_exception_justification: "The user controls this request through Helium service consent and the filter-list update setting."
+        })");
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  tracking_query_loader_ =
+      network::SimpleURLLoader::Create(std::move(request), traffic_annotation);
+  tracking_query_loader_->SetTimeoutDuration(base::Seconds(30));
+  auto factory = g_browser_process->system_network_context_manager()
+                     ->GetSharedURLLoaderFactory();
+  tracking_query_loader_->DownloadToString(factory.get(), std::move(callback),
+                                           max_size);
+}
+
+void ProfileNetworkContextService::OnTrackingQueryCatalogDownloaded(
+    std::optional<std::string> body) {
+  tracking_query_loader_.reset();
+  auto catalog = body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+                      : std::nullopt;
+  const auto* entry = catalog ? catalog->FindDict("adguard-spyware-url") : nullptr;
+  const auto* destinations = entry ? entry->Find("contentURL") : nullptr;
+  const auto& profile_prefs = *profile_->GetPrefs();
+  GURL source;
+  if (destinations && destinations->is_string()) {
+    source = GURL(destinations->GetString());
+  } else if (destinations && destinations->is_list()) {
+    for (const auto& destination : destinations->GetList()) {
+      const auto* url = destination.GetIfString();
+      if (url && CanUseTrackingQueryAsset(profile_prefs, GURL(*url))) {
+        source = GURL(*url);
+        break;
+      }
+    }
+  }
+  if (!GetTrackingQueryCatalogURL().is_valid()) {
+    return;
+  }
+  if (!CanUseTrackingQueryAsset(profile_prefs, source)) {
+    ScheduleTrackingQueryRefresh(kTrackingQueryRetryInterval);
+    return;
+  }
+  FetchTrackingQueryResource(
+      source, net::kMaxTrackingQueryListSize,
+      base::BindOnce(&ProfileNetworkContextService::OnTrackingQueryListDownloaded,
+                     weak_factory_.GetWeakPtr(), source));
+}
+
+void ProfileNetworkContextService::OnTrackingQueryListDownloaded(
+    const GURL& source, std::optional<std::string> body) {
+  tracking_query_loader_.reset();
+  auto* profile_prefs = profile_->GetPrefs();
+  if (!GetTrackingQueryCatalogURL().is_valid()) {
+    return;
+  }
+  if (!body || body->empty() ||
+      !CanUseTrackingQueryAsset(*profile_prefs, source) ||
+      (*body != tracking_query_list_ &&
+       !net::TrackingQueryRules::FromDownloadedList(*body))) {
+    ScheduleTrackingQueryRefresh(kTrackingQueryRetryInterval);
+    return;
+  }
+
+  base::DictValue snapshot;
+  snapshot.Set("source", source.spec());
+  snapshot.Set("content", std::move(*body));
+  snapshot.Set("checked", base::TimeToValue(base::Time::Now()));
+  profile_prefs->SetDict(prefs::kHeliumTrackingQueryAsset, std::move(snapshot));
+  ScheduleTrackingQueryRefresh(kTrackingQueryRefreshInterval);
+}
+
+void ProfileNetworkContextService::ConfigureTrackingQueryCleanup(
+    network::mojom::NetworkContextParams* params) const {
+  params->enable_tracking_query_cleanup = tracking_query_cleanup_enabled_;
+  params->tracking_query_list = tracking_query_list_;
+  params->tracking_query_excluded_domains = tracking_query_excluded_domains_;
+}
+
+bool ProfileNetworkContextService::LoadTrackingQueryState() {
+  const auto* profile_prefs = profile_->GetPrefs();
+  const bool enabled =
+      profile_prefs->GetBoolean(prefs::kHeliumCleanTrackingLinksEnabled);
+  const bool enabled_changed =
+      std::exchange(tracking_query_cleanup_enabled_, enabled) != enabled;
+  const auto& snapshot = profile_prefs->GetDict(prefs::kHeliumTrackingQueryAsset);
+  const auto* source = snapshot.FindString("source");
+  const auto* content = snapshot.FindString("content");
+  if (enabled && source && content &&
+      CanUseTrackingQueryAsset(*profile_prefs, GURL(*source))) {
+    if (*content == tracking_query_list_) {
+      return enabled_changed;
+    }
+    if (auto parsed = net::TrackingQueryRules::FromDownloadedList(*content)) {
+      tracking_query_list_ = *content;
+      tracking_query_rules_ = std::move(parsed);
+      return true;
+    }
+  }
+  const bool rules_changed = !tracking_query_list_.empty();
+  tracking_query_list_.clear();
+  tracking_query_rules_.reset();
+  return enabled_changed || rules_changed;
+}
+
+void ProfileNetworkContextService::UpdateTrackingQueryRules() {
+  if (is_shutting_down_ || !LoadTrackingQueryState()) {
+    return;
+  }
+  profile_->ForEachLoadedStoragePartition(
+      [this](content::StoragePartition* partition) {
+        partition->GetNetworkContext()->SetTrackingQueryCleanup(
+            tracking_query_cleanup_enabled_, tracking_query_list_);
+      });
+}
+
+std::vector<std::string>
+ProfileNetworkContextService::ReadTrackingQueryExcludedDomains() const {
+  std::vector<std::string> domains;
+  for (const auto& entry : profile_->GetPrefs()->GetList(
+           prefs::kHeliumTrackingQueryExcludedDomains)) {
+    if (!entry.is_string()) {
+      continue;
+    }
+    std::string host = base::ToLowerASCII(entry.GetString());
+    if (host.ends_with('.')) {
+      host.pop_back();
+    }
+    if (host.empty() ||
+        host.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789.-") !=
+            std::string::npos) {
+      continue;
+    }
+    const GURL url("https://" + host);
+    if (url.is_valid() && url.has_host()) {
+      domains.emplace_back(url.host());
+    }
+  }
+  std::ranges::sort(domains);
+  auto duplicate = std::ranges::unique(domains);
+  domains.erase(duplicate.begin(), duplicate.end());
+  return domains;
+}
+
+void ProfileNetworkContextService::UpdateTrackingQueryExcludedDomains() {
+  if (is_shutting_down_) {
+    return;
+  }
+  auto domains = ReadTrackingQueryExcludedDomains();
+  if (domains == tracking_query_excluded_domains_) {
+    return;
+  }
+  tracking_query_excluded_domains_ = std::move(domains);
+  profile_->ForEachLoadedStoragePartition(
+      [this](content::StoragePartition* partition) {
+        partition->GetNetworkContext()->SetTrackingQueryExcludedDomains(
+            tracking_query_excluded_domains_);
+      });
+}
