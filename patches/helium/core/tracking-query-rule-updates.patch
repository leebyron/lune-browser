+TEST(TrackingQueryTest, HonorsDownloadedScopeValuesAndExceptions) {
+  auto rules = TrackingQueryRules::FromDownloadedList(
+      "||example.test/share/*$doc,removeparam=/^via=(a|b)$/\n"
+      "||example.test^$xhr,removeparam=media\n"
+      "$removeparam=campaign,to=~login.example.test\n"
+      "$removeparam=referral,to=amazon.*\n"
+      "@@||example.test/share/original^$removeparam\n"
+      "||instagram.com^$removeparam=igsh\n");
+  ASSERT_TRUE(rules);
+  const auto copy = [&](std::string_view url) {
+    return StripTrackingQuery(GURL(url), TrackingQueryAction::kCopy, rules.get());
+  };
+  EXPECT_EQ(copy("https://example.test/share/x?via=%61&via=c&media=keep&campaign=2"),
+            GURL("https://example.test/share/x?via=c&media=keep"));
+  EXPECT_EQ(copy("https://www.instagram.com/p/x?igsh=one"),
+            GURL("https://www.instagram.com/p/x"));
+  EXPECT_FALSE(copy("https://login.example.test/?campaign=2"));
+  EXPECT_FALSE(copy("https://example.test/share/original?fbclid=keep&via=b"));
+  EXPECT_FALSE(copy("https://example.test.evil.invalid/share/x?via=a"));
+  EXPECT_EQ(copy("https://shop.amazon.co.uk/s?referral=a&s=price"),
+            GURL("https://shop.amazon.co.uk/s?s=price"));
+  EXPECT_FALSE(copy("https://amazon.example.com/s?referral=keep"));
+}
