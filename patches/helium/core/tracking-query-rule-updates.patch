+TEST(TrackingQueryTest, HonorsDomainExclusions) {
+  const std::string excluded[] = {"example.test"};
+  for (const auto action :
+       {TrackingQueryAction::kNavigate, TrackingQueryAction::kCopy}) {
+    EXPECT_FALSE(StripTrackingQuery(GURL("https://example.test/?fbclid=keep"),
+                                    action, nullptr, excluded));
+    EXPECT_FALSE(StripTrackingQuery(
+        GURL("https://sub.example.test:8443/?fbclid=keep"), action, nullptr,
+        excluded));
+    EXPECT_EQ(StripTrackingQuery(GURL("https://notexample.test/?fbclid=test"),
+                                 action, nullptr, excluded),
+              GURL("https://notexample.test/"));
+  }
+}
