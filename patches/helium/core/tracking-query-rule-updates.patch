+std::optional<bool> EvaluateFilterCondition(std::string_view condition) {
+  condition = base::TrimWhitespaceASCII(condition, base::TRIM_ALL);
+  if (condition.starts_with('(') && condition.ends_with(')')) {
+    condition.remove_prefix(1);
