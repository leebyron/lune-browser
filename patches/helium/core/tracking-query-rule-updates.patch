+  for (auto entry : base::SplitStringPiece(value, "|", base::TRIM_WHITESPACE,
+                                           base::SPLIT_WANT_ALL)) {
+    const bool excluded = entry.starts_with('~');
+    if (excluded) {
+      entry.remove_prefix(1);
+    }
+    const auto name = entry.ends_with(".*")
+                          ? entry.substr(0, entry.size() - 2)
+                          : entry;
