+// static-filter-syntax documentation. Evaluate rules in a top-level document
+// context. uBO uses the top-level destination as the document origin.
+struct Domains {
+  std::vector<std::string> included;
+  std::vector<std::string> excluded;
+  bool Matches(const GURL& url) const {
+    std::optional<std::string> registrable_domain;
+    auto matches_domain = [&](std::string_view name) {
+      if (!name.ends_with(".*")) {
+        return url.DomainIs(name);
+      }
