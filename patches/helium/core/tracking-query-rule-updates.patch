+def main():
+    output, snapshot, *assets = map(Path, sys.argv[1:])
+    def embed(name, paths):
+        rules = "\n".join(
+            line for path in paths
+            for line in map(str.strip, path.read_text(encoding="utf-8").splitlines())
+            if line.startswith("!#") or (
+                not line.startswith(("!", "[", "#")) and DIRECTIVE.search(line)
+            )
+        )
+        if not rules or ')LuneRules"' in rules:
+            raise ValueError("Expected embeddable uBlock removal directives")
+        return f'constexpr std::string_view {name} = R"LuneRules(\n{rules}\n)LuneRules";\n'
