+         !source.has_username() && !source.has_password() &&
+         !source.has_query() && !source.has_ref() &&
+         source.path().starts_with("/ubo/adguard-spyware-url/") &&
+         source.path().ends_with("/privacy-removeparam.txt") &&
+         url::Origin::Create(source).IsSameOriginWith(
+             url::Origin::Create(helium::GetServicesBaseURL(prefs)));
