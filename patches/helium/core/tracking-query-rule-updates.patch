+    output.write_text(
+        embed("kBundledTrackingQueryRules", assets)
+        + embed("kBundledTrackingQuerySnapshot", [snapshot]),
+        encoding="utf-8",
+    )
+
+
+if __name__ == "__main__":
+    main()
