+      "adguard_ext_chromium", "adguard_ext_opera", "cap_ipaddress",
+      "env_chromium", "ext_ublock",
+  });
+  constexpr auto disabled = base::MakeFixedFlatSet<std::string_view>({
+      "adguard", "adguard_app_android", "adguard_app_cli", "adguard_app_ios",
+      "adguard_app_mac", "adguard_app_windows", "adguard_ext_android_cb",
+      "adguard_ext_chromium_mv3", "adguard_ext_edge", "adguard_ext_firefox",
+      "adguard_ext_safari", "cap_html_filtering", "env_brave", "env_edge",
+      "env_firefox", "env_legacy", "env_mobile", "env_mv3", "env_safari",
+      "ext_abp", "ext_devbuild", "ext_ubol", "false",
