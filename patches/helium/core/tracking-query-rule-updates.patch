+  if (pattern.starts_with("||") && pattern.ends_with('^')) {
+    const std::string_view host = pattern.substr(2, pattern.size() - 3);
+    if (!host.empty() &&
+        host.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789-.") ==
+            std::string_view::npos) {
+      rule.host = host;
+      return true;
+    }
+  }
+
+  std::string expression;
+  if (pattern.starts_with('/') && pattern.ends_with('/')) {
+    expression = pattern.substr(1, pattern.size() - 2);
+  } else {
+    if (pattern.starts_with("||")) {
+      expression = R"(^https?://(?:[^/?#]*\.)?)";
+      pattern.remove_prefix(2);
+    } else if (pattern.starts_with('|')) {
+      expression = "^";
+      pattern.remove_prefix(1);
+    }
+    const bool anchored_end = pattern.ends_with('|');
+    if (anchored_end) {
+      pattern.remove_suffix(1);
+    }
+    while (!pattern.empty()) {
+      const size_t special = pattern.find_first_of("*^");
+      expression += RE2::QuoteMeta(pattern.substr(0, special));
+      if (special == std::string_view::npos) {
+        break;
+      }
+      expression += pattern[special] == '*'
+                        ? ".*"
+                        : "(?:[^a-zA-Z0-9_.%-]|$)";
+      pattern.remove_prefix(special + 1);
+    }
+    if (anchored_end) {
