+TEST(TrackingQueryTest, DownloadReplacesBundledSnapshot) {
+  const GURL original("https://example.test/?pjclid=one&fbclid=two&keep=1");
+  EXPECT_EQ(StripTrackingQuery(original, TrackingQueryAction::kNavigate),
+            GURL("https://example.test/?keep=1"));
+
+  auto rules = TrackingQueryRules::FromDownloadedList("$removeparam=new_id");
+  ASSERT_TRUE(rules);
