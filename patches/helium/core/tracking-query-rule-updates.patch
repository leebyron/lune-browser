+void NetworkContext::SetTrackingQueryCleanup(bool enabled,
+                                             const std::string& list) {
+  enable_tracking_query_cleanup_ = enabled;
+  tracking_query_rules_ =
+      enabled ? net::TrackingQueryRules::FromDownloadedList(list) : nullptr;
+}
+
+std::optional<GURL> NetworkContext::StripTrackingQuery(const GURL& url) const {
+  if (!enable_tracking_query_cleanup_) {
+    return std::nullopt;
+  }
+  return net::StripTrackingQuery(url, net::TrackingQueryAction::kNavigate,
+                                 tracking_query_rules_.get(),
+                                 tracking_query_excluded_domains_);
+}
+
+void NetworkContext::SetTrackingQueryExcludedDomains(
+    const std::vector<std::string>& excluded_domains) {
+  tracking_query_excluded_domains_ = excluded_domains;
+}
