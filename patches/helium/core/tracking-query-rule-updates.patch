+GURL ProfileNetworkContextService::GetTrackingQueryCatalogURL() const {
+  if (is_shutting_down_ || !profile_->IsRegularProfile() ||
+      !tracking_query_cleanup_enabled_ ||
+      !helium::ShouldAccessUBlockAssets(*profile_->GetPrefs())) {
+    return GURL();
+  }
