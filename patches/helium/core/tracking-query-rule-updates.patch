+TEST(TrackingQueryTest, UsesBundledUBlockFilterConditions) {
+  auto rules = TrackingQueryRules::FromDownloadedList(
+      "!#if (ext_ublock && env_chromium)\n"
+      "$removeparam=classic\n"
+      "!#if !ext_ubol\n"
+      "$removeparam=not_lite\n"
+      "!#endif\n"
+      "!#else\n"
+      "$removeparam=other_browser\n"
+      "!#endif\n"
+      "!#if cap_ipaddress || env_firefox\n"
+      "$removeparam=has_ip\n"
+      "!#else\n"
+      "!#include inactive-list.txt\n"
+      "!#endif\n");
+  ASSERT_TRUE(rules);
+  const GURL original(
+      "https://example.test/?classic=1&not_lite=1&other_browser=1&has_ip=1");
+  EXPECT_EQ(StripTrackingQuery(original, TrackingQueryAction::kCopy,
+                              rules.get()),
+            GURL("https://example.test/?other_browser=1"));
+}
+
+TEST(TrackingQueryTest, KeepsUnsupportedDownloadsFromReplacingRules) {
+  EXPECT_FALSE(TrackingQueryRules::FromDownloadedList("No list here."));
+  for (std::string_view unsupported : {
+           "@@$removeparam,unsupported",
+           "!#include more-rules.txt",
+           "$removeparam=|legacy",
+           "$removeparam=~|legacy",
+           "$removeparam=multiple|values",
+           "$removeparam=first,queryprune=second",
+           "$removeparam=~",
+           "$removeparam=//",
+           "!#if ext_ublock && cap_unknown\n"
+           "@@$removeparam\n"
+           "!#endif",
+           "!#if unknown || ext_ublock\n"
+           "@@$removeparam\n"
+           "!#endif",
+           "!#if ext_ublock\n"
+           "!#else\n"
+           "!#else\n"
+           "!#endif",
