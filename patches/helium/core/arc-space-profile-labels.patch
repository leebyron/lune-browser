+namespace {
+
+// Synced custom profiles are identified by both device and directory.
+std::string_view GetArcSpaceProfile(const base::DictValue& space,
+                                    std::string_view local_machine_id) {
+  const auto* profile = space.FindDict("profile");
+  if (!profile) {
+    return {};
+  }
+  if (profile->FindBool("default").value_or(false)) {
+    return "Default";
+  }
+  const auto* custom = profile->FindDictByDottedPath("custom._0");
+  if (!custom || local_machine_id.empty()) {
+    return {};
+  }
+  const auto* machine_id = custom->FindString("machineID");
+  const auto* basename = custom->FindString("directoryBasename");
+  if (!machine_id || !basename ||
+      !base::EqualsCaseInsensitiveASCII(*machine_id, local_machine_id)) {
+    return {};
+  }
+  return *basename;
+}
+
+using ArcSpaceNames = std::map<std::string, std::vector<std::string>, std::less<>>;
+
+ArcSpaceNames ReadArcSpaceNames(const base::FilePath& sidebar_path) {
+  std::string content;
+  if (!base::ReadFileToString(sidebar_path, &content)) {
+    return {};
+  }
+  const auto sidebar =
+      base::JSONReader::ReadDict(content, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  const auto* containers =
+      sidebar ? sidebar->FindListByDottedPath("sidebar.containers") : nullptr;
+  if (!containers) {
+    return {};
+  }
+
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> machine_id_pref(
+      CFPreferencesCopyAppValue(CFSTR("machineID"),
+                                CFSTR("company.thebrowser.Browser")));
+  const auto machine_id_string =
+      base::apple::CFCast<CFStringRef>(machine_id_pref.get());
+  const std::string machine_id =
+      machine_id_string ? base::SysCFStringRefToUTF8(machine_id_string) : "";
+  ArcSpaceNames names;
+  for (const auto& container : *containers) {
+    const auto* data = container.GetIfDict();
+    const auto* spaces = data ? data->FindList("spaces") : nullptr;
+    if (!spaces) {
+      continue;
+    }
+    // The sidebar list alternates Space IDs and their dictionaries.
+    for (size_t i = 0; i + 1 < spaces->size(); i += 2) {
+      const auto* space = (*spaces)[i + 1].GetIfDict();
+      if (!(*spaces)[i].is_string() || !space) {
+        continue;
+      }
+      const auto* title = space->FindString("title");
+      const std::string_view id = GetArcSpaceProfile(*space, machine_id);
+      if (id.empty() || !title) {
+        continue;
+      }
+      const std::string_view name =
+          base::TrimWhitespaceASCII(*title, base::TRIM_ALL);
+      if (name.empty()) {
+        continue;
+      }
+      auto& titles = names[std::string(id)];
+      if (std::ranges::find(titles, name) == titles.end()) {
+        titles.emplace_back(name);
+      }
+    }
+  }
+  return names;
+}
+
