+base::ListValue GetArcSourceProfiles(const base::FilePath& user_data_folder) {
+  auto profiles = GetChromeSourceProfiles(
+      user_data_folder.AppendASCII("Local State"), /*prefer_last_used=*/true);
+  if (profiles.empty()) {
+    return profiles;
+  }
+  const auto names = ReadArcSpaceNames(
+      user_data_folder.DirName().AppendASCII("StorableSidebar.json"));
+  for (auto& profile : profiles) {
+    auto& entry = profile.GetDict();
+    const auto it = names.find(*entry.FindString("id"));
+    if (it != names.end()) {
+      entry.Set("name", base::JoinString(it->second, ", "));
+    }
+  }
+  return profiles;
+}
