+
+#include <optional>
+
+#include "net/base/net_export.h"
+#include "url/gurl.h"
+
+namespace net {
+
+enum class TrackingQueryAction { kNavigate, kCopy };
+
+// Returns a replacement URL only when an HTTP(S) query was cleaned.
+NET_EXPORT std::optional<GURL> StripTrackingQuery(
+    const GURL& url,
+    TrackingQueryAction action);
