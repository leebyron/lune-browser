+// Copyright 2026 The Lune Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "net/base/tracking_query.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/fixed_flat_set.h"
+#include "base/feature_list.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace net {
+
+namespace {
+
+BASE_FEATURE(kHeliumTrackingQueryCleanup, base::FEATURE_ENABLED_BY_DEFAULT);
+
+// Reviewed parameter names from AdGuard/uBO URL Tracking Protection. Keep
+// ambiguous names such as "si" restricted to the destinations that use them
+// for tracking. See https://github.com/uBlockOrigin/uAssets/blob/master/filters/privacy-removeparam.txt
+constexpr auto kClickIdentifiers = base::MakeFixedFlatSet<std::string_view>({
+    "dclid", "fbclid", "gclid", "msclkid", "ttclid", "twclid",
+});
+
+constexpr auto kCampaignParameters = base::MakeFixedFlatSet<std::string_view>({
+    "utm_campaign", "utm_content", "utm_id", "utm_medium", "utm_source",
+    "utm_source_platform", "utm_term",
+});
+
+constexpr auto kSignatureParameters = base::MakeFixedFlatSet<std::string_view>({
+    "hmac", "key-pair-id", "oauth_signature", "sig", "signature",
+    "x-amz-signature", "x-goog-signature",
+});
+
+bool IsTrackingParameter(std::string_view name,
+                         const GURL& url,
+                         TrackingQueryAction action) {
+  return kClickIdentifiers.contains(name) ||
+         (action == TrackingQueryAction::kCopy &&
+          kCampaignParameters.contains(name)) ||
+         (name == "si" &&
+          (url.DomainIs("youtu.be") || url.DomainIs("open.spotify.com") ||
+           (url.DomainIs("youtube.com") &&
+            url.path().starts_with("/shorts/")))) ||
+         (name == "igsh" && url.DomainIs("instagram.com")) ||
+         (name == "igshid" &&
+          (url.DomainIs("instagram.com") || url.DomainIs("threads.com") ||
+           url.DomainIs("threads.net")));
+}
+
+}  // namespace
+
+std::optional<GURL> StripTrackingQuery(const GURL& url,
+                                     TrackingQueryAction action) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.query().empty() ||
+      !base::FeatureList::IsEnabled(kHeliumTrackingQueryCleanup)) {
+    return std::nullopt;
+  }
+
+  const auto fields = base::SplitStringPiece(
+      url.query(), "&", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::vector<std::string_view> kept;
+  kept.reserve(fields.size());
+  bool has_code = false;
+  bool has_state = false;
+  bool has_client_id = false;
+  bool has_redirect_uri = false;
+  for (std::string_view field : fields) {
+    const auto name = base::ToLowerASCII(base::UnescapeBinaryURLComponent(
+        field.substr(0, field.find('='))));
+    // A signature may cover the whole query. Keep OAuth URLs intact as well.
+    if (kSignatureParameters.contains(name)) {
+      return std::nullopt;
+    }
+    has_code |= name == "code";
+    has_state |= name == "state";
+    has_client_id |= name == "client_id";
+    has_redirect_uri |= name == "redirect_uri";
+    if (!IsTrackingParameter(name, url, action)) {
+      kept.push_back(field);
+    }
+  }
+
+  if (kept.size() == fields.size() || (has_code && has_state) ||
+      (has_client_id && has_redirect_uri)) {
+    return std::nullopt;
+  }
+
+  // Match decoded names, but use the original fields to rebuild the URL.
+  const std::string query = base::JoinString(kept, "&");
+  GURL::Replacements replacements;
+  if (kept.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+}  // namespace net
