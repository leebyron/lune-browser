+// Copyright 2026 The Lune Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "net/base/tracking_query.h"
+
+#include "base/test/scoped_feature_list.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace net {
+namespace {
+
+TEST(TrackingQueryTest, PreservesOriginalFieldsAndFragment) {
+  const GURL original(
+      "https://example.test/a?item=%2f%2B+%20&%66bclid=one&item=two&FBCLID"
+      "&empty=&bare#details");
+  EXPECT_EQ(StripTrackingQuery(original, TrackingQueryAction::kNavigate),
+            GURL("https://example.test/a?item=%2f%2B+%20&item=two&empty=&bare"
+                 "#details"));
+  EXPECT_EQ(StripTrackingQuery(GURL("https://example.test/?gclid=test#details"),
+                               TrackingQueryAction::kNavigate),
+            GURL("https://example.test/#details"));
+}
+
+TEST(TrackingQueryTest, RemovesCampaignTagsOnCopy) {
+  const GURL url("https://example.test/?utm_source=mail&id=7&s=price");
+  EXPECT_FALSE(StripTrackingQuery(url, TrackingQueryAction::kNavigate));
+  EXPECT_EQ(StripTrackingQuery(url, TrackingQueryAction::kCopy),
+            GURL("https://example.test/?id=7&s=price"));
+}
+
+TEST(TrackingQueryTest, RestrictsShareIdentifiersToDocumentedSites) {
+  for (const auto action :
+       {TrackingQueryAction::kNavigate, TrackingQueryAction::kCopy}) {
+    EXPECT_EQ(StripTrackingQuery(GURL("https://youtu.be/video?si=test&t=30"),
+                                 action),
+              GURL("https://youtu.be/video?t=30"));
+    EXPECT_EQ(StripTrackingQuery(
+                  GURL("https://open.spotify.com/track/track?si=test"), action),
+              GURL("https://open.spotify.com/track/track"));
+    EXPECT_EQ(StripTrackingQuery(
+                  GURL("https://www.instagram.com/p/post/?igsh=test"), action),
+              GURL("https://www.instagram.com/p/post/"));
+    EXPECT_FALSE(StripTrackingQuery(GURL("https://example.test/?si=keep"),
+                                    action));
+    EXPECT_FALSE(StripTrackingQuery(GURL("https://youtube.com.evil.test/"
+                                         "shorts/video?si=keep"),
+                                    action));
+  }
+}
+
+TEST(TrackingQueryTest, PreservesSignedAndOAuthUrls) {
+  for (const auto action :
+       {TrackingQueryAction::kNavigate, TrackingQueryAction::kCopy}) {
+    EXPECT_FALSE(StripTrackingQuery(
+        GURL("https://example.test/?fbclid=test&X-Amz-Signature=abc"), action));
+    EXPECT_FALSE(StripTrackingQuery(
+        GURL("https://example.test/?state=abc&fbclid=test&code=def"), action));
+    EXPECT_FALSE(StripTrackingQuery(
+        GURL("https://example.test/?client_id=abc&fbclid=test&redirect_uri=def"),
+        action));
+    EXPECT_FALSE(StripTrackingQuery(GURL("file:///tmp/f?fbclid=test"), action));
+  }
+}
+
+TEST(TrackingQueryTest, CanDisableCleanup) {
+  base::test::ScopedFeatureList features;
+  features.InitFromCommandLine("", "HeliumTrackingQueryCleanup");
+  const GURL url("https://example.test/?fbclid=keep");
+  EXPECT_FALSE(StripTrackingQuery(url, TrackingQueryAction::kNavigate));
+  EXPECT_FALSE(StripTrackingQuery(url, TrackingQueryAction::kCopy));
+}
+
+}  // namespace
