+bool TabStripModel::WillContextMenuMuteTabs(int index) {
+  for (int tab_index : GetIndicesForCommand(index)) {
+    WebContents* const contents = GetWebContentsAt(tab_index);
+    if (contents && !contents->IsAudioMuted()) {
+      return true;
+    }
+  }
+  return false;
+}
