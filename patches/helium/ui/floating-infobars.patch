+TEST_F(InfoBarContainerWithPriorityTest, ShowAllDrainsQueueAndAdmitsEveryPriority) {
+  TestPriorityContainer container(&delegate_);
+  TestManager manager;
+  container.ChangeInfoBarManager(&manager);
+  auto* first = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kDefault);
+  auto* second = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kDefault);
+  auto* low = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kLow);
+  ASSERT_EQ(1u, container.visible_count());
+  ASSERT_EQ(2u, container.PendingInfoBarCount());
+
+  container.SetShowAllInfoBars(true);
+  EXPECT_EQ(3u, container.visible_count());
+  EXPECT_EQ(0u, container.PendingInfoBarCount());
+  EXPECT_TRUE(container.IsCurrentlyVisible(first));
+  EXPECT_TRUE(container.IsCurrentlyVisible(second));
+  EXPECT_TRUE(container.IsCurrentlyVisible(low));
+  EXPECT_EQ(0u, container.pending_count_notifications().back());
+
+  auto* critical =
+      AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kCriticalSecurity);
+  auto* another = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kDefault);
+  EXPECT_EQ(5u, container.visible_count());
+  EXPECT_TRUE(container.IsCurrentlyVisible(critical));
+  EXPECT_TRUE(container.IsCurrentlyVisible(another));
+  manager.RemoveInfoBar(second);
+  EXPECT_EQ(4u, container.visible_count());
+  EXPECT_FALSE(container.HasPendingInfoBars());
+}
+
+TEST_F(InfoBarContainerWithPriorityTest, DisablingShowAllRestoresAdmissionLimits) {
+  TestPriorityContainer container(&delegate_);
+  TestManager manager;
+  container.SetShowAllInfoBars(true);
+  container.ChangeInfoBarManager(&manager);
+  auto* first = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kDefault);
+  auto* second = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kDefault);
+  container.SetShowAllInfoBars(false);
+  auto* third = AddInfoBar(&manager, InfoBarDelegate::InfobarPriority::kDefault);
+  EXPECT_EQ(2u, container.visible_count());
+  EXPECT_EQ(1u, container.PendingInfoBarCount());
+  EXPECT_FALSE(container.IsCurrentlyVisible(third));
+
+  manager.RemoveInfoBar(first);
+  EXPECT_FALSE(container.IsCurrentlyVisible(third));
+  manager.RemoveInfoBar(second);
+  EXPECT_TRUE(container.IsCurrentlyVisible(third));
+  EXPECT_EQ(1u, container.visible_count());
+  EXPECT_FALSE(container.HasPendingInfoBars());
+}
