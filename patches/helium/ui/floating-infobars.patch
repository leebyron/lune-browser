+
+bool InfoBarContainerView::DoesIntersectRect(const views::View* target,
+                                            const gfx::Rect& rect) const {
+  if (!views::ViewTargeterDelegate::DoesIntersectRect(target, rect)) {
+    return false;
+  }
+  if (!floating_) {
+    return true;
+  }
+  // Transparent gaps and the rounded ends must pass input to the page.
+  for (const View* child : children()) {
+    if (child == chrome_border_ || !child->GetVisible()) {
+      continue;
+    }
+    gfx::Rect child_rect = rect;
+    child_rect.Offset(-child->x(), -child->y());
+    if (child->HitTestRect(child_rect)) {
+      return true;
+    }
+  }
+  return false;
+}
