+
+bool InfoBarView::GetHitTestMask(SkPath* mask) const {
+  const SkRect bounds = gfx::RectToSkRect(GetLocalBounds());
+  const float radius = GetFloatingCornerRadius();
+  *mask = floating_ ? SkPath::RRect(bounds, radius, radius)
+                   : SkPath::Rect(bounds);
+  return true;
+}
+
+void InfoBarView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::View::OnBoundsChanged(previous_bounds);
+  if (floating_ && previous_bounds.size() != size()) {
+    UpdateBackground();
+  }
+}
+
+float InfoBarView::GetFloatingCornerRadius() const {
+  // Concentric with the window corner at the layout's 8 DIP content inset.
+  // Clamp while the infobar animates open or closed.
+  return std::min({static_cast<float>(std::max(0, GetSystemWindowRadius() - 8)),
+                   height() / 2.0f, width() / 2.0f});
+}
+
+void InfoBarView::UpdateBackground() {
+  const bool should_use_native_frame_materials =
+      !floating_ && helium::ShouldUseNativeFrameMaterials(this);
+  const float radius = floating_ ? GetFloatingCornerRadius() : 0;
+  if (floating_) {
+    SetBackground(
+        views::CreateRoundedRectBackground(kColorInfoBarBackground, radius));
+    SetBorder(std::make_unique<FloatingInfoBarBorder>(radius));
+    if (!floating_shadow_) {
+      floating_shadow_ = std::make_unique<views::ViewDecoration>(this);
+      floating_shadow_->SetShadow(
+          4, ui::decoration::Shadow::Style::kMaterialDesign,
+          ui::decoration::Shadow::ElevationToColorsMap{
+              {4, {SkColorSetA(SK_ColorBLACK, 0x20),
+                   SkColorSetA(SK_ColorBLACK, 0x10)}}});
+    }
+    floating_shadow_->SetRoundedCorners(gfx::RoundedCornersF(radius));
+  } else if (should_use_native_frame_materials) {
+    SetBackground(nullptr);
+  } else {
+    SetBackground(views::CreateSolidBackground(kColorInfoBarBackground));
+  }
+  if (!floating_) {
+    floating_shadow_.reset();
+    SetBorder(nullptr);
+  }
+  if (layer()) {
+    layer()->SetFillsBoundsOpaquely(!floating_ &&
+                                   !should_use_native_frame_materials);
+    layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(radius));
+    layer()->SetIsFastRoundedCorner(floating_);
+  }
+}
