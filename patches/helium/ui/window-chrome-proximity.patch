+bool IsPointerInNativeWindowHoverArea(const BrowserView* view,
+                                      bool retention) {
+  if (!view || !view->GetWidget() || view->IsFullscreen()) {
+    return false;
+  }
+  NSWindow* window = view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSView* content = window.contentView;
+  if (!content) {
+    return false;
+  }
+  const NSRect bounds = [window convertRectToScreen:
+      [content convertRect:content.bounds toView:nil]];
+  const CGFloat margin = retention ? 16 : 8;
+  const NSPoint pointer = NSEvent.mouseLocation;
+  return pointer.x >= NSMinX(bounds) - margin &&
+         pointer.x <= NSMaxX(bounds) + margin &&
+         pointer.y >= NSMinY(bounds) - margin &&
+         pointer.y <= NSMaxY(bounds) + margin;
+}
