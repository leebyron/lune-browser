+gfx::ImageSkia NativeToolbarSymbol(const views::View* view,
+                                 const char* icon_name, int size,
+                                 SkColor color) {
+  if (!IsFloatingToolbarControl(view)) {
+    return {};
+  }
+  return NativeToolbarSymbolForIcon(icon_name, size, color);
+}
+
+gfx::ImageSkia NativeToolbarSymbolForIcon(const char* icon_name_or_null, int size,
+                                        SkColor color) {
+  // Drag reordering deliberately supplies VectorIcon::EmptyIcon(), whose
+  // name is null. Preserve that empty placeholder instead of reading it.
+  if (!icon_name_or_null) {
+    return {};
+  }
+  const std::string_view icon_name(icon_name_or_null);
+  NSString* name = nil;
+  // Only replace recognized browser artwork. Extension-provided images and
+  // specialized warning/status icons retain their original representation.
+  if (icon_name == "kMoreVertIcon" ||
+      icon_name == "kBrowserToolsChromeRefreshOldIcon" ||
+      icon_name == "kBrowserToolsTouchOldIcon" ||
+      icon_name == "kBrowserToolsOldIcon") {
+    name = @"ellipsis";
+  } else if (icon_name == "kChromeExtensionIcon" ||
+             icon_name == "kExtensionIcon" ||
+             icon_name == "kExtensionChromeRefreshOldIcon" ||
+             icon_name == "kExtensionOldIcon") {
+    name = @"puzzlepiece.extension";
+  } else if (icon_name == "kDownloadIcon" ||
+             icon_name == "kDownloadToolbarButtonChromeRefreshOldIcon") {
+    name = @"arrow.down.circle";
+  } else if (icon_name == "kSplitSceneIcon" ||
+             icon_name == "kSplitSceneOldIcon") {
+    name = @"rectangle.split.2x1";
+  } else if (icon_name == "kPrintIcon" || icon_name == "kPrintMenuOldIcon") {
+    name = @"printer";
+  } else if (icon_name == "kHistoryIcon" ||
+             icon_name == "kHistoryChromeRefreshOldIcon") {
+    name = @"clock.arrow.circlepath";
+  } else if (icon_name == "kTranslateIcon") {
+    name = @"translate";
+  } else if (icon_name == "kShareIcon") {
+    name = @"square.and.arrow.up";
+  } else if (icon_name == "kHotelClassIcon" ||
+             icon_name == "kBookmarksSidePanelRefreshOldIcon") {
+    name = @"book";
+  } else if (icon_name == "kDeleteIcon" ||
+             icon_name == "kTrashCanRefreshOldIcon") {
+    name = @"trash";
+  } else if (icon_name == "kCastIcon" ||
+             icon_name == "kCastChromeRefreshOldIcon") {
+    name = @"airplay.video";
+  } else if (icon_name == "kQrCodeIcon" ||
+             icon_name == "kQrCodeChromeRefreshOldIcon") {
+    name = @"qrcode";
+  } else if (icon_name == "kCodeIcon" ||
+             icon_name == "kDeveloperToolsOldIcon") {
+    name = @"chevron.left.forwardslash.chevron.right";
+  } else if (icon_name == "kTableChartIcon") {
+    name = @"memorychip";
+  } else if (icon_name == "kLinkIcon" ||
+             icon_name == "kLinkChromeRefreshOldIcon") {
+    name = @"square.and.arrow.up";
+  } else if (icon_name == "kEditIcon" ||
+             icon_name == "kEditChromeRefreshOldIcon") {
+    name = @"slider.horizontal.2.square";
+  } else if (icon_name == "kAccountBoxIcon" || icon_name == "kAccountBoxOldIcon" ||
+             icon_name == "kAccountCircleIcon" ||
+             icon_name == "kAccountCircleChromeRefreshOldIcon") {
+    name = @"person.crop.circle";
+  } else if (icon_name == "kManageSearchIcon" ||
+             icon_name == "kTabSearchTabStripOldIcon") {
+    name = @"rectangle.and.text.magnifyingglass";
+  } else if (icon_name == "kIncognitoIcon" ||
+             icon_name == "kIncognitoRefreshMenuOldIcon" ||
+             icon_name == "kIncognitoCircleFilledIcon" ||
+             icon_name == "kIncognitoOldIcon") {
+    name = @"eye.slash";
+  } else if (icon_name == "kQueueMusicIcon" ||
+             icon_name == "kMediaToolbarButtonChromeRefreshOldIcon" ||
+             icon_name == "kMediaToolbarButtonTouchOldIcon") {
+    name = @"music.note.list";
+  }
+  if (icon_name == "kArrowBackIcon" ||
+      icon_name == "kBackArrowChromeRefreshOldIcon") {
+    name = @"chevron.backward";
+  } else if (icon_name == "kArrowForwardIcon" ||
+             icon_name == "kForwardArrowChromeRefreshOldIcon") {
+    name = @"chevron.forward";
+  } else if (icon_name == "kRefreshIcon" ||
+             icon_name == "kReloadChromeRefreshOldIcon") {
+    name = @"arrow.clockwise";
+  } else if (icon_name == "kHomeIcon" ||
+             icon_name == "kNavigateHomeChromeRefreshOldIcon") {
+    name = @"house";
+  } else if (icon_name == "kSidebarLeftIcon") {
+    name = @"sidebar.left";
+  } else if (icon_name == "kSidebarRightIcon") {
+    name = @"sidebar.right";
+  } else if (icon_name == "kAddIcon" ||
+             icon_name == "kAddWeight500CustomIcon") {
+    name = @"plus";
+  } else if (icon_name == "kGlobeIcon") {
+    name = @"globe";
+  }
+  if (!name) {
+    return {};
+  }
+  NSImage* symbol = [NSImage imageWithSystemSymbolName:name
+                              accessibilityDescription:nil];
+  if (!symbol) {
+    return {};
+  }
+  symbol = [symbol imageWithSymbolConfiguration:
+      [NSImageSymbolConfiguration configurationWithPointSize:16
+                                                     weight:NSFontWeightMedium]];
+  NSImage* image = [NSImage imageWithSize:NSMakeSize(size, size) flipped:NO
+      drawingHandler:^BOOL(NSRect bounds) {
+    NSSize symbol_size = symbol.size;
+    // Fit tall/wide symbols without changing the common image/target center.
+    const CGFloat scale = std::min<CGFloat>(1, std::min(
+        size / symbol_size.width, size / symbol_size.height));
+    symbol_size.width *= scale;
+    symbol_size.height *= scale;
+    [symbol drawInRect:NSMakeRect((size - symbol_size.width) / 2,
+                                 (size - symbol_size.height) / 2,
+                                 symbol_size.width, symbol_size.height)];
+    return YES;
+  }];
+  return gfx::ImageSkiaOperations::CreateColorMask(
+      gfx::ImageSkiaFromNSImage(image), color);
+}
