+// Match the Views toolbar's semantic symbol colors without a hover bezel.
+@interface HeliumHeaderSymbolButton : NSButton
+@end
+@implementation HeliumHeaderSymbolButton {
+  NSTrackingArea* _symbolTrackingArea;
+  BOOL _symbolHovered;
+  NSTimer* _symbolFadeTimer;
+  CGFloat _symbolHoverAmount;
+  CGFloat _symbolFadeFrom;
+  NSTimeInterval _symbolFadeStart;
+}
+- (void)dealloc {
+  [_symbolFadeTimer invalidate];
+}
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  if (!self.window) {
+    [_symbolFadeTimer invalidate];
+    _symbolFadeTimer = nil;
+    _symbolHovered = NO;
+    _symbolHoverAmount = 0;
+  }
+}
+- (void)advanceSymbolFade {
+  const CGFloat progress = std::clamp(
+      (NSDate.timeIntervalSinceReferenceDate - _symbolFadeStart) / 0.1,
+      0.0, 1.0);
+  const CGFloat target = _symbolHovered ? 1 : 0;
+  _symbolHoverAmount = _symbolFadeFrom + (target - _symbolFadeFrom) * progress;
+  self.needsDisplay = YES;
+  if (progress >= 1) {
+    [_symbolFadeTimer invalidate];
+    _symbolFadeTimer = nil;
+  }
+}
+- (void)setSymbolHovered:(BOOL)hovered {
+  if (_symbolHovered == hovered) {
+    return;
+  }
+  if (_symbolFadeTimer) {
+    [self advanceSymbolFade];
+    [_symbolFadeTimer invalidate];
+  }
+  _symbolHovered = hovered;
+  _symbolFadeFrom = _symbolHoverAmount;
+  _symbolFadeStart = NSDate.timeIntervalSinceReferenceDate;
+  __weak HeliumHeaderSymbolButton* weakSelf = self;
+  _symbolFadeTimer = [NSTimer timerWithTimeInterval:1.0 / 60 repeats:YES
+      block:^(NSTimer* timer) {
+        [weakSelf advanceSymbolFade];
+      }];
+  [NSRunLoop.mainRunLoop addTimer:_symbolFadeTimer forMode:NSRunLoopCommonModes];
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_symbolTrackingArea) {
+    [self removeTrackingArea:_symbolTrackingArea];
+  }
+  _symbolTrackingArea = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways |
+                   NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_symbolTrackingArea];
+  [self setSymbolHovered:self.window && NSMouseInRect(
+      [self convertPoint:self.window.mouseLocationOutsideOfEventStream
+                fromView:nil], self.visibleRect, self.isFlipped)];
+  self.needsDisplay = YES;
+}
+- (void)mouseEntered:(NSEvent*)event {
+  [self setSymbolHovered:YES];
+}
+- (void)mouseExited:(NSEvent*)event {
+  [self setSymbolHovered:NO];
+}
+- (void)drawRect:(NSRect)dirtyRect {
+  NSColor* tint = NSColor.secondaryLabelColor;
+  if (!self.enabled) {
+    tint = NSColor.disabledControlTextColor;
+  } else if (self.cell.isHighlighted) {
+    tint = [tint colorWithSystemEffect:NSColorSystemEffectPressed];
+  } else {
+    NSColor* hover = [tint colorWithSystemEffect:NSColorSystemEffectRollover];
+    tint = [tint blendedColorWithFraction:_symbolHoverAmount ofColor:hover];
+  }
+  if (![self.contentTintColor isEqual:tint]) {
+    self.contentTintColor = tint;
+  }
+  [super drawRect:dirtyRect];
+}
+@end
