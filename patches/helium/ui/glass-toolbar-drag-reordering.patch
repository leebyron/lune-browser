+
+void SetFloatingToolbarDropPlaceholder(views::View* view, bool shown) {
+  if (!view || (shown && !IsFloatingToolbarControl(view)) ||
+      view->GetProperty(kFloatingToolbarDropPlaceholderKey) == shown) {
+    return;
+  }
+  view->SetProperty(kFloatingToolbarDropPlaceholderKey, shown);
+  view->SchedulePaint();
+}
+
+void PaintFloatingToolbarDropPlaceholder(const views::View& view,
+                                         gfx::Canvas& canvas) {
+  if (!view.GetProperty(kFloatingToolbarDropPlaceholderKey)) {
+    return;
+  }
+  gfx::Rect bounds = view.GetLocalBounds();
+  bounds.Inset(3);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(ChromeDropPlaceholderColor(view));
+  canvas.DrawRoundRect(bounds, std::min(bounds.width(), bounds.height()) / 2.f,
+                       flags);
+}
