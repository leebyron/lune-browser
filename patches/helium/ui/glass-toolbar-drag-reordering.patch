+std::optional<size_t> PinnedToolbarActionsContainer::GetDropIndex(
+    int event_x,
+    actions::ActionId dragged_id) {
+  int offset = GetMirroredXInView(event_x);
+  if (helium::IsFloatingToolbarControl(this)) {
+    const auto* layout = GetAnimatingLayoutManager();
+    std::optional<size_t> last_slot;
+    for (size_t i = 0; i < pinned_buttons_.size(); ++i) {
+      auto* button = pinned_buttons_[i].get();
+      if (button->GetActionId() != dragged_id &&
+          !layout->CanBeVisible(button) && !button->GetVisible()) {
+        continue;
+      }
+      // Read the logical slots. The dragged action keeps its space while
+      // the actual views are animated to temporary positions.
+      offset -= button->GetPreferredSize().width();
+      last_slot = i;
+      if (offset < 0) {
+        break;
+      }
+    }
+    return last_slot;
+  }
+
+  const size_t visible_pinned_icons = std::ranges::count_if(
+      pinned_buttons_,
+      [](PinnedActionToolbarButton* button) { return button->GetVisible(); });
+  if (visible_pinned_icons == 0) {
+    return std::nullopt;
+  }
+  const size_t button_offset = pinned_buttons_.size() - visible_pinned_icons;
+  return std::min(WidthToIconCount(offset), visible_pinned_icons - 1) +
+         button_offset;
+}
