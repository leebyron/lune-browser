+class SiteInfoPopoverWidget : public views::NativeWidgetMac,
+                              public views::ViewObserver {
+ public:
+  SiteInfoPopoverWidget(views::Widget* widget, NSView* anchor)
+      : NativeWidgetMac(widget), anchor_(anchor) {}
+
+  void Show(ui::mojom::WindowShowState show_state,
+            const gfx::Rect&) override {
+    NSView* anchor = anchor_;
+    NSView* positioning_view = anchor.superview;
+    if (!positioning_view.window || anchor.hiddenOrHasHiddenAncestor) {
+      GetWidget()->Close();
+      return;
+    }
+
+    auto* root = GetWidget()->GetRootView();
+    views::SetVectorIconRenderer(*root, RenderSiteInfoSymbol);
+    ConfigurePopoverContent(root);
+    root_observation_.Observe(root);
+
+    NSView* contents = GetNativeView().GetNativeNSView();
+    const NSSize content_size = contents.frame.size;
+    NSViewController* controller = [[NSViewController alloc] init];
+    controller.view = [[NSView alloc] initWithFrame:NSMakeRect(
+        0, 0, content_size.width, content_size.height)];
+    contents.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    // Keep the Views bridge's backing window hidden. Cache its NSView as
+    // NativeViewHost does when moving the content view to another window.
+    SetNativeWindowProperty(
+        views::NativeWidgetMacNSWindowHost::kMovedContentNSView,
+        (__bridge void*)contents);
+    NSWindow* backing_window = GetNativeWindow().GetNativeNSWindow();
+    backing_window.contentView = nil;
+    backing_window.ignoresMouseEvents = YES;
+    [controller.view addSubview:contents];
+
+    popover_delegate_ = [[HeliumSiteInfoPopoverDelegate alloc]
+        initWithWidget:GetWidget()->GetWeakPtr()];
+    popover_ = [[NSPopover alloc] init];
+    popover_.behavior = NSPopoverBehaviorTransient;
+    popover_.delegate = popover_delegate_;
+    popover_.appearance = anchor.effectiveAppearance;
+    popover_.contentViewController = controller;
+    popover_.contentSize = content_size;
+
+    // AppKit clips the positioning rect to its view. Use the capsule's
+    // controls view so the pointer can sit just below the button.
+    const NSRect button_rect = [positioning_view convertRect:anchor.bounds
+                                                   fromView:anchor];
+    const CGFloat downward_offset = positioning_view.isFlipped ? 1 : -1;
+    const NSRect positioning_rect = NSOffsetRect(button_rect, 0, downward_offset);
+    const NSRectEdge preferred_edge =
+        positioning_view.isFlipped ? NSRectEdgeMaxY : NSRectEdgeMinY;
+    remote_cocoa::mojom::NativeWidgetNSWindowHost* host = GetNSWindowHost();
+    // Mark the Views widget as shown before the popover takes key focus so
+    // the toolbar's existing bubble-retention logic can see it.
+    host->OnVisibilityChanged(true);
+    [popover_ showRelativeToRect:positioning_rect
+                         ofView:positioning_view
+                  preferredEdge:preferred_edge];
+    if (!popover_.shown) {
+      GetWidget()->Close();
+      return;
+    }
+    // BridgedContentView clears its size when it moves into an NSWindow
+    // whose content view it does not own. Size it to the AppKit host here.
+    contents.frame = controller.view.bounds;
+    [backing_window orderOut:nil];
+    ClearNativeFocus();
+    NSWindow* popover_window = controller.view.window;
+    [popover_window makeKeyWindow];
+    host->OnWindowKeyStatusChanged(
+        popover_window.isKeyWindow, popover_window.firstResponder == contents,
+        NSApp.fullKeyboardAccessEnabled);
+    GetWidget()->SetInitialFocus(show_state);
+
+    __weak NSView* weak_anchor = anchor;
+    __weak NSWindow* weak_popover_window = popover_window;
+    auto widget = GetWidget()->GetWeakPtr();
+    escape_monitor_ = [NSEvent
+        addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown
+        handler:^NSEvent*(NSEvent* event) {
+          NSWindow* event_window = event.window ?: NSApp.keyWindow;
+          NSWindow* anchor_window = weak_anchor.window;
+          if (widget && !widget->IsClosed() && anchor_window &&
+              (event_window == weak_popover_window ||
+               event_window == anchor_window || NSApp.mainWindow == anchor_window) &&
+              ui::KeyboardCodeFromNSEvent(event) == ui::VKEY_ESCAPE) {
+            widget->CloseWithReason(views::Widget::ClosedReason::kEscKeyPressed);
+            return nil;
+          }
+          return event;
+        }];
+  }
+
+  void SetBounds(const gfx::Rect& bounds) override {
+    NativeWidgetMac::SetBounds(bounds);
+    if (popover_) {
+      popover_.contentSize = NativeWidgetMac::GetClientAreaBoundsInScreen()
+                                 .size()
+                                 .ToCGSize();
+    }
+  }
+
+  gfx::Rect GetClientAreaBoundsInScreen() const override {
+    NSView* contents = popover_.contentViewController.view;
+    NSWindow* window = contents.window;
+    return window ? gfx::ScreenRectFromNSRect(
+                        [window convertRectToScreen:
+                                    [contents convertRect:contents.bounds
+                                                  toView:nil]])
+                  : NativeWidgetMac::GetClientAreaBoundsInScreen();
+  }
+
+  gfx::Rect GetWindowBoundsInScreen() const override {
+    NSWindow* window = popover_.contentViewController.view.window;
+    return window ? gfx::ScreenRectFromNSRect(window.frame)
+                  : NativeWidgetMac::GetWindowBoundsInScreen();
+  }
+
+  void ClearNativeFocus() override {
+    NSView* contents = GetNativeView().GetNativeNSView();
+    [contents.window makeFirstResponder:contents];
+  }
+
+  void Activate() override {
+    [popover_.contentViewController.view.window makeKeyWindow];
+  }
+
+  // The Views sublevel manager orders the widget at the end of Show().
+  // AppKit already positions the popover. Ordering the backing window would
+  // place it over the popover and intercept clicks on its contents.
+  void StackAbove(gfx::NativeView) override {}
+  void StackAtTop() override {}
+
+  void Close() override {
+    ClosePopover();
+    NativeWidgetMac::Close();
+  }
+
+  void CloseNow() override {
+    ClosePopover();
+    NativeWidgetMac::CloseNow();
+  }
+
+ private:
+  void OnViewHierarchyChanged(
+      views::View*, const views::ViewHierarchyChangedDetails& details) override {
+    if (details.is_add) {
+      ConfigurePopoverContent(details.child);
+    }
+  }
+
+  void OnViewIsDeleting(views::View*) override { root_observation_.Reset(); }
+
+  void OnWindowDestroying(gfx::NativeWindow) override { ClosePopover(); }
+
+  static void ConfigurePopoverContent(views::View* view) {
+    if (auto* security = views::AsViewClass<SecurityInformationView>(view)) {
+      security->UsePopoverRowStyle();
+    }
+
+    // AppKit supplies the popover chrome. Let row highlights fill the content
+    // width by clearing the trailing inset used by the Views bubble.
+    if (auto* container =
+            views::AsViewClass<PageInfoMainView::ContainerView>(view)) {
+      container->RemoveExtraRightMargin();
+    }
+    if (view->GetID() ==
+        PageInfoViewFactory::VIEW_ID_PAGE_INFO_LINK_OR_BUTTON_SITE_SETTINGS) {
+      view->ClearProperty(views::kMarginsKey);
+    }
+
+    if (auto* row = views::AsViewClass<RichHoverButton>(view);
+        row && row->GetActionIcon() == PageInfoViewFactory::GetLaunchIcon()) {
+      row->SetActionIcon(ui::ImageModel());
+    }
+
+    // Subpixel text needs an opaque background. AppKit composites the
+    // transparent Views layer over the native popover material.
+    if (auto* label = views::AsViewClass<views::Label>(view)) {
+      label->SetSubpixelRenderingEnabled(false);
+    }
+    for (views::View* child : view->children()) {
+      ConfigurePopoverContent(child);
+    }
+  }
+
+  void ClosePopover() {
+    if (!popover_) {
+      return;
+    }
+    if (escape_monitor_) {
+      [NSEvent removeMonitor:escape_monitor_];
+      escape_monitor_ = nil;
+    }
+    popover_.delegate = nil;
+    [popover_ close];
+    NSView* contents = GetNativeView().GetNativeNSView();
+    NSWindow* backing_window = GetNativeWindow().GetNativeNSWindow();
+    [contents removeFromSuperview];
+    backing_window.contentView = contents;
+    SetNativeWindowProperty(
+        views::NativeWidgetMacNSWindowHost::kMovedContentNSView, nullptr);
+    popover_ = nil;
+    popover_delegate_ = nil;
+  }
+
+  base::ScopedObservation<views::View, views::ViewObserver> root_observation_{
+      this};
+  NSView* __weak anchor_;
+  NSPopover* __strong popover_;
+  id __strong escape_monitor_;
+  HeliumSiteInfoPopoverDelegate* __strong popover_delegate_;
+};
+
+}  // namespace
