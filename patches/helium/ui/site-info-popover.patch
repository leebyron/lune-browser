+gfx::ImageSkia RasterizeImageModelForView(const View& view,
+                                         const ui::ImageModel& image_model) {
+  const ui::ColorProvider* colors = view.GetColorProvider();
+  const Widget* widget = view.GetWidget();
+  const View* root = widget ? widget->GetRootView() : nullptr;
+  if (root && image_model.IsVectorIcon()) {
+    if (auto renderer = root->GetProperty(kVectorIconRenderer)) {
+      gfx::ImageSkia image = renderer(image_model.GetVectorIcon(), colors);
+      if (!image.isNull()) {
+        return image;
+      }
+    }
+  }
+  return image_model.Rasterize(colors);
+}
