+    PreferredSizeChanged();
+  }
+
+ private:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    // Keep the initial preferred width for unbounded measurement. When the
+    // table allocates a column, measure the text at that width so wrapping
+    // and the row height agree.
+    return StyledLabel::CalculatePreferredSize(
+        available_size.width().is_bounded()
+            ? available_size
+            : views::SizeBounds(preferred_width_, available_size.height()));
+  }
+
+  int preferred_width_ = 0;
+};
