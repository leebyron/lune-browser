+gfx::ImageSkia RenderSiteInfoSymbol(const ui::VectorIconModel& icon,
+                                    const ui::ColorProvider* colors) {
+  if (!icon.vector_icon()->name) {
+    return {};
+  }
+  std::string_view name(icon.vector_icon()->name);
+  if (name.starts_with("k") && name.ends_with("Icon")) {
+    name.remove_prefix(1);
+    name.remove_suffix(4);
+  }
+  if (name.ends_with("ChromeRefreshOld")) {
+    name.remove_suffix(16);
+  } else if (name.ends_with("RefreshOld")) {
+    name.remove_suffix(10);
+  } else if (name.ends_with("Old")) {
+    name.remove_suffix(3);
+  }
+  if (name.ends_with("Custom")) {
+    name.remove_suffix(6);
+  }
+  if (name.ends_with("Flippable")) {
+    name.remove_suffix(9);
+  }
+
+  auto it = kSiteInfoSymbols.find(name);
+  if (it == kSiteInfoSymbols.end() && name.ends_with("Filled")) {
+    name.remove_suffix(6);
+    it = kSiteInfoSymbols.find(name);
+  }
+  bool blocked = icon.badge_icon() != nullptr;
+  if (it == kSiteInfoSymbols.end() && name.ends_with("Off")) {
+    name.remove_suffix(3);
+    it = kSiteInfoSymbols.find(name);
+    blocked = true;
+  }
+  const int size = icon.icon_size();
+  if (size <= 0 || (!colors && icon.color().IsLogical())) {
+    return {};
+  }
+  const char* symbol = it == kSiteInfoSymbols.end() ? "info.circle" : it->second;
+  const SkColor color =
+      colors && std::string_view(symbol) == "exclamationmark.triangle.fill"
+          ? colors->GetColor(ui::kColorAlertMediumSeverityIcon)
+          : icon.color().ResolveToSkColor(colors);
+  int point_size = std::max(8, size - 4);
+  // Match the regular AppKit control font for Close. Use less emphasis for
+  // the trailing disclosure indicator while keeping the row's hit bounds.
+  const int control_point_size =
+      base::ClampRound([NSFont systemFontSizeForControlSize:NSControlSizeRegular]);
+  if (name == "Close" || name == "CloseRounded") {
+    point_size = std::min(size, control_point_size);
+  } else if (std::string_view(symbol) == "chevron.forward") {
+    point_size = std::min(point_size, control_point_size - 1);
+  }
+  auto image =
+      helium::NativeToolbarSymbolForName(symbol, size, color, point_size);
+  if (image.isNull()) {
+    // A supported version of macOS may ship an earlier SF Symbols catalogue.
+    image = helium::NativeToolbarSymbolForName(
+        "info.circle", size, color, point_size);
+  }
+  if (blocked) {
+    const auto badge =
+        helium::NativeToolbarSymbolForName("nosign", size, color, point_size);
+    image = gfx::ImageSkiaOperations::CreateSuperimposedImage(image, badge);
+  }
+  return image;
+}
