+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_TAB_ALERT_ICON_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_TAB_ALERT_ICON_H_
+
+#include <array>
+#include <optional>
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/views/helium/native_frame_materials.h"
+#include "components/tabs/public/tab_alert.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace helium {
+
+struct TabAlertSymbol {
+  const char* name;
+  const char* fallback = nullptr;
+  bool use_tab_foreground = false;
+  bool use_capture_color = false;
+};
+
+inline std::optional<TabAlertSymbol> GetTabAlertSymbol(
+    std::optional<tabs::TabAlert> state) {
+  switch (state.value_or(tabs::TabAlert::kNone)) {
+    case tabs::TabAlert::kPipPlaying:
+      return TabAlertSymbol{.name = "pip",
+                            .use_tab_foreground = true};
+    case tabs::TabAlert::kAudioPlaying:
+      return TabAlertSymbol{.name = "speaker.wave.2",
+                            .use_tab_foreground = true};
+    case tabs::TabAlert::kAudioMuting:
+      return TabAlertSymbol{.name = "speaker.slash",
+                            .use_tab_foreground = true};
+    case tabs::TabAlert::kVideoRecording:
+      return TabAlertSymbol{.name = "video", .use_capture_color = true};
+    case tabs::TabAlert::kAudioRecording:
+      return TabAlertSymbol{.name = "microphone",
+                            .fallback = "mic",
+                            .use_capture_color = true};
+    case tabs::TabAlert::kMediaRecording:
+      return TabAlertSymbol{.name = "video.badge.waveform",
+                            .fallback = "record.circle",
+                            .use_capture_color = true};
+    case tabs::TabAlert::kTabCapturing:
+      return TabAlertSymbol{.name = "interface.window.on.rectangle",
+                            .fallback = "macwindow.on.rectangle",
+                            .use_capture_color = true};
+    case tabs::TabAlert::kDesktopCapturing:
+      return TabAlertSymbol{.name = "display", .use_capture_color = true};
+    case tabs::TabAlert::kBluetoothConnected:
+    case tabs::TabAlert::kBluetoothScanActive:
+      return TabAlertSymbol{.name = "antenna.radiowaves.left.and.right"};
+    case tabs::TabAlert::kUsbConnected:
+      return TabAlertSymbol{.name = "cable.connector"};
+    case tabs::TabAlert::kHidConnected:
+      return TabAlertSymbol{.name = "gamecontroller"};
+    case tabs::TabAlert::kSerialConnected:
+      return TabAlertSymbol{.name = "cpu"};
+    case tabs::TabAlert::kVrPresentingInHeadset:
+      return TabAlertSymbol{.name = "vision.pro", .fallback = "eyeglasses"};
+    default:
+      break;
+  }
+  return std::nullopt;
+}
+
+inline gfx::ImageSkia NativeTabAlertImage(const TabAlertSymbol& symbol,
+                                         const views::View* view,
+                                         SkColor foreground) {
+  if (symbol.use_capture_color) {
+    foreground = NativeTabCaptureColor(view);
+  }
+  gfx::ImageSkia image = NativeSidebarSymbolForName(symbol.name, foreground);
+  if (image.isNull() && symbol.fallback) {
+    image = NativeSidebarSymbolForName(symbol.fallback, foreground);
+  }
+  return image;
+}
+
+class BluetoothScanAnimation {
+ public:
+  BluetoothScanAnimation(const char* symbol,
+                         SkColor color,
+                         base::RepeatingClosure on_frame)
+      : color_(color),
+        frames_{NativeSidebarSymbolForName(symbol, color, 0.0),
+                NativeSidebarSymbolForName(symbol, color, 0.5),
+                NativeSidebarSymbolForName(symbol, color, 1.0)},
+        on_frame_(std::move(on_frame)) {
+    timer_.Start(FROM_HERE, base::Milliseconds(260), this,
+                 &BluetoothScanAnimation::Advance);
+  }
+
+  SkColor color() const { return color_; }
+  const gfx::ImageSkia& image(bool animate = true) const {
+    return animate ? frames_[index_] : frames_.back();
+  }
+
+ private:
+  void Advance() {
+    index_ = (index_ + 1) % frames_.size();
+    on_frame_.Run();
+  }
+
+  const SkColor color_;
+  const std::array<gfx::ImageSkia, 3> frames_;
+  const base::RepeatingClosure on_frame_;
+  size_t index_ = 0;
+  base::RepeatingTimer timer_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_TAB_ALERT_ICON_H_
