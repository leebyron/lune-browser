+bool BrowserView::IsPointInTopChromeHoverArea(const gfx::Point& point) const {
+  // The detached tabs sidebar can overlap side-docked DevTools.
+  if (auto* sidebar = GetSidebarView(); sidebar && sidebar->IsDrawn() &&
+      GetSideChromeRevealRatio() > 0) {
+    const gfx::Rect bounds = views::View::ConvertRectToTarget(
+        sidebar, this, sidebar->GetLocalBounds());
+    if (point.x() >= bounds.x() && point.x() < bounds.right()) {
+      return true;
+    }
+  }
+  for (const auto& container : multi_contents_view_->contents_container_views()) {
+    if (!container->GetVisible() ||
+        !container->devtools_web_view()->GetVisible()) {
+      continue;
+    }
+    const gfx::Rect pane = views::View::ConvertRectToTarget(
+        container.get(), this, container->GetLocalBounds());
+    if (point.x() < pane.x() || point.x() >= pane.right()) {
+      continue;
+    }
+    const gfx::Rect content = views::View::ConvertRectToTarget(
+        container.get(), this, container->GetContentsViewBounds());
+    using Placement = ContentsContainerView::DevToolsDockedPlacement;
+    const auto placement = container->devtools_docked_placement();
+    if ((placement == Placement::kLeft && point.x() < content.x()) ||
+        (placement == Placement::kRight && point.x() >= content.right())) {
+      return false;
+    }
+  }
+  return true;
+}
