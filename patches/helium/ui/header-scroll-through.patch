+// Window-local wheel routing preserves the original native event. In particular,
+// momentum must stay with the content that received the end of the direct scroll,
+// even if the pointer subsequently moves over a different pane or toolbar item.
+@interface HeliumHeaderScrollRouter : NSObject
+@property(nonatomic, copy) NSView* (^resolveTarget)(NSEvent*, NSView*);
+- (NSEvent*)routeEvent:(NSEvent*)event;
+- (void)shutdown;
+@end
+@implementation HeliumHeaderScrollRouter {
+  id _monitor;
+  __weak NSView* _momentumTarget;
+}
+@synthesize resolveTarget = _resolveTarget;
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    __weak HeliumHeaderScrollRouter* weakSelf = self;
+    _monitor = [NSEvent
+        addLocalMonitorForEventsMatchingMask:NSEventMaskScrollWheel
+                                    handler:^NSEvent*(NSEvent* event) {
+      HeliumHeaderScrollRouter* owner = weakSelf;
+      return owner ? [owner routeEvent:event] : event;
+    }];
+  }
+  return self;
+}
+- (NSEvent*)routeEvent:(NSEvent*)event {
+  if (event.type != NSEventTypeScrollWheel || !self.resolveTarget) {
+    return event;
+  }
+  const bool momentum = event.momentumPhase != NSEventPhaseNone;
+  NSView* target = self.resolveTarget(event, momentum ? _momentumTarget : nil);
+  // Do not steal momentum from a scroll that AppKit delivered to the page or
+  // another control directly. Only continue streams this router forwarded.
+  if (momentum && !_momentumTarget) {
+    return event;
+  }
+  if (!target) {
+    _momentumTarget = nil;
+    return event;
+  }
+  _momentumTarget = event.phase != NSEventPhaseNone || momentum ? target : nil;
+  if (event.phase == NSEventPhaseCancelled ||
+      event.momentumPhase == NSEventPhaseEnded) {
+    _momentumTarget = nil;
+  }
+  // Direct delivery avoids redispatching through this monitor or the overlay.
+  [target scrollWheel:event];
+  return nil;
+}
+- (void)shutdown {
+  if (_monitor) {
+    [NSEvent removeMonitor:_monitor];
+    _monitor = nil;
+  }
+  self.resolveTarget = nil;
+  _momentumTarget = nil;
+}
+- (void)dealloc {
+  [self shutdown];
+}
+@end
