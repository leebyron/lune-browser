+NSView* BrowserFrameViewMac::HeaderScrollTarget(NSEvent* event,
+                                                NSView* momentum_target) {
+  auto* browser = GetBrowserView();
+  if (!HasFloatingAddressBar() || !GetWidget() || GetWidget()->IsClosed() ||
+      !GetWidget()->IsVisible() || browser->IsChromeRevealHeldForMenu() ||
+      IsWindowControlsMenuOpen() || NSApp.modalWindow) {
+    return nil;
+  }
+  NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSWindow* toolbar_window = floating_toolbar_widget_
+      ? floating_toolbar_widget_->GetNativeWindow().GetNativeNSWindow() : nil;
+  if (!event.window || (event.window != window && event.window != toolbar_window) ||
+      window.attachedSheet) {
+    return nil;
+  }
+  const NSPoint screen =
+      [event.window convertPointToScreen:event.locationInWindow];
+  gfx::Point point = gfx::ScreenPointFromNSPoint(screen);
+  views::View::ConvertPointFromScreen(browser, &point);
+  // Autocomplete extends beyond the header band. Deliver to its native
+  // owner, which deliberately keeps these non-scrolling rows off the page.
+  if (momentum_target == floating_address_bar_ && momentum_target) {
+    return floating_address_bar_;
+  }
+  if (!momentum_target && [floating_address_bar_ isEditing]) {
+    NSPoint local = [floating_address_bar_
+        convertPoint:[window convertPointFromScreen:screen] fromView:nil];
+    if (NSPointInRect(local, floating_address_bar_.bounds) &&
+        local.y < NSHeight(floating_address_bar_.bounds) - 36) {
+      return floating_address_bar_;
+    }
+  }
+  if (!momentum_target) {
+    auto* drag = floating_drag_host_.view();
+    if (!drag || !drag->IsDrawn() || !floating_drag_region_.enabled ||
+        !views::View::ConvertRectToTarget(drag, browser, drag->GetLocalBounds())
+             .Contains(point)) {
+      return nil;
+    }
+    if (auto* sidebar = browser->GetSidebarView();
+        sidebar && sidebar->IsDrawn() &&
+        views::View::ConvertRectToTarget(sidebar, browser,
+                                         sidebar->GetLocalBounds()).Contains(point)) {
+      return nil;
+    }
+  }
+  // Hit-test each actual content container, below the header, rather than using
+  // the active tab. Views target selection also protects modal scrims and other
+  // content overlays. Docked DevTools has its own WebView and native receiver.
+  for (const auto& container : browser->GetContentsContainerViews()) {
+    if (!container->IsDrawn()) {
+      continue;
+    }
+    gfx::Point local = point;
+    views::View::ConvertPointToTarget(browser, container.get(), &local);
+    views::View* hit = container->GetEventHandlerForPoint(local);
+    for (views::WebView* web_view :
+         {static_cast<views::WebView*>(container->contents_view()),
+          container->devtools_web_view()}) {
+      if (!web_view || !web_view->IsDrawn() || !web_view->GetEnabled() ||
+          !web_view->web_contents() ||
+          web_view->holder()->GetProperty(views::kIsBlockedByModalKey)) {
+        continue;
+      }
+      NSView* native = web_view->web_contents()->GetNativeView().GetNativeNSView();
+      if (!native || native.window != window || native.hiddenOrHasHiddenAncestor) {
+        continue;
+      }
+      if (momentum_target) {
+        if ([momentum_target isDescendantOf:native]) {
+          return momentum_target;
+        }
+        continue;
+      }
+      if (!hit || !web_view->Contains(hit)) {
+        continue;
+      }
+      NSPoint location = [native convertPoint:
+          [window convertPointFromScreen:screen] fromView:nil];
+      if (!NSPointInRect(location, native.visibleRect)) {
+        continue;
+      }
+      return [native hitTest:[native.superview convertPoint:
+          [window convertPointFromScreen:screen] fromView:nil]];
+    }
+  }
+  return nil;
+}
