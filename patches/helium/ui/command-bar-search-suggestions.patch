+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_command_bar_suggestions.h"
+
+#include <algorithm>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_provider_client.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_scheme_classifier.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/common/pref_names.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/search_provider.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+
+namespace {
+
+class SuggestionsClient : public ChromeAutocompleteProviderClient {
+ public:
+  explicit SuggestionsClient(Profile* profile)
+      : ChromeAutocompleteProviderClient(profile) {}
+  // Cmd-T already queries its local history. Do not add search-history matches
+  // or fetch remote suggestion images merely because a row became visible.
+  history::URLDatabase* GetInMemoryDatabase() override { return nullptr; }
+  void PrefetchImage(const GURL&) override {}
+  GeolocationHeaderService* GetGeolocationHeaderService() const override {
+    return nullptr;
+  }
+};
+
+bool IsRemoteSuggestion(omnibox::AutocompleteMatchType type) {
+  switch (type) {
+    case omnibox::AutocompleteMatchType::kSearchSuggest:
+    case omnibox::AutocompleteMatchType::kSearchSuggestEntity:
+    case omnibox::AutocompleteMatchType::kSearchSuggestTail:
+    case omnibox::AutocompleteMatchType::kSearchSuggestPersonalized:
+    case omnibox::AutocompleteMatchType::kNavsuggest:
+    case omnibox::AutocompleteMatchType::kNavsuggestPersonalized:
+      return true;
+    default:
+      return false;
+  }
+}
+
+}  // namespace
+
+HeliumCommandBarSuggestions::HeliumCommandBarSuggestions(
+    Profile* profile, base::RepeatingClosure changed)
+    : profile_(profile), changed_(std::move(changed)),
+      client_(std::make_unique<SuggestionsClient>(profile)),
+      provider_(base::MakeRefCounted<SearchProvider>(client_.get(), this)) {}
+
+HeliumCommandBarSuggestions::~HeliumCommandBarSuggestions() {
+  Stop();
+}
+
+void HeliumCommandBarSuggestions::Stop() {
+  // Clear the previous query as well as its timers and loaders. SearchProvider
+  // cannot deliver a cancelled response to a new query or a reopened palette.
+  provider_->Stop(AutocompleteStopReason::kClobbered);
+  engine_keyword_.clear();
+  keyword_mode_ = false;
+  items_.clear();
+}
+
+void HeliumCommandBarSuggestions::Start(const std::u16string& query,
+                                      const std::string& keyword) {
+  Stop();
+  if (query.empty() || (keyword.empty() && query.starts_with(u"!")) ||
+      profile_->IsOffTheRecord() ||
+      !profile_->GetPrefs()->GetBoolean(prefs::kSearchSuggestEnabled)) {
+    return;
+  }
+  auto* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  if (!service || !service->loaded()) {
+    return;
+  }
+  const TemplateURL* engine = keyword.empty()
+      ? service->GetDefaultSearchProvider()
+      : service->GetTemplateURLForKeyword(base::UTF8ToUTF16(keyword));
+  if (!engine || engine->suggestions_url().empty() ||
+      !engine->SupportsReplacement(service->search_terms_data())) {
+    return;
+  }
+  engine_keyword_ = engine->keyword();
+  keyword_mode_ = !keyword.empty();
+  AutocompleteInput input(
+      keyword.empty() ? query : engine_keyword_ + u" " + query,
+      metrics::OmniboxEventProto::OTHER,
+      ChromeAutocompleteSchemeClassifier(profile_));
+  input.set_prevent_inline_autocomplete(true);
+  input.set_allow_exact_keyword_match(!keyword.empty());
+  // SearchProvider suppresses the default-engine request in keyword mode.
+  // A bang without a suggestions URL returns above, never falling back.
+  input.set_in_keyword_mode(!keyword.empty());
+  provider_->Start(input, false);
+  UpdateItems();
+}
+
+void HeliumCommandBarSuggestions::OnProviderUpdate(
+    bool updated_matches, const AutocompleteProvider* provider) {
+  if (updated_matches) {
+    UpdateItems();
+  }
+}
+
+void HeliumCommandBarSuggestions::UpdateItems() {
+  items_.clear();
+  auto* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  const auto* engine = service
+      ? service->GetTemplateURLForKeyword(engine_keyword_) : nullptr;
+  if (engine && profile_->GetPrefs()->GetBoolean(prefs::kSearchSuggestEnabled)) {
+    int score = 60;
+    for (const auto& match : provider_->matches()) {
+      // Navigation matches carry from_keyword, but have no keyword string.
+      // Search matches also name their engine; check both without discarding
+      // the website hits supplied by the selected engine.
+      if (!IsRemoteSuggestion(match.type) ||
+          match.from_keyword != keyword_mode_ ||
+          (AutocompleteMatch::IsSearchType(match.type) &&
+           match.keyword != engine_keyword_) ||
+          !match.destination_url.SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      if (std::ranges::any_of(items_, [&match](const auto& item) {
+            return item.url == match.destination_url;
+          })) {
+        continue;
+      }
+      const bool search = AutocompleteMatch::IsSearchType(match.type);
+      HeliumCommandBarItem item;
+      item.type = search ? HeliumCommandBarItem::Type::kSearchSuggestion
+                         : HeliumCommandBarItem::Type::kNavigationSuggestion;
+      item.title = !search && !match.description.empty()
+          ? match.description : match.contents;
+      item.url = match.destination_url;
+      item.url_spec = item.url.spec();
+      item.description = search ? engine->short_name()
+                                : base::UTF8ToUTF16(item.url_spec);
+      item.icon_url = search ? engine->favicon_url() : GURL();
+      item.score = score--;
+      items_.push_back(std::move(item));
+    }
+  }
+  changed_.Run();
+}
