+            GetLayoutConstant(LayoutConstant::kVerticalTabHeight) / 2 - 6);
+  EXPECT_EQ(GetTabStripViewTargetBounds(group_view->group_header()).y(), 0);
+  EXPECT_FALSE(group_view->group_line()->GetVisible());
+
+  ClickTabGroupHeaderToToggleCollapse();
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return !grouped_tab->GetVisible(); }));
+  RunScheduledLayouts();
+  const auto collapsed_group = GetTabStripViewTargetBounds(group_view);
+  const auto collapsed_header =
+      GetTabStripViewTargetBounds(group_view->group_header());
+  const auto after_collapsed = GetTabStripViewTargetBounds(following_tab);
+  EXPECT_EQ(collapsed_header.y(), 0);
+  EXPECT_EQ(
+      after_collapsed.y() - collapsed_group.y() - collapsed_header.bottom(),
+      GetLayoutConstant(LayoutConstant::kVerticalTabHeight) / 2 - 6);
+}
