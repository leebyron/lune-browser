+  auto* header = widget->SetContentsView(std::make_unique<TabGroupHeaderView>(
+      delegate, TabStripOrientation::kVertical, nullptr, &data.visual_data));
+  EXPECT_CALL(delegate, GetTabGroupData())
+      .WillRepeatedly(testing::ReturnRef(data));
+  header->OnDataChanged(data);
+  const auto neutral_color =
+      header->title_label_for_testing()->GetEnabledColor();
+  EXPECT_EQ(nullptr, header->background());
+  EXPECT_EQ(nullptr, header->editor_bubble_button());
+
+  data.visual_data = tab_groups::TabGroupVisualData(
+      u"Renamed", tab_groups::TabGroupColorId::kRed, false);
+  header->OnDataChanged(data);
+  EXPECT_EQ(neutral_color,
+            header->title_label_for_testing()->GetEnabledColor());
+  EXPECT_EQ(u"Renamed", header->title_label_for_testing()->GetText());
+  EXPECT_EQ(nullptr, header->background());
