+TEST_F(TabGroupHeaderViewTest, TitleBaselineMatchesOlderTabsLabelButton) {
+  MockDelegate delegate;
+  tab_groups::TabGroupVisualData visual_data(
+      u"Research", tab_groups::TabGroupColorId::kBlue, false);
+  auto widget = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+  auto* host = widget->SetContentsView(std::make_unique<views::View>());
+  auto* group = host->AddChildView(std::make_unique<TabGroupHeaderView>(
+      delegate, TabStripOrientation::kVertical, nullptr, &visual_data));
+  // Older Tabs uses LabelButton, whose vertical border insets do not move text.
+  auto* older = host->AddChildView(std::make_unique<views::LabelButton>(
+      views::Button::PressedCallback(), u"Older Tabs"));
+  views::Label* reference_title = nullptr;
+  for (const auto& child : older->children()) {
+    if (auto* label = views::AsViewClass<views::Label>(child.get())) {
+      reference_title = label;
+      break;
+    }
+  }
+  ASSERT_TRUE(reference_title);
+  reference_title->SetFontList(
+      views::Label().font_list().DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+  older->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(6, 9, 0, 9)));
+  group->SetBounds(0, 0, 240, 24);
+  group->title_label_for_testing()->SetText(u"Research");
+  older->SetBounds(0, 30, 240, 24);
+  group->DeprecatedLayoutImmediately();
+  older->DeprecatedLayoutImmediately();
+  const auto* title = group->title_label_for_testing();
+  EXPECT_EQ(title->y() + title->GetBaseline(),
+            reference_title->y() + reference_title->GetBaseline());
+  EXPECT_EQ(
+      group->height() - title->y() - title->GetBaseline(),
+      older->height() - reference_title->y() - reference_title->GetBaseline());
+}
