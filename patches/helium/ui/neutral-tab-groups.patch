+  auto* following_tab = unpinned->children().back()->view();
+  const auto group_bounds = GetTabStripViewTargetBounds(group_view);
+  const auto grouped_bounds = GetTabStripViewTargetBounds(grouped_tab);
+  const auto following_bounds = GetTabStripViewTargetBounds(following_tab);
+  EXPECT_EQ(group_bounds.x() + grouped_bounds.x(), following_bounds.x());
+  EXPECT_EQ(grouped_bounds.width(), following_bounds.width());
