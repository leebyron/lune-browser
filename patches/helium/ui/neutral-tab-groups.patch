+void LayoutSidebarSectionHeader(views::ProposedLayout& layout,
+                                views::Label* title,
+                                views::ImageView* disclosure,
+                                const gfx::Size& size,
+                                bool show_disclosure) {
+  auto* title_layout = layout.GetLayoutFor(title);
+  if (!title_layout) {
+    // LabelButton returns an empty layout for an unbounded size query.
+    return;
+  }
+  title_layout->bounds.set_y(0);
+  title_layout->bounds.set_height(size.height());
+  // Match the tab close slot, using the native symbol's 16px canvas.
+  const int tab_height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  layout.child_layouts.emplace_back(
+      disclosure, show_disclosure && size.width() > 64,
+      gfx::Rect(size.width() - tab_height / 2 - 6, (size.height() - 16) / 2, 16,
+                16));
+}
