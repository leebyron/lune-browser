     const user_data_importer::SourceProfile& source_profile,
+    uint16_t imported_items) {
+  FireWebUIListener("import-data-status-changed", base::Value("inProgress"));
+  if (imported_items & importer::kOpenTabs) {
+    imported_items &= ~importer::kOpenTabs;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&importer::ReadOpenTabs, source_profile.importer_type,
+                       source_profile.source_path),
+        base::BindOnce(&BraveImportDataHandler::OpenImportedTabs,
+                       weak_factory_.GetWeakPtr(), source_profile,
+                       imported_items));
+    return;
+  }
+  StartDataImport(source_profile, imported_items, /*opened_tabs=*/false);
+}
+
+void BraveImportDataHandler::OpenImportedTabs(
+    const user_data_importer::SourceProfile& source_profile,
+    uint16_t imported_items,
+    importer::OpenTabsForImport tabs) {
+  auto* browser = GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+      web_ui()->GetWebContents());
+  bool opened_tabs = false;
+  if (browser) {
+    for (const auto& group : tabs.pinned_groups) {
+      opened_tabs |= OpenPinnedGroup(*browser, group);
+    }
+    for (const auto& url : tabs.urls) {
+      if (chrome::AddAndReturnTabAt(browser, url,
+                                   browser->GetTabStripModel()->count(),
+                                   /*foreground=*/false)) {
+        opened_tabs = true;
+      }
+    }
+  }
+  StartDataImport(source_profile, imported_items, opened_tabs);
