+const base::ListValue* FindArcSpaceItems(const base::DictValue& space,
+                                        const ArcSidebarItems& items,
+                                        std::string_view section) {
+  for (const char* field : {"newContainerIDs", "containerIDs"}) {
+    const auto* ids = space.FindList(field);
+    if (!ids) {
+      continue;
+    }
+    for (size_t i = 0; i + 1 < ids->size(); i += 2) {
+      const auto& kind = (*ids)[i];
+      const auto* kind_dict = kind.GetIfDict();
+      const auto* kind_name = kind.GetIfString();
+      if ((!kind_name || *kind_name != section) &&
+          (!kind_dict || !kind_dict->FindDict(section))) {
+        continue;
+      }
+      const auto* id = (*ids)[i + 1].GetIfString();
+      const auto container = id ? items.find(*id) : items.end();
+      if (container != items.end()) {
+        return container->second->FindList("childrenIds");
+      }
+    }
+  }
+  return nullptr;
+}
+
+void AppendArcTabUrls(const base::ListValue& children,
+                      const ArcSidebarItems& items,
+                      bool flatten_folders,
+                      std::set<std::string_view>& seen,
+                      std::vector<GURL>& tabs) {
+  std::vector<const base::Value*> pending;
+  auto push_children = [&pending](const base::ListValue& ids) {
+    for (const auto& id : base::Reversed(ids)) {
+      pending.push_back(&id);
+    }
+  };
+  push_children(children);
+  while (!pending.empty()) {
+    const auto* id = pending.back()->GetIfString();
+    pending.pop_back();
+    const auto item = id ? items.find(*id) : items.end();
+    if (item == items.end() || !seen.insert(item->first).second) {
+      continue;
+    }
+    if (item->second->FindDictByDottedPath("data.splitView") ||
+        (flatten_folders && item->second->FindDictByDottedPath("data.list"))) {
+      if (const auto* nested = item->second->FindList("childrenIds")) {
+        push_children(*nested);
+      }
+      continue;
+    }
+    if (const auto* url =
+            item->second->FindStringByDottedPath("data.tab.savedURL")) {
+      GURL tab_url(*url);
+      if (tab_url.is_valid() && tab_url.SchemeIsHTTPOrHTTPS()) {
+        tabs.push_back(std::move(tab_url));
+      }
+    }
+  }
+}
+
+void AppendArcPinnedItems(const base::ListValue& children,
+                          const ArcSidebarItems& items,
+                          ArcSidebarVisitedItems& visited,
+                          ArcSidebarProfile& profile) {
+  base::ListValue loose_items;
+  for (const auto& child : children) {
+    const auto* id = child.GetIfString();
+    const auto item = id ? items.find(*id) : items.end();
+    if (item == items.end()) {
+      continue;
+    }
+    if (!item->second->FindDictByDottedPath("data.list")) {
+      loose_items.Append(*id);
+      continue;
+    }
+    const auto* folder = item->second->FindList("childrenIds");
+    if (!folder || !visited.pinned_folders.insert(*id).second) {
+      continue;
+    }
+
