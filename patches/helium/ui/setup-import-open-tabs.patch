+importer::OpenTabsForImport GetArcOpenTabs(
+    const base::FilePath& profile_path) {
+  auto sidebar = ReadArcSidebarProfiles(
+      profile_path.DirName().DirName().AppendASCII("StorableSidebar.json"));
+  if (!sidebar) {
+    return {};
+  }
+  const auto profile = sidebar->find(profile_path.BaseName().value());
+  return profile == sidebar->end() ? importer::OpenTabsForImport()
+                                   : std::move(profile->second.open_tabs);
