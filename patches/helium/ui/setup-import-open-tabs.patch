+
+#ifndef CHROME_COMMON_IMPORTER_OPEN_TABS_FOR_IMPORT_H_
+#define CHROME_COMMON_IMPORTER_OPEN_TABS_FOR_IMPORT_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "url/gurl.h"
+
+namespace importer {
+
+struct PinnedTabGroupForImport {
+  // Arc's ungrouped pins get a localized title in the destination browser.
+  std::optional<std::u16string> title;
+  std::vector<GURL> urls;
+};
+
+struct OpenTabsForImport {
+  std::vector<GURL> urls;
+  std::vector<PinnedTabGroupForImport> pinned_groups;
+
+  bool empty() const { return urls.empty() && pinned_groups.empty(); }
+};
+
+}  // namespace importer
+
+#endif  // CHROME_COMMON_IMPORTER_OPEN_TABS_FOR_IMPORT_H_
