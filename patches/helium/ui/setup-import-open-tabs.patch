+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/importer/open_tabs_importer.h"
+
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "build/build_config.h"
+#include "chrome/common/importer/chrome_importer_utils.h"
+#include "components/sessions/core/command_storage_backend.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+
+namespace importer {
+
+OpenTabsForImport ReadOpenTabs(user_data_importer::ImporterType type,
+                               const base::FilePath& profile_path) {
+#if BUILDFLAG(IS_MAC)
+  if (type == user_data_importer::TYPE_ARC) {
+    return GetArcOpenTabs(profile_path);
+  }
+#endif
+
+  if (type != user_data_importer::TYPE_CHROME) {
+    return {};
+  }
+
+  const auto commands =
+      sessions::CommandStorageBackend::ReadCommandsForImport(profile_path);
+  if (commands.empty()) {
+    return {};
+  }
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active_window_id = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded_window_ids;
+  sessions::RestoreSessionFromCommands(
+      commands, &windows, &active_window_id, &platform_session_id,
+      &discarded_window_ids);
+
+  OpenTabsForImport tabs;
+  for (const auto& window : windows) {
+    for (const auto& tab : window->tabs) {
+      const GURL& url =
+          tab->navigations[tab->normalized_navigation_index()].virtual_url();
+      if (url.is_valid() && url.SchemeIsHTTPOrHTTPS()) {
+        tabs.urls.push_back(url);
+      }
+    }
+  }
+  return tabs;
+}
+
+}  // namespace importer
