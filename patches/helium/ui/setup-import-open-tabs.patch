+bool OpenPinnedGroup(BrowserWindowInterface& browser,
+                     const importer::PinnedTabGroupForImport& group) {
+  auto* model = browser.GetTabStripModel();
+  if (!model->SupportsTabGroups()) {
+    return false;
+  }
+
+  std::vector<int> indices;
+  for (const auto& url : group.urls) {
+    auto* contents = chrome::AddAndReturnTabAt(&browser, url, model->count(),
+                                               /*foreground=*/false);
+    if (!contents) {
+      continue;
+    }
+    const int index = model->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  if (indices.empty()) {
+    return false;
+  }
+
+  std::ranges::sort(indices);
+  const auto id = model->AddToNewGroup(indices);
+  const auto color = model->group_model()->GetTabGroup(id)->visual_data()->color();
+  model->ChangeTabGroupVisuals(
+      id, tab_groups::TabGroupVisualData(
+              group.title ? *group.title
+                          : l10n_util::GetStringUTF16(
+                                IDS_HELIUM_ONBOARDING_DATA_IMPORT_ARC_PINNED_TABS),
+              color, /*is_collapsed=*/true),
+      /*is_customized=*/true);
+  model->SetTabGroupPinned(id, true);
+  return true;
+}
