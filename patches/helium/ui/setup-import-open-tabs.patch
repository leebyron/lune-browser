+std::vector<std::unique_ptr<SessionCommand>>
+CommandStorageBackend::ReadCommandsForImport(const base::FilePath& profile_path) {
+  for (const auto& session : GetSessionFilesSortedByReverseTimestamp(
+           profile_path, SessionType::kSessionRestore, /*encrypted=*/false)) {
+    if (SessionFileReader::GetMarkerStatus(session.path, /*encryptor=*/nullptr) !=
+        CommandStorageReadStatus::kSuccess) {
+      continue;
+    }
+    return SessionFileReader::Read(session.path, /*encryptor=*/nullptr).commands;
+  }
+  return {};
+}
