+content::WebContents* BrowserFrameViewMac::PageTopDragTarget(
+    NSEvent* event, gfx::PointF& widget_point) {
+  auto* browser = GetBrowserView();
+  NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  if (!HasFloatingAddressBar() || !window.movable ||
+      GetWidget()->IsFullscreen() ||
+      window.attachedSheet || NSApp.modalWindow ||
+      browser->IsChromeRevealHeldForMenu() || IsWindowControlsMenuOpen() ||
+      !browser->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumPageTopWindowDrag) ||
+      ui::IsWindowResizePoint(window, event.locationInWindow)) {
+    return nullptr;
+  }
+
+  const NSPoint screen = [window convertPointToScreen:event.locationInWindow];
+  gfx::Point point = gfx::ScreenPointFromNSPoint(screen);
+  views::View::ConvertPointFromScreen(browser, &point);
+  if (point.y() < 0 || point.y() >= kFloatingToolbarHeight) {
+    return nullptr;
+  }
+  NSView* content_view = window.contentView;
+  NSView* native_hit = [content_view hitTest:
+      [content_view.superview convertPoint:event.locationInWindow fromView:nil]];
+  if (!native_hit) {
+    return nullptr;
+  }
+  for (const auto& container : browser->GetContentsContainerViews()) {
+    auto* page = container->contents_view();
+    if (!page || !page->IsDrawn() || !page->GetEnabled() ||
+        page->holder()->GetProperty(views::kIsBlockedByModalKey)) {
+      continue;
+    }
+    gfx::Point local = point;
+    views::View::ConvertPointToTarget(browser, container.get(), &local);
+    auto* hit = container->GetEventHandlerForPoint(local);
+    if (!hit || !page->Contains(hit)) {
+      continue;
+    }
+    content::WebContents* contents = page->web_contents();
+    if (!contents || !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() ||
+        contents->IsFullscreen()) {
+      return nullptr;
+    }
+    auto* frame = contents->GetPrimaryMainFrame();
+    auto* view = frame->GetRenderWidgetHost()->GetView();
+    NSView* renderer = view ? view->GetNativeView().GetNativeNSView() : nil;
+    if (!renderer || renderer.window != window ||
+        ![native_hit isDescendantOf:renderer]) {
+      return nullptr;
+    }
+    NSPoint position = [renderer convertPoint:event.locationInWindow fromView:nil];
+    if (!renderer.isFlipped) {
+      position.y = NSMaxY(renderer.bounds) - position.y;
+    }
+    widget_point = gfx::PointF(position.x, position.y);
+    return contents;
+  }
+  return nullptr;
+}
+
+void BrowserFrameViewMac::OnPageTopDragTarget(uint64_t press, bool eligible) {
+  if (press == page_top_drag_press_id_ && page_top_drag_press_) {
+    page_top_drag_eligible_ = eligible;
+  }
+}
+
+NSEvent* BrowserFrameViewMac::HandlePageTopDragEvent(NSEvent* event) {
+  if (!GetWidget() || GetWidget()->IsClosed() ||
+      event.window != GetWidget()->GetNativeWindow().GetNativeNSWindow()) {
+    return event;
+  }
+  if (event.type == NSEventTypeLeftMouseDown) {
+    ++page_top_drag_press_id_;
+    page_top_drag_press_ = nil;
+    page_top_drag_document_ = {};
+    page_top_drag_active_ = false;
+    page_top_drag_eligible_ = false;
+    if (event.clickCount == 1 && !(event.modifierFlags & kPageTopDragModifiers)) {
+      if (auto* target = PageTopDragTarget(event, page_top_drag_point_)) {
+        auto* frame = target->GetPrimaryMainFrame();
+        page_top_drag_document_ = frame->GetWeakDocumentPtr();
+        page_top_drag_press_ = event;
+        content::IsPageTopDragTarget(
+            *frame->GetRenderWidgetHost(), page_top_drag_point_,
+            base::BindOnce(&BrowserFrameViewMac::OnPageTopDragTarget,
+                           page_top_drag_weak_factory_.GetWeakPtr(),
+                           page_top_drag_press_id_));
+      }
+    }
+    return event;
+  }
+  if (event.type == NSEventTypeLeftMouseUp) {
+    page_top_drag_press_ = nil;
+    page_top_drag_document_ = {};
+    return std::exchange(page_top_drag_active_, false) ? nil : event;
+  }
+  if (page_top_drag_active_) {
+    return nil;
+  }
+  NSEvent* press = page_top_drag_press_;
+  if (!press) {
+    return event;
+  }
+  const NSPoint start = press.locationInWindow;
+  const NSPoint current = event.locationInWindow;
+  if (std::hypot(current.x - start.x, current.y - start.y) <
+      kPageTopDragThreshold) {
+    return event;
+  }
+  page_top_drag_press_ = nil;
+  auto* frame = page_top_drag_document_.AsRenderFrameHostIfValid();
+  gfx::PointF widget_point;
+  auto* target = page_top_drag_eligible_ ? PageTopDragTarget(press, widget_point)
+                                         : nullptr;
+  if (!frame || !target || frame != target->GetPrimaryMainFrame() ||
+      widget_point != page_top_drag_point_ ||
+      (event.modifierFlags & kPageTopDragModifiers)) {
+    return event;
+  }
+
+  page_top_drag_active_ = true;
+  content::ReleasePageTopDragPress(*frame->GetRenderWidgetHost(),
+                                   widget_point);
+  [event.window performWindowDragWithEvent:press];
+  return nil;
+}
