+bool HasPageDragListeners(const EventTarget& target) {
+  return target.HasEventListeners(event_type_names::kMousedown) ||
+         target.HasEventListeners(event_type_names::kMouseup) ||
+         target.HasEventListeners(event_type_names::kMousemove) ||
+         target.HasEventListeners(event_type_names::kPointerdown) ||
+         target.HasEventListeners(event_type_names::kPointerup) ||
+         target.HasEventListeners(event_type_names::kPointermove) ||
+         target.HasEventListeners(event_type_names::kPointerrawupdate) ||
+         target.HasEventListeners(event_type_names::kGotpointercapture) ||
+         target.HasEventListeners(event_type_names::kDragstart) ||
+         target.HasEventListeners(event_type_names::kSelectstart);
+}
+
+bool IsPlainPageBackground(const HitTestResult& hit,
+                           const Document& document) {
+  Node* node = hit.InnerNode();
+  if (!node || &node->GetDocument() != &document || hit.GetScrollbar() ||
+      hit.IsOverEmbeddedContentView() || hit.URLElement() ||
+      hit.InnerPossiblyPseudoNode() != node || IsEditable(*node)) {
+    return false;
+  }
+
+  // Permit ordinary structural HTML only. Custom controls, text, media,
+  // frames, canvas and shadow trees retain their pointer input.
+  for (Node* ancestor = node; ancestor && ancestor != &document;
+       ancestor = ancestor->parentNode()) {
+    const auto* element = DynamicTo<HTMLElement>(ancestor);
+    if (!element || element->IsInShadowTree() || element->draggable() ||
+        element->FastHasAttribute(html_names::kRoleAttr) ||
+        element->FastHasAttribute(html_names::kTabindexAttr) ||
+        HasPageDragListeners(*element)) {
+      return false;
+    }
+    if (!element->HasTagName(html_names::kHTMLTag) &&
+        !element->HasTagName(html_names::kBodyTag) &&
+        !element->HasTagName(html_names::kDivTag) &&
+        !element->HasTagName(html_names::kSectionTag) &&
+        !element->HasTagName(html_names::kMainTag) &&
+        !element->HasTagName(html_names::kHeaderTag) &&
+        !element->HasTagName(html_names::kFooterTag) &&
+        !element->HasTagName(html_names::kArticleTag) &&
+        !element->HasTagName(html_names::kAsideTag) &&
+        !element->HasTagName(html_names::kNavTag)) {
+      return false;
+    }
+  }
+  return !HasPageDragListeners(document) &&
+         document.domWindow() && !HasPageDragListeners(*document.domWindow());
+}
+
+}  // namespace
+
+void WebFrameWidgetImpl::IsPageTopDragTarget(
+    const gfx::PointF& point_in_widget,
+    IsPageTopDragTargetCallback callback) {
+  LocalFrame* frame = local_root_ ? local_root_->GetFrame() : nullptr;
+  const bool eligible =
+      frame && frame->IsOutermostMainFrame() && frame->View() &&
+      frame->GetDocument() && GetPage() &&
+      !GetPage()->GetPointerLockController().IsPointerLocked() &&
+      IsPlainPageBackground(
+          CoreHitTestResultAt(widget_base_->DIPsToBlinkSpace(point_in_widget)),
+          *frame->GetDocument());
+  std::move(callback).Run(eligible);
+}
+
+void WebFrameWidgetImpl::ReleasePageTopDragPress(
+    const gfx::PointF& point_in_widget) {
+  LocalFrame* frame = local_root_ ? local_root_->GetFrame() : nullptr;
+  if (!frame || !frame->View()) {
+    return;
+  }
+  WebMouseEvent release(WebInputEvent::Type::kMouseUp,
+                        WebInputEvent::kNoModifiers, base::TimeTicks::Now());
+  release.button = WebMouseEvent::Button::kLeft;
