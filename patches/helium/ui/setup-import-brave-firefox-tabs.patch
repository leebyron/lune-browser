+constexpr size_t kMaxFirefoxSessionSize = 64 * 1024 * 1024;
+
+std::optional<base::DictValue> ReadFirefoxSession(
+    const base::FilePath& path) {
+  constexpr std::string_view kMagic("mozLz40\0", 8);
+  constexpr size_t kHeaderSize = kMagic.size() + sizeof(uint32_t);
+  std::string compressed;
+  if (!base::ReadFileToStringWithMaxSize(path, &compressed,
+                                       kMaxFirefoxSessionSize) ||
+      compressed.size() <= kHeaderSize || !compressed.starts_with(kMagic)) {
+    return std::nullopt;
+  }
+
+  const auto bytes = base::as_byte_span(compressed);
+  const uint32_t size =
+      base::U32FromLittleEndian(bytes.subspan<kMagic.size(), sizeof(uint32_t)>());
+  if (size == 0 || size > kMaxFirefoxSessionSize) {
+    return std::nullopt;
+  }
+
+  const auto payload = bytes.subspan(kHeaderSize);
+  std::string json(size, '\0');
+  auto buffer = base::as_writable_byte_span(json);
+  if (compression_decode_buffer(buffer.data(), buffer.size(), payload.data(),
+                                payload.size(), nullptr,
+                                COMPRESSION_LZ4_RAW) != size) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+OpenTabsForImport ReadFirefoxOpenTabs(const base::FilePath& profile) {
+  // Prefer Firefox's clean session, then its active recovery snapshots.
+  for (const auto* name : {"sessionstore.jsonlz4",
+                           "sessionstore-backups/recovery.jsonlz4",
+                           "sessionstore-backups/recovery.baklz4",
+                           "sessionstore-backups/previous.jsonlz4"}) {
+    const auto session = ReadFirefoxSession(profile.AppendASCII(name));
+    const auto* windows = session ? session->FindList("windows") : nullptr;
+    if (!windows) {
+      continue;
+    }
+
+    OpenTabsForImport result;
+    for (const auto& window : *windows) {
+      const auto* window_data = window.GetIfDict();
+      const auto* tabs = window_data ? window_data->FindList("tabs") : nullptr;
+      if (!tabs || window_data->FindBool("isPrivate").value_or(false)) {
+        continue;
+      }
+      for (const auto& tab : *tabs) {
+        const auto* tab_data = tab.GetIfDict();
+        const auto* entries = tab_data ? tab_data->FindList("entries") : nullptr;
+        const int selected =
+            tab_data ? tab_data->FindInt("index").value_or(0) : 0;
+        if (!entries || selected <= 0 ||
+            static_cast<size_t>(selected) > entries->size()) {
+          continue;
+        }
+
+        const auto* entry = (*entries)[selected - 1].GetIfDict();
+        const auto* url = entry ? entry->FindString("url") : nullptr;
+        if (url) {
+          GURL current_url(*url);
+          if (current_url.is_valid() && current_url.SchemeIsHTTPOrHTTPS()) {
+            result.urls.push_back(std::move(current_url));
+          }
+        }
+      }
+    }
+    return result;
+  }
+  return {};
+}
+
