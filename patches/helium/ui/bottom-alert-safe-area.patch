+  max_safe_area_insets_ = max_safe_area;
+  RecomputeSafeAreaInsets(setter);
+}
+
+void Page::SetBrowserOverlayInsets(LocalFrame* setter, gfx::Insets insets) {
+  browser_overlay_insets_ = insets;
+  RecomputeSafeAreaInsets(setter);
+}
+
+void Page::RecomputeSafeAreaInsets(LocalFrame* setter) {
+  gfx::Insets max_safe_area = max_safe_area_insets_;
+  if (setter->IsOutermostMainFrame()) {
+    const auto fit = setter->GetDocument()->GetViewportData()
+                         .GetViewportDescription().GetViewportFit();
+    if (fit == mojom::ViewportFit::kCover ||
+        fit == mojom::ViewportFit::kCoverForcedByUserAgent) {
+      // Both values measure from the same viewport edges: take the maximum,
+      // rather than adding overlapping occlusions together.
+      max_safe_area.SetToMax(browser_overlay_insets_);
+    }
+  }
