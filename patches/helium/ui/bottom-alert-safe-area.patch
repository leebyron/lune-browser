+namespace {
+
+// Store the geometry with its WebContents, including across renderer swaps.
+// Layout updates only send changed values; a committed document always receives
+// the current value even if the native view did not need another layout.
+class BrowserOverlayInsets : public base::SupportsUserData::Data,
+                             public content::WebContentsObserver {
+ public:
+  explicit BrowserOverlayInsets(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+
+  static void Set(content::WebContents* contents, int bottom) {
+    if (!contents) {
+      return;
+    }
+    static const char kKey = 0;
+    auto* state = static_cast<BrowserOverlayInsets*>(contents->GetUserData(&kKey));
+    if (!state) {
+      auto data = std::make_unique<BrowserOverlayInsets>(contents);
+      state = data.get();
+      contents->SetUserData(&kKey, std::move(data));
+    }
+    if (state->bottom_ != bottom) {
+      state->bottom_ = bottom;
+      state->Send();
+    }
+  }
+
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->HasCommitted() && navigation->IsInPrimaryMainFrame()) {
+      Send();
+    }
+  }
+
+ private:
+  void Send() {
+    auto* frame = web_contents()->GetPrimaryMainFrame();
+    if (!frame || !frame->IsRenderFrameLive()) {
+      return;
+    }
+    mojo::AssociatedRemote<blink::mojom::DisplayCutoutClient> client;
+    frame->GetRemoteAssociatedInterfaces()->GetInterface(
+        client.BindNewEndpointAndPassReceiver());
+    client->SetBrowserOverlayInsets(gfx::Insets::TLBR(0, 0, bottom_, 0));
+  }
+
+  int bottom_ = 0;
+};
+
+}  // namespace
