+CAShapeLayer* MakeTrafficLightBezel(NSRect frame) {
+  CAShapeLayer* bezel = [CAShapeLayer layer];
+  bezel.frame = frame;
+  bezel.lineWidth = 1.0;
+  bezel.fillColor = [NSColor colorWithWhite:0 alpha:0.22].CGColor;
+  bezel.strokeColor = [NSColor colorWithWhite:0 alpha:0.18].CGColor;
+  bezel.opacity = kIdleTrafficLightBezelOpacity;
+  // Stroke inside the native button's bounds. Use an ellipse so the rim and
+  // fill share smooth circular coverage beneath the native artwork.
+  const CGFloat inset = bezel.lineWidth / 2;
+  CGPathRef path =
+      CGPathCreateWithEllipseInRect(CGRectInset(bezel.bounds, inset, inset),
+                                   nullptr);
+  bezel.path = path;
+  CGPathRelease(path);
+  return bezel;
 }
 
