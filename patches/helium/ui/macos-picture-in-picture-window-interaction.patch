+CALayer* AddSkipSymbol(NSButton* button, bool forward) {
+  button.wantsLayer = YES;
+  CALayer* arrow = MakeSymbolLayer(
+      forward ? "goforward.10" : "gobackward.10", kSkipSymbolCanvas, 18);
+  CALayer* number = [CALayer layer];
+  number.bounds = arrow.bounds;
+  number.contentsGravity = arrow.contentsGravity;
+  number.contents = arrow.contents;
+
+  // Keep both digits and their antialiased baseline in the stationary
+  // mask. The SF Symbol's numeral sits slightly below its canvas midpoint.
+  const CGRect numberRect = CGRectMake(6.5, 8.5, 10.5, 9);
+  CAShapeLayer* numberMask = [CAShapeLayer layer];
+  numberMask.frame = number.bounds;
+  CGPathRef numberPath = CGPathCreateWithRect(numberRect, nullptr);
+  numberMask.path = numberPath;
+  CGPathRelease(numberPath);
+  number.mask = numberMask;
+
+  CAShapeLayer* arrowMask = [CAShapeLayer layer];
+  arrowMask.frame = arrow.bounds;
+  CGMutablePathRef arrowPath = CGPathCreateMutable();
+  CGPathAddRect(arrowPath, nullptr, arrow.bounds);
+  CGPathAddRect(arrowPath, nullptr, numberRect);
+  arrowMask.path = arrowPath;
+  arrowMask.fillRule = kCAFillRuleEvenOdd;
+  CGPathRelease(arrowPath);
+  arrow.mask = arrowMask;
+
+  // Both SF Symbols share a ring offset even though their arrowheads point
+  // in opposite directions. Preserve the artwork position when moving the pivot.
+  const CGPoint circleOffset = CGPointMake(-0.5, 1);
+  arrow.anchorPoint = CGPointMake(0.5 + circleOffset.x / kSkipSymbolCanvas,
