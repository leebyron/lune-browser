+NSBitmapImageRep* RenderTrafficLightGlyphs(NSWindow* window,
+                                          const TrafficLightOffsets& offsets,
+                                          NSSize size) {
+  // Rasterize AppKit once, offscreen. A live color filter can corrupt the
+  // video surface during the titlebar fade.
+  NSWindow* drawingWindow = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, size.width, size.height)
+                styleMask:window.styleMask & ~NSWindowStyleMaskFullSizeContentView
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+  drawingWindow.opaque = NO;
+  drawingWindow.backgroundColor = NSColor.clearColor;
+  drawingWindow.collectionBehavior = window.collectionBehavior;
+  HeliumFullscreenWindowControls* controls =
+      [[HeliumFullscreenWindowControls alloc] initWithWindow:drawingWindow
+                                                        size:size
+                                  allowsWindowManagementMenu:NO];
+  controls.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  LayoutTrafficLightGroup(controls, offsets);
+  for (NSButton* button in controls.subviews) {
+    button.enabled = YES;
+  }
+  [drawingWindow.contentView addSubview:controls];
+  [controls setMouseInsideControls:YES];
+  NSBitmapImageRep* artwork =
+      [controls bitmapImageRepForCachingDisplayInRect:controls.bounds];
+  if (!artwork) {
+    return nil;
+  }
+  [controls cacheDisplayInRect:controls.bounds toBitmapImageRep:artwork];
+
+  NSBitmapImageRep* glyphs = [[NSBitmapImageRep alloc]
+      initWithBitmapDataPlanes:nullptr
+                    pixelsWide:artwork.pixelsWide
+                    pixelsHigh:artwork.pixelsHigh
+                 bitsPerSample:8
+               samplesPerPixel:4
+                      hasAlpha:YES
+                      isPlanar:NO
+                colorSpaceName:NSDeviceRGBColorSpace
+                   bytesPerRow:0
+                  bitsPerPixel:0];
+  if (!glyphs) {
+    return nil;
+  }
+
+  // The white marks are brighter than the native faces. Write a
+  // premultiplied white mask so the clear pixels carry no color or opacity.
+  constexpr CGFloat kGlyphThreshold = 0.80;
+  bool hasGlyphs = false;
+  @autoreleasepool {
+    for (NSInteger y = 0; y < artwork.pixelsHigh; ++y) {
+      unsigned char* row = glyphs.bitmapData + y * glyphs.bytesPerRow;
+      for (NSInteger x = 0; x < artwork.pixelsWide; ++x) {
+        NSColor* color = [[artwork colorAtX:x y:y]
+            colorUsingColorSpace:NSColorSpace.sRGBColorSpace];
+        unsigned char sample = 0;
+        if (color) {
+          const CGFloat brightness =
+              std::min({color.redComponent, color.greenComponent,
+                        color.blueComponent});
+          const CGFloat coverage = std::clamp(
+              (brightness - kGlyphThreshold) / (1 - kGlyphThreshold), 0.0, 1.0);
+          sample = std::round(255 * coverage * color.alphaComponent);
+        }
+        std::fill_n(row + x * 4, 4, sample);
+        hasGlyphs |= sample > 0;
+      }
+    }
+  }
+  glyphs.size = size;
+  return hasGlyphs ? glyphs : nil;
+}
