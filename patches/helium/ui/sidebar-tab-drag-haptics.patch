+// Copyright 2026 The Lune Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/tab_drag_handler.h"
+
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/common/tab_collection_node.h"
+#include "chrome/browser/ui/views/tabs/dragging/tab_drag_haptics_mac.h"
+
+void TabDragHandler::UpdateTabDragHaptics(bool play_feedback) {
+  if (root_node_->orientation() != TabStripOrientation::kVertical ||
+      !drag_controller_ || drag_controller_->is_window_drag_only() ||
+      drag_controller_->event_source() != ui::mojom::DragEventSource::kMouse ||
+      IsDraggingGroupHeader()) {
+    return;
+  }
+
+  const content::WebContents* source_contents =
+      drag_controller_->GetSessionData().source_view_drag_data()->contents;
+  const int source_index =
+      tab_strip_model_->GetIndexOfWebContents(source_contents);
+  if (source_index == TabStripModel::kNoTab) {
+    return;
+  }
+
+  const auto& indices = tab_strip_model_->selection_model()
+                            .GetListSelectionModel()
+                            .selected_indices();
+  const auto group = tab_strip_model_->GetTabGroupForTab(source_index);
+  const bool pinned = tab_strip_model_->IsTabPinned(source_index);
+  if (last_tab_drop_destination_ &&
+      last_tab_drop_destination_->indices == indices &&
+      last_tab_drop_destination_->group == group &&
+      last_tab_drop_destination_->pinned == pinned) {
+    return;
+  }
+  last_tab_drop_destination_ = TabDropDestination{indices, group, pinned};
+
+  if (play_feedback) {
+    PlaySidebarTabDragHaptic(*tab_strip_model_->profile());
+  }
+}
