+// Copyright 2026 The Lune Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/dragging/tab_drag_haptics_mac.h"
+
+#import <AppKit/NSHapticFeedback.h>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/sidebar_tab_drag_pref_names.h"
+#include "components/prefs/pref_service.h"
+
+void PlaySidebarTabDragHaptic(const Profile& profile) {
+  if (profile.GetPrefs()->GetBoolean(prefs::kSidebarTabDragHaptics)) {
+    [NSHapticFeedbackManager.defaultPerformer
+        performFeedbackPattern:NSHapticFeedbackPatternGeneric
+               performanceTime:NSHapticFeedbackPerformanceTimeNow];
+  }
+}
