+// AppKit's two-point line padding scrolls with the text. Reserve that margin
+// outside the editor instead, so clipped URLs still align with result titles.
+static NSRect HeliumAddressEditingFrame(NSRect frame) {
+  return NSInsetRect(frame, std::min<CGFloat>(2, NSWidth(frame) / 2), 0);
+}
+
+@interface HeliumAddressTextFieldCell : HeliumWordTextFieldCell
+@end
+@implementation HeliumAddressTextFieldCell
+- (NSText*)setUpFieldEditorAttributes:(NSText*)textObject {
+  NSText* result = [super setUpFieldEditorAttributes:textObject];
+  if ([result isKindOfClass:NSTextView.class]) {
+    ((NSTextView*)result).textContainer.lineFragmentPadding = 0;
+  }
+  return result;
+}
+@end
+
