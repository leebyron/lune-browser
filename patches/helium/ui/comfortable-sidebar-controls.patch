+gfx::Rect TabCloseButton::GetSidebarTrailingControlBounds(
+    const gfx::Size& row_size,
+    const gfx::Size& control_size) {
+  const int center_x =
+      row_size.width() - GetLayoutConstant(LayoutConstant::kVerticalTabHeight) / 2;
+  return gfx::Rect(center_x - control_size.width() / 2,
+                   (row_size.height() - control_size.height()) / 2,
+                   control_size.width(), control_size.height());
