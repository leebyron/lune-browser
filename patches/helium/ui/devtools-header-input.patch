+cc::Region DockedDevToolsHeaderExclusion(BrowserView* view,
+                                        const gfx::Rect& header) {
+  cc::Region exclusion;
+  for (const auto& container : view->GetContentsContainerViews()) {
+    auto* devtools = container->devtools_web_view();
+    if (!container->IsDrawn() || !devtools->IsDrawn()) {
+      continue;
+    }
+    using Placement = ContentsContainerView::DevToolsDockedPlacement;
+    const auto placement = container->devtools_docked_placement();
+    if (placement != Placement::kLeft && placement != Placement::kRight) {
+      continue;
+    }
+
+    // The DevTools WebView extends behind the inspected page. Only the exposed
+    // column should receive input through the header, including in split view.
+    gfx::Rect column = views::View::ConvertRectToTarget(
+        devtools, view, devtools->GetLocalBounds());
+    const gfx::Rect page = views::View::ConvertRectToTarget(
+        container.get(), view, container->GetContentsViewBounds());
+    if (placement == Placement::kLeft) {
+      column.set_width(std::clamp(page.x() - column.x(), 0, column.width()));
+    } else {
+      const int left = std::clamp(page.right(), column.x(), column.right());
+      column.set_width(column.right() - left);
+      column.set_x(left);
+    }
+    column.Intersect(header);
+    exclusion.Union(column);
+  }
+  if (auto* sidebar = view->GetSidebarView(); !exclusion.IsEmpty() &&
+      sidebar && sidebar->IsDrawn() && view->GetSideChromeRevealRatio() > 0) {
+    exclusion.Subtract(views::View::ConvertRectToTarget(
+        sidebar, view, sidebar->GetLocalBounds()));
+  }
+  return exclusion;
+}
