+NSColor* NativeSidebarGlassTintColor(BrowserView* view) {
+  const auto* colors = view ? view->GetColorProvider() : nullptr;
+  // Keep accessibility's high-contrast material treatment.
+  if (!colors ||
+      view->browser_widget()->GetColorProviderKey().contrast_mode ==
+          ui::ColorProviderKey::ContrastMode::kHigh) {
+    return nil;
+  }
+  // Derive the hue and saturation from the mounted sidebar's theme color.
+  // Calibrate lightness and glass strength separately: native glass does not
+  // render like the mounted material's ordinary overlay.
+  const bool dark = view->browser_widget()->GetColorProviderKey().color_mode ==
+                    ui::ColorProviderKey::ColorMode::kDark;
+  color_utils::HSL tone;
+  color_utils::SkColorToHSL(colors->GetColor(kColorToolbar), &tone);
+  tone.l = std::min(1.0, tone.l * (dark ? .65 : 1.05));
+  NSColor* background = GetFrameMaterialThemeTintOverlayColor(
+      color_utils::HSLToSkColor(tone, 255), dark);
+  return [background colorWithAlphaComponent:dark ? .4 : .3];
+}
+
 }  // namespace helium
