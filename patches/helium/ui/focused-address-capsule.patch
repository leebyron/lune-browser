+- (CGFloat)presentedAddressTextOriginInWindow {
+  CALayer* presentation = _addressContainer.layer.presentationLayer;
+  NSNumber* translation = [presentation valueForKeyPath:kAddressTextTranslation];
+  return [self addressTextOriginInWindow] + translation.doubleValue;
+}
