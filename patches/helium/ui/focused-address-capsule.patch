+- (void)animateFocusTransitionFrom:(CGFloat)previousTextOrigin {
+  [_addressContainer.layer removeAnimationForKey:kAddressTextTranslation];
+  [_focusedIcon.layer removeAnimationForKey:kAddressIconPop];
+  [_siteInfo.layer removeAnimationForKey:@"opacity"];
+  [_reload.layer removeAnimationForKey:@"opacity"];
+  if (NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion) {
+    return;
+  }
+
+  // Move the containing layer so the AppKit field editor and its selection
+  // travel together. The actual control frames already have their final layout.
+  const CFTimeInterval start = CACurrentMediaTime();
+  const auto add = [start](CALayer* layer, NSString* key, CAAnimation* motion) {
+    motion.beginTime = [layer convertTime:start fromLayer:nil];
+    [layer addAnimation:motion forKey:key];
+  };
+  const CGFloat offset = previousTextOrigin - [self addressTextOriginInWindow];
+  add(_addressContainer.layer, kAddressTextTranslation,
+      AddressFocusAnimation(kAddressTextTranslation, offset, 0));
+  if (_editing) {
+    CALayer* layer = _focusedIcon.layer;
+    const CGSize size = layer.bounds.size;
+    const CGPoint anchor = layer.anchorPoint;
+    // AppKit uses a corner anchor for this backing layer. Ease scale and
+    // translation component by component so the slot's center stays fixed.
+    CAAnimationGroup* pop = [CAAnimationGroup animation];
+    pop.duration = kAddressFocusDuration;
+    pop.animations = @[
+      AddressFocusAnimation(@"transform.scale", 0, 1),
+      AddressFocusAnimation(kAddressTextTranslation,
+                            (.5 - anchor.x) * size.width, 0),
+      AddressFocusAnimation(@"transform.translation.y",
+                            (.5 - anchor.y) * size.height, 0),
+    ];
+    add(layer, kAddressIconPop, pop);
+  } else {
+    add(_siteInfo.layer, @"opacity", AddressFocusAnimation(@"opacity", 0, 1));
+    if (!_reload.hidden) {
+      add(_reload.layer, @"opacity", AddressFocusAnimation(@"opacity", 0, 1));
+    }
+  }
+}
