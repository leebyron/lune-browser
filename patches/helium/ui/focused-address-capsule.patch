+        search::IsSplitViewNewTabPage(url)) {
+      image = _searchSymbol;
+    } else if (favicon.valid && !favicon.image.IsEmpty()) {
+      image = favicon.image.AsNSImage();
+    }
+  }
+  if (_focusedIcon.image != image) {
+    _focusedIcon.image = image;
+  }
+}
