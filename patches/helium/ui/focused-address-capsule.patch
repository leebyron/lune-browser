+- (CGFloat)addressTextOriginInWindow {
+  const NSRect bounds = _address.bounds;
+  CGFloat origin = NSMinX([_address convertRect:bounds toView:nil]);
+  if (!_address.userEditing) {
+    NSString* text = _address.stringValue.length ? _address.stringValue
+                                                 : _address.placeholderString;
+    const CGFloat width =
+        [text sizeWithAttributes:@{NSFontAttributeName : _address.font}].width;
+    origin += std::max<CGFloat>(2, (NSWidth(bounds) - width) / 2);
+  }
+  return origin;
+}
