+// Tab updates include favicon changes that arrive after navigation commits.
+class HeliumAddressFaviconObserver : public TabStripModelObserver {
+ public:
+  HeliumAddressFaviconObserver(HeliumFloatingAddressBar* owner,
+                               TabStripModel* model)
+      : owner_(owner) {
+    model->AddObserver(this);
+  }
+
+  void OnTabChangedAt(tabs::TabInterface* tab, TabChangeType) override {
+    if (tab->IsActivated()) {
+      [owner_ updateLeadingIcon];
+    }
+  }
+
+ private:
+  HeliumFloatingAddressBar* __weak owner_;
+};
