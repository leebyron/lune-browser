+// static
+base::ScopedClosureRunner BrowserView::HoldChromeRevealForMenu(
+    views::Widget* widget) {
+  auto* view = widget ? GetBrowserViewForNativeWindow(widget->GetNativeWindow())
+                      : nullptr;
+  if (!view || !view->IsZenModeEnabledForLayout()) {
+    return {};
+  }
+  ++view->chrome_menu_hold_count_;
+  view->zen_cursor_exit_timer_.Stop();
+  return base::ScopedClosureRunner(base::BindOnce(
+      &BrowserView::ReleaseChromeMenuHold, view->GetAsWeakPtr()));
+}
+
+void BrowserView::ReleaseChromeMenuHold() {
+  CHECK_GT(chrome_menu_hold_count_, 0);
+  if (--chrome_menu_hold_count_ == 0) {
+    // Menu commands can destroy their presenter or browser. Reevaluate only
+    // after dispatch unwinds, and never retain either through this task.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BrowserView::UpdateZenModeRevealFromCursor,
+                                 GetAsWeakPtr()));
+  }
+}
