+base::Time OlderTabsController::LastUse(const content::WebContents* contents) {
+  const auto* data = Find(contents);
+  return data ? data->last_use : base::Time();
+}
+int OlderTabsController::DateKey(base::Time time) {
+  base::Time::Exploded parts;
+  time.LocalExplode(&parts);
+  parts.hour = parts.minute = parts.second = parts.millisecond = 0;
+  base::Time midnight;
+  return base::Time::FromUTCExploded(parts, &midnight)
+             ? (midnight - base::Time::UnixEpoch()).InDays()
+             : 0;
+}
+std::u16string OlderTabsController::ShortDate(base::Time time, base::Time now) {
+  const int days = DateKey(now) - DateKey(time);
+  if (days == 0) {
+    return l10n_util::GetStringUTF16(IDS_OLDER_TABS_TODAY);
+  }
+  if (days == 1) {
+    return l10n_util::GetStringUTF16(IDS_OLDER_TABS_YESTERDAY);
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  icu::SimpleDateFormat formatter(
+      icu::UnicodeString(days >= 2 && days <= 4 ? "EEEE" : "MMM"), error);
+  icu::UnicodeString text;
+  if (U_FAILURE(error)) {
+    return base::TimeFormatShortDate(time);
+  }
+  formatter.format(time.InMillisecondsFSinceUnixEpoch(), text);
+  if (days < 2 || days > 4) {
+    base::Time::Exploded parts;
+    time.LocalExplode(&parts);
+    text.append(" ");
+    formatter.applyPattern(icu::UnicodeString("d"));
+    formatter.format(time.InMillisecondsFSinceUnixEpoch(), text);
+    // Chromium omits ICU's rule-based ordinal data. English day suffixes
+    // are small and deterministic; other locales retain localized digits.
+    if (std::string_view(icu::Locale::getDefault().getLanguage()) == "en") {
+      const int day = parts.day_of_month;
+      const char* suffix = "th";
+      if (day < 11 || day > 13) {
+        switch (day % 10) {
+          case 1:
+            suffix = "st";
+            break;
+          case 2:
+            suffix = "nd";
+            break;
+          case 3:
+            suffix = "rd";
+            break;
+        }
+      }
+      text.append(suffix);
+    }
+  }
+  return std::u16string(text.getBuffer(), text.length());
+}
