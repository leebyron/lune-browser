+void PermissionToggleRowView::OnMouseReleased(const ui::MouseEvent& event) {
+  if (inline_reset_button_ && toggle_button_->GetEnabled() &&
+      event.IsLeftMouseButton() && HitTestPoint(event.location())) {
+    OnToggleButtonPressed();
