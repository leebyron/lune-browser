+void PageInfoMainView::UseAutomaticDownloadsPopoverRow(
+    PermissionToggleRowView::ResetButtonFactory reset_button_factory) {
+  if (automatic_downloads_reset_factory_) {
+    return;
+  }
+  automatic_downloads_reset_factory_ = std::move(reset_button_factory);
+  // The popover can configure the view while it is being added after Back.
+  // Wait for the hierarchy notification to finish before attaching the button.
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PageInfoMainView::ApplyAutomaticDownloadsPopoverRow,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void PageInfoMainView::ApplyAutomaticDownloadsPopoverRow() {
+  const auto it =
+      syncable_permission_rows_.find(ContentSettingsType::AUTOMATIC_DOWNLOADS);
+  if (it == syncable_permission_rows_.end()) {
+    return;
+  }
+  it->second->UsePopoverToggleStyle(automatic_downloads_reset_factory_);
+  PermissionInfoList permissions;
+  for (const auto& row : toggle_rows_) {
+    permissions.push_back(row->permission());
+  }
+  UpdateResetButton(permissions);
+}
