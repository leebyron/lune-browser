+void PermissionToggleRowView::UsePopoverToggleStyle(
+    const ResetButtonFactory& reset_button_factory) {
+  if (!toggle_button_ || inline_reset_button_) {
+    return;
+  }
+
+  auto button = reset_button_factory.Run(
+      base::BindRepeating(&PermissionToggleRowView::ResetPermission,
+                          base::Unretained(this)));
+  const int top_inset =
+      std::max(0, (row_view_->GetFirstLineHeight() -
+                   button->GetPreferredSize().height()) / 2);
+  button->SetProperty(views::kMarginsKey,
+                      gfx::Insets::TLBR(top_inset, 6, 0, 4));
+  button->SetVisible(permission_.setting.has_value());
+  inline_reset_button_ = row_view_->AddControl(std::move(button));
+  row_view_->ReorderChildView(inline_reset_button_,
+                              row_view_->GetIndexOf(toggle_button_).value());
+}
+
+bool PermissionToggleRowView::OnMousePressed(const ui::MouseEvent& event) {
+  return inline_reset_button_ && toggle_button_->GetEnabled() &&
+         event.IsOnlyLeftMouseButton();
+}
