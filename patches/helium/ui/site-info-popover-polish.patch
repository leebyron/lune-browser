+class SiteInfoResetButtonHost : public views::NativeViewHost {
+ public:
+  explicit SiteInfoResetButtonHost(base::RepeatingClosure action)
+      : button_([[HeliumSiteInfoResetButton alloc]
+            initWithAction:std::move(action)]) {
+    const NSSize size = button_.fittingSize;
+    SetPreferredSize(gfx::Size(base::ClampCeil(size.width),
+                               base::ClampCeil(size.height)));
+  }
+
+  void AddedToWidget() override {
+    if (GetVisible()) {
+      AttachButton();
+    }
+  }
+
+ private:
+  void AttachButton() {
+    if (!native_view()) {
+      Attach(gfx::NativeView(button_));
+    }
+  }
+
+  void VisibilityChanged(views::View* starting_from, bool visible) override {
+    if (GetWidget()) {
+      if (visible && IsDrawn()) {
+        AttachButton();
+      } else if (!visible && native_view()) {
+        Detach();
+      }
+    }
+    views::NativeViewHost::VisibilityChanged(starting_from, visible);
+  }
+
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::NativeViewHost>(this);
+    NSView* container = button_.superview;
+    if (!container || button_.hidden) {
+      return;
+    }
+    // The Views root is inset inside the AppKit popover window.
+    const gfx::Rect bounds = ConvertRectToWidget(GetContentsBounds());
+    const CGFloat y = container.isFlipped
+                          ? bounds.y()
+                          : NSHeight(container.bounds) - bounds.bottom();
+    button_.frame = NSMakeRect(bounds.x(), y, bounds.width(), bounds.height());
+  }
+
+  HeliumSiteInfoResetButton* __strong button_;
+};
