+void ConfigureSiteInfoPopoverHeader(views::FlexLayoutView& header) {
+  views::View* back = nullptr;
+  views::View* close = nullptr;
+  for (views::View* child : header.children()) {
+    if (child->GetID() == PageInfoViewFactory::VIEW_ID_PAGE_INFO_BACK_BUTTON) {
+      back = child;
+    } else if (child->GetID() ==
+               PageInfoViewFactory::VIEW_ID_PAGE_INFO_CLOSE_BUTTON) {
+      close = child;
+    }
+  }
+  if (!close || !close->GetVisible()) {
+    return;
+  }
+  close->SetVisible(false);
+
+  views::View* labels = &header;
+  gfx::Insets header_margins = header.GetInteriorMargin();
+  if (back) {
+    header.SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    header_margins.set_bottom(0);
+    if (auto* title = header.GetViewByID(
+            PageInfoViewFactory::VIEW_ID_PAGE_INFO_SUBPAGE_TITLE)) {
+      labels = title->parent();
+      const auto* margins = labels->GetProperty(views::kMarginsKey);
+      labels->SetProperty(views::kMarginsKey,
+                          gfx::Insets::VH(0, margins ? margins->right() : 0));
+    }
+    // Keep the title centered across the panel, independent of the Back button.
+    auto* spacer = header.AddChildView(std::make_unique<views::View>());
+    spacer->SetCanProcessEventsWithinSubtree(false);
+    spacer->SetPreferredSize(back->GetPreferredSize());
+    if (const auto* padding = back->GetProperty(views::kInternalPaddingKey)) {
+      spacer->SetProperty(views::kInternalPaddingKey, *padding);
+    }
+  } else {
+    header_margins.set_top(header_margins.top() + kSiteInfoSubpageTopAdjustment);
+  }
+  header.SetInteriorMargin(header_margins);
+  for (views::View* child : labels->children()) {
+    if (auto* label = views::AsViewClass<views::Label>(child)) {
+      if (back &&
+          label->GetID() != PageInfoViewFactory::VIEW_ID_PAGE_INFO_SUBPAGE_TITLE) {
+        label->SetVisible(false);
+        continue;
+      }
+      label->SetTextStyle(views::style::STYLE_BODY_3);
+      label->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    }
+  }
+}
