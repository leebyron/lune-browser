+    self.font = [NSFont systemFontOfSize:
+        [NSFont systemFontSizeForControlSize:self.controlSize]];
+    [self setButtonType:NSButtonTypeMomentaryPushIn];
+    self.target = self;
+    self.action = @selector(resetPermission:);
+  }
+  return self;
+}
+
+- (void)resetPermission:(id)sender {
+  auto callback = _callback;
+  callback.Run();
