+    // clean without changing the ordinary tab menu.
+    bool next_is_separator = true;
+    for (size_t i = GetItemCount(); i > 0; --i) {
+      const bool separator = GetTypeAt(i - 1) == ui::MenuModel::TYPE_SEPARATOR;
+      if (separator && next_is_separator) {
+        RemoveItemAt(i - 1);
+      } else {
