+namespace tabs {
+namespace {
+const char kDataKey = 0;
+
+// Lives with the WebContents, so transfer between windows retains the clocks.
+// Replacement/discard explicitly copies the serializable state below.
+class CleanupData : public base::SupportsUserData::Data,
+                    public content::WebContentsObserver {
+ public:
+  explicit CleanupData(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+  void DidGetUserInteraction(const blink::WebInputEvent&) override {
+    auto* tab = TabInterface::MaybeGetFromContents(web_contents());
+    auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (browser) {
+      browser->GetTabStripModel()->older_tabs_controller()->Interact(
+          web_contents());
+    }
+  }
+
+  std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::Time last_use = base::Time::Now();
+  base::Time age = last_use;
+  base::Time close_clock;
+  base::Time frozen;
+  double order = 0;
+  std::optional<double> drag_original_order;
+  int drag_origin_window = 0;
+  bool dirty = true;
+  bool detached = false;
+  bool drag_regular = false;
+  bool dragging = false;
+  base::TimeTicks last_saved;
+};
+
+CleanupData* Find(const content::WebContents* contents) {
+  return contents ? static_cast<CleanupData*>(contents->GetUserData(&kDataKey))
+                  : nullptr;
+}
+CleanupData& Get(content::WebContents* contents) {
+  if (!Find(contents)) {
+    contents->SetUserData(&kDataKey, std::make_unique<CleanupData>(contents));
+  }
+  return *Find(contents);
+}
+void ReturnToRegular(CleanupData& data, base::Time now) {
+  data.age = now;
+  data.close_clock = base::Time();
+  data.frozen = base::Time();
+}
+base::TimeDelta Duration(PrefService* prefs, const char* key, int fallback) {
+  // Invalid external writes fail conservatively. Zero is an explicit Never;
+  // bound positive durations to one year before constructing a TimeDelta.
+  const int hours = prefs->GetInteger(key);
+  if (hours == -1 && std::string_view(key) == kOlderTabsCloseHours) {
+    return base::TimeDelta();  // Explicit Immediately retention.
+  }
+  if (hours == 0) {
+    return base::TimeDelta::Max();
+  }
+  return base::Hours(hours > 0 && hours <= 24 * 365 ? hours : fallback);
+}
+}  // namespace
+
+// Session restore queues saved-group reconnection independently of restoring
+// the tab strip. Do not remove members until those pending connections finish.
+class OlderTabsGroupReadiness
+    : public tab_groups::TabGroupSyncService::Observer {
+ public:
+  OlderTabsGroupReadiness(tab_groups::TabGroupSyncService* service,
+                          base::RepeatingClosure ready)
+      : service_(service), ready_(std::move(ready)), initialized_(!service) {
+    if (service_) {
+      // AddObserver also reports initialization to late observers.
+      service_->AddObserver(this);
+    }
+  }
+  ~OlderTabsGroupReadiness() override {
+    if (service_) {
+      service_->RemoveObserver(this);
+    }
+  }
+  bool initialized() const { return initialized_; }
+  void OnInitialized() override {
+    initialized_ = true;
+    ready_.Run();
+  }
+  void OnWillBeDestroyed() override {
+    service_->RemoveObserver(this);
+    service_ = nullptr;
+    initialized_ = false;
+  }
+
+ private:
+  raw_ptr<tab_groups::TabGroupSyncService> service_;
+  base::RepeatingClosure ready_;
+  bool initialized_;
+};
+
+OlderTabsController::OlderTabsController(TabStripModel* model) : model_(model) {
+  model_->AddObserver(this);
+  base::PowerMonitor::GetInstance()->AddPowerSuspendObserver(this);
+  auto* prefs = model_->profile()->GetPrefs();
+  if (!prefs->FindPreference(kOlderTabsMoveHours)) {
+    return;  // Minimal tab-model test profiles may not register browser prefs.
+  }
+  pref_registrar_.Init(prefs);
+  for (const char* key :
+       {kOlderTabsMoveHours, kOlderTabsCloseHours, kOlderTabsMoveGrouped}) {
+    pref_registrar_.Add(
+        key, base::BindRepeating(&OlderTabsController::OnSettingsChanged,
+                                 base::Unretained(this)));
+  }
+  pref_registrar_.Add(
+      kOlderTabsCollapsed,
+      base::BindRepeating(&OlderTabsController::ScheduleReconcile,
+                          base::Unretained(this)));
+  close_not_before_ = base::TimeTicks::Now() + base::Minutes(5);
+  timer_.Start(FROM_HERE, base::Minutes(1), this,
+               &OlderTabsController::Reconcile);
+}
+OlderTabsController::~OlderTabsController() {
+  base::PowerMonitor::GetInstance()->RemovePowerSuspendObserver(this);
+  model_->RemoveObserver(this);
+}
+void OlderTabsController::OnResume() {
+  close_not_before_ = base::TimeTicks::Now() + base::Minutes(5);
+  ScheduleReconcile();
+}
+
+bool OlderTabsController::IsOlder(const content::WebContents* contents) {
+  auto* data = Find(contents);
+  return data && !data->close_clock.is_null();
+}
+bool OlderTabsController::ComesBefore(const content::WebContents* a,
+                                      const content::WebContents* b) {
+  const auto& x = *Find(a);
+  const auto& y = *Find(b);
+  return x.frozen != y.frozen ? x.frozen > y.frozen : x.id < y.id;
+}
+bool OlderTabsController::IsDraggingToRegular(
+    const content::WebContents* contents) {
+  auto* data = Find(contents);
+  return data && data->drag_regular && TabDragController::IsActive();
+}
+base::Time OlderTabsController::FrozenLastUse(
+    const content::WebContents* contents) {
+  auto* data = Find(contents);
+  return data ? data->frozen : base::Time();
+}
+std::string OlderTabsController::Serialize(
+    const content::WebContents* contents) {
+  auto* data = Find(contents);
+  if (!data) {
+    return {};
+  }
+  base::DictValue value;
+  value.Set("version", 1);
+  value.Set("id", data->id);
+  value.Set("last_use", base::TimeToValue(data->last_use));
+  value.Set("age", base::TimeToValue(data->age));
+  value.Set("close_clock", base::TimeToValue(data->close_clock));
+  value.Set("frozen", base::TimeToValue(data->frozen));
+  value.Set("order", data->order);
+  return base::WriteJson(value).value_or("");
+}
+void OlderTabsController::Restore(content::WebContents* contents,
+                                  const std::string& serialized,
+                                  bool from_session_restore) {
+  auto value = base::JSONReader::ReadDict(serialized, base::JSON_PARSE_RFC);
+  if (!value || value->FindInt("version") != 1) {
+    return;
+  }
+  auto read_time = [&](const char* key) {
+    const auto* v = value->Find(key);
+    return v ? base::ValueToTime(*v).value_or(base::Time()) : base::Time();
+  };
+  const auto now = base::Time::Now();
+  auto& data = Get(contents);
+  auto valid_time = [&](base::Time time) {
+    return !time.is_null() && time <= now && time > base::Time::UnixEpoch();
+  };
+  const auto last_use = read_time("last_use");
+  const auto age = read_time("age");
+  const auto close_clock = read_time("close_clock");
+  const auto frozen = read_time("frozen");
+  if (!valid_time(last_use) || !valid_time(age) ||
+      (!close_clock.is_null() &&
+       (!valid_time(close_clock) || !valid_time(frozen)))) {
+    return;  // Missing/corrupt/future dates receive fresh migration grace.
+  }
+  if (const auto* id = value->FindString("id");
+      id && base::Uuid::ParseLowercase(*id).is_valid()) {
+    data.id = *id;
+  }
+  data.last_use = last_use;
+  data.age = age;
+  data.close_clock = close_clock;
+  data.frozen = frozen;
+  const auto order = value->FindDouble("order").value_or(0);
+  data.order = std::isfinite(order) && std::abs(order) < 1e12 ? order : 0;
+  if (!from_session_restore) {
+    // Explicit recently-closed recovery starts a fresh regular aging cycle.
+    ReturnToRegular(data, now);
+    data.order = 0;
+    data.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+}
+
+bool OlderTabsController::IsEnabled() const {
+  if (model_->profile()->IsOffTheRecord() ||
+      !model_->profile()->GetPrefs()->FindPreference(kOlderTabsMoveHours) ||
+      Duration(model_->profile()->GetPrefs(), kOlderTabsMoveHours,
+               kDefaultOlderTabsMoveHours)
+          .is_max() ||
+      !model_->delegate()->IsNormalWindow()) {
+    return false;
+  }
+  auto* browser = model_->delegate()->GetBrowserWindowInterface();
+  auto* state =
+      browser ? VerticalTabStripStateController::From(browser) : nullptr;
+  return state && state->ShouldDisplayVerticalTabs();
+}
+int OlderTabsController::FirstOlderIndex() const {
+  for (int i = 0; i < model_->count(); ++i) {
+    if (IsOlder(model_->GetWebContentsAt(i))) {
+      return i;
+    }
+  }
+  return model_->count();
+}
+
+void OlderTabsController::Save(content::WebContents* contents) {
+  Get(contents).dirty = true;
+  if (observing_change_) {
+    return;  // SessionService observes insertion later; save after
+             // notifications.
+  }
+  if (model_->profile()->IsOffTheRecord()) {
+    return;
+  }
+  auto* helper = sessions::SessionTabHelper::FromWebContents(contents);
+  if (helper && helper->window_id().is_valid()) {
+    if (auto* service =
+            SessionServiceFactory::GetForProfile(model_->profile())) {
+      service->AddTabExtraData(helper->window_id(), helper->session_id(),
+                               kOlderTabsSessionKey, Serialize(contents));
+      Get(contents).last_saved = base::TimeTicks::Now();
+      Get(contents).dirty = false;
+    }
+  }
+}
+void OlderTabsController::Interact(content::WebContents* contents) {
+  if (!contents ||
+      model_->GetIndexOfWebContents(contents) == TabStripModel::kNoTab) {
+    return;
+  }
+  auto& data = Get(contents);
+  const auto now = base::Time::Now();
+  data.last_use = now;
+  data.dirty = true;
+  if (IsOlder(contents)) {
+    data.close_clock = now;
+  } else {
+    data.age = now;
+  }
+  // Keep event contents private and coalesce disk writes, while updating the
+  // in-memory deadline on every trusted input event.
+  if (base::TimeTicks::Now() - data.last_saved >= base::Seconds(30)) {
+    Save(contents);
+  }
+}
+void OlderTabsController::NormalizeOrderKeys() {
+  std::vector<content::WebContents*> tabs;
+  for (int i = 0; i < model_->count(); ++i) {
+    tabs.push_back(model_->GetWebContentsAt(i));
+  }
+  std::stable_sort(tabs.begin(), tabs.end(), [](auto* a, auto* b) {
+    return std::tie(Get(a).order, Get(a).id) <
+           std::tie(Get(b).order, Get(b).id);
+  });
+  // Retain each hidden tab's next surviving logical neighbor, then rebase
+  // keys in current regular-stack order. This also handles bulk/group moves
+  // and precision exhaustion without recursion on inverted neighbor keys.
+  std::map<content::WebContents*, std::vector<content::WebContents*>> before;
+  std::vector<content::WebContents*> trailing;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    if (!IsOlder(tabs[i])) {
+      continue;
+    }
+    auto next = std::find_if(tabs.begin() + i + 1, tabs.end(),
+                             [](auto* tab) { return !IsOlder(tab); });
+    if (next == tabs.end()) {
+      trailing.push_back(tabs[i]);
+    } else {
+      before[*next].push_back(tabs[i]);
+    }
+  }
+  std::vector<content::WebContents*> logical;
+  for (int i = 0; i < model_->count(); ++i) {
+    auto* contents = model_->GetWebContentsAt(i);
+    if (IsOlder(contents)) {
+      continue;
+    }
+    auto& hidden = before[contents];
+    logical.insert(logical.end(), hidden.begin(), hidden.end());
+    logical.push_back(contents);
+  }
+  logical.insert(logical.end(), trailing.begin(), trailing.end());
+  double key = 1024;
+  for (auto* contents : logical) {
+    Get(contents).order = key;
+    key += 1024;
+    Save(contents);
+  }
+}
+void OlderTabsController::AssignOrder(content::WebContents* contents) {
+  const int index = model_->GetIndexOfWebContents(contents);
+  double previous = 0;
+  double next = 0;
+  for (int i = index - 1; i >= 0; --i) {
+    auto* candidate = model_->GetWebContentsAt(i);
+    if (!IsOlder(candidate) && Get(candidate).order != 0) {
+      previous = Get(candidate).order;
+      break;
+    }
+  }
+  for (int i = index + 1; i < model_->count(); ++i) {
+    auto* candidate = model_->GetWebContentsAt(i);
+    if (!IsOlder(candidate) && Get(candidate).order != 0) {
+      next = Get(candidate).order;
+      break;
+    }
+  }
+  if (next != 0 && next <= previous) {
+    NormalizeOrderKeys();
+    AssignOrder(contents);
+    return;
+  }
+  // Insert after hidden logical positions in this gap. Hidden tabs do not
+  // collide with a new fractional key, and repeated Keep actions preserve
+  // their relative order regardless of the order in which they are kept.
+  for (int i = 0; i < model_->count(); ++i) {
+    auto* candidate = model_->GetWebContentsAt(i);
+    if (candidate != contents && IsOlder(candidate) &&
+        (next == 0 || Get(candidate).order < next)) {
+      previous = std::max(previous, Get(candidate).order);
+    }
+  }
+  if (next == 0) {
+    next = previous + 2048;
+  }
+  if (next - previous < 0.000001 || next > 1e11) {
+    NormalizeOrderKeys();
+    AssignOrder(contents);
+    return;
+  }
+  Get(contents).order = (previous + next) / 2;
+  Save(contents);
+}
+void OlderTabsController::Keep(content::WebContents* contents) {
+  if (model_->GetIndexOfWebContents(contents) == TabStripModel::kNoTab ||
+      !IsOlder(contents)) {
+    return;
+  }
+  ReturnToRegular(Get(contents), base::Time::Now());
+  // Return before the first surviving regular neighbor with a greater logical
+  // key. If a group was formed across the old position, use its leading edge.
+  int target = FirstOlderIndex();
+  for (int i = model_->IndexOfFirstNonPinnedTab(); i < model_->count(); ++i) {
+    auto* candidate = model_->GetWebContentsAt(i);
+    if (candidate != contents && !IsOlder(candidate) &&
+        Get(candidate).order > Get(contents).order) {
+      target = i;
+      if (auto group = model_->GetTabAtIndex(i)->GetGroup()) {
+        while (target > model_->IndexOfFirstNonPinnedTab() &&
+               model_->GetTabAtIndex(target - 1)->GetGroup() == group) {
+          --target;
+        }
+      }
+      break;
+    }
+  }
+  const int current = model_->GetIndexOfWebContents(contents);
+  if (current < target) {
+    --target;
+  }
+  {
+    base::AutoReset<bool> guard(&mutating_, true);
+    model_->MoveWebContentsAt(
+        current, std::max(target, model_->IndexOfFirstNonPinnedTab()), false);
+  }
+  Save(contents);
+  ScheduleReconcile();
+}
+void OlderTabsController::KeepAll() {
+  std::vector<content::WebContents*> older;
+  for (int i = 0; i < model_->count(); ++i) {
+    auto* contents = model_->GetWebContentsAt(i);
+    if (IsOlder(contents)) {
+      older.push_back(contents);
+    }
+  }
+  // Keep uses saved logical neighbors, independently of frozen date order.
+  for (auto* contents : older) {
+    Keep(contents);
+  }
+}
+void OlderTabsController::CloseAll() {
+  // This is an explicit user command. Use the ordinary bulk historical close
+  // path, including unload handling and fresh handle/protection checks.
+  model_->ExecuteCloseTabsCommand(
+      base::BindRepeating(
+          [](base::WeakPtr<OlderTabsController> controller) {
+            std::vector<TabHandle> handles;
+            if (controller) {
+              auto* model = controller->model_.get();
+              for (int i = 0; i < model->count(); ++i) {
+                if (IsOlder(model->GetWebContentsAt(i))) {
+                  handles.push_back(model->GetTabAtIndex(i)->GetHandle());
+                }
+              }
+            }
+            return handles;
+          },
+          weak_factory_.GetWeakPtr()),
+      /*delete_groups=*/false);
+}
+void OlderTabsController::SetDragDestination(content::WebContents* contents,
+                                             bool regular) {
+  auto& data = Get(contents);
+  if (!data.dragging) {
+    data.dragging = true;
+    if (!data.drag_original_order) {
+      data.drag_original_order = data.order;
+      auto* browser = model_->delegate()->GetBrowserWindowInterface();
+      data.drag_origin_window = browser ? browser->GetSessionID().id() : 0;
+    }
+  }
+  data.drag_regular = regular;
+}
+void OlderTabsController::FinishDrag(
+    const std::vector<content::WebContents*>& contents,
+    bool completed) {
+  for (auto* tab : contents) {
+    if (model_->GetIndexOfWebContents(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    auto& data = Get(tab);
+    if (completed && (!IsOlder(tab) || data.drag_regular)) {
+      ReturnToRegular(data, base::Time::Now());
+      AssignOrder(tab);
+    }
+    if ((!completed || (IsOlder(tab) && !data.drag_regular)) &&
+        data.drag_original_order) {
+      auto* browser = model_->delegate()->GetBrowserWindowInterface();
+      if (browser && browser->GetSessionID().id() == data.drag_origin_window) {
+        data.order = *data.drag_original_order;
+        Save(tab);
+      }
+    }
+    data.dragging = false;
+    data.drag_original_order.reset();
+    data.drag_origin_window = 0;
+    data.drag_regular = false;
+  }
+  ScheduleReconcile();
+}
+void OlderTabsController::NormalizeModelOrder() {
+  std::vector<content::WebContents*> older;
+  for (int i = model_->IndexOfFirstNonPinnedTab(); i < model_->count(); ++i) {
+    auto* contents = model_->GetWebContentsAt(i);
+    if (IsOlder(contents)) {
+      older.push_back(contents);
+    }
+  }
+  std::sort(older.begin(), older.end(),
+            [](auto* a, auto* b) { return ComesBefore(a, b); });
+  // Only move eligible standalone Older tabs. Never extract individual group
+  // or split members while shifting regular rows to make room.
+  // First gather Older tabs at the end in their existing order; moving to
+  // the end is always outside every regular group and split collection.
+  bool gathered = true;
+  const int first = model_->count() - older.size();
+  for (int i = model_->IndexOfFirstNonPinnedTab(); i < model_->count(); ++i) {
+    if (IsOlder(model_->GetWebContentsAt(i)) != (i >= first)) {
+      gathered = false;
+      break;
+    }
+  }
+  if (!gathered) {
+    std::vector<content::WebContents*> current;
+    for (int i = 0; i < model_->count(); ++i) {
+      if (IsOlder(model_->GetWebContentsAt(i))) {
+        current.push_back(model_->GetWebContentsAt(i));
+      }
+    }
+    for (auto* contents : current) {
+      model_->MoveWebContentsAt(model_->GetIndexOfWebContents(contents),
+                                model_->count() - 1, false);
+    }
+  }
+  for (size_t i = 0; i < older.size(); ++i) {
+    const int current = model_->GetIndexOfWebContents(older[i]);
+    const int target = first + i;
+    if (current != target) {
+      model_->MoveWebContentsAt(current, target, false);
+    }
+  }
+}
+
+bool OlderTabsController::IsProtected(int index, bool closing) const {
+  auto* tab = model_->GetTabAtIndex(index);
+  auto* contents = tab->GetContents();
+  if (model_->IsTabPinned(index) ||
+      (tab->GetGroup() &&
+       !model_->profile()->GetPrefs()->GetBoolean(kOlderTabsMoveGrouped)) ||
+      tab->GetSplit() || model_->IsTabSelected(index) || tab->IsVisible() ||
+      contents->IsLoading() || contents->IsCurrentlyAudible() ||
+      contents->IsBeingCaptured() || contents->HasPictureInPictureVideo() ||
+      contents->HasPictureInPictureDocument()) {
+    return true;
+  }
+  return closing &&
+         (contents->NeedToFireBeforeUnloadOrUnloadEvents() ||
+          model_->profile()->GetDownloadManager()->InProgressCount() > 0);
+}
+void OlderTabsController::Reconcile() {
+  reconcile_pending_ = false;
+  if (mutating_ || model_->closing_all() || TabDragController::IsActive() ||
+      SessionRestore::IsRestoring(model_->profile())) {
+    return;
+  }
+  base::AutoReset<bool> guard(&mutating_, true);
+  const auto now = base::Time::Now();
+  auto* prefs = model_->profile()->GetPrefs();
+  // An absent UI suspends lifecycle transitions; all tabs remain visible in
+  // horizontal mode or with cleanup disabled. Membership is retained.
+  const bool enabled = IsEnabled();
+  if (enabled) {
+    const auto move_after =
+        Duration(prefs, kOlderTabsMoveHours, kDefaultOlderTabsMoveHours);
+    const auto close_after =
+        Duration(prefs, kOlderTabsCloseHours, kDefaultOlderTabsCloseHours);
+    const bool move_grouped = prefs->GetBoolean(kOlderTabsMoveGrouped);
+    if (move_grouped && !group_readiness_) {
+      group_readiness_ = std::make_unique<OlderTabsGroupReadiness>(
+          tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+              model_->profile()),
+          base::BindRepeating(&OlderTabsController::ScheduleReconcile,
+                              weak_factory_.GetWeakPtr()));
+    }
+    std::vector<content::WebContents*> candidates;
+    for (int i = model_->count() - 1; i >= 0; --i) {
+      candidates.push_back(model_->GetWebContentsAt(i));
+    }
+    // Ungrouping can move a tab to a group's boundary. Walk stable contents,
+    // rather than indices, so no neighbor is processed twice or skipped.
+    for (auto* contents : candidates) {
+      const int i = model_->GetIndexOfWebContents(contents);
+      if (i == TabStripModel::kNoTab) {
+        continue;
+      }
+      auto& data = Get(contents);
+      if (data.order == 0) {
+        AssignOrder(contents);
+      }
+      const bool grouped = model_->GetTabAtIndex(i)->GetGroup().has_value();
+      if (model_->IsTabPinned(i) || model_->GetTabAtIndex(i)->GetSplit() ||
+          (grouped && (!move_grouped || IsOlder(contents)))) {
+        if (IsOlder(contents)) {
+          ReturnToRegular(data, now);
+          AssignOrder(contents);
+        }
+        continue;
+      }
+      if (grouped && !group_readiness_->initialized()) {
+        continue;
+      }
+      // Clock rollback/future timestamps get a fresh deadline, keeping a valid
+      // historical date snapshot separate from the new grace baseline.
+      if (data.age > now || data.close_clock > now || data.last_use > now) {
+        data.age = now;
+        data.last_use = std::min(data.last_use, now);
+        if (IsOlder(contents)) {
+          data.close_clock = now;
+        }
+        Save(contents);
+        continue;
+      }
+      if (IsOlder(contents)) {
+        if (base::TimeTicks::Now() >= close_not_before_ &&
+            now - data.close_clock >= close_after && !IsProtected(i, true)) {
+          // Recheck current preferences and protection immediately before the
+          // standard historical-tab close path. Never impersonate user input.
+          model_->CloseWebContentsAt(
+              i, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+        }
+      } else if (now - data.age >= move_after && !IsProtected(i, false)) {
+        if (close_after.is_zero()) {
+          // Immediately bypasses Older entirely. A protected or grace-delayed
+          // tab stays regular until the ordinary close path can handle it.
+          if (base::TimeTicks::Now() >= close_not_before_ &&
+              !IsProtected(i, true)) {
+            model_->CloseWebContentsAt(
+                i, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+          }
+          continue;
+        }
+        if (grouped) {
+          // Move the eligible tab alone. Date buckets are presentation rows,
+          // and never become tab groups or drag sources.
+          model_->RemoveFromGroup({i});
+        }
+        data.frozen = data.last_use;
+        data.close_clock =
+            now;  // One transition: downtime cannot skip retention.
+        Save(contents);
+      }
+    }
+    NormalizeModelOrder();
+  }
+  // Insertion observers run before SessionService has tracked the tab/window.
+  // Flush coalesced activity and initial metadata after all notifications
+  // finish.
+  for (int i = 0; i < model_->count(); ++i) {
+    auto* contents = model_->GetWebContentsAt(i);
+    if (Get(contents).dirty) {
+      Save(contents);
+    }
+  }
+  changed_.Notify();
+}
+
+void OlderTabsController::ScheduleReconcile() {
+  if (reconcile_pending_) {
+    return;
+  }
+  reconcile_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&OlderTabsController::Reconcile,
+                                weak_factory_.GetWeakPtr()));
+}
+void OlderTabsController::OnSettingsChanged() {
+  // A shorter retention setting cannot surprise-close tabs while the user is
+  // editing it. Date snapshots and age baselines stay unchanged.
+  close_not_before_ = base::TimeTicks::Now() + base::Minutes(5);
+  ScheduleReconcile();
+}
+base::CallbackListSubscription OlderTabsController::RegisterChanged(
+    base::RepeatingClosure callback) {
+  return changed_.Add(std::move(callback));
+}
+void OlderTabsController::OnTabStripModelChanged(
+    TabStripModel*,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (mutating_) {
+    return;
+  }
+  base::AutoReset<bool> observation_guard(&observing_change_, true);
+  if (const auto* replace = change.type() == TabStripModelChange::kReplaced
+                                ? change.GetReplace()
+                                : nullptr) {
+    Restore(replace->new_contents, Serialize(replace->old_contents), true);
+  }
+  if (const auto* remove = change.type() == TabStripModelChange::kRemoved
+                               ? change.GetRemove()
+                               : nullptr) {
+    for (const auto& removed : remove->contents) {
+      if (auto* data = Find(removed.contents)) {
+        if (TabDragController::IsActive() && !data->drag_original_order) {
+          data->dragging = true;
+          data->drag_original_order = data->order;
+          auto* browser = model_->delegate()->GetBrowserWindowInterface();
+          data->drag_origin_window = browser ? browser->GetSessionID().id() : 0;
+        }
+        data->detached = true;
+      }
+    }
+  }
+  if (const auto* insert = change.type() == TabStripModelChange::kInserted
+                               ? change.GetInsert()
+                               : nullptr) {
+    for (const auto& inserted : insert->contents) {
+      auto& data = Get(inserted.contents);
+      if (data.detached) {
+        data.order = 0;
+        data.detached = false;
+      }
+      if (data.order == 0) {
+        AssignOrder(inserted.contents);
+      }
+      Save(inserted.contents);
+    }
+  }
+  if (const auto* move = change.type() == TabStripModelChange::kMoved
+                             ? change.GetMove()
+                             : nullptr;
+      move && !TabDragController::IsActive() &&
+      !(Find(move->contents) && Find(move->contents)->dragging)) {
+    auto* contents = move->contents.get();
+    if (IsOlder(contents)) {
+      ReturnToRegular(Get(contents), base::Time::Now());
+    }
+    AssignOrder(contents);
+    Interact(contents);
+  }
+  if (selection.active_tab_changed() && selection.new_contents) {
+    Interact(selection.new_contents);
+    if (IsOlder(selection.new_contents)) {
+      model_->profile()->GetPrefs()->SetBoolean(kOlderTabsCollapsed, false);
+    }
+  }
+  ScheduleReconcile();
+}
