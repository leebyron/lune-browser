+  const auto* tab = views::AsViewClass<TabView>(view);
+  return tab && tab->GetTabInterface() ? tab->GetTabInterface()->GetContents()
+                                       : nullptr;
+}
+// Convert a local calendar date to a synthetic UTC midnight. Subtraction of
+// these dates counts civil days without treating a DST day as 24 elapsed hours.
+int CivilDaysBetween(base::Time newer, base::Time older) {
+  auto date = [](base::Time time) {
+    base::Time::Exploded parts;
+    time.LocalExplode(&parts);
+    parts.hour = parts.minute = parts.second = parts.millisecond = 0;
+    base::Time result;
+    return base::Time::FromUTCExploded(parts, &result) ? result : base::Time();
+  };
+  return (date(newer) - date(older)).InDays();
+}
+std::u16string OlderDate(base::Time time, int days) {
+  if (days > 7) {
+    return l10n_util::GetStringUTF16(IDS_OLDER_TABS_OLDER_LABEL);
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  icu::SimpleDateFormat formatter(icu::UnicodeString("EEEE"), error);
+  icu::UnicodeString text;
+  if (U_SUCCESS(error)) {
+    formatter.format(time.InMillisecondsFSinceUnixEpoch(), text);
+  }
+  return std::u16string(text.getBuffer(), text.length());
+}
+}  // namespace
+
+bool UnpinnedTabContainerView::IsOlderView(const views::View* view) const {
+  return has_older_tabs_ &&
+         tabs::OlderTabsController::IsOlder(ContentsForView(view)) &&
+         !tabs::OlderTabsController::IsDraggingToRegular(ContentsForView(view));
+}
+bool UnpinnedTabContainerView::IsOlderTabView(const views::View* view) const {
+  return has_older_tabs_ &&
+         tabs::OlderTabsController::IsOlder(ContentsForView(view));
+}
+std::vector<views::View*> UnpinnedTabContainerView::OlderViewsInDateOrder()
+    const {
+  std::vector<views::View*> result;
+  if (collection_node_) {
+    for (auto* child : collection_node_->GetDirectChildren()) {
+      if (tabs::OlderTabsController::IsOlder(ContentsForView(child))) {
+        result.push_back(child);
+      }
+    }
+  }
+  std::sort(result.begin(), result.end(), [](auto* a, auto* b) {
+    return tabs::OlderTabsController::ComesBefore(ContentsForView(a),
+                                                  ContentsForView(b));
+  });
+  return result;
+}
+void UnpinnedTabContainerView::OnThemeChanged() {
+  TabCollectionZOrderManager::OnThemeChanged();
+  UpdateOlderTabs();
+}
+bool UnpinnedTabContainerView::CanReorderDraggedTabsAt(
+    const gfx::Point& point) const {
+  // Older is a chronological list, never an arbitrary insertion destination.
+  return !has_older_tabs_ || !older_header_ || point.y() < older_header_->y();
+}
+bool UnpinnedTabContainerView::OlderTabsCollapsed() const {
+  if (!collection_node_) {
+    return false;
+  }
+  auto* model =
+      collection_node_->GetController()->GetDragHandler().GetTabStripModel();
+  return model->profile()->GetPrefs()->GetBoolean(tabs::kOlderTabsCollapsed);
+}
+views::View* UnpinnedTabContainerView::older_header() const {
+  return older_header_;
+}
+views::View* UnpinnedTabContainerView::OlderDateHeading(
+    const views::View* view) const {
+  auto it = older_date_headings_.find(view);
+  return it != older_date_headings_.end() ? it->second.get() : nullptr;
+}
+void UnpinnedTabContainerView::ToggleOlderTabs() {
+  if (!collection_node_) {
+    return;
+  }
+  auto* prefs = collection_node_->GetController()
+                    ->GetDragHandler()
+                    .GetTabStripModel()
+                    ->profile()
+                    ->GetPrefs();
+  prefs->SetBoolean(tabs::kOlderTabsCollapsed, !OlderTabsCollapsed());
+  UpdateOlderTabs();
+}
+void UnpinnedTabContainerView::ExecuteOlderTabsMenuCommand(int command) {
+  if (!collection_node_) {
+    return;
+  }
+  auto* model =
+      collection_node_->GetController()->GetDragHandler().GetTabStripModel();
+  switch (command) {
+    case kCloseAllOlder:
+      model->older_tabs_controller()->CloseAll();
+      return;
+    case kKeepAllOlder:
+      model->older_tabs_controller()->KeepAll();
+      return;
+    case kOlderSettings:
+      chrome::ShowSettingsSubPage(
+          model->delegate()->GetBrowserWindowInterface(),
+          chrome::kAppearanceSubPage);
+      return;
+  }
+}
+void UnpinnedTabContainerView::UpdateOlderTabs() {
+  if (!collection_node_ || !older_header_) {
+    return;
+  }
+  auto* model =
+      collection_node_->GetController()->GetDragHandler().GetTabStripModel();
+  const bool enabled = model->older_tabs_controller()->IsEnabled();
+  const bool narrow = GetTabStripCollapseState() !=
+                      tabs::VerticalTabStripCollapseState::kExpanded;
+  const auto older =
+      enabled ? OlderViewsInDateOrder() : std::vector<views::View*>();
+  has_older_tabs_ = !older.empty();
+  older_date_headings_.clear();
+  std::set<int> used_days;
+  const auto now = base::Time::Now();
+  for (auto* child : older) {
+    const auto frozen =
+        tabs::OlderTabsController::FrozenLastUse(ContentsForView(child));
+    const int days = CivilDaysBetween(now, frozen);
+    if (narrow || days < 2) {
+      continue;
+    }
+    // The final Older bucket combines every date more than a week ago.
+    const int key =
+        days > 7 ? -1 : CivilDaysBetween(frozen, base::Time::UnixEpoch());
+    if (!used_days.insert(key).second) {
+      continue;
+    }
+    auto& label = older_day_labels_[key];
+    if (!label) {
+      label = AddChildView(std::make_unique<views::Label>());
+      label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      label->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+      label->SetAutoColorReadabilityEnabled(false);
+      label->SetFontList(label->font_list().DeriveWithSizeDelta(-3));
+      // Trim two pixels from each edge without recentering the text.
+      label->SetVerticalAlignment(gfx::ALIGN_TOP);
+      label->SetBorder(views::CreateEmptyBorder(gfx::Insets().set_top(
+          std::max(0, (20 - label->font_list().GetHeight()) / 2 - 3))));
+      label->SetCanProcessEventsWithinSubtree(false);
+      label->GetViewAccessibility().SetRole(ax::mojom::Role::kHeading);
+    }
+    if (GetColorProvider()) {
+      const auto secondary =
+          GetColorProvider()->GetColor(ui::kColorLabelForegroundSecondary);
+      const auto color =
+          helium::NativeGlassColor(
+              label, helium::NativeGlassColorRole::kSidebarSection)
+              .value_or(SkColorSetA(secondary, SkColorGetA(secondary) * 0.65f));
+      label->SetEnabledColor(SkColorSetA(color, SkColorGetA(color) * 0.85f));
+    }
+    const auto name = OlderDate(frozen, days);
+    label->SetText(base::i18n::ToUpper(name));
+    label->GetViewAccessibility().SetName(name);
+    older_date_headings_[child] = label;
+  }
+  for (auto it = older_day_labels_.begin(); it != older_day_labels_.end();) {
+    if (!used_days.contains(it->first)) {
+      RemoveChildViewT(it->second.get());
+      it = older_day_labels_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  // Stable views participate in the same animation as tab rows. Recreating
+  // headings on every insertion made their animation start at another point.
+  size_t index = 0;
+  for (auto* child : collection_node_->GetDirectChildren()) {
+    if (!enabled ||
+        !tabs::OlderTabsController::IsOlder(ContentsForView(child))) {
+      ReorderChildView(child, index++);
+    }
+  }
+  ReorderChildView(older_header_, index++);
+  for (auto* child : older) {
+    if (auto* heading = OlderDateHeading(child)) {
+      ReorderChildView(heading, index++);
+    }
+    ReorderChildView(child, index++);
+  }
+  InvalidateZOrder();
+  older_header_->SetVisible(has_older_tabs_);
+  older_header_->SetText(narrow ? std::u16string()
+                                : l10n_util::GetStringUTF16(IDS_OLDER_TABS));
+  older_header_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_OLDER_TABS));
+  static_cast<OlderTabsHeaderButton*>(older_header_.get())
+      ->SetCollapsed(OlderTabsCollapsed());
+  if (OlderTabsCollapsed()) {
+    older_header_->GetViewAccessibility().SetIsCollapsed();
+  } else {
+    older_header_->GetViewAccessibility().SetIsExpanded();
+  }
+  InvalidateLayout();
+}
