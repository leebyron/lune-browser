+inline constexpr int kDefaultOlderTabsMoveHours = 24;
+inline constexpr int kDefaultOlderTabsCloseHours = 72;
+inline constexpr char kOlderTabsMoveHours[] = "helium.tabs.cleanup_move_hours";
+inline constexpr char kOlderTabsCloseHours[] =
+    "helium.tabs.cleanup_close_hours";
+inline constexpr char kOlderTabsMoveGrouped[] =
+    "helium.tabs.cleanup_move_grouped";
+inline constexpr char kOlderTabsCollapsed[] = "helium.tabs.older_collapsed";
+inline constexpr char kOlderTabsSessionKey[] = "helium.older_tabs.v1";
+
+// Owns lifecycle independently of the sidebar view. Older tabs form a trailing
+// model segment; a separate persisted ordering key retains their former stack
+// positions. The existing model remains authoritative for selection and DnD.
+class OlderTabsController : public TabStripModelObserver,
+                            public base::PowerSuspendObserver {
+ public:
+  explicit OlderTabsController(TabStripModel* model);
+  ~OlderTabsController() override;
+
+  static bool IsOlder(const content::WebContents* contents);
+  static bool ComesBefore(const content::WebContents* a,
+                          const content::WebContents* b);
+  static bool IsDraggingToRegular(const content::WebContents* contents);
+  static base::Time FrozenLastUse(const content::WebContents* contents);
+  static std::string Serialize(const content::WebContents* contents);
+  static void Restore(content::WebContents* contents,
+                      const std::string& data,
+                      bool from_session_restore);
+
+  bool IsEnabled() const;
+  int FirstOlderIndex() const;
+  void Keep(content::WebContents* contents);
+  void KeepAll();
+  void CloseAll();
+  void Interact(content::WebContents* contents);
+  void SetDragDestination(content::WebContents* contents, bool regular);
+  void FinishDrag(const std::vector<content::WebContents*>& contents,
+                  bool completed);
+  void Reconcile();
+  void OnResume() override;
+  base::CallbackListSubscription RegisterChanged(
+      base::RepeatingClosure callback);
+
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  void ScheduleReconcile();
+  void OnSettingsChanged();
+  void AssignOrder(content::WebContents* contents);
+  void NormalizeOrderKeys();
+  void NormalizeModelOrder();
+  bool IsProtected(int index, bool closing) const;
+  void Save(content::WebContents* contents);
+
+  const raw_ptr<TabStripModel> model_;
+  PrefChangeRegistrar pref_registrar_;
+  std::unique_ptr<OlderTabsGroupReadiness> group_readiness_;
+  base::RepeatingTimer timer_;
+  base::TimeTicks close_not_before_;
+  bool mutating_ = false;
+  bool observing_change_ = false;
+  bool reconcile_pending_ = false;
+  base::RepeatingClosureList changed_;
+  base::WeakPtrFactory<OlderTabsController> weak_factory_{this};
+};
