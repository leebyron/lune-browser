+void VideoOverlayWindowViews::OnMacPointerActivity(bool moved) {
+  if (!has_been_shown_ || IsClosed() || !IsVisible() || IsMinimized()) {
+    return;
+  }
+  if (moved) {
+    ResetMacPointerIdle();
+  } else if (pointer_idle_) {
+    // A stationary click keeps its existing hit target.
+    return;
+  }
+  UpdateControlsForCursor();
+  UpdateMacPointerIdleTimer();
+}
+
+bool VideoOverlayWindowViews::CanTimeOutMacControls() const {
+  return has_been_shown_ && !IsClosed() && IsVisible() && !IsMinimized() &&
+         !pointer_idle_ && !keyboard_controls_visible_ && !is_live_resizing_ &&
+         !force_controls_visible_.has_value() && !IsOverlayViewShown() &&
+         (!live_caption_dialog_ || !live_caption_dialog_->GetVisible()) &&
+         progress_view_drag_state_ ==
+             global_media_controls::DragState::kDragEnded &&
+         (header_hovered_ || footer_hovered_);
+}
+
+void VideoOverlayWindowViews::UpdateMacPointerIdleTimer() {
+  if (CanTimeOutMacControls()) {
+    hide_controls_timer_.Reset();
+  } else {
+    hide_controls_timer_.Stop();
+  }
+}
+
+void VideoOverlayWindowViews::OnMacPointerIdleTimeout() {
+  if (!CanTimeOutMacControls()) {
+    return;
+  }
+  if (IsMouseButtonDown()) {
+    hide_controls_timer_.Reset();
+    return;
+  }
+  pointer_idle_ = true;
+  UpdateControlsVisibility(false);
+  static_cast<VideoOverlayWindowNativeWidgetMac*>(native_widget())
+      ->SetIdleCursorHidden(true);
+}
+
+void VideoOverlayWindowViews::ResetMacPointerIdle() {
+  pointer_idle_ = false;
+  keyboard_controls_visible_ = false;
+  hide_controls_timer_.Stop();
+  if (auto* mac_widget =
+          static_cast<VideoOverlayWindowNativeWidgetMac*>(native_widget())) {
+    mac_widget->SetIdleCursorHidden(false);
   }
 }
 
