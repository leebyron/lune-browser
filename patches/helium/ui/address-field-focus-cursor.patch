--- a/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
+++ b/chrome/browser/ui/views/frame/browser_frame_view_mac.mm
@@ -1312,6 +1312,22 @@
 @synthesize focusSurface = _focusSurface;
 @synthesize userEditing = _userEditing;
 @synthesize onInitialFocus = _onInitialFocus;
+- (void)setUserEditing:(BOOL)userEditing {
+  if (_userEditing == userEditing) {
+    return;
+  }
+  _userEditing = userEditing;
+  [self discardCursorRects];
+  [self.window invalidateCursorRectsForView:self];
+}
+- (void)resetCursorRects {
+  if (self.userEditing) {
+    // AppKit owns cursor handling while its native field editor is installed.
+    [super resetCursorRects];
+    return;
+  }
+  [self addCursorRect:self.bounds cursor:NSCursor.arrowCursor];
+}
 - (BOOL)acceptsFirstResponder {
   // Keep automatic window activation from silently starting URL editing.
   return self.userEditing;
