+namespace {
+
+constexpr char kManualPipAutoOffersShown[] = "profile.manual_pip_auto_offers_shown";
+
+}  // namespace
+
+// static
+void AutoPipSettingHelper::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kManualPipAutoOffersShown);
+}
+
+std::unique_ptr<AutoPipSettingOverlayView>
+AutoPipSettingHelper::CreateManualVideoOfferIfNeeded(
+    views::View* anchor_view,
+    views::BubbleBorder::Arrow arrow) {
+  auto* profile =
+      Profile::FromBrowserContext(web_contents_->GetBrowserContext());
+  if (!profile->IsRegularProfile() || !origin_.SchemeIsHTTPOrHTTPS() ||
+      GetEffectiveContentSetting() != CONTENT_SETTING_ASK) {
+    return nullptr;
+  }
+
+  const std::string origin_key = url::Origin::Create(origin_).Serialize();
+  PrefService* prefs = profile->GetPrefs();
+  if (prefs->GetDict(kManualPipAutoOffersShown).contains(origin_key)) {
+    return nullptr;
+  }
+
+  {
+    ScopedDictPrefUpdate shown(prefs, kManualPipAutoOffersShown);
+    shown->Set(origin_key, true);
+  }
+  ui_was_shown_but_not_acknowledged_ = false;
+
+  return std::make_unique<AutoPipSettingOverlayView>(
+      base::BindOnce(
+          [](base::WeakPtr<AutoPipSettingHelper> helper,
+             AutoPipSettingView::UiResult result) {
+            if (helper &&
+                result == AutoPipSettingView::UiResult::kAllowOnEveryVisit &&
+                helper->GetEffectiveContentSetting() == CONTENT_SETTING_ASK) {
+              helper->UpdateContentSetting(CONTENT_SETTING_ALLOW);
+            }
+          },
+          weak_factory_.GetWeakPtr()),
+      origin_, anchor_view, arrow, /*is_manual_offer=*/true);
+}
+#endif  // BUILDFLAG(IS_MAC)
+
