+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/tab/tab_close_button.h"
+
+#import <AppKit/AppKit.h>
+
+#include "ui/gfx/image/image_skia_operations.h"
+#include "ui/gfx/image/image_skia_util_mac.h"
+
+ui::ImageModel TabCloseButton::GetSidebarIcon() const {
+  // Keep the symbol's weight close to the 16 pt New Tab plus, independently of
+  // the larger button target. AppKit supplies the native xmark geometry.
+  NSImage* symbol = [NSImage imageWithSystemSymbolName:@"xmark"
+                              accessibilityDescription:nil];
+  symbol = [symbol imageWithSymbolConfiguration:
+                       [NSImageSymbolConfiguration
+                           configurationWithPointSize:12
+                                               weight:NSFontWeightMedium]];
+  NSImage* image = [NSImage
+       imageWithSize:NSMakeSize(16, 16)
+             flipped:NO
+      drawingHandler:^BOOL(NSRect bounds) {
+        const NSSize size = symbol.size;
+        [symbol drawInRect:NSMakeRect((NSWidth(bounds) - size.width) / 2,
+                                      (NSHeight(bounds) - size.height) / 2,
+                                      size.width, size.height)];
+        return YES;
+      }];
+  return ui::ImageModel::FromImageSkia(
+      gfx::ImageSkiaOperations::CreateColorMask(
+          gfx::ImageSkiaFromNSImage(image), colors_.foreground_color));
+}
