+    } else if (child->GetVisible()) {
+      new_tab_button_container_->InsertBeforeInFocusList(child);
+      return;
+    }
+  }
+  if (last_pinned_group) {
+    new_tab_button_container_->InsertAfterInFocusList(last_pinned_group);
+  }
