+TEST(SessionServiceCommandsTest, LegacyGroupMetadataDefaultsToUnpinned) {
+  const auto window = SessionID::NewUnique();
+  const auto tab = SessionID::NewUnique();
+  const auto group = tab_groups::TabGroupId::GenerateNew();
+  auto commands = BuildRestorableSession(window, tab);
+  commands.push_back(CreateTabGroupCommand(tab, group));
+  tab_groups::TabGroupVisualData data(u"Legacy",
+                                      tab_groups::TabGroupColorId::kGrey);
+  auto modern = CreateTabGroupMetadataUpdateCommand(group, &data, std::nullopt);
+  // Construct the old on-disk format, with no trailing pin-state field.
+  base::Pickle legacy;
+  base::WriteTokenToPickle(&legacy, group.token());
+  legacy.WriteString16(data.title());
+  legacy.WriteUInt32(static_cast<uint32_t>(data.color()));
+  legacy.WriteBool(data.is_collapsed());
+  legacy.WriteBool(false);  // Not a saved group.
+  commands.push_back(std::make_unique<SessionCommand>(modern->id(), legacy));
+  std::vector<std::unique_ptr<SessionWindow>> windows;
+  EXPECT_EQ(SessionReplayResult::kSuccess, ReplayCommands(commands, &windows));
+  ASSERT_EQ(1u, windows.size());
+  ASSERT_EQ(1u, windows[0]->tab_groups.size());
+  EXPECT_FALSE(windows[0]->tab_groups[0]->visual_data.is_pinned());
+}
