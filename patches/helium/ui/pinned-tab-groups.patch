+  }
+  // Keep keyboard traversal at the same boundary as the visible New Tab row.
+  views::View* last_pinned_group = nullptr;
+  for (auto* child : collection_node_->GetDirectChildren()) {
+    if (IsPinnedGroupView(child)) {
