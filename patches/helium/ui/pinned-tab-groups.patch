+    tab_groups::TabGroupVisualData data(
+        u"Projects", tab_groups::TabGroupColorId::kBlue, true);
+    data.SetIsPinned(pinned);
+    commands.push_back(
+        CreateTabGroupMetadataUpdateCommand(group, &data, std::nullopt));
+    std::vector<std::unique_ptr<SessionWindow>> windows;
+    EXPECT_EQ(SessionReplayResult::kSuccess,
+              ReplayCommands(commands, &windows));
+    ASSERT_EQ(1u, windows.size());
+    ASSERT_EQ(1u, windows[0]->tab_groups.size());
+    EXPECT_EQ(data, windows[0]->tab_groups[0]->visual_data);
+  }
