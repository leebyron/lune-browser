+bool TabStripModel::IsTabGroupPinned(
+    const tab_groups::TabGroupId& group) const {
+  return group_model_ && group_model_->ContainsTabGroup(group) &&
+         group_model_->GetTabGroup(group)->visual_data()->is_pinned();
+}
+
+int TabStripModel::IndexOfFirstRegularTab() const {
+  int index = IndexOfFirstNonPinnedTab();
+  while (index < count()) {
+    const auto group = GetTabGroupForTab(index);
+    if (!group || !IsTabGroupPinned(*group)) {
+      break;
+    }
+    index = group_model_->GetTabGroup(*group)->ListTabs().end();
+  }
+  return index;
+}
+
+void TabStripModel::SetTabGroupPinned(const tab_groups::TabGroupId& group,
+                                      bool pinned) {
+  if (!group_model_ || !group_model_->ContainsTabGroup(group) ||
+      IsTabGroupPinned(group) == pinned) {
+    return;
+  }
+  auto* tab_group = group_model_->GetTabGroup(group);
+  const auto range = tab_group->ListTabs();
+  if (range.is_empty()) {
+    return;
+  }
+  // Place newly pinned groups last in their section; unpin to the top of the
+  // regular section. MoveGroupTo uses the destination after removing the group.
+  int target = IndexOfFirstRegularTab();
+  if (static_cast<int>(range.start()) < target) {
+    target -= range.length();
+  }
+  MoveGroupTo(group, target);
+  ChangeTabGroupVisuals(group, *tab_group->visual_data(), false, pinned);
+}
