+
+bool UnpinnedTabContainerView::IsPointInPinnedGroupArea(
+    const gfx::Point& point) const {
+  if (orientation_ != TabStripOrientation::kVertical || !collection_node_) {
+    return false;
+  }
+  if (pinned_groups_separator_ && pinned_groups_separator_->GetVisible()) {
+    int boundary = pinned_groups_separator_->bounds().bottom();
+    const auto* model =
+        collection_node_->GetController()->GetDragHandler().GetTabStripModel();
+    if (model->IndexOfFirstRegularTab() == model->IndexOfFirstNonPinnedTab()) {
+      // Empty sections use the existing clearance, not a placeholder row.
+      boundary += 8;
+    }
+    return point.y() < boundary;
+  }
+  if (new_tab_button_container_ && new_tab_button_container_->GetVisible()) {
+    return point.y() < new_tab_button_container_->bounds().CenterPoint().y();
+  }
+  // Without New Tab or pinned items the top position always reorders. When a
+  // pinned-tile grid exists, its existing lower gap can accept a first group.
+  return point.y() < 0 && collection_node_->GetController()
+                                  ->GetDragHandler()
+                                  .GetTabStripModel()
+                                  ->IndexOfFirstNonPinnedTab() > 0;
+}
