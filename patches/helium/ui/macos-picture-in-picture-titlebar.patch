+  const CGFloat height = std::min(kOpenTabHeight, 2 * (center - 2));
+  const CGFloat right = NSWidth(self.bounds) - center + height / 2;
+  const bool showTitle = right - _openTabWidth >= lightsRight + 4;
+  const CGFloat width = showTitle ? _openTabWidth : height;
+  _openTabButton.title = showTitle ? _openTabTitle : @"";
+  _openTabButton.imagePosition = showTitle ? NSImageLeft : NSImageOnly;
+  _material.frame = NSMakeRect(right - width, center - height / 2, width, height);
+  if (@available(macOS 26, *)) {
+    ((NSGlassEffectView*)_material).cornerRadius = height / 2;
+  } else {
+    _material.layer.cornerRadius = height / 2;
+  }
