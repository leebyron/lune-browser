+}
+
+- (void)layout {
+  [super layout];
+  NSWindow* window = self.window;
+  NSView* frameView = window.contentView.superview;
+  NSButton* standardClose = [window standardWindowButton:NSWindowCloseButton];
+  const NSRect closeFrame =
+      [self convertRect:standardClose.frame fromView:standardClose.superview];
+  const CGFloat standardCenter =
+      std::max(NSMidY(closeFrame), kOpenTabHeight / 2 + 4);
+  const CGFloat radius = [frameView respondsToSelector:@selector(_cornerRadius)]
+                             ? frameView._cornerRadius
+                             : standardCenter;
+  const CGFloat center = radius > 0 ? radius : standardCenter;
+  window.contentView.layer.cornerRadius = radius;
+  window.contentView.layer.masksToBounds = YES;
+
+  CGFloat lightsRight = 0;
+  for (NSUInteger i = 0; i < _lights.count; ++i) {
+    NSButton* standardButton = [window standardWindowButton:kWindowButtons[i]];
+    const CGFloat offset =
+        std::abs(NSMidX(standardButton.frame) - NSMidX(standardClose.frame));
+    standardButton.hidden = YES;
+    NSButton* button = _lights[i];
+    NSRect frame = button.frame;
+    frame.origin = NSMakePoint(center + offset - NSWidth(frame) / 2,
+                              center - NSHeight(frame) / 2);
+    button.frame = frame;
+    lightsRight = std::max(lightsRight, NSMaxX(frame));
+  }
