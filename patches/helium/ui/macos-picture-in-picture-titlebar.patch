+                                     image:[image imageWithSymbolConfiguration:configuration]
+                                    target:self
+                                    action:@selector(openSourceTab:)];
+  _openTabButton.bordered = NO;
+  _openTabButton.font = [NSFont systemFontOfSize:11 weight:NSFontWeightMedium];
+  _openTabButton.imagePosition = NSImageLeft;
+  _openTabButton.contentTintColor = NSColor.whiteColor;
+  _openTabButton.toolTip = accessibilityTitle;
+  _openTabButton.accessibilityLabel = _openTabTitle;
