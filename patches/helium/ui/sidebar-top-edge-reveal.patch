 inline constexpr int kNativeTopChromeRetentionDistance = 64;
 inline constexpr int kNativeSideChromeRevealDistance = 16;
 inline constexpr int kNativeSideChromeRetentionDistance = 128;
+inline constexpr int kNativeToolbarControlHeight = 36;
+inline constexpr int kNativeToolbarVerticalPadding = 8;
+
+inline constexpr bool IsWithinNativeTopChromeRetention(int y,
+                                                      int chrome_bottom) {
+  return y <= chrome_bottom + kNativeTopChromeRetentionDistance;
+}
+
+inline constexpr bool IsInNativeSidebarTopHoverColumn(int x,
+                                                     int width,
+                                                     bool right_aligned) {
+  constexpr int kSidebarTopRevealWidth = 112;
+  return right_aligned ? x >= width - kSidebarTopRevealWidth
+                       : x < kSidebarTopRevealWidth;
+}
 
