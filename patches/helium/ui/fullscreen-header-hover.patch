+bool IsPointerAboveNativeFullscreenContent(const BrowserView* view) {
+  if (!view || !view->GetWidget() || !view->IsFullscreen() ||
+      fullscreen_utils::IsInContentFullscreen(view->browser())) {
+    return false;
+  }
+  NSWindow* window = view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSScreen* screen = window.screen;
+  NSView* content = window.contentView;
+  if (!screen || !content) {
+    return false;
+  }
+  const NSRect content_bounds = [window convertRectToScreen:
+      [content convertRect:content.bounds toView:nil]];
+  const NSPoint pointer = NSEvent.mouseLocation;
+  // AppKit can place the entire content window below the menu bar or camera
+  // safe area. Use that live boundary, independent of menu-bar preferences,
+  // screen origin, backing scale or which display owns the fullscreen space.
+  return pointer.x >= NSMinX(content_bounds) &&
+         pointer.x < NSMaxX(content_bounds) &&
+         pointer.x >= NSMinX(screen.frame) &&
+         pointer.x < NSMaxX(screen.frame) &&
+         pointer.y >= NSMaxY(content_bounds) &&
+         pointer.y <= NSMaxY(screen.frame);
+}
