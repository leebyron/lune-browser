+TEST_F(VideoOverlayWindowViewsTest, ScrubberCanBeGrabbedPastTrackEndpoints) {
+  constexpr base::TimeDelta duration = base::Seconds(100);
+  overlay_window().UpdateNaturalSize({640, 480});
+  overlay_window().ShowInactive();
+  overlay_window().ForceControlsVisibleForTesting(true);
+  overlay_window().SetMediaPosition(media_session::MediaPosition(
+      /*playback_rate=*/0, duration, base::Seconds(42),
+      /*end_of_media=*/false));
+
+  auto* progress = overlay_window().progress_view_for_testing();
+  const gfx::Rect track = progress->GetTrackBounds();
+  ASSERT_FALSE(track.IsEmpty());
+  auto click = [&](int x) {
+    const gfx::Point point(x, track.CenterPoint().y());
+    const ui::MouseEvent press(
+        ui::EventType::kMousePressed, point, point, ui::EventTimeForNow(),
+        ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+    ASSERT_TRUE(progress->OnMousePressed(press));
+    const ui::MouseEvent release(
+        ui::EventType::kMouseReleased, point, point, ui::EventTimeForNow(),
+        ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+    progress->OnMouseReleased(release);
+  };
+
+  EXPECT_CALL(pip_window_controller(), SeekTo(base::TimeDelta()));
+  click(track.x() - 5);
+  EXPECT_CALL(pip_window_controller(), SeekTo(duration));
+  click(track.right() + 5);
+}
