+// Read the owning browser's resolved toolbar color, so selected accents,
+// extension themes, incognito, and Light/Dark/Device retain their precedence.
+// AppKit applies the tint; this adds no overlays or backdrop sampling.
+NSColor* FloatingChromeTintColor(BrowserView* view) {
+  const SkColor color = view->GetColorProvider()->GetColor(kColorToolbar);
+  return [NSColor colorWithSRGBRed:SkColorGetR(color) / 255.0
+                            green:SkColorGetG(color) / 255.0
+                             blue:SkColorGetB(color) / 255.0
+                            alpha:.12];
+}
