+void VerticalNewTabButton::OnPaintBackground(gfx::Canvas* canvas) {
+  if (GetState() != STATE_HOVERED && GetState() != STATE_PRESSED) {
+    return;
+  }
+  const bool active = !GetWidget() || GetWidget()->ShouldPaintAsActive();
+  const auto native_color =
+      helium::NativeGlassColor(this, helium::NativeGlassColorRole::kHover);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(native_color.value_or(GetColorProvider()->GetColor(
+      active ? kColorTabBackgroundInactiveHoverFrameActive
+             : kColorTabBackgroundInactiveHoverFrameInactive)));
+  canvas->DrawRoundRect(
+      gfx::RectF(GetLocalBounds()),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+}
+
+void VerticalNewTabButton::OnThemeChanged() {
+  shared::NewTabButton::OnThemeChanged();
+  UpdateTabForeground();
+}
+
+void VerticalNewTabButton::StateChanged(ButtonState old_state) {
+  shared::NewTabButton::StateChanged(old_state);
+  UpdateTabForeground();
+}
+
+void VerticalNewTabButton::UpdateTabForeground() {
+  const bool active = !GetWidget() || GetWidget()->ShouldPaintAsActive();
+  const bool hovered =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  SetForegroundColorId(
+      hovered ? (active ? kColorTabForegroundInactiveHoverFrameActive
+                        : kColorTabForegroundInactiveHoverFrameInactive)
+              : (active ? kColorTabForegroundInactiveFrameActive
+                        : kColorTabForegroundInactiveFrameInactive));
+}
