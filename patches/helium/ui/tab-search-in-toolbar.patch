+constexpr base::TimeDelta kHideTabSearchButtonDelay = base::Seconds(2);
+
+}  // namespace
+
+DEFINE_USER_DATA(TabSearchToolbarButtonController);
+
+// static
+TabSearchToolbarButtonController* TabSearchToolbarButtonController::From(
+    BrowserWindowInterface* browser_window) {
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+TabSearchToolbarButtonController::TabSearchToolbarButtonController(
+    BrowserWindowInterface* browser_window,
+    BrowserView* browser_view)
+    : browser_view_(browser_view),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  browser_view_->UpdateTabSearchBubbleHost();
+}
+
+TabSearchToolbarButtonController::~TabSearchToolbarButtonController() = default;
+
+void TabSearchToolbarButtonController::PrepareToShowBubble() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+
+  PinnedToolbarActions* const pinned_actions = GetPinnedToolbarActions();
+  if (pinned_actions && !pinned_actions->IsActionPinned(kActionTabSearch)) {
+    pinned_actions->ShowActionEphemerallyInToolbar(kActionTabSearch, true);
+  }
+}
+
+void TabSearchToolbarButtonController::UpdateBubbleHost(
+    TabSearchBubbleHost* bubble_host) {
+  tab_search_bubble_host_observation_.Reset();
+  if (bubble_host) {
+    tab_search_bubble_host_observation_.Observe(bubble_host);
+  }
+}
+
+void TabSearchToolbarButtonController::OnBubbleInitializing() {
+  actions::ActionItem* const action_item = GetTabSearchActionItem();
+  CHECK(action_item);
+  action_item->SetIsShowingBubble(true);
+
+  PrepareToShowBubble();
+}
+
+void TabSearchToolbarButtonController::OnBubbleDestroying() {
+  actions::ActionItem* const action_item = GetTabSearchActionItem();
+  CHECK(action_item);
+  action_item->SetIsShowingBubble(false);
+
+  PinnedToolbarActions* const pinned_actions = GetPinnedToolbarActions();
+  if (!pinned_actions || pinned_actions->IsActionPinned(kActionTabSearch)) {
+    return;
+  }
+
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TabSearchToolbarButtonController::
+                         MaybeHideActionEphemerallyInToolbar,
+                     weak_ptr_factory_.GetWeakPtr()),
+      kHideTabSearchButtonDelay);
+}
+
+void TabSearchToolbarButtonController::OnHostDestroying() {
+  UpdateBubbleHost(nullptr);
+}
+
+actions::ActionItem*
+TabSearchToolbarButtonController::GetTabSearchActionItem() {
+  return actions::ActionManager::Get().FindAction(
+      kActionTabSearch,
+      BrowserActions::From(browser_view_->browser())->root_action_item());
+}
+
+PinnedToolbarActions*
+TabSearchToolbarButtonController::GetPinnedToolbarActions() {
+  ToolbarButtonProvider* const provider =
+      browser_view_->toolbar_button_provider();
+  return provider ? provider->GetPinnedToolbarActions() : nullptr;
+}
+
+void TabSearchToolbarButtonController::MaybeHideActionEphemerallyInToolbar() {
+  actions::ActionItem* const action_item = GetTabSearchActionItem();
+  PinnedToolbarActions* const pinned_actions = GetPinnedToolbarActions();
+  if (!action_item || !pinned_actions || action_item->GetIsShowingBubble() ||
+      pinned_actions->IsActionPinned(kActionTabSearch)) {
+    return;
+  }
+
+  pinned_actions->ShowActionEphemerallyInToolbar(kActionTabSearch, false);
+}
