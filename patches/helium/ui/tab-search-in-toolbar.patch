+
+  TabSearchToolbarButtonController(BrowserWindowInterface* browser_window,
+                                   BrowserView* browser_view);
+  ~TabSearchToolbarButtonController() override;
+
+  TabSearchToolbarButtonController(
+      const TabSearchToolbarButtonController&) = delete;
+  TabSearchToolbarButtonController& operator=(
+      const TabSearchToolbarButtonController&) = delete;
+
+  void PrepareToShowBubble();
+  void UpdateBubbleHost(TabSearchBubbleHost* bubble_host);
