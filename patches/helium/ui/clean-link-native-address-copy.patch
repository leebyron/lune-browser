+    if (NSString* cleaned = self.cleanAddressForCopy(text)) {
+      ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+      writer.WriteText(base::SysNSStringToUTF16(cleaned));
+      return;
+    }
+  }
+  [super copy:sender];
+}
