+// The field editor receives Copy from AppKit's responder chain.
+@interface HeliumAddressFieldEditor : NSTextView
+@property(nonatomic, copy) NSString* (^cleanAddressForCopy)(NSString*);
+@end
+
+@implementation HeliumAddressFieldEditor
+@synthesize cleanAddressForCopy = _cleanAddressForCopy;
+- (void)copy:(id)sender {
+  NSString* text = self.string;
+  if (self.cleanAddressForCopy &&
