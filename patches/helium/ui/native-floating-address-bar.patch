+// A plain outer NSView keeps the native surface in the NativeViewHost's z-order
+// above web content. The actual controls belong to
+// NSGlassEffectView.contentView.
+@interface HeliumFloatingAddressBar : NSView
+- (instancetype)initWithBrowserView:(BrowserView*)browserView;
+- (void)refresh;
+@end
+
+@implementation HeliumFloatingAddressBar {
+  base::WeakPtr<BrowserView> _browserView;
+  NSView* _material;
+  NSView* _controls;
+  NSButton* _address;
+  NSButton* _siteInfo;
+  NSButton* _reload;
+}
+
+- (instancetype)initWithBrowserView:(BrowserView*)browserView {
+  self = [super initWithFrame:NSMakeRect(0, 0, 480, 36)];
+  if (!self) {
+    return nil;
+  }
+  _browserView = browserView->GetAsWeakPtr();
+  _controls = [[NSView alloc] initWithFrame:self.bounds];
+  _controls.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  if (@available(macOS 26, *)) {
+    NSGlassEffectView* glass =
+        [[NSGlassEffectView alloc] initWithFrame:self.bounds];
+    glass.style = NSGlassEffectViewStyleRegular;
+    glass.cornerRadius = 18;
+    glass.contentView = _controls;
+    if (@available(macOS 27, *)) {
+      glass.effectIsInteractive = YES;
+    }
+    _material = glass;
+  } else {
+    NSVisualEffectView* material =
+        [[NSVisualEffectView alloc] initWithFrame:self.bounds];
+    material.material = NSVisualEffectMaterialPopover;
+    material.blendingMode = NSVisualEffectBlendingModeWithinWindow;
+    material.state = NSVisualEffectStateFollowsWindowActiveState;
+    material.wantsLayer = YES;
+    material.layer.cornerRadius = 18;
+    material.layer.masksToBounds = YES;
+    [material addSubview:_controls];
+    _material = material;
+  }
+  _material.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [self addSubview:_material];
+
+  _siteInfo = [NSButton
+      buttonWithImage:[NSImage imageWithSystemSymbolName:@"slider.horizontal.3"
+                                accessibilityDescription:nil]
+               target:self
+               action:@selector(showSiteInfo:)];
+  _siteInfo.bordered = NO;
+  _siteInfo.frame = NSMakeRect(4, 2, 32, 32);
+  _siteInfo.toolTip = base::SysUTF16ToNSString(
+      l10n_util::GetStringUTF16(IDS_TOOLTIP_LOCATION_ICON));
+  _siteInfo.accessibilityLabel = _siteInfo.toolTip;
+  [_controls addSubview:_siteInfo];
+
+  _address = [NSButton buttonWithTitle:@""
+                                target:self
+                                action:@selector(editAddress:)];
+  _address.bordered = NO;
+  _address.font = [NSFont systemFontOfSize:13];
+  _address.frame = NSMakeRect(40, 2, 400, 32);
+  _address.autoresizingMask = NSViewWidthSizable;
+  _address.lineBreakMode = NSLineBreakByTruncatingTail;
+  [_controls addSubview:_address];
+
+  _reload = [NSButton
+      buttonWithImage:[NSImage imageWithSystemSymbolName:@"arrow.clockwise"
+                                accessibilityDescription:nil]
+               target:self
+               action:@selector(reload:)];
+  _reload.bordered = NO;
+  _reload.frame = NSMakeRect(444, 2, 32, 32);
+  _reload.autoresizingMask = NSViewMinXMargin;
+  [_controls addSubview:_reload];
+  return self;
+}
+
+- (void)refresh {
+  if (!_browserView) {
+    return;
+  }
+  const auto* model = LocationBarModel::From(_browserView->browser());
+  if (!model) {
+    return;
+  }
+  std::u16string display = model->GetURLForDisplay(false);
+  const auto security = model->GetSecureDisplayText();
+  if (!security.empty()) {
+    display = security + u" — " + display;
+  }
+  // Use the browser's formatter and security text; never imply a secure origin
+  // with a decorative padlock or use a document title in place of its address.
+  _address.title = base::SysUTF16ToNSString(
+      display.empty() ? l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION)
+                      : display);
+  _address.toolTip = base::SysUTF16ToNSString(model->GetFormattedFullURL());
+  _address.accessibilityLabel =
+      base::SysUTF16ToNSString(l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION));
+  _address.accessibilityValue = _address.toolTip;
+  _siteInfo.accessibilityHelp =
+      base::SysUTF16ToNSString(model->GetSecureAccessibilityText());
+  auto* contents = _browserView->GetActiveWebContents();
+  const bool loading = contents && contents->IsLoading();
+  _reload.image =
+      [NSImage imageWithSystemSymbolName:loading ? @"xmark" : @"arrow.clockwise"
+                accessibilityDescription:nil];
+  _reload.toolTip = base::SysUTF16ToNSString(l10n_util::GetStringUTF16(
+      loading ? IDS_TOOLTIP_STOP : IDS_TOOLTIP_RELOAD));
+  _reload.accessibilityLabel = _reload.toolTip;
+  // Honor the profile's appearance override before falling back to the OS.
+  const auto scheme =
+      ThemeServiceFactory::GetForProfile(_browserView->browser()->GetProfile())
+          ->GetBrowserColorScheme();
+  const bool dark = scheme == ThemeService::BrowserColorScheme::kDark ||
+                    (scheme == ThemeService::BrowserColorScheme::kSystem &&
+                     _browserView->GetNativeTheme()->preferred_color_scheme() ==
+                         ui::NativeTheme::PreferredColorScheme::kDark);
+  self.appearance = [NSAppearance
+      appearanceNamed:dark ? NSAppearanceNameDarkAqua : NSAppearanceNameAqua];
+}
+
+- (void)editAddress:(id)sender {
+  if (!_browserView) {
+    return;
+  }
+  auto* browser = _browserView->browser();
+  if (browser->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumCommandBarEnabled)) {
+    if (auto* controller = HeliumCommandBarController::From(browser)) {
+      controller->Show(
+          _browserView->GetWidget()->GetNativeView(),
+          base::UTF8ToUTF16(LocationBarModel::From(browser)->GetURL().spec()));
+      return;
+    }
+  }
+  _browserView->SetFocusToLocationBar(true);
+}
+
+- (void)showSiteInfo:(id)sender {
+  if (_browserView && _browserView->toolbar()->location_bar_view()) {
+    _browserView->toolbar()->location_bar_view()->ShowPageInfoDialog();
+  }
+}
+
+- (void)reload:(id)sender {
+  if (!_browserView) {
+    return;
+  }
+  auto* contents = _browserView->GetActiveWebContents();
+  if (contents && contents->IsLoading()) {
+    chrome::Stop(_browserView->browser());
+  } else {
+    chrome::Reload(_browserView->browser(), WindowOpenDisposition::kCurrentTab);
+  }
+}
+@end
 
