+bool BrowserFrameViewMac::HasFloatingAddressBar() const {
+  const auto* view = GetBrowserView();
+  return view->IsZenModeEnabledForLayout() &&
+         view->IsVerticalAddressBarInSidebar() &&
+         !view->IsZenModeTopChromePinned();
+}
+
+void BrowserFrameViewMac::UpdateFloatingAddressBar(bool cooldown_expired) {
+  auto* browser_view = GetBrowserView();
+  if (!GetWidget() || !browser_view->toolbar()) {
+    return;
+  }
+  auto* host =
+      static_cast<views::NativeViewHost*>(floating_address_host_.view());
+  auto* command_bar = HeliumCommandBarController::From(browser_view->browser());
+  const bool command_bar_open = command_bar && command_bar->IsShowing();
+  bool bubble_open = false;
+  for (const auto& child :
+       views::Widget::GetAllOwnedWidgets(GetWidget()->GetNativeView())) {
+    if (child != GetWidget() && child->IsVisible() && !child->IsClosed() &&
+        child->widget_delegate() &&
+        child->widget_delegate()->AsBubbleDialogDelegate()) {
+      bubble_open = true;
+      break;
+    }
+  }
+  if (!HasFloatingAddressBar() ||
+      (!GetWidget()->IsActive() && !command_bar_open && !bubble_open) ||
+      !NSApp.active) {
+    floating_address_hide_timer_->Stop();
+    floating_address_refresh_timer_->Stop();
+    if (host) {
+      host->SetVisible(false);
+    }
+    return;
+  }
 
+  // Content coordinates naturally account for either mounted sidebar edge.
+  gfx::Rect content = views::View::ConvertRectToTarget(
+      browser_view->contents_container()->parent(), browser_view,
+      browser_view->contents_container()->bounds());
+  const int capsule_width = std::min(480, content.width() - 192);
+  if (capsule_width < 160) {
+    floating_address_hide_timer_->Stop();
+    floating_address_refresh_timer_->Stop();
+    if (host) {
+      host->SetVisible(false);
+    }
+    return;
+  }
+  const gfx::Rect bounds(content.CenterPoint().x() - capsule_width / 2, 4,
+                         capsule_width, 36);
+  NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSView* native_view =
+      browser_view->GetWidget()->GetNativeView().GetNativeNSView();
+  NSPoint mouse =
+      [native_view convertPoint:window.mouseLocationOutsideOfEventStream
+                       fromView:nil];
+  if (!native_view.isFlipped) {
+    mouse.y = native_view.bounds.size.height - mouse.y;
+  }
+  gfx::Point cursor(base::ClampFloor(mouse.x), base::ClampFloor(mouse.y));
+  views::View::ConvertPointFromWidget(browser_view, &cursor);
+  const bool in_rail = cursor.y() >= 0 && cursor.y() < 8 &&
+                       cursor.x() >= content.x() &&
+                       cursor.x() < content.right();
+  gfx::Rect hover_bounds = bounds;
+  hover_bounds.set_y(0);
+  hover_bounds.set_height(bounds.bottom() + 4);
+  const bool in_capsule =
+      host && host->GetVisible() && hover_bounds.Contains(cursor);
+  const bool editing =
+      command_bar_open ||
+      (browser_view->toolbar()->location_bar_view() &&
+       browser_view->toolbar()->location_bar_view()->IsFocusWithin());
+
+  if (host && host->GetVisible()) {
+    host->SetBoundsRect(bounds);
+    [floating_address_bar_ refresh];
+  }
+  // Keyboard address editing reveals the same surface as pointer entry.
+  if (in_rail || in_capsule || editing ||
+      (host && host->GetVisible() && bubble_open)) {
+    floating_address_hide_timer_->Stop();
+    if (!host) {
+      auto owned_host = std::make_unique<views::NativeViewHost>();
+      host = browser_view->AddChildView(std::move(owned_host));
+      floating_address_host_.SetView(host);
+      floating_address_bar_ =
+          [[HeliumFloatingAddressBar alloc] initWithBrowserView:browser_view];
+      host->Attach(gfx::NativeView(floating_address_bar_));
+    }
+    host->SetBoundsRect(bounds);
+    [floating_address_bar_ refresh];
+    host->SetVisible(true);
+    // Recheck while visible so native menus/focus changes that do not generate
+    // a Views mouse event still begin a fresh cooldown after interaction ends.
+    if (!floating_address_refresh_timer_->IsRunning()) {
+      floating_address_refresh_timer_->Start(
+          FROM_HERE, base::Milliseconds(100),
+          base::BindRepeating(&BrowserFrameViewMac::UpdateFloatingAddressBar,
+                              base::Unretained(this), false));
+    }
+    return;
+  }
+  if (!host || !host->GetVisible()) {
+    return;
+  }
+  if (cooldown_expired) {
+    floating_address_refresh_timer_->Stop();
+    host->SetVisible(false);
+    return;
+  }
+  // Reentry cancels this timer; repeated exit events must not restart it.
+  if (!floating_address_hide_timer_->IsRunning()) {
+    floating_address_hide_timer_->Start(
+        FROM_HERE, base::Milliseconds(700),
+        base::BindOnce(&BrowserFrameViewMac::UpdateFloatingAddressBar,
+                       base::Unretained(this), true));
+  }
+}
