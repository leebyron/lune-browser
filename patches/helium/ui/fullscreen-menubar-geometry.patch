+int NativeFullscreenTopControlsOffset(const BrowserView* view,
+                                      double menubar_fraction) {
+  if (!view || !view->GetWidget() || !view->IsFullscreen()) {
+    return 0;
+  }
+  NSWindow* window = view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  NSScreen* screen = window.screen;
+  NSView* content = window.contentView;
+  if (!screen || !content) {
+    return 0;
+  }
+  const NSRect bounds = [window convertRectToScreen:
+      [content convertRect:content.bounds toView:nil]];
+  const CGFloat menu_height =
+      NSApplication.sharedApplication.mainMenu.menuBarHeight;
+  const CGFloat menu_bottom = NSMaxY(screen.frame) -
+      menu_height * std::clamp(menubar_fraction, 0.0, 1.0);
+  // Always-visible menus and camera safe areas may already lower the window.
+  // Derive the remaining occlusion on every layout, including initial entry.
+  return static_cast<int>(std::ceil(
+      std::max<CGFloat>(0, NSMaxY(bounds) - menu_bottom)));
+}
