+               (command == DownloadCommands::SHOW_IN_FOLDER &&
+                button->GetVisible() && button.get() == focused);
+      });
+  const bool highlighted =
+      (Contains(focused) || (hovered && has_row_hover_action)) &&
+      !quick_action_highlighted;
