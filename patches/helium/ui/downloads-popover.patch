+gfx::Size DownloadBubbleRowView::LayoutQuickActions() {
+#if BUILDFLAG(IS_MAC)
+  const bool share_inside_edge =
+      quick_actions_.at(DownloadCommands::CANCEL)->GetVisible() &&
+      (quick_actions_.at(DownloadCommands::PAUSE)->GetVisible() ||
+       quick_actions_.at(DownloadCommands::RESUME)->GetVisible());
+  int width = 0;
+  for (views::View* child : quick_action_holder_->children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    auto* button = static_cast<DownloadQuickActionButton*>(child);
+    const gfx::Insets margins = button->SetSharesInsideEdge(share_inside_edge);
+    width += margins.left();
+    button->SetBounds(width, 0, helium::kNativeDownloadButtonSize,
+                      helium::kNativeDownloadButtonSize);
+    width += helium::kNativeDownloadButtonSize + margins.right();
+  }
+  return width > 0 ? gfx::Size(width, helium::kNativeDownloadButtonSize)
+                   : gfx::Size();
+#else
+  return quick_action_holder_->GetPreferredSize();
+#endif
+}
