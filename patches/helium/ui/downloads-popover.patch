+                               image, 0.7)
+                         : image;
+            },
+            symbol, dimmed),
+        gfx::Size(kDownloadActionCanvas, kDownloadActionCanvas));
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    ImageButton::StateChanged(old_state);
+    if (state_changed_) {
+      state_changed_.Run();
+    }
+  }
+
+  bool GetHitTestMask(SkPath* mask) const override {
+    // Split the overlapping targets at the midpoint between their centers.
+    gfx::Rect bounds = GetLocalBounds();
+    bounds.Inset(hit_insets_);
+    *mask = SkPath::Rect(gfx::RectToSkRect(GetMirroredRect(bounds)));
+    return true;
+  }
+
+  const DownloadCommands::Command command_;
