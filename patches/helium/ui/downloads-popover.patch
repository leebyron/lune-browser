+      : ImageButton(std::move(callback)),
+        command_(command),
+        state_changed_(std::move(state_changed)) {
+    views::ConfigureVectorImageButton(this);
+    SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+    const char* symbol = GetNativeDownloadActionSymbol(command);
+    SetImageModel(STATE_NORMAL, MakeIcon(symbol, /*dimmed=*/true));
+    const auto active_icon = MakeIcon(symbol, /*dimmed=*/false);
+    SetImageModel(STATE_HOVERED, active_icon);
+    SetImageModel(STATE_PRESSED, active_icon);
+  }
+
+  gfx::Insets SetSharesInsideEdge(bool shares_inside_edge) {
+    hit_insets_ = gfx::Insets();
+    gfx::Insets margins = gfx::Insets::TLBR(0, kDownloadActionMargin, 0, 0);
+    if (shares_inside_edge) {
+      if (command_ == DownloadCommands::CANCEL) {
+        margins.set_left(-kSharedActionEdge);
+        hit_insets_.set_left(kSharedActionEdge);
+      } else if (command_ == DownloadCommands::PAUSE ||
+                 command_ == DownloadCommands::RESUME) {
+        margins.set_right(-kSharedActionEdge);
+        hit_insets_.set_right(kSharedActionEdge);
+      }
+    }
+    return margins;
+  }
+
+ private:
+  static ui::ImageModel MakeIcon(const char* symbol, bool dimmed) {
+    return ui::ImageModel::FromImageGenerator(
+        base::BindRepeating(
+            [](const char* symbol, bool dimmed,
