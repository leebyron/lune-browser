+#include "third_party/zlib/google/zip_reader.h"
+
+namespace {
+
+// A Safari export contains one HTML bookmark file. Its name is localized.
+bool ReadSafariBookmarkArchive(const base::FilePath& path, std::string& html) {
+  constexpr size_t kMaxBookmarksBytes = 32 * 1024 * 1024;
+  zip::ZipReader archive;
+  if (!archive.Open(path)) {
+    return false;
+  }
+  while (const auto* entry = archive.Next()) {
+    if (!entry->is_directory &&
+        entry->path.MatchesExtension(FILE_PATH_LITERAL(".html"))) {
+      return archive.ExtractCurrentEntryToString(kMaxBookmarksBytes, &html) &&
+             !html.empty();
+    }
+  }
+  return false;
+}
+
+}  // namespace
 
