 // The amount of padding between the label and any sync icon.
 constexpr int kSyncIconLabelPadding = 2;
 
+// Use the favicon design size and center the painted glyph rather than its
+// font advance: color emoji fallback can have asymmetric sidebearings.
+constexpr int kEmojiFontSize = kIconSize;
+constexpr int kEmojiCanvasSize = 24;
+
+class TabGroupEmojiImageSource : public gfx::ImageSkiaSource {
+ public:
+  TabGroupEmojiImageSource(std::u16string text,
+                          const gfx::FontList& font,
+                          SkColor color)
+      : text_(std::move(text)),
+        font_(font.DeriveWithSizeDelta(kEmojiFontSize - font.GetFontSize())),
+        color_(SkColorSetA(color, SK_AlphaOPAQUE)) {}
+
+  gfx::ImageSkiaRep GetImageForScale(float scale) override {
+    gfx::Canvas glyph_canvas(gfx::Size(64, 64), scale, false);
+    glyph_canvas.DrawStringRectWithFlags(
+        text_, font_, color_, gfx::Rect(64, 64),
+        gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_ELLIPSIS);
+    const SkBitmap glyph = glyph_canvas.GetBitmap();
+    int left = glyph.width();
+    int top = glyph.height();
+    int right = 0;
+    int bottom = 0;
+    for (int y = 0; y < glyph.height(); ++y) {
+      for (int x = 0; x < glyph.width(); ++x) {
+        if (SkColorGetA(glyph.getColor(x, y))) {
+          left = std::min(left, x);
+          top = std::min(top, y);
+          right = std::max(right, x + 1);
+          bottom = std::max(bottom, y + 1);
+        }
+      }
+    }
+    gfx::Canvas output(gfx::Size(kEmojiCanvasSize, kEmojiCanvasSize), scale,
+                       false);
+    SkBitmap bitmap = output.GetBitmap();
+    if (right > left && bottom > top) {
+      SkBitmap cropped;
+      if (glyph.extractSubset(&cropped,
+                              SkIRect::MakeLTRB(left, top, right, bottom))) {
+        SkCanvas canvas(bitmap);
+        canvas.drawImage(cropped.asImage(),
+                         (bitmap.width() - cropped.width()) / 2.0f,
+                         (bitmap.height() - cropped.height()) / 2.0f);
+      }
+    }
+    return gfx::ImageSkiaRep(bitmap, scale);
+  }
+
+  bool HasRepresentationAtAllScales() const override { return true; }
+
+ private:
+  const std::u16string text_;
+  const gfx::FontList font_;
+  const SkColor color_;
+};
+
+// Classify complete user-perceived characters, preserving flags, modifiers and
+// joined emoji rather than counting their individual UTF-16 code units.
+bool IsEmojiGrapheme(std::u16string_view character) {
+  if (u_stringHasBinaryProperty(
+          reinterpret_cast<const UChar*>(character.data()), character.size(),
+          UCHAR_RGI_EMOJI)) {
+    return true;
+  }
+  // Accept unqualified pictographs such as a bare heart, while honoring an
+  // explicit text-presentation selector and excluding ordinary digits.
+  base::i18n::UTF16CharIterator codepoint(character);
+  return !codepoint.end() &&
+         u_hasBinaryProperty(codepoint.get(), UCHAR_EXTENDED_PICTOGRAPHIC) &&
+         character.find(u'\uFE0E') == std::u16string_view::npos;
+}
+
+size_t LeadingEmojiLength(std::u16string_view title) {
+  base::i18n::BreakIterator characters(
+      title, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (!characters.Init() || !characters.Advance() ||
+      !IsEmojiGrapheme(characters.GetString())) {
+    return 0;
+  }
+  const size_t prefix_length = characters.GetString().size();
+  // This treatment is only for a single emoji name prefix. Multiple emoji
+  // anywhere in the name keep the ordinary, unsplit label presentation.
+  while (characters.Advance()) {
+    if (IsEmojiGrapheme(characters.GetString())) {
+      return 0;
+    }
+  }
+  return prefix_length;
+}
