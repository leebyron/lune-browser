+void BrowserFrameViewMac::UpdateFloatingSidebar(bool top_presented) {
+  auto* view = GetBrowserView();
+  auto* sidebar =
+      static_cast<VerticalTabStripRegionView*>(view->GetSidebarView());
+  const bool eligible = HasFloatingAddressBar() && sidebar;
+  auto* background = static_cast<views::NativeViewHost*>(
+      floating_sidebar_material_host_.view());
+  auto* button_host =
+      static_cast<views::NativeViewHost*>(floating_sidebar_button_host_.view());
+  if (!eligible) {
+    ResetFloatingSidebar();
+    if (background) {
+      background->SetVisible(false);
+    }
+    if (button_host) {
+      button_host->SetVisible(false);
+    }
+    return;
+  }
+  const bool detached = !view->IsZenModeSideChromePinned();
+  const bool right = view->IsVerticalTabStripRightAligned();
+  const CGFloat reveal = detached ? view->GetSideChromeRevealRatio() : 1;
+  if (detached) {
+    if (!background) {
+      background =
+          view->AddChildViewAt(std::make_unique<views::NativeViewHost>(), 0);
+      floating_sidebar_material_host_.SetView(background);
+      floating_sidebar_material_ =
+          [[HeliumSidebarSurface alloc] initWithFrame:NSZeroRect];
+      background->Attach(gfx::NativeView(floating_sidebar_material_));
+    }
+    if (!floating_sidebar_widget_) {
+      floating_sidebar_owner_.SetView(sidebar);
+      floating_sidebar_widget_ = std::make_unique<views::Widget>();
+      views::Widget::InitParams params(
+          views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+          views::Widget::InitParams::TYPE_POPUP);
+      params.parent = GetWidget()->GetNativeView();
+      params.activatable = views::Widget::InitParams::Activatable::kNo;
+      params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+      params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+      params.child = true;
+      params.name = "Floating sidebar controls";
+      floating_sidebar_widget_->Init(std::move(params));
+      floating_sidebar_widget_->SetNativeWindowProperty(
+          BrowserView::kBrowserViewKey, view);
+      floating_sidebar_widget_->SetContentsView(
+          std::make_unique<views::View>());
+      // Reparenting the controls must preserve the original sidebar's blank
+      // area context menu. Tab-specific menus continue to handle their own
+      // hits.
+      floating_sidebar_widget_->GetContentsView()->set_context_menu_controller(
+          view->browser_widget());
+      NSWindow* window =
+          floating_sidebar_widget_->GetNativeWindow().GetNativeNSWindow();
+      window.hasShadow = NO;
+      window.opaque = NO;
+      window.backgroundColor = NSColor.clearColor;
+      sidebar->SetFloatingControlsHost(
+          floating_sidebar_widget_->GetContentsView());
+    }
+    gfx::Rect bounds = views::View::ConvertRectToTarget(
+        sidebar, view, sidebar->GetLocalBounds());
+    background->SetBoundsRect(bounds);
+    background->SetVisible(reveal > 0);
+    // The sidebar already supplies its own horizontal slide/fade progress.
+    [floating_sidebar_material_ setRevealFraction:reveal];
+    floating_sidebar_material_.appearance = FloatingChromeAppearance();
+    // Keep the 38-point native header row and 5-point resize band in the
+    // parent window, rather than relying on delayed mouse-event pass-through.
+    bounds.Inset(gfx::Insets::TLBR(38, right ? 5 : 0, 0, right ? 0 : 5));
+    // A child NSWindow is not clipped by its parent during the slide.
+    bounds.Intersect(view->GetLocalBounds());
+    views::View::ConvertRectToScreen(view, &bounds);
+    floating_sidebar_widget_->SetBounds(bounds);
+    sidebar->LayoutFloatingControls();
+    floating_sidebar_widget_->LayoutRootViewIfNecessary();
+    NSWindow* window =
+        floating_sidebar_widget_->GetNativeWindow().GetNativeNSWindow();
+    NSAppearance* appearance = FloatingChromeAppearance();
+    if (![window.appearance isEqual:appearance]) {
+      window.appearance = appearance;
+      floating_sidebar_widget_->ResetLastColorProviderKey();
+      floating_sidebar_widget_->ScheduleThemeChanged();
+    }
+    window.ignoresMouseEvents = reveal == 0;
+    if (reveal > 0 && !floating_sidebar_widget_->IsVisible()) {
+      floating_sidebar_widget_->ShowInactive();
+    }
+    window.alphaValue = reveal;
+  } else {
+    ResetFloatingSidebar();
+    if (background) {
+      background->SetVisible(false);
+    }
+  }
+  if (!button_host) {
+    button_host = view->AddChildView(std::make_unique<views::NativeViewHost>());
+    floating_sidebar_button_host_.SetView(button_host);
+    floating_sidebar_button_ =
+        [[HeliumGlassSidebarButton alloc] initWithBrowserView:view];
+    button_host->Attach(gfx::NativeView(floating_sidebar_button_));
+  }
+  const CGFloat closed_x = right ? view->width() - 44 : 108;
+  const CGFloat open_x =
+      right ? view->width() - sidebar->width() : sidebar->width() - 36;
+  const int x = base::ClampRound(closed_x + (open_x - closed_x) * reveal);
+  button_host->SetBounds(x, 8 + TopUIFullscreenYOffset(), 36, 36);
+  floating_sidebar_button_.appearance = FloatingChromeAppearance();
+  [floating_sidebar_button_ setPresented:top_presented || reveal > 0];
+  [floating_sidebar_button_ refreshEmbedded:reveal > 0];
+  button_host->SetVisible(top_presented || reveal > 0 ||
+                          !floating_sidebar_button_.hidden);
+}
+
+void BrowserFrameViewMac::ResetFloatingSidebar() {
+  if (auto* sidebar = static_cast<VerticalTabStripRegionView*>(
+          floating_sidebar_owner_.view())) {
+    sidebar->SetFloatingControlsHost(nullptr);
+  }
+  floating_sidebar_owner_.SetView(nullptr);
+  if (floating_sidebar_widget_) {
+    floating_sidebar_widget_->SetNativeWindowProperty(
+        BrowserView::kBrowserViewKey, nullptr);
+    floating_sidebar_widget_->CloseNow();
+    floating_sidebar_widget_.reset();
+  }
+  if (auto* host = floating_sidebar_material_host_.view()) {
+    host->SetVisible(false);
+  }
+}
