 #include "ui/native_theme/native_theme.h"
 #include "ui/views/widget/widget.h"
 
+// Draw above fallback content without adding an input region or layout inset.
+@interface HeliumFallbackSurfaceEdge : NSView
+@property(nonatomic) CGFloat cornerRadius;
+@end
+
+@implementation HeliumFallbackSurfaceEdge
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  self.needsDisplay = YES;
+}
+- (void)viewDidChangeBackingProperties {
+  [super viewDidChangeBackingProperties];
+  self.needsDisplay = YES;
+}
+- (void)drawRect:(NSRect)dirtyRect {
+  const CGFloat scale = self.window ? self.window.backingScaleFactor : 1;
+  const CGFloat pixel = 1 / scale;
+  if (NSWidth(self.bounds) < pixel || NSHeight(self.bounds) < pixel) {
+    return;
+  }
+  const CGFloat radius = std::max(CGFloat(0), self.cornerRadius - pixel / 2);
+  NSBezierPath* edge = [NSBezierPath
+      bezierPathWithRoundedRect:NSInsetRect(self.bounds, pixel / 2, pixel / 2)
+                        xRadius:radius
+                        yRadius:radius];
+  edge.lineWidth = pixel;
+  [NSColor.separatorColor setStroke];
+  [edge stroke];
+}
+@end
+
 namespace helium {
+
+void AddNativeFallbackSurfaceEdge(NSView* surface, CGFloat radius) {
+  HeliumFallbackSurfaceEdge* edge =
+      [[HeliumFallbackSurfaceEdge alloc] initWithFrame:surface.bounds];
+  edge.cornerRadius = radius;
+  edge.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [surface addSubview:edge];
+}
