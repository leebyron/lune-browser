+namespace {
+
+constexpr char kSidebarWidthLastDensity[] = "vertical_tabs.width_last_density";
+constexpr int kUnknownSidebarWidthDensity = -1;
+
+}  // namespace
+
+void UpdateSidebarWidthGeneration(PrefService* local_state) {
+  const int density = std::to_underlying(GetHeliumUiDensity());
+  const int last_density = local_state->GetInteger(kSidebarWidthLastDensity);
+  if (last_density == density) {
+    return;
+  }
+  if (last_density != kUnknownSidebarWidthDensity) {
+    local_state->SetInteger(
+        prefs::kSidebarWidthGeneration,
+        local_state->GetInteger(prefs::kSidebarWidthGeneration) + 1);
+  }
+  local_state->SetInteger(kSidebarWidthLastDensity, density);
+}
