+int TabStripView::GetVerticalPinnedTabDropBoundary(bool tab_is_pinned) const {
+  const auto layout =
+      static_cast<const TabStripViewLayout*>(GetLayoutManager())
+          ->GetProposedLayout(size());
+  const int grid_bottom =
+      layout.GetLayoutFor(pinned_tabs_scroll_view_)->bounds.bottom();
+
+  // Use the final viewport so scrolling and tile animations cannot move the
+  // boundary. Keep an exit margin for the gap that disappears if pinning the
+  // last member of a group removes its header.
+  constexpr int kGridGap = PinnedTabContainerView::kTabPadding;
+  int boundary = GetPinnedTabsContainer()->HasEmptyDropEntry()
+                     ? grid_bottom
+                     : grid_bottom + (tab_is_pinned ? 2 * kGridGap : -kGridGap);
+  if (const auto group_top =
+          GetUnpinnedTabsContainer()->GetFirstPinnedGroupTopForDrag()) {
+    const int group_viewport_top =
+        layout.GetLayoutFor(unpinned_tabs_scroll_view_)->bounds.y();
+    const int group_top_in_viewport =
+        std::max(0, *group_top - unpinned_tabs_scroll_view_->GetVisibleRect().y());
+    // The space above the first visible pinned group belongs to the grid.
+    boundary = std::max(boundary, group_viewport_top + group_top_in_viewport);
+  }
+  return boundary;
+}
