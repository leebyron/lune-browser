+      current_layout.GetLayoutFor(pinned_groups_separator_);
+  const int pin_boundary =
+      separator_layout && separator_layout->visible
+          ? separator_layout->bounds.bottom()
+          : UnpinnedTabContainerViewVerticalLayout::kEmptyPinnedGroupDropHeight;
+  const bool pinned = point.y() < pin_boundary;
+  const bool stays_in_section = pinned == IsPinnedGroupView(dragged_group);
+  const auto* layout_manager =
+      static_cast<const UnpinnedTabContainerViewVerticalLayout*>(
+          layout_manager_->target_layout_manager());
+  const auto drop_layout = layout_manager->CalculateGroupDropLayout(
+      current_layout.host_size.width(), *dragged_group);
