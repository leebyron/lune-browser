+    const auto* group = views::AsViewClass<TabGroupView>(child.child_view);
+    int midpoint =
+        group ? child.bounds.y() +
+                    group->group_header()->GetPreferredSize().height() / 2
+              : child.bounds.CenterPoint().y();
+    if (stays_in_section) {
+      midpoint += after_dragged_group ? kReorderHysteresis : -kReorderHysteresis;
+    }
+    if (dragged_top < midpoint) {
+      return {node, pinned};
+    }
+  }
+  return {nullptr, pinned};
