+  // Measure against stationary rows in final layout coordinates. A small
+  // distance past the midpoint must be crossed to reverse an insertion.
+  constexpr int kReorderHysteresis = 4;
+  bool after_dragged_group = false;
+  for (const auto& child : drop_layout.child_layouts) {
+    if (child.child_view == dragged_group) {
+      after_dragged_group = true;
+      continue;
+    }
+    if (!child.visible || IsPinnedGroupView(child.child_view) != pinned) {
+      continue;
+    }
+    const auto* node = GetCollectionNodeFromView(*child.child_view);
+    if (!node) {
+      continue;
