+// AppKit's default caption dispatch bypasses Views on a full-size content
+// window. Route only the pinned sidebar's blank background through the same
+// native drag/menu path as the floating header; real tab controls pass through.
+@interface HeliumPinnedSidebarInput : HeliumGlassDragRegion
+@end
+@implementation HeliumPinnedSidebarInput {
+  base::WeakPtr<BrowserView> _sidebarBrowser;
+}
+- (instancetype)initWithBrowserView:(BrowserView*)view {
+  self = [super initWithBrowserView:view];
+  if (self) {
+    _sidebarBrowser = view->GetAsWeakPtr();
+    self.enabled = YES;
+  }
+  return self;
+}
+- (NSRect)interactiveBounds {
+  // The host already excludes the window perimeter and sidebar resize handle.
+  return self.bounds;
+}
+- (void)resetCursorRects {
+  // Registering the entire rectangle would override cursors on tab controls.
+}
+- (NSView*)hitTest:(NSPoint)point {
+  const NSPoint local = [self convertPoint:point fromView:self.superview];
+  if (!self.enabled || self.hidden || !_sidebarBrowser ||
+      !NSPointInRect(local, self.bounds) ||
+      NSApp.currentEvent.type == NSEventTypeScrollWheel) {
+    return nil;
+  }
+  auto* sidebar = static_cast<VerticalTabStripRegionView*>(
+      _sidebarBrowser->GetSidebarView());
+  if (!sidebar || !_sidebarBrowser->IsZenModeSideChromePinned()) {
+    return nil;
+  }
+  gfx::Point position = gfx::ScreenPointFromNSPoint(
+      [self.window convertPointToScreen:[self convertPoint:local toView:nil]]);
+  views::View::ConvertPointFromScreen(sidebar, &position);
+  const bool caption = sidebar->IsPositionInWindowCaption(position);
+  VLOG(1) << "Native pinned sidebar input " << position.ToString() << " caption=" << caption;
+  return caption ? self : nil;
+}
+@end
+
 namespace {
+class PinnedSidebarInputTargeter : public views::ViewTargeterDelegate {
+ public:
+  explicit PinnedSidebarInputTargeter(BrowserView* browser)
+      : browser_(browser->GetAsWeakPtr()) {}
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override {
+    if (!browser_ || !browser_->IsZenModeSideChromePinned() ||
+        !target->GetLocalBounds().Intersects(rect)) {
+      return false;
+    }
+    auto* sidebar = static_cast<VerticalTabStripRegionView*>(browser_->GetSidebarView());
+    if (!sidebar) {
+      return false;
+    }
+    gfx::Point local = rect.CenterPoint();
+    views::View::ConvertPointToTarget(target, sidebar, &local);
+    const bool caption = sidebar->IsPositionInWindowCaption(local);
+    VLOG(1) << "Pinned sidebar input " << local.ToString() << " caption=" << caption;
+    return caption;
+  }
+ private:
+  base::WeakPtr<BrowserView> browser_;
+};
