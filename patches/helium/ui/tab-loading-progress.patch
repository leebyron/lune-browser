+SkColor TabGlowColor(const views::View& view) {
+  auto* browser = BrowserView::GetBrowserViewForNativeWindow(
+      view.GetWidget()->GetNativeWindow());
+  if (!browser || !browser->GetColorProvider()) {
+    return view.GetColorProvider()->GetColor(ui::kColorSysPrimary);
+  }
+  auto key = browser->browser_widget()->GetColorProviderKey();
+  const auto* colors = browser->GetColorProvider();
+  const SkColor accent = colors->GetColor(ui::kColorSysPrimary);
+  if (key.contrast_mode == ui::ColorProviderKey::ContrastMode::kHigh ||
+      key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone) {
+    return accent;
+  }
+  if (key.frame_style == ui::ColorProviderKey::FrameStyle::kSystem &&
+      !key.custom_theme && !key.app_controller) {
+    const SkColor blue = colors->GetColor(kColorTabThrobber);
+    return key.color_mode == ui::ColorProviderKey::ColorMode::kLight
+               ? color_utils::AlphaBlend(SK_ColorWHITE, blue, 0.42f)
+               : blue;
+  }
+  if (key.user_color_source == ui::ColorProviderKey::UserColorSource::kBaseline &&
+      !key.custom_theme && !key.app_controller) {
+    // Both Lune appearances use the dark palette's button highlight.
+    key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+    return ui::ColorProviderManager::Get().GetColorProviderFor(key)->GetColor(
+        ui::kColorSysPrimary);
+  }
+
+  const SkColor background = colors->GetColor(kColorTabBackgroundActiveFrameActive);
+  color_utils::HSL tone;
+  color_utils::SkColorToHSL(background, &tone);
+  if (tone.s < 0.08 || tone.l < 0.04 || tone.l > 0.96) {
+    // Very light and neutral surfaces can lose the hue of their theme.
+    color_utils::SkColorToHSL(accent, &tone);
+  }
+  // Stay within an analogous hue, taking the shorter arc toward blue.
+  constexpr double kBlueHue = 215.0 / 360.0;
+  constexpr double kMaxHueShift = 30.0 / 360.0;
+  const double toward_blue = std::remainder(kBlueHue - tone.h, 1.0);
+  tone.h = tone.s < 0.08 ? kBlueHue : std::fmod(
+      tone.h + std::clamp(toward_blue, -kMaxHueShift, kMaxHueShift) + 1.0, 1.0);
+  tone.s = std::max(tone.s, 0.85);
+  tone.l = color_utils::IsDark(background) ? 0.67 : 0.40;
+  return color_utils::HSLToSkColor(tone, SK_AlphaOPAQUE);
+}
