+bool TabGroupHeaderView::UsesNativeGroupMenu() const {
+#if BUILDFLAG(IS_MAC)
+  return orientation_ == TabStripOrientation::kVertical;
+#else
+  return false;
+#endif
+}
+
+bool TabGroupHeaderView::IsRenaming() const {
+  return title_editor_ && title_editor_->GetVisible();
+}
+
+void TabGroupHeaderView::BeginRename() {
+  if (!title_editor_ || !delegate_->IsValid()) {
+    return;
+  }
+  if (delegate_->GetTabGroup().is_ephemeral()) {
+    editor_bubble_tracker_.Opened(delegate_->ShowGroupEditorBubble(false));
+    return;
+  }
+  delegate_->HideHoverCard(TabSlotController::HoverCardUpdateType::kEvent);
+  delegate_->CancelHeaderDrag();
+  title_editor_->SetText(tab_group_visual_data_.title());
+  title_editor_->SetVisible(true);
+  OnBubbleOpened();
+  InvalidateLayout();
+  ScrollViewToVisible();
+  title_editor_->RequestFocus();
+  title_editor_->SelectAll(false);
+}
+
+void TabGroupHeaderView::FinishRename(bool commit, bool restore_focus) {
+  if (!IsRenaming()) {
+    return;
+  }
+  const std::u16string title(title_editor_->GetText());
+  title_editor_->SetVisible(false);
+  auto weak_this = weak_ptr_factory_.GetWeakPtr();
+  if (commit && delegate_->IsValid()) {
+    if (auto* browser = delegate_->GetBrowserWindowInterface()) {
+      auto* model = browser->GetTabStripModel();
+      const auto* tab_group = model->group_model()->GetTabGroup(group());
+      const auto* visuals = tab_group->visual_data();
+      model->ChangeTabGroupVisuals(
+          group(),
+          tab_groups::TabGroupVisualData(title, visuals->color(),
+                                         visuals->is_collapsed()),
+          /*is_customized=*/true);
+    }
+  }
+  if (!weak_this || !delegate_->IsValid()) {
+    return;
+  }
+  OnDataChanged(delegate_->GetTabGroupData());
+  OnBubbleClosed();
+  InvalidateLayout();
+  if (restore_focus) {
+    RequestFocus();
+  }
+}
+
+bool TabGroupHeaderView::HandleKeyEvent(views::Textfield* sender,
+                                        const ui::KeyEvent& event) {
+  if (!IsRenaming() || event.type() != ui::EventType::kKeyPressed ||
+      title_editor_->IsIMEComposing()) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN ||
+      event.key_code() == ui::VKEY_ESCAPE) {
+    // Keep the field focused until dispatch finishes so Enter cannot reach
+    // the header's collapse shortcut after committing the name.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&TabGroupHeaderView::FinishRename,
+                                  weak_ptr_factory_.GetWeakPtr(),
+                                  event.key_code() == ui::VKEY_RETURN, true));
+    return true;
+  }
+  return false;
+}
+
+void TabGroupHeaderView::ShowNativeGroupMenu(
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto* browser = delegate_->GetBrowserWindowInterface();
+  if (!browser || !delegate_->IsValid() ||
+      (group_menu_runner_ && group_menu_runner_->IsRunning())) {
+    return;
+  }
+  if (delegate_->GetTabGroup().is_ephemeral()) {
+    editor_bubble_tracker_.Opened(delegate_->ShowGroupEditorBubble(false));
+    return;
+  }
+  FinishRename(true, false);
+  auto* model = browser->GetTabStripModel();
+  group_menu_runner_.reset();
+  group_menu_.Clear();
+  group_menu_.AddItemWithStringId(kRenameGroup, IDS_TAB_GROUP_MENU_RENAME);
+  group_menu_.AddItemWithStringId(kToggleGroupPinned,
+                                  model->IsTabGroupPinned(group())
+                                      ? IDS_TAB_GROUP_MENU_UNPIN
+                                      : IDS_TAB_GROUP_MENU_PIN);
+  group_menu_.AddSeparator(ui::NORMAL_SEPARATOR);
+  group_menu_.AddItemWithStringId(kNewTabInGroup, IDS_TAB_GROUP_MENU_NEW_TAB);
+  if (base::FeatureList::IsEnabled(tabs::kTabGroupHome)) {
+    group_menu_.AddItemWithStringId(kGroupHome,
+                                    IDS_TAB_GROUP_HEADER_CXMENU_HOME);
+  }
+  group_menu_.AddItemWithStringId(kMoveGroupToWindow,
+                                  IDS_TAB_GROUP_MENU_MOVE_WINDOW);
+  if (base::FeatureList::IsEnabled(features::kTabGroupsFocusing)) {
+    group_menu_.AddItemWithStringId(kToggleGroupFocus,
+                                    delegate_->IsGroupFocused()
+                                        ? IDS_TAB_GROUP_MENU_UNFOCUS
+                                        : IDS_TAB_GROUP_MENU_FOCUS);
+  }
+  group_menu_.AddSeparator(ui::NORMAL_SEPARATOR);
+  group_menu_.AddItemWithStringId(kUngroupTabs,
+                                  IDS_TAB_GROUP_HEADER_CXMENU_UNGROUP);
+  group_menu_.AddItemWithStringId(kCloseTabsInGroup,
+                                  IDS_TAB_GROUP_MENU_CLOSE_TABS);
+  OnBubbleOpened();
+  menu_reveal_hold_ = BrowserView::HoldChromeRevealForMenu(GetWidget());
+  group_menu_runner_ = std::make_unique<views::MenuRunner>(
+      &group_menu_, views::MenuRunner::CONTEXT_MENU,
+      base::BindRepeating(&TabGroupHeaderView::OnNativeMenuClosed,
+                          weak_ptr_factory_.GetWeakPtr()));
+  group_menu_runner_->RunMenuAt(
+      GetWidget(), nullptr,
+      gfx::Rect(source_type == ui::mojom::MenuSourceType::kMouse
+                    ? point
+                    : GetBoundsInScreen().origin(),
+                gfx::Size()),
+      views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void TabGroupHeaderView::OnNativeMenuClosed() {
+  menu_reveal_hold_.RunAndReset();
+  OnBubbleClosed();
+}
+
+bool TabGroupHeaderView::IsCommandIdEnabled(int command_id) const {
+  auto* browser = delegate_->GetBrowserWindowInterface();
+  if (!browser || !delegate_->IsValid()) {
+    return false;
+  }
+  auto* model = browser->GetTabStripModel();
+  return command_id != kMoveGroupToWindow ||
+         model->count() !=
+             model->group_model()->GetTabGroup(group())->tab_count();
+}
+
+void TabGroupHeaderView::ExecuteCommand(int command_id, int event_flags) {
+  auto* browser = delegate_->GetBrowserWindowInterface();
+  if (!browser || !delegate_->IsValid()) {
+    return;
+  }
+  auto* model = browser->GetTabStripModel();
+  const auto id = group();
+  switch (command_id) {
+    case kRenameGroup:
+      BeginRename();
+      return;
+    case kToggleGroupPinned:
+      model->SetTabGroupPinned(id, !model->IsTabGroupPinned(id));
+      return;
+    case kNewTabInGroup:
+      model->delegate()->AddTabAt(
+          GURL(), model->group_model()->GetTabGroup(id)->ListTabs().end(), true,
+          id);
+      return;
+    case kMoveGroupToWindow:
+      model->delegate()->MoveGroupToNewWindow(id);
+      return;
+    case kToggleGroupFocus:
+      if (model->GetFocusedGroup() == id) {
+        model->ExitFocusMode(TabGroupFocusExitReason::kEditorBubble);
+      } else {
+        model->EnterFocusMode(id);
+      }
+      return;
+    case kGroupHome:
+      chrome::AddSelectedTabWithURL(browser, GURL("chrome://tab-group-home/"),
+                                    ui::PAGE_TRANSITION_TYPED);
+      return;
+    case kUngroupTabs: {
+      if (auto* service = tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+              browser->GetProfile())) {
+        if (const auto saved = service->GetGroup(id)) {
+          tab_groups::SavedTabGroupUtils::UngroupSavedGroup(
+              browser, saved->saved_guid());
+          return;
+        }
+      }
+      const auto range = model->group_model()->GetTabGroup(id)->ListTabs();
+      std::vector<int> tabs;
+      for (auto index = range.start(); index < range.end(); ++index) {
+        tabs.push_back(index);
+      }
+      model->RemoveFromGroup(tabs);
+      return;
+    }
+    case kCloseTabsInGroup: {
+      auto* service = tab_groups::TabGroupSyncServiceFactory::GetForProfile(
+          browser->GetProfile());
+      if (service) {
+        if (const auto saved = service->GetGroup(id)) {
+          tab_groups::SavedTabGroupUtils::DeleteSavedGroup(browser,
+                                                           saved->saved_guid());
+          return;
+        }
+      }
+      model->CloseAllTabsInGroup(id);
+      return;
+    }
+  }
+}
