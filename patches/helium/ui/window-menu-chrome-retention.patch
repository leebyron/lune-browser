+
+- (BOOL)windowManagementMenuOpen {
+  if (_windowManagementMenu) {
+    return YES;
+  }
+  // Recent AppKit versions host the green-button menu in another process:
+  // no NSMenu tracking notifications or local popup NSWindow are produced.
+  // AppKit attaches this remote view to the zoom button for the synchronous
+  // showMenu: call and removes it on return (dismissal/cancel/service failure).
+  // Inspect the existing view only; the private placeholder getter creates it.
+  Class remote_menu_class = NSClassFromString(@"NSThemeWidgetZoomMenuRemoteView");
+  if (remote_menu_class) {
+    for (NSView* child in _zoomButton.subviews) {
+      if ([child isKindOfClass:remote_menu_class]) {
+        return YES;
+      }
+    }
+  }
+  return NO;
+}
+
+- (void)windowMenuDidBeginTracking:(NSNotification*)notification {
+  NSMenu* menu = base::apple::ObjCCast<NSMenu>(notification.object);
+  // AppKit's zoom-button cell is the native menu's delegate. Compare identity
+  // rather than relying on a private AppKit class or selector, or treating
+  // every menu in the process as a reason to retain this window's chrome.
+  if (menu && _zoomButton && menu.delegate == (id)_zoomButton.cell) {
+    _windowManagementMenu = menu;
+  }
+}
+
+- (void)windowMenuDidEndTracking:(NSNotification*)notification {
+  // A submenu or a menu from another window must not release this retention.
+  if (notification.object == _windowManagementMenu) {
+    _windowManagementMenu = nil;
+  }
+}
+
+- (void)viewWillMoveToWindow:(NSWindow*)newWindow {
+  if (newWindow != self.window) {
+    _windowManagementMenu = nil;
+  }
+  [super viewWillMoveToWindow:newWindow];
+}
