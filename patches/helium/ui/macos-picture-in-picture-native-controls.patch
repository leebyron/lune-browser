+void PictureInPictureControllerImpl::OnFullscreenRequested() {
+  HTMLVideoElement* video = picture_in_picture_element_.Get();
+  if (!video) {
+    return;
+  }
+  if (LocalFrame* frame = video->GetDocument().GetFrame()) {
