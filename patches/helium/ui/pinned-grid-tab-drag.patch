+double TabView::GetPinDragProgress() const {
+  return IsPinDragAnimating() ? pin_drag_animation_.GetCurrentValue()
+                              : (pinned_ ? 1.0 : 0.0);
+}
+
+double TabView::GetPinDragTransitionProgress() const {
+  const double end = pinned_ ? 1.0 : 0.0;
+  const double distance = end - pin_drag_start_progress_;
+  return distance == 0.0 ? 1.0 : std::clamp(
+      (GetPinDragProgress() - pin_drag_start_progress_) / distance, 0.0, 1.0);
+}
+
+int TabView::GetPinDragIconX(int regular_x, int icon_width) const {
+  // Interpolate the left offset between fixed endpoint geometries. Chasing
+  // the center of each intermediate width introduces a second, curved motion.
+  const int target_x = pinned_
+      ? (pin_drag_target_size_.width() - icon_width) / 2
+      : regular_x;
+  return gfx::Tween::IntValueBetween(
+      GetPinDragTransitionProgress(), pin_drag_start_icon_x_, target_x);
+}
+
+gfx::Size TabView::GetPinDragSize(const gfx::Size& target) const {
+  if (!IsPinDragAnimating() || !IsDragging()) {
+    return target;
+  }
+  const double t = GetPinDragTransitionProgress();
+  return gfx::Size(
+      gfx::Tween::IntValueBetween(t, pin_drag_start_size_.width(), target.width()),
+      gfx::Tween::IntValueBetween(t, pin_drag_start_size_.height(), target.height()));
+}
+
+void TabView::AnimationProgressed(const gfx::Animation* animation) {
+  if (parent()) {
+    parent()->InvalidateLayout();
+    parent()->SchedulePaint();
+  }
+  InvalidateLayout();
+}
+
+void TabView::AnimationEnded(const gfx::Animation* animation) {
+  AnimationProgressed(animation);
+}
