+bool TabDragHandler::CanChangeDraggedTabPinnedState() const {
+  if (!drag_controller_ || drag_controller_->is_window_drag_only() ||
+      root_node_->orientation() != TabStripOrientation::kVertical) {
+    return false;
+  }
+  const auto& data = drag_controller_->GetSessionData().tab_drag_data_;
