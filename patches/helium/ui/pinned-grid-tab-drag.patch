+// Copyright 2026 The Lune Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_PINNED_TAB_DROP_TARGET_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_PINNED_TAB_DROP_TARGET_H_
+
+#include <cstddef>
+#include <cstdlib>
+#include <limits>
+#include <span>
+
+// Centers of the final grid cells, including the dragged tab's reserved cell.
+// Rendered bounds and morph progress must never enter this calculation.
+struct PinnedTabDropCell {
+  int x;
+  int y;
+};
+
+inline size_t PinnedTabDropInsertionTarget(
+    std::span<const PinnedTabDropCell> cells,
+    size_t source_index,
+    int pointer_x,
+    int pointer_y) {
+  size_t slot = source_index;
+  int nearest_row = std::numeric_limits<int>::max();
+  int nearest_column = std::numeric_limits<int>::max();
+  for (size_t i = 0; i < cells.size(); ++i) {
+    const int row = std::abs(pointer_y - cells[i].y);
+    const int column = std::abs(pointer_x - cells[i].x);
+    if (row < nearest_row ||
+        (row == nearest_row && column < nearest_column)) {
+      nearest_row = row;
+      nearest_column = column;
+      slot = i;
+    }
+  }
+  // The model inserts before a target node, discounting the moving tab when
+  // it preceded that node. Convert the chosen final cell to that convention.
+  return slot > source_index ? slot + 1 : slot;
+}
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_PINNED_TAB_DROP_TARGET_H_
