+  const auto* contents = drag_controller_->GetSessionData()
+                             .source_view_drag_data()->contents.get();
+  const int index = tab_strip_model_->GetIndexOfWebContents(contents);
+  if (index != TabStripModel::kNoTab &&
+      tab_strip_model_->IsTabPinned(index) != pinned) {
+    tab_strip_model_->SetTabPinned(index, pinned);
