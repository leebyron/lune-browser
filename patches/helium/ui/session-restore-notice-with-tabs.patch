+// static
 void SessionRestore::OnGotSession(
     Profile* profile,
     bool for_apps,
     const std::vector<const sessions::SessionWindow*>& windows) {
+  if (!for_apps) {
+    // Reuse the session read before any restored browser opens and asks to
+    // display startup notices. A new profile or empty/unreadable session must
+    // not advertise restoration just because it is the startup default.
+    const bool has_tabs = std::ranges::any_of(windows, [](const auto* window) {
+      return SessionService::IsRelevantWindowType(window->type) &&
+             std::ranges::any_of(window->tabs, [](const auto& tab) {
+               return !tab->navigations.empty();
+             });
+    });
+    if (has_tabs) {
+      profile->SetUserData(&kHasRestorableTabsKey,
+                          std::make_unique<base::SupportsUserData::Data>());
+    } else {
+      profile->RemoveUserData(&kHasRestorableTabsKey);
+    }
+  }
   for (auto& observer : *observers()) {
     observer.OnGotSession(profile, for_apps, windows);
   }
