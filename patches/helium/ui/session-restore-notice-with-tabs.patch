+TEST_F(SessionRestoreInfobarModelTest, NoNoticeWithoutSavedTabs) {
+  TestingProfile profile;
+  profile.GetPrefs()->SetInteger(prefs::kRestoreOnStartup, 1);
+  SessionRestoreInfobarModel model(profile, false);
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+
+  SessionRestore::OnGotSession(&profile, false, {});
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+
+  sessions::SessionWindow window;
+  window.type = sessions::SessionWindow::TYPE_NORMAL;
+  SessionRestore::OnGotSession(&profile, false, {&window});
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+
+  window.tabs.push_back(std::make_unique<sessions::SessionTab>());
+  SessionRestore::OnGotSession(&profile, false, {&window});
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+}
+
+TEST_F(SessionRestoreInfobarModelTest, SavedTabsAreScopedToProfileAndSession) {
+  TestingProfile profile;
+  TestingProfile other_profile;
+  profile.GetPrefs()->SetInteger(prefs::kRestoreOnStartup, 1);
+  other_profile.GetPrefs()->SetInteger(prefs::kRestoreOnStartup, 1);
+  SessionRestoreInfobarModel model(profile, false);
+  SessionRestoreInfobarModel other_model(other_profile, false);
+  SessionRestoreInfobarModel crash_model(profile, true);
+  sessions::SessionWindow window;
+  window.type = sessions::SessionWindow::TYPE_NORMAL;
+  window.tabs.push_back(std::make_unique<sessions::SessionTab>());
+  window.tabs.back()->navigations.emplace_back();
+  SessionRestore::OnGotSession(&profile, false, {&window});
+  EXPECT_TRUE(model.ShouldShowOnStartup());
+  EXPECT_FALSE(other_model.ShouldShowOnStartup());
+  EXPECT_FALSE(crash_model.ShouldShowOnStartup());
+
+  // An app-session read must not erase the browser-session result.
+  SessionRestore::OnGotSession(&profile, true, {});
+  EXPECT_TRUE(model.ShouldShowOnStartup());
+
+  // A later empty browser session must not retain a stale positive result.
+  SessionRestore::OnGotSession(&profile, false, {});
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+}
+
+TEST_F(SessionRestoreInfobarModelTest, AppTabsDoNotTriggerBrowserNotice) {
+  TestingProfile profile;
+  profile.GetPrefs()->SetInteger(prefs::kRestoreOnStartup, 1);
+  SessionRestoreInfobarModel model(profile, false);
+  sessions::SessionWindow window;
+  window.type = sessions::SessionWindow::TYPE_APP;
+  window.tabs.push_back(std::make_unique<sessions::SessionTab>());
+  window.tabs.back()->navigations.emplace_back();
+  SessionRestore::OnGotSession(&profile, true, {&window});
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+  SessionRestore::OnGotSession(&profile, false, {&window});
+  EXPECT_FALSE(model.ShouldShowOnStartup());
+
+  window.type = sessions::SessionWindow::TYPE_POPUP;
+  SessionRestore::OnGotSession(&profile, false, {&window});
+  EXPECT_TRUE(model.ShouldShowOnStartup());
+}
+
 }  // namespace session_restore_infobar
