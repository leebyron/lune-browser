+// Preserve AppKit's relative button positions while anchoring the first
+// center to the rounded corner. The 36-point row leaves 18 points on either
+// side of the first/last centers, so its hit region follows the compact group.
+static CGFloat HeliumWindowControlOffset(NSWindow* window, NSUInteger index) {
+  constexpr NSWindowButton types[] = {
+      NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+  NSButton* first = [window standardWindowButton:types[0]];
+  NSButton* button = [window standardWindowButton:types[index]];
+  if (!first || !button) {
+    // Normal titled windows have all three controls. Retain standard spacing
+    // if AppKit temporarily removes them while changing window style.
+    return 23 * index;
+  }
+  return std::abs(NSMidX(button.frame) - NSMidX(first.frame));
+}
+
+static CGFloat HeliumWindowControlsWidth(NSWindow* window) {
+  return 36 + HeliumWindowControlOffset(window, 2);
+}
