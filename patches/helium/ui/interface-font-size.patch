+double GetMacReadingSizeScale() {
+  // AppKit's system font does not expose the Accessibility > Display > Text
+  // size selection. Read the system's preferred reading-size category when
+  // available. Older macOS versions and unknown categories use the default.
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> reading_preferences(
+      CFPreferencesCopyAppValue(CFSTR("FontSizeCategory"),
+                                CFSTR("com.apple.universalaccess")));
+  const auto dictionary =
+      base::apple::CFCast<CFDictionaryRef>(reading_preferences.get());
+  if (!dictionary) {
+    return 1.0;
+  }
+  const auto category = base::apple::GetValueFromDictionary<CFStringRef>(
+      dictionary, CFSTR("global"));
+  if (!category) {
+    return 1.0;
+  }
+
+  constexpr double kDefaultReadingSize = 11.0;
+  constexpr std::pair<std::string_view, int> kReadingSizes[] = {
+      {"XXXS", 9}, {"XXS", 10}, {"XS", 11}, {"S", 12}, {"M", 13},
+      {"L", 14}, {"XL", 15}, {"XXL", 16}, {"XXXL", 17}, {"AX1", 20},
+      {"AX2", 24}, {"AX3", 29}, {"AX4", 35}, {"AX5", 42},
+  };
+  const std::string selected = base::SysCFStringRefToUTF8(category);
+  for (const auto& [name, point_size] : kReadingSizes) {
+    if (selected == name) {
+      return point_size / kDefaultReadingSize;
+    }
+  }
+  return 1.0;
+}
+
+int ScaleSidebarFontSize(int base_size) {
+  static const double reading_scale = GetMacReadingSizeScale();
+  // At the default reading size, rounding at this scale preserves the
+  // previous 12/14 pt labels and 9/10 pt date headings.
+  constexpr double kLargerScale = 1.15;
+  return std::lround(base_size * reading_scale *
+                     (GetHeliumUiFont() == HeliumUiFont::kLarger ? kLargerScale
+                                                               : 1.0));
+}
+
+}  // namespace
+
+HeliumUiFont GetHeliumUiFont() {
+  // Like density, the font preset applies consistently across the session.
+  const PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (!local_state) {
+    return HeliumUiFont::kNormal;
+  }
+  static const auto font = [local_state] {
+    if (local_state->GetInteger(prefs::kHeliumUiFont) ==
+        std::to_underlying(HeliumUiFont::kLarger)) {
+      return HeliumUiFont::kLarger;
+    }
+    return HeliumUiFont::kNormal;
+  }();
+  return font;
+}
+
+gfx::FontList GetSidebarFont(const gfx::FontList& font, int size_delta) {
+  return font.DeriveWithSizeDelta(
+      ScaleSidebarFontSize(font.GetFontSize() + size_delta) -
+      font.GetFontSize());
+}
