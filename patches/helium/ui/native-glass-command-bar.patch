+  auto* view = new HeliumCommandBarView(
+      parent, initial_query, std::move(on_closed), std::move(on_query),
+      std::move(on_activate), std::move(on_escape));
+  auto* widget = new views::Widget;
+  views::Widget::InitParams params(
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent;
+  params.delegate = view;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  widget->Init(std::move(params));
+  auto* parent_widget = views::Widget::GetWidgetForNativeView(parent);
+  const gfx::Rect bounds = parent_widget->GetWindowBoundsInScreen();
+  view->native_->width = std::min(kWidth, std::max(280, bounds.width() - 32));
+  widget->SetBounds(
+      gfx::Rect(bounds.x() + (bounds.width() - view->native_->width) / 2,
+                bounds.y() + bounds.height() / 5, view->native_->width,
+                kInputHeight + 2 * kInset));
+  view->native_->host->Attach(gfx::NativeView(view->native_->material));
+  widget->Show();
+  widget->AddObserver(view);
+  [view->native_->pane.input.window
+      makeFirstResponder:view->native_->pane.input];
+  [view->native_->pane.input selectText:nil];
+  return view;
+}
+
+HeliumCommandBarView::HeliumCommandBarView(
+    gfx::NativeView parent,
+    const std::u16string& initial_query,
+    base::OnceClosure on_closed,
+    base::RepeatingCallback<void(const std::u16string&)> on_query,
+    base::RepeatingCallback<void(size_t)> on_activate,
+    base::RepeatingClosure on_escape)
+    : on_closed_(std::move(on_closed)),
+      on_query_(std::move(on_query)),
+      on_activate_(std::move(on_activate)),
+      on_escape_(std::move(on_escape)),
+      native_(std::make_unique<Native>()) {
+  SetModalType(ui::mojom::ModalType::kNone);
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::FillLayout>());
+  native_->host =
+      contents->AddChildView(std::make_unique<views::NativeViewHost>());
+  SetContentsView(std::move(contents));
+  auto* pane =
+      [[HeliumCommandPane alloc] initWithFrame:NSMakeRect(0, 0, kWidth, 68)];
+  native_->pane = pane;
+  pane.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  pane.rows = [[NSMutableArray alloc] init];
+  pane.input = [[NSTextField alloc] init];
+  pane.input.font = [NSFont systemFontOfSize:18];
+  pane.input.bordered = NO;
+  pane.input.drawsBackground = NO;
+  pane.input.focusRingType = NSFocusRingTypeNone;
+  pane.input.textColor = NSColor.labelColor;
+  pane.input.placeholderString = @"Search or type a URL";
+  pane.input.stringValue = base::SysUTF16ToNSString(initial_query);
+  pane.input.accessibilityLabel = @"Search or type a URL";
+  pane.input.cell.usesSingleLineMode = YES;
+  pane.input.delegate = pane;
+  [pane addSubview:pane.input];
+  pane.scope = [NSTextField labelWithString:@""];
+  pane.scope.font = [NSFont systemFontOfSize:11];
+  pane.scope.textColor = NSColor.secondaryLabelColor;
+  pane.scope.hidden = YES;
+  [pane addSubview:pane.scope];
+  pane.onQuery = ^(NSString* text) {
+    on_query_.Run(base::SysNSStringToUTF16(text));
+  };
+  pane.onActivate = ^(NSInteger index) {
+    on_activate_.Run(index);
+  };
+  pane.onCommand = ^BOOL(SEL command) {
+    if (command == @selector(moveUp:)) {
+      MoveSelection(-1);
+      return YES;
+    }
+    if (command == @selector(moveDown:)) {
+      MoveSelection(1);
+      return YES;
+    }
+    if (command == @selector(cancelOperation:)) {
+      on_escape_.Run();
+      return YES;
+    }
+    if (command == @selector(insertNewline:)) {
+      if (native_->pane.rows.count) {
+        on_activate_.Run(selected_);
+      }
+      return YES;
+    }
+    if (command == @selector(insertTab:)) {
+      if (scope_hint_) {
+        on_activate_.Run(*scope_hint_);
+      }
+      return YES;
+    }
+    if (command == @selector(deleteBackward:) &&
+        native_->pane.input.stringValue.length == 0 &&
+        !native_->pane.scope.hidden) {
+      on_escape_.Run();
+      return YES;
+    }
+    return NO;
+  };
+  auto* parent_widget = views::Widget::GetWidgetForNativeView(parent);
+  auto* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+      parent_widget->GetNativeWindow());
+  bool dark =
+      ui::NativeTheme::GetInstanceForNativeUi()->preferred_color_scheme() ==
+      ui::NativeTheme::PreferredColorScheme::kDark;
+  if (browser_view) {
+    auto scheme = ThemeServiceFactory::GetForProfile(browser_view->GetProfile())
+                      ->GetBrowserColorScheme();
+    if (scheme != ThemeService::BrowserColorScheme::kSystem) {
+      dark = scheme == ThemeService::BrowserColorScheme::kDark;
+    }
+  }
+  NSAppearance* appearance = [NSAppearance
+      appearanceNamed:dark ? NSAppearanceNameDarkAqua : NSAppearanceNameAqua];
+  if (@available(macOS 26, *)) {
+    NSGlassEffectView* glass =
+        [[NSGlassEffectView alloc] initWithFrame:pane.frame];
+    glass.appearance = appearance;
+    glass.style = NSGlassEffectViewStyleRegular;
+    glass.cornerRadius = 20;
+    glass.contentView = pane;
+    native_->material = glass;
+  } else {
+    NSVisualEffectView* effect =
+        [[NSVisualEffectView alloc] initWithFrame:pane.frame];
+    effect.appearance = appearance;
+    effect.material = NSVisualEffectMaterialPopover;
+    effect.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    effect.state = NSVisualEffectStateActive;
+    effect.wantsLayer = YES;
+    effect.layer.cornerRadius = 20;
+    effect.layer.masksToBounds = YES;
+    [effect addSubview:pane];
+    native_->material = effect;
+  }
+  native_->material.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+}
