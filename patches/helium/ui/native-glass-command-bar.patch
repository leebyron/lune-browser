+HeliumCommandBarView::~HeliumCommandBarView() = default;
+void HeliumCommandBarView::Close() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void HeliumCommandBarView::SetResults(
+    const std::vector<HeliumCommandBarItem>& items,
+    std::optional<size_t> scope_hint) {
+  scope_hint_ = scope_hint;
+  for (HeliumCommandRow* row in native_->pane.rows) {
+    [row removeFromSuperview];
+  }
+  [native_->pane.rows removeAllObjects];
+  selected_ = 0;
+  for (size_t i = 0; i < items.size(); ++i) {
+    const auto& item = items[i];
+    HeliumCommandRow* row = [[HeliumCommandRow alloc] init];
+    row.bordered = NO;
+    row.title = @"";
+    row.tag = i;
+    row.primaryText = base::SysUTF16ToNSString(item.title);
+    row.secondaryText = base::SysUTF8ToNSString(item.url_spec);
+    row.tagText = TagForType(item.type);
+    NSString* symbol =
+        item.type == HeliumCommandBarItem::Type::kSearch ||
+                item.type == HeliumCommandBarItem::Type::kSiteSearch
+            ? @"magnifyingglass"
+            : @"globe";
+    row.resultImage = [NSImage imageWithSystemSymbolName:symbol
+                                accessibilityDescription:nil];
+    row.accessibilityLabel =
+        [NSString stringWithFormat:@"%@, %@, %@", row.primaryText,
+                                   row.secondaryText, row.tagText];
+    row.target = native_->pane;
+    row.action = @selector(activateRow:);
+    row.onHover = ^(NSInteger index) {
+      SetSelected(index);
+    };
+    [native_->pane.rows addObject:row];
+    [native_->pane addSubview:row];
+  }
+  UpdateRowHighlight();
+  ResizeToContents();
+}
+void HeliumCommandBarView::ResizeToContents() {
+  if (!GetWidget()) {
+    return;
+  }
+  int height = kInputHeight + 2 * kInset +
+               native_->pane.rows.count * kRowHeight +
+               (native_->pane.scope.hidden ? 0 : 26);
+  if (GetWidget()->GetWindowBoundsInScreen().height() != height) {
+    GetWidget()->SetSize(gfx::Size(native_->width, height));
+  }
+  native_->pane.needsLayout = YES;
+}
+void HeliumCommandBarView::SetInputText(const std::u16string& text) {
+  native_->pane.input.stringValue = base::SysUTF16ToNSString(text);
+  [native_->pane.input selectText:nil];
+}
+void HeliumCommandBarView::SetScope(const std::u16string& name) {
+  native_->pane.scope.stringValue =
+      base::SysUTF16ToNSString(name);
+  native_->pane.scope.hidden = NO;
+  ResizeToContents();
+}
+void HeliumCommandBarView::ClearScope() {
+  native_->pane.scope.hidden = YES;
+  ResizeToContents();
+}
+void HeliumCommandBarView::SetItemImage(size_t index, const gfx::Image& image) {
+  if (index >= native_->pane.rows.count || image.IsEmpty()) {
+    return;
+  }
+  native_->pane.rows[index].resultImage = image.ToNSImage();
+  native_->pane.rows[index].needsDisplay = YES;
+}
+void HeliumCommandBarView::MoveSelection(int delta) {
+  size_t count = native_->pane.rows.count;
+  if (count) {
+    SetSelected((selected_ + count + delta) % count);
+  }
+}
+void HeliumCommandBarView::SetSelected(size_t index) {
+  if (index >= native_->pane.rows.count) {
+    return;
+  }
+  selected_ = index;
+  UpdateRowHighlight();
+}
+void HeliumCommandBarView::UpdateRowHighlight() {
+  for (HeliumCommandRow* row in native_->pane.rows) {
+    row.selected = static_cast<size_t>(row.tag) == selected_;
+    row.needsDisplay = YES;
+    row.accessibilityValue = row.selected ? @"Selected" : @"";
+  }
+}
+void HeliumCommandBarView::WindowClosing() {
+  GetWidget()->RemoveObserver(this);
+  std::move(on_closed_).Run();
+}
+void HeliumCommandBarView::OnWidgetActivationChanged(views::Widget* widget,
+                                                     bool active) {
+  if (!active) {
+    Close();
+  }
+}
+void HeliumCommandBarView::ContentsChanged(views::Textfield*,
+                                           const std::u16string&) {}
+bool HeliumCommandBarView::HandleKeyEvent(views::Textfield*,
+                                          const ui::KeyEvent&) {
+  return false;
+}
