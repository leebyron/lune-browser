+@interface HeliumCommandRow : NSButton
+@property(nonatomic, copy) NSString* primaryText;
+@property(nonatomic, copy) NSString* secondaryText;
+@property(nonatomic, copy) NSString* tagText;
+@property(nonatomic, strong) NSImage* resultImage;
+@property(nonatomic) BOOL selected;
+@property(nonatomic, copy) void (^onHover)(NSInteger);
+@end
+
+@implementation HeliumCommandRow
+@synthesize primaryText = _primaryText, secondaryText = _secondaryText,
+            tagText = _tagText, resultImage = _resultImage,
+            selected = _selected, onHover = _onHover;
+- (BOOL)isFlipped {
+  return YES;
+}
+- (BOOL)acceptsFirstResponder {
+  return NO;
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  for (NSTrackingArea* area in self.trackingAreas.copy) {
+    [self removeTrackingArea:area];
+  }
+  [self addTrackingArea:[[NSTrackingArea alloc]
+                            initWithRect:NSZeroRect
+                                 options:NSTrackingMouseEnteredAndExited |
+                                         NSTrackingActiveInKeyWindow |
+                                         NSTrackingInVisibleRect
+                                   owner:self
+                                userInfo:nil]];
+}
+- (void)mouseEntered:(NSEvent*)event {
+  if (self.onHover) {
+    self.onHover(self.tag);
+  }
+}
+- (void)drawRect:(NSRect)dirtyRect {
+  if (self.selected) {
+    [[NSColor.selectedContentBackgroundColor colorWithAlphaComponent:0.25]
+        setFill];
+    [[NSBezierPath bezierPathWithRoundedRect:NSInsetRect(self.bounds, 0, 1)
+                                     xRadius:10
+                                     yRadius:10] fill];
+  }
+  [self.resultImage drawInRect:NSMakeRect(12, 18, 16, 16)
+                      fromRect:NSZeroRect
+                     operation:NSCompositingOperationSourceOver
+                      fraction:1
+                respectFlipped:YES
+                         hints:nil];
+  CGFloat width = NSWidth(self.bounds);
+  BOOL subtitle = self.secondaryText.length > 0;
+  DrawText(self.primaryText, NSMakeRect(40, subtitle ? 7 : 17, width - 142, 20),
+           13, NSColor.labelColor);
+  if (subtitle) {
+    DrawText(self.secondaryText, NSMakeRect(40, 28, width - 142, 17), 11,
+             NSColor.secondaryLabelColor);
+  }
+  DrawText(self.tagText, NSMakeRect(width - 94, 18, 82, 18), 11,
+           NSColor.secondaryLabelColor, NSTextAlignmentRight);
+}
+@end
+
+@interface HeliumCommandPane : NSView <NSTextFieldDelegate>
+@property(nonatomic, strong) NSTextField* input;
+@property(nonatomic, strong) NSTextField* scope;
+@property(nonatomic, strong) NSMutableArray<HeliumCommandRow*>* rows;
+@property(nonatomic, copy) void (^onQuery)(NSString*);
+@property(nonatomic, copy) BOOL (^onCommand)(SEL);
+@property(nonatomic, copy) void (^onActivate)(NSInteger);
+@end
+
+@implementation HeliumCommandPane
+@synthesize input = _input, scope = _scope, rows = _rows, onQuery = _onQuery,
+            onCommand = _onCommand, onActivate = _onActivate;
+- (BOOL)isFlipped {
+  return YES;
+}
+- (void)controlTextDidChange:(NSNotification*)notification {
+  if (self.onQuery) {
+    self.onQuery(self.input.stringValue);
+  }
+}
+- (BOOL)control:(NSControl*)control
+               textView:(NSTextView*)textView
+    doCommandBySelector:(SEL)selector {
+  return self.onCommand && self.onCommand(selector);
+}
+- (void)activateRow:(NSButton*)sender {
+  if (self.onActivate) {
+    self.onActivate(sender.tag);
+  }
+}
+- (void)layout {
+  [super layout];
+  const CGFloat width = NSWidth(self.bounds);
+  self.input.frame = NSMakeRect(20, 19, width - 40, 26);
+  CGFloat y = kInputHeight + kInset;
+  if (!self.scope.hidden) {
+    self.scope.frame = NSMakeRect(20, y, width - 40, 22);
+    y += 26;
+  }
+  for (HeliumCommandRow* row in self.rows) {
+    row.frame = NSMakeRect(kInset, y, width - 2 * kInset, kRowHeight);
+    y += kRowHeight;
+  }
+}
+@end
+
+struct HeliumCommandBarView::Native {
+  NSView* __strong material;
+  HeliumCommandPane* __strong pane;
+  raw_ptr<views::NativeViewHost> host = nullptr;
+  int width = kWidth;
+  ~Native() {
+    pane.input.delegate = nil;
+    pane.onQuery = nil;
+    pane.onCommand = nil;
+    pane.onActivate = nil;
+    for (HeliumCommandRow* row in pane.rows) {
+      row.onHover = nil;
+      row.target = nil;
+    }
+    [material removeFromSuperview];
+  }
+};
