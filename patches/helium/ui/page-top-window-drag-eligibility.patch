+bool HasInteractiveAriaRole(const Element& element) {
+  const AtomicString& role_attribute =
+      element.FastGetAttribute(html_names::kRoleAttr);
+  if (role_attribute.empty()) {
+    return false;
+  }
+  for (const auto& token :
+       role_attribute.GetString().SimplifyWhiteSpace().SplitSkippingEmpty(' ')) {
+    const auto role = AriaRoleToInternalRole(AtomicString(token.ToAsciiLower()));
+    if (role != ax::mojom::blink::Role::kUnknown) {
+      return ui::IsControl(role) || ui::IsLink(role) || ui::IsSelect(role);
+    }
+  }
+  return false;
+}
