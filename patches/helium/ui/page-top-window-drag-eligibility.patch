+ public:
+  PageTopDragInputObserver(content::RenderWidgetHost& host,
+                           base::TimeTicks press,
+                           const gfx::PointF& press_position)
+      : press_(press), press_position_(press_position) {
+    host_observation_.Observe(&host);
+    input_observation_.Observe(&host);
+  }
+
+  void WillForwardMotion(base::TimeTicks motion) {
+    if (first_motion_.is_null()) {
+      first_motion_ = motion;
+    }
+    latest_motion_ = motion;
+  }
+
+  bool ShouldLeaveWithPage(base::TimeTicks now) const {
+    return denied_ || !host_observation_.IsObserving() ||
+           (!first_motion_.is_null() &&
+            now - first_motion_ > kPageTopDragDecisionTimeout);
+  }
+
+  bool IsReadyForWindowDrag() const {
+    return !approved_motion_.is_null() && approved_motion_ == latest_motion_;
+  }
+
+ private:
+  void OnInputEventAck(const content::RenderWidgetHost&,
+                       blink::mojom::InputEventResultSource source,
+                       blink::mojom::InputEventResultState,
+                       const blink::WebInputEvent& event) override {
+    if (source != blink::mojom::InputEventResultSource::kMainThread || denied_) {
+      return;
+    }
+    using Type = blink::WebInputEvent::Type;
+    if (event.GetType() == Type::kMouseDown && event.TimeStamp() == press_) {
+      press_acknowledged_ = true;
+    }
+    if (!press_acknowledged_ || event.GetType() != Type::kMouseMove ||
+        latest_motion_.is_null() || event.TimeStamp() != latest_motion_ ||
+        static_cast<const blink::WebMouseEvent&>(event).button !=
+            blink::WebMouseEvent::Button::kLeft) {
+      return;
+    }
+
+    // Blink has dispatched both the press and the motion to the page. The
+    // generic input acknowledgement cannot distinguish a DOM cancellation
+    // from ordinary mouse handling, so ask Blink about this gesture.
+    content::IsPageTopDragTarget(
+        *input_observation_.GetSource(), press_position_,
+        base::BindOnce(&PageTopDragInputObserver::OnEligibility,
+                       weak_factory_.GetWeakPtr(), event.TimeStamp()));
+  }
+
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost*) override {
+    input_observation_.Reset();
+    host_observation_.Reset();
+  }
+
+  void OnEligibility(base::TimeTicks motion, bool eligible) {
+    if (eligible) {
+      approved_motion_ = motion;
+    } else {
+      denied_ = true;
+    }
+  }
+
+  const base::TimeTicks press_;
+  const gfx::PointF press_position_;
+  base::TimeTicks first_motion_;
+  base::TimeTicks latest_motion_;
+  base::TimeTicks approved_motion_;
+  bool press_acknowledged_ = false;
+  bool denied_ = false;
+  base::ScopedObservation<content::RenderWidgetHost,
+                          content::RenderWidgetHostObserver>
+      host_observation_{this};
+  base::ScopedObservation<content::RenderWidgetHost,
+                          content::RenderWidgetHost::InputEventObserver>
+      input_observation_{this};
+  base::WeakPtrFactory<PageTopDragInputObserver> weak_factory_{this};
+};
