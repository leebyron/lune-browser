+bool EventHandler::IsPageTopDragTarget(const HitTestResult& hit,
+                                      const HitTestLocation& location) {
+  Node* node = hit.InnerNode();
+  if (!page_top_drag_press_unclaimed_ || !page_top_drag_dispatched_motion_ ||
+      !MousePressed() || pointer_event_manager_->GetMouseCaptureTarget() ||
+      scroll_manager_->InResizeMode() ||
+      mouse_event_manager_->GetDragState().drag_src_ ||
+      (GetSelectionController().HasExtendedSelection() &&
+       frame_->Selection().GetSelectionInDomTree().IsRange()) ||
+      !node || node != mouse_event_manager_->MousePressNode() ||
+      &node->GetDocument() != frame_->GetDocument() || hit.GetScrollbar() ||
+      hit.IsOverEmbeddedContentView() || hit.URLElement() ||
+      hit.InnerPossiblyPseudoNode() != node || hit.IsSelected(location) ||
+      node->IsInUserAgentShadowRoot() || IsEditable(*node) ||
+      (node->IsTextNode() && node->CanStartSelection())) {
+    return false;
+  }
+
+  for (auto* element = hit.InnerElement(); element;
+       element = FlatTreeTraversal::ParentElement(*element)) {
+    const auto* html = DynamicTo<HTMLElement>(element);
+    const auto* layout = element->GetLayoutObject();
+    if ((html && (html->draggable() || html->IsInteractiveContent())) ||
+        (layout && layout->IsLayoutReplaced()) ||
+        element->HasActivationBehavior() ||
+        element->FastHasAttribute(html_names::kTabindexAttr) ||
+        element->IsShadowHostWithDelegatesFocus() ||
+        HasInteractiveAriaRole(*element)) {
+      return false;
+    }
+  }
+
+  const auto cursor = SelectCursor(location, hit);
+  return cursor && cursor->type() == PointerCursor().type();
+}
