+void VerticalTabStripRegionView::UpdateScrollEdgeSeparators() {
+  auto* strip = tab_strip_view();
+  auto* scroll = strip ? strip->unpinned_tabs_scroll_view() : nullptr;
+  if (!scroll || !scroll->contents() || scroll->height() <= 0) {
+    scroll_top_separator_->SetVisible(false);
+    footer_->SetScrollOverflow(false, interior_margin_);
+    return;
+  }
+  const gfx::Rect visible = scroll->GetVisibleRect();
+  const gfx::Rect viewport = views::View::ConvertRectToTarget(
+      scroll, content_area_view_, scroll->GetLocalBounds());
+  // Span the sidebar's outer edges, including its content side insets.
+  // Overlay the lines without consuming row or footer space.
+  const int line_x = -interior_margin_.left();
+  const int line_width =
+      content_area_view_->width() + interior_margin_.width();
+  scroll_top_separator_->SetBounds(line_x, viewport.y(), line_width, 1);
+  scroll_top_separator_->SetVisible(visible.y() > 0);
+  footer_->SetScrollOverflow(
+      visible.bottom() < scroll->contents()->height(), interior_margin_);
+}
