+using MediaAction = media_session::mojom::MediaSessionAction;
+
+bool IsMediaCommand(int command) {
+  return command <= kMediaPlayPause && command >= kMediaSkipAd;
+}
+
+std::optional<MediaAction> AvailableMediaAction(content::WebContents* contents,
+                                                int command) {
+  auto* session = content::MediaSession::GetIfExists(contents);
+  if (!session) {
+    return std::nullopt;
+  }
+  const auto info = session->GetMediaSessionInfoSync();
+  if (!info ||
+      (command != kMediaPictureInPicture &&
+       (!info->is_controllable ||
+        info->state ==
+            media_session::mojom::MediaSessionInfo::SessionState::kInactive))) {
+    return std::nullopt;
+  }
+  MediaAction action;
+  switch (command) {
+    case kMediaPlayPause:
+      action = info->playback_state ==
+                       media_session::mojom::MediaPlaybackState::kPlaying
+                   ? MediaAction::kPause
+                   : MediaAction::kPlay;
+      break;
+    case kMediaPictureInPicture:
+      action = info->picture_in_picture_state ==
+                       media_session::mojom::MediaPictureInPictureState::
+                           kInPictureInPicture
+                   ? MediaAction::kExitPictureInPicture
+                   : MediaAction::kEnterPictureInPicture;
+      break;
+    case kMediaPreviousTrack:
+      action = MediaAction::kPreviousTrack;
+      break;
+    case kMediaNextTrack:
+      action = MediaAction::kNextTrack;
+      break;
+    case kMediaSeekBackward:
+      action = MediaAction::kSeekBackward;
+      break;
+    case kMediaSeekForward:
+      action = MediaAction::kSeekForward;
+      break;
+    case kMediaStop:
+      action = MediaAction::kStop;
+      break;
+    case kMediaSkipAd:
+      action = MediaAction::kSkipAd;
+      break;
+    default:
+      return std::nullopt;
+  }
+  const auto actions = session->GetMediaSessionActionsSync();
+  return std::ranges::find(actions, action) != actions.end()
+             ? std::optional(action)
+             : std::nullopt;
+}
+
+bool ExecuteMediaAction(content::MediaSession* session, MediaAction action) {
+  using SuspendType = content::MediaSession::SuspendType;
+  switch (action) {
+    case MediaAction::kPlay:
+      session->Resume(SuspendType::kUI);
+      break;
+    case MediaAction::kPause:
+      session->Suspend(SuspendType::kUI);
+      break;
+    case MediaAction::kPreviousTrack:
+      session->PreviousTrack();
+      break;
+    case MediaAction::kNextTrack:
+      session->NextTrack();
+      break;
+    case MediaAction::kSeekBackward:
+      session->Seek(
+          base::Seconds(-media_session::mojom::kDefaultSeekTimeSeconds));
+      break;
+    case MediaAction::kSeekForward:
+      session->Seek(
+          base::Seconds(media_session::mojom::kDefaultSeekTimeSeconds));
+      break;
+    case MediaAction::kStop:
+      session->Stop(SuspendType::kUI);
+      break;
+    case MediaAction::kSkipAd:
+      session->SkipAd();
+      break;
+    case MediaAction::kEnterPictureInPicture:
+      session->EnterPictureInPicture();
+      break;
+    case MediaAction::kExitPictureInPicture:
+      session->ExitPictureInPicture();
+      break;
+    default:
+      return false;
+  }
+  return true;
+}
+
+std::u16string CommandShortcut(BrowserWindowInterface* browser, int command) {
+  auto* service =
+      browser_shortcuts::BrowserShortcutServiceFactory::GetForProfile(
+          browser->GetProfile());
+  if (!service) {
+    return {};
+  }
+  // Some menu actions and keyboard handlers have different IDs. Match only
+  // wrappers that currently perform this action, never a similarly named
+  // target-tab command or a shortcut currently repurposed for another task.
+  std::vector<int> ids{command};
+  auto* prefs = browser->GetProfile()->GetPrefs();
+  auto* layout = HeliumLayoutStateController::From(browser);
+  const bool collapse = layout && layout->IsVerticalLayout() &&
+                        prefs->GetBoolean(prefs::kVerticalCollapseShortcut);
+  if (command == IDC_TASK_MANAGER) {
+    ids.push_back(IDC_TASK_MANAGER_SHORTCUT);
+  } else if ((command == IDC_COPY_URL &&
+              prefs->GetBoolean(prefs::kCopyPageUrlShortcut)) ||
+             (command == IDC_DEV_TOOLS_INSPECT &&
+              !prefs->GetBoolean(prefs::kCopyPageUrlShortcut))) {
+    ids.push_back(IDC_COPY_OR_INSPECT_SHORTCUT);
+  } else if (command == IDC_SAVE_PAGE && !collapse) {
+    ids.push_back(IDC_CTRL_S_SHORTCUT);
+  } else if (command == kPinSidebar && collapse) {
+    ids.push_back(IDC_CTRL_S_SHORTCUT);
+  }
+  const auto& commands = service->GetCommands();
+  for (int id : ids) {
+    const auto entry = std::ranges::find(
+        commands, id, &browser_shortcuts::CommandInfo::command_id);
+    if (entry != commands.end() && !entry->accelerators.empty()) {
+      return entry->accelerators.front().display_text;
+    }
+  }
+  // The service is authoritative, including deliberately removed bindings.
+  return {};
+}
+
+int CommandUsageScore(const base::DictValue& usage,
+                      const char* key,
+                      base::Time now) {
+  const auto* entry = usage.FindDict(key);
+  if (!entry) {
+    return 0;
+  }
+  const int frequency = std::clamp(entry->FindInt("count").value_or(0), 0, 20);
+  const double last = entry->FindDouble("last_used").value_or(0);
+  const double age =
+      std::clamp((now.InSecondsFSinceUnixEpoch() - last) / 86400.0, 0.0, 30.0);
+  const int recency = last > 0 ? 30 - static_cast<int>(age) : 0;
+  return frequency + recency;
+}
+
+void RecordCommandUse(Profile* profile, int command) {
+  if (profile->IsOffTheRecord()) {
+    return;
+  }
+  const auto entry = std::ranges::find(kCommands, command, &Entry::command);
+  if (entry == std::end(kCommands)) {
+    return;
+  }
+  ScopedDictPrefUpdate update(profile->GetPrefs(),
+                              prefs::kHeliumCommandBarCommandUsage);
+  auto* record = update->EnsureDict(entry->usage_key);
+  record->Set("count",
+              std::clamp(record->FindInt("count").value_or(0), 0, 999) + 1);
+  record->Set("last_used", base::Time::Now().InSecondsFSinceUnixEpoch());
+  // Only the fixed registry's stable keys can be written: history is bounded
+  // by the catalogue rather than query text, URLs or transient tab identities.
+}
