+
+bool IsCommandQuery(const std::u16string& query) {
+  std::u16string trimmed;
+  base::TrimWhitespace(query, base::TRIM_LEADING, &trimmed);
+  return trimmed.starts_with(u"/") && !trimmed.starts_with(u"//");
+}
+
+std::optional<HeliumCommandBarItem> CommandForId(
+    BrowserWindowInterface* browser,
+    int command) {
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return std::nullopt;
+  }
+  const auto entry = std::ranges::find(kCommands, command, &Entry::command);
+  if (entry == std::end(kCommands)) {
+    return std::nullopt;
+  }
+  auto* strip = browser->GetTabStripModel();
+  if (!strip || !strip->GetActiveWebContents()) {
+    return std::nullopt;
+  }
+  auto* layout = HeliumLayoutStateController::From(browser);
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+  const bool zen = layout && layout->IsZenModeEnabled();
+  const bool vertical_layout = layout && layout->IsVerticalLayout();
+  if (command > 0 && (!chrome::SupportsCommand(browser, command) ||
+                      !chrome::IsCommandEnabled(browser, command))) {
+    return std::nullopt;
+  }
+  int label = entry->label;
+  std::string symbol = entry->symbol;
+  const int active = strip->active_index();
+  if (IsMediaCommand(command)) {
+    auto action = AvailableMediaAction(strip->GetActiveWebContents(), command);
+    if (!action) {
+      return std::nullopt;
+    }
+    if (*action == MediaAction::kPause) {
+      label = IDS_COMMAND_BAR_PAUSE_MEDIA;
+      symbol = "pause.fill";
+    } else if (*action == MediaAction::kExitPictureInPicture) {
+      label = IDS_COMMAND_BAR_EXIT_PICTURE_IN_PICTURE;
+      symbol = "pip.exit";
+    }
+  }
+  switch (command) {
+    case IDC_WINDOW_PIN_TAB:
+      if (!strip->IsContextMenuCommandEnabled(
+              active, TabStripModel::CommandTogglePinned)) {
+        return std::nullopt;
+      }
+      if (strip->IsTabPinned(active)) {
+        label = IDS_COMMAND_BAR_UNPIN_TAB;
+        symbol = "pin.slash";
+      }
+      break;
+    case IDC_WINDOW_MUTE_SITE:
+      if (!strip->IsContextMenuCommandEnabled(
+              active, TabStripModel::CommandToggleSiteMuted)) {
+        return std::nullopt;
+      }
+      if (IsSiteMuted(*strip, active)) {
+        label = IDS_COMMAND_BAR_UNMUTE_SITE;
+        symbol = "speaker.wave.2";
+      } else {
+        auto* audible = RecentlyAudibleHelper::FromWebContents(
+            strip->GetActiveWebContents());
+        if (!audible || !audible->WasRecentlyAudible()) {
+          return std::nullopt;
+        }
+      }
+      break;
+    case IDC_FULLSCREEN:
+      if (browser->GetWindow()->IsFullscreen()) {
+        label = IDS_COMMAND_BAR_EXIT_FULLSCREEN;
+        symbol = "arrow.down.right.and.arrow.up.left";
+      }
+      break;
+    case IDC_BROWSER_LAYOUT_VERTICAL_RIGHT:
+      if (!vertical_layout) {
+        return std::nullopt;
+      }
+      if (browser->GetProfile()->GetPrefs()->GetBoolean(
+              prefs::kHeliumVerticalRightAligned)) {
+        label = IDS_COMMAND_BAR_MOVE_SIDEBAR_TO_LEFT;
+        symbol = "sidebar.left";
+      }
+      break;
+    case IDC_TOGGLE_ZEN_MODE_TOP_CHROME_PIN:
+      if (!zen || !view) {
+        return std::nullopt;
+      }
+      if (view->IsZenModeTopChromePinned()) {
+        label = IDS_COMMAND_BAR_UNPIN_TOP_BAR;
+        symbol = "pin.slash";
+      }
+      break;
+    case kPinSidebar:
+      if (!zen || !view) {
+        return std::nullopt;
+      }
+      if (view->IsZenModeSideChromePinned()) {
+        label = IDS_COMMAND_BAR_UNPIN_SIDEBAR;
+        symbol = "pin.slash";
+      }
+      break;
+  }
+  HeliumCommandBarItem item;
+  item.type = HeliumCommandBarItem::Type::kCommand;
+  item.command = command;
+  item.title = l10n_util::GetStringUTF16(label);
+  item.symbol_name = symbol;
+  item.shortcut = CommandShortcut(browser, command);
+  return item;
+}
+
+std::vector<HeliumCommandBarItem> CommandsForQuery(
+    BrowserWindowInterface* browser,
+    const std::u16string& query,
+    bool commands_only) {
+  std::u16string q;
+  base::TrimWhitespace(query, base::TRIM_ALL, &q);
+  if (commands_only && q.starts_with(u"/")) {
+    q.erase(0, 1);
+    base::TrimWhitespace(q, base::TRIM_ALL, &q);
+  }
+  q = base::i18n::ToLower(q);
+  std::vector<HeliumCommandBarItem> items;
+  if (!browser || (q.empty() && !commands_only)) {
+    return items;
+  }
+  for (const auto& entry : kCommands) {
+    auto item = CommandForId(browser, entry.command);
+    if (!item) {
+      continue;
+    }
+    int score = q.empty() ? 1 : ScoreText(base::i18n::ToLower(item->title), q);
+    for (const auto& alias :
+         base::SplitString(entry.aliases, "|", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY)) {
+      score = std::max(score, ScoreText(base::UTF8ToUTF16(alias), q));
+    }
+    if (score > 0) {
+      item->score = score;
+      items.push_back(std::move(*item));
+    }
+  }
+  const auto& usage =
+      browser->GetProfile()->GetOriginalProfile()->GetPrefs()->GetDict(
+          prefs::kHeliumCommandBarCommandUsage);
+  const auto now = base::Time::Now();
+  std::ranges::stable_sort(items, [&usage, now](const auto& a, const auto& b) {
+    if (a.score != b.score) {
+      return a.score > b.score;
+    }
+    const auto entry_a =
+        std::ranges::find(kCommands, a.command, &Entry::command);
+    const auto entry_b =
+        std::ranges::find(kCommands, b.command, &Entry::command);
+    return CommandUsageScore(usage, entry_a->usage_key, now) >
+           CommandUsageScore(usage, entry_b->usage_key, now);
+  });
+  return items;
+}
+
+bool ExecutePaletteCommand(BrowserWindowInterface* browser,
+                           const HeliumCommandBarItem& item) {
+  auto current = CommandForId(browser, item.command);
+  if (!current || current->title != item.title ||
+      current->symbol_name != item.symbol_name) {
+    return false;
+  }
+  // Record the accepted invocation before a handler can destroy its window
+  // or profile (for example, closing the final private tab).
+  auto* strip = browser->GetTabStripModel();
+  content::MediaSession* session = nullptr;
+  std::optional<MediaAction> media_action;
+  if (IsMediaCommand(item.command)) {
+    session = content::MediaSession::GetIfExists(strip->GetActiveWebContents());
+    media_action =
+        AvailableMediaAction(strip->GetActiveWebContents(), item.command);
+    if (!session || !media_action) {
+      return false;
+    }
+  }
+  RecordCommandUse(browser->GetProfile(), item.command);
+  if (media_action) {
+    return ExecuteMediaAction(session, *media_action);
+  }
+  const int active = strip->active_index();
+  switch (item.command) {
+    case IDC_WINDOW_PIN_TAB:
+      // Explicitly target the active pane, even with a multi-tab selection.
+      strip->SetTabPinned(active, !strip->IsTabPinned(active));
+      return true;
+    case IDC_WINDOW_MUTE_SITE:
+      strip->SetSitesMuted({active}, !IsSiteMuted(*strip, active));
+      return true;
+    case kPinSidebar:
+      BrowserView::GetBrowserViewForBrowser(browser)->ToggleZenModeSideChrome();
+      return true;
+    default:
+      // Includes browser policy, navigation and close/unload checks.
+      return chrome::ExecuteCommand(browser, item.command);
+  }
+}
