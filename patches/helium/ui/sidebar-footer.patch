+SidebarFooterView::SidebarFooterView(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser), state_controller_(state_controller) {
+  SetOrientation(views::LayoutOrientation::kVertical);
+  SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  SetDefault(views::kMarginsKey, gfx::Insets::TLBR(2, 0, 0, 0));
+
+  update_button_ = AddChildView(std::make_unique<FooterButton>(
+      base::BindRepeating([] { chrome::AttemptRelaunch(); }),
+      IDS_RELAUNCH_TO_UPDATE, vector_icons::kRefreshIcon));
+
+  default_prompt_ = AddChildView(std::make_unique<views::FlexLayoutView>());
+  default_prompt_->SetOrientation(views::LayoutOrientation::kHorizontal);
+  default_prompt_->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  default_button_ =
+      default_prompt_->AddChildView(std::make_unique<FooterButton>(
+          base::RepeatingClosure(), IDS_DEFAULT_BROWSER_INFOBAR_OK_BUTTON_LABEL,
+          omnibox::kProductChromeRefreshOldIcon));
+  default_button_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                               views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  default_button_->set_context_menu_controller(this);
+  dismiss_button_ =
+      default_prompt_->AddChildView(std::make_unique<FooterButton>(
+          base::RepeatingClosure(), IDS_APP_CLOSE, vector_icons::kCloseIcon));
+  dismiss_button_->SetText(u"");
+  dismiss_button_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  dismiss_button_->SetPreferredSize(
+      gfx::Size(28, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+  dismiss_button_->set_context_menu_controller(this);
+
+  collapse_subscription_ =
+      state_controller_->RegisterOnCollapseChanged(base::BindRepeating(
+          [](SidebarFooterView* footer, tabs::VerticalTabStripCollapseState) {
+            footer->UpdateState();
+          },
+          base::Unretained(this)));
+#if BUILDFLAG(ENABLE_SPARKLE)
+  update_subscription_ = helium::RegisterUpdateReadyChanged(base::BindRepeating(
+      &SidebarFooterView::UpdateState, base::Unretained(this)));
+#endif
+  UpdateState();
+}
+
+SidebarFooterView::~SidebarFooterView() = default;
+
+void SidebarFooterView::SetDefaultBrowserPrompt(base::RepeatingClosure accept,
+                                                base::RepeatingClosure dismiss,
+                                                base::RepeatingClosure reject) {
+  has_default_prompt_ = !accept.is_null();
+  default_button_->SetCallback(std::move(accept));
+  dismiss_ = std::move(dismiss);
+  reject_ = std::move(reject);
+  dismiss_button_->SetCallback(dismiss_);
+  UpdateState();
+}
+
+void SidebarFooterView::UpdateState() {
+  bool ready = false;
+#if BUILDFLAG(ENABLE_SPARKLE)
+  ready = helium::ApplicationIsNearlyUpdated();
+#endif
+  const bool collapsed = state_controller_->GetCollapseState() ==
+                         tabs::VerticalTabStripCollapseState::kCollapsed;
+  // Keep actions reachable in the narrow strip; their full names remain in
+  // accessibility and tooltips. Expand-on-hover restores the full labels.
+  default_button_->SetText(
+      collapsed ? u""
+                : l10n_util::GetStringUTF16(
+                      IDS_DEFAULT_BROWSER_INFOBAR_OK_BUTTON_LABEL));
+  default_button_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_DEFAULT_BROWSER_INFOBAR_OK_BUTTON_LABEL));
+  update_button_->SetText(
+      collapsed ? u"" : l10n_util::GetStringUTF16(IDS_RELAUNCH_TO_UPDATE));
+  update_button_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_RELAUNCH_TO_UPDATE));
+  dismiss_button_->SetVisible(!collapsed);
+  default_prompt_->SetVisible(has_default_prompt_);
+  update_button_->SetVisible(ready);
+  SetVisible(has_default_prompt_ || ready);
+  PreferredSizeChanged();
+}
+
+void SidebarFooterView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (!has_default_prompt_) {
+    return;
+  }
+  menu_runner_.reset();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(0, l10n_util::GetStringUTF16(IDS_APP_CLOSE));
+  menu_model_->AddItem(
+      1, l10n_util::GetStringUTF16(IDS_CARET_BROWSING_DO_NOT_ASK));
+  menu_lock_ =
+      BrowserView::GetBrowserViewForBrowser(browser_)
+          ->tab_strip_view()
+          ->GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepCurrentState);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU,
+      base::BindRepeating(
+          [](SidebarFooterView* footer) { footer->menu_lock_.reset(); },
+          base::Unretained(this)));
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void SidebarFooterView::ExecuteCommand(int command_id, int event_flags) {
+  // The manager posts closure of all prompts, so menu dispatch can finish
+  // safely.
+  auto action = command_id == 1 ? reject_ : dismiss_;
+  if (action) {
+    action.Run();
+  }
+}
