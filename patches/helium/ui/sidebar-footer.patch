+namespace {
+// Match the density and native colors of the surrounding tab rows. A footer
+// action keeps its preferred height even when the tabs have room to grow.
+class FooterButton : public views::LabelButton {
+  METADATA_HEADER(FooterButton, views::LabelButton)
+ public:
+  FooterButton(base::RepeatingClosure action,
+               int message,
+               const gfx::VectorIcon& icon)
+      : views::LabelButton(std::move(action),
+                           l10n_util::GetStringUTF16(message)),
+        icon_(icon) {
+    SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 7)));
+    SetImageLabelSpacing(7);
+    SetPreferredSize(
+        gfx::Size(-1, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+    SetTooltipText(l10n_util::GetStringUTF16(message));
+    GetViewAccessibility().SetName(l10n_util::GetStringUTF16(message));
+  }
+
+  void OnThemeChanged() override {
+    views::LabelButton::OnThemeChanged();
+    const SkColor color = helium::NativeGlassControlColor(this).value_or(
+        GetColorProvider()->GetColor(kColorTabForegroundInactiveFrameActive));
+    SetEnabledTextColors(color);
+    SetImageModel(STATE_NORMAL,
+                  ui::ImageModel::FromVectorIcon(*icon_, color, 16));
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    if (GetState() != STATE_HOVERED && GetState() != STATE_PRESSED) {
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(
+        helium::NativeGlassColor(this, helium::NativeGlassColorRole::kHover)
+            .value_or(GetColorProvider()->GetColor(
+                kColorTabBackgroundInactiveHoverFrameActive)));
+    canvas->DrawRoundRect(
+        gfx::RectF(GetLocalBounds()),
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+  }
+
+ private:
+  const raw_ref<const gfx::VectorIcon> icon_;
+};
+BEGIN_METADATA(FooterButton)
+END_METADATA
+}  // namespace
