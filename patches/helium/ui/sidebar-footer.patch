+
+void DefaultBrowserInfoBarManager::UpdateBrowserPrompt(
+    BrowserWindowInterface* browser) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+  auto* region =
+      view ? static_cast<VerticalTabStripRegionView*>(view->GetSidebarView())
+           : nullptr;
+  const bool sidebar = UsesSidebar(browser);
+  if (region) {
+    auto callback = [&](SidebarAction action) {
+      return base::BindRepeating(&DefaultBrowserInfoBarManager::OnSidebarAction,
+                                 weak_factory_.GetWeakPtr(),
+                                 browser->GetProfile(), action);
+    };
+    region->footer()->SetDefaultBrowserPrompt(
+        sidebar ? callback(SidebarAction::kAccept) : base::RepeatingClosure(),
+        sidebar ? callback(SidebarAction::kDismiss) : base::RepeatingClosure(),
+        sidebar ? callback(SidebarAction::kReject) : base::RepeatingClosure());
+  }
+  auto* model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    auto* contents = model->GetWebContentsAt(i);
+    auto it = infobars_.find(contents);
+    if (sidebar && it != infobars_.end()) {
+      auto* bar = it->second.get();
+      bar->owner()->RemoveObserver(this);
+      static_cast<ConfirmInfoBarDelegate*>(bar->delegate())
+          ->RemoveObserver(this);
+      infobars_.erase(it);
+      bar->RemoveSelf();
+    } else if (!sidebar && it == infobars_.end()) {
+      CreateInfoBarForWebContents(contents, browser->GetProfile());
+    }
+  }
+}
+
+void DefaultBrowserInfoBarManager::OnSidebarAction(Profile* profile,
+                                                   SidebarAction action) {
+  if (sidebar_action_pending_) {
+    return;
+  }
+  sidebar_action_pending_ = true;
+  // Match the legacy delegate's preference updates, then use the same
+  // controller and global dismissal path. Defer destruction until after the
+  // button callback.
+  if (action == SidebarAction::kReject) {
+    g_browser_process->local_state()->SetBoolean(
+        prefs::kHeliumDefaultBrowserRejected, true);
+  } else {
+    chrome::startup::default_prompt::UpdatePrefsForDismissedPrompt(profile);
+  }
+  if (action == SidebarAction::kAccept) {
+    ProcessAccept();
+  } else {
+    ProcessDismiss();
+  }
+  CloseAllPromptsSoon(action == SidebarAction::kAccept ? CloseReason::kAccept
+                                                       : CloseReason::kDismiss);
+}
