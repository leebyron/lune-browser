+void AlignPanelsWithSidebar(PrefService* pref_service) {
+  // Keep browser panels opposite the tab sidebar, including restored profiles
+  // and writes from Settings or another browser window.
+  const bool panel_on_right =
+      !pref_service->GetBoolean(prefs::kHeliumVerticalRightAligned);
+  if (pref_service->GetBoolean(prefs::kSidePanelHorizontalAlignment) !=
+      panel_on_right) {
+    pref_service->SetBoolean(prefs::kSidePanelHorizontalAlignment, panel_on_right);
+  }
+}
+
+}  // namespace
+#endif
