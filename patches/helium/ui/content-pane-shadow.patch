description: add a subtle compositor shadow behind each rounded content pane

--- a/chrome/browser/ui/views/frame/contents_container_view.cc
+++ b/chrome/browser/ui/views/frame/contents_container_view.cc
@@ -42,6 +42,7 @@
 #include "ui/gfx/geometry/insets.h"
 #include "ui/gfx/geometry/rect.h"
 #include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/views/accessibility/view_accessibility.h"
 #include "ui/views/border.h"
 #include "ui/views/layout/delegating_layout_manager.h"
 #include "ui/views/layout/fill_layout.h"
@@ -49,6 +50,7 @@
 #include "ui/views/metadata/view_factory.h"
 #include "ui/views/view.h"
 #include "ui/views/view_class_properties.h"
+#include "ui/views/view_decoration.h"
 #include "ui/views/widget/widget.h"
 
 #if BUILDFLAG(IS_WIN)
@@ -67,6 +69,19 @@
   SetLayoutManager(std::make_unique<views::DelegatingLayoutManager>(this));
   SetProperty(views::kElementIdentifierKey, kContentsContainerViewElementId);
 
+  // Keep the shadow below every surface in the pane. A separate transparent
+  // anchor avoids shadowing individual DevTools or footer surfaces and lets the
+  // decoration extend into surrounding chrome without clipping web content.
+  content_shadow_anchor_ = AddChildView(std::make_unique<views::View>());
+  content_shadow_anchor_->SetPaintToLayer();
+  content_shadow_anchor_->layer()->SetFillsBoundsOpaquely(false);
+  content_shadow_anchor_->SetCanProcessEventsWithinSubtree(false);
+  content_shadow_anchor_->GetViewAccessibility().SetIsIgnored(true);
+  content_shadow_anchor_->SetVisible(false);
+  content_shadow_ =
+      std::make_unique<views::ViewDecoration>(content_shadow_anchor_);
+  content_shadow_->SetShadow(2);
+
   // The default z-order is the order in which children were added to the
   // parent view. So first added devtools and the devtools scrim view (as it
   // exists behind the content view), then the content view and new tab page
@@ -313,6 +328,7 @@
   contents_view_->SetBackgroundRadii(radii);
   contents_view_->holder()->SetNativeViewCornerRadii(radii);
   contents_scrim_view_->SetRoundedCorners(corner_radii);
+  content_shadow_->SetRoundedCorners(corner_radii);
 
   if (new_tab_footer_view_) {
     new_tab_footer_view_->SetBackgroundRadii(content_lower_rounded_corners);
@@ -647,6 +663,10 @@
   }
 
   gfx::Rect full_contents_bounds = GetContentsBounds();
+  layouts.child_layouts.emplace_back(
+      content_shadow_anchor_.get(),
+      should_round_contents_ && !full_contents_bounds.IsEmpty(),
+      full_contents_bounds);
   gfx::Rect devtools_bounds;
   // The area contents excluding devtools is drawn (ie |contents_view_|,
   // |new_tab_footer_view_|, etc).
--- a/chrome/browser/ui/views/frame/contents_container_view.h
+++ b/chrome/browser/ui/views/frame/contents_container_view.h
@@ -38,6 +38,7 @@
 }  // namespace new_tab_footer
 
 namespace views {
+class ViewDecoration;
 class WebView;
 }  // namespace views
 
@@ -197,6 +198,11 @@
 
   raw_ptr<BrowserView> browser_view_ = nullptr;
 
+  // A non-interactive anchor enclosing the whole pane, including docked DevTools.
+  // Its decoration is behind web content and never changes the content insets.
+  raw_ptr<views::View> content_shadow_anchor_ = nullptr;
+  std::unique_ptr<views::ViewDecoration> content_shadow_;
+
   // An invisible view used to anchor tab toasts to the top of the contents
   // view, while being before the contents view in the focus order.
   raw_ptr<views::View> toast_anchor_view_ = nullptr;
