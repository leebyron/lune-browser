+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_NATIVE_WORD_NAVIGATION_MAC_H_
+#define CHROME_BROWSER_UI_HELIUM_NATIVE_WORD_NAVIGATION_MAC_H_
+
+#import <AppKit/AppKit.h>
+
+// Installs the word-boundary storage before editing starts, so native typing
+// undo always targets the active storage. Other cell behavior stays native.
+@interface HeliumWordTextFieldCell : NSTextFieldCell
+@end
+
+namespace helium {
+
+// Supplies Chromium word boundaries to AppKit for word movement/selection.
+// AppKit still performs the command and owns selection anchors and bidi motion.
+bool HandleNativeWordNavigation(NSControl* control,
+                                 NSTextView* editor,
+                                 SEL command);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_NATIVE_WORD_NAVIGATION_MAC_H_
Index: fixture-src/chrome/browser/ui/helium/native_word_navigation_mac.mm
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ fixture-src/chrome/browser/ui/helium/native_word_navigation_mac.mm	2026-11-12 11:23:52.834912416 -0800
@@ -0,0 +1,169 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/native_word_navigation_mac.h"
+
+#import <objc/message.h>
+#import <objc/runtime.h>
+
+#include "base/i18n/break_iterator.h"
+#include "base/strings/sys_string_conversions.h"
+
+namespace {
+char kWordStorageKey;
+}  // namespace
+
+// AppKit's word commands consult NSTextStorage's nextWordFromIndex:forward:.
+// Override only that decision, leaving native movement, bidi selection and its
+// internal anchor intact. The field editor remains an ordinary NSTextView.
+@interface HeliumWordTextStorage : NSTextStorage
+- (void)prepareForControl:(NSControl*)control
+                  editor:(NSTextView*)editor
+          wordNavigation:(BOOL)wordNavigation;
+@end
+
+@implementation HeliumWordTextStorage {
+  NSMutableAttributedString* _backing;
+  __weak NSControl* _control;
+  __weak NSTextView* _editor;
+  BOOL _wordNavigation;
+}
+
+- (instancetype)init {
+  if ((self = [super init])) {
+    _backing = [[NSMutableAttributedString alloc] init];
+  }
+  return self;
+}
+
+- (NSString*)string {
+  return _backing.string;
+}
+
+- (NSDictionary<NSAttributedStringKey, id>*)attributesAtIndex:(NSUInteger)index
+                                            effectiveRange:(NSRangePointer)range {
+  return [_backing attributesAtIndex:index effectiveRange:range];
+}
+
+- (void)replaceCharactersInRange:(NSRange)range withString:(NSString*)string {
+  _wordNavigation = NO;
+  [_backing replaceCharactersInRange:range withString:string];
+  [self edited:NSTextStorageEditedCharacters
+                 range:range
+        changeInLength:static_cast<NSInteger>(string.length) -
+                       static_cast<NSInteger>(range.length)];
+}
+
+- (void)setAttributes:(NSDictionary<NSAttributedStringKey, id>*)attributes
+                range:(NSRange)range {
+  [_backing setAttributes:attributes range:range];
+  [self edited:NSTextStorageEditedAttributes range:range changeInLength:0];
+}
+
+- (void)prepareForControl:(NSControl*)control
+                  editor:(NSTextView*)editor
+          wordNavigation:(BOOL)wordNavigation {
+  _control = control;
+  _editor = editor;
+  _wordNavigation = wordNavigation;
+}
+
+- (NSUInteger)nextWordFromIndex:(NSUInteger)location forward:(BOOL)forward {
+  if (!_wordNavigation || !_editor || _control.currentEditor != _editor ||
+      _editor.hasMarkedText || location > self.length) {
+    return [super nextWordFromIndex:location forward:forward];
+  }
+  const std::u16string text = base::SysNSStringToUTF16(self.string);
+  base::i18n::BreakIterator words(text, base::i18n::BreakIterator::BREAK_WORD);
+  if (!words.Init()) {
+    return [super nextWordFromIndex:location forward:forward];
+  }
+  // Match RenderText's forward word ends and backward word starts. Chromium's
+  // existing ICU data splits hostnames at dots while retaining decimal numbers.
+  NSUInteger previous = 0;
+  while (words.Advance()) {
+    if (!words.IsWord()) {
+      continue;
+    }
+    if (forward && words.pos() > location) {
+      return words.pos();
+    }
+    if (!forward) {
+      if (words.prev() >= location) {
+        break;
+      }
+      previous = words.prev();
+    }
+  }
+  return forward ? text.size() : previous;
+}
+@end
+
+@implementation HeliumWordTextFieldCell
+- (instancetype)initTextCell:(NSString*)string {
+  if ((self = [super initTextCell:string])) {
+    self.editable = YES;
+    self.selectable = YES;
+    self.scrollable = YES;
+  }
+  return self;
+}
+
+- (NSText*)setUpFieldEditorAttributes:(NSText*)textObject {
+  NSText* result = [super setUpFieldEditorAttributes:textObject];
+  if ([result isKindOfClass:NSTextView.class]) {
+    NSTextView* editor = (NSTextView*)result;
+    HeliumWordTextStorage* storage =
+        objc_getAssociatedObject(editor, &kWordStorageKey);
+    if (!storage || editor.textStorage != storage) {
+      // Opt into AppKit's supported TextKit 1 compatibility mode before typing
+      // registers undo operations against the field editor's text storage.
+      NSTextStorage* original = editor.textStorage;
+      storage = [[HeliumWordTextStorage alloc] init];
+      [storage setAttributedString:original];
+      [editor.layoutManager replaceTextStorage:storage];
+      objc_setAssociatedObject(editor, &kWordStorageKey, storage,
+                               OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+  }
+  return result;
+}
+@end
+
+namespace helium {
+namespace {
+
+bool IsWordNavigation(SEL command) {
+  return command == @selector(moveWordLeft:) ||
+         command == @selector(moveWordRight:) ||
+         command == @selector(moveWordBackward:) ||
+         command == @selector(moveWordForward:) ||
+         command == @selector(moveWordLeftAndModifySelection:) ||
+         command == @selector(moveWordRightAndModifySelection:) ||
+         command == @selector(moveWordBackwardAndModifySelection:) ||
+         command == @selector(moveWordForwardAndModifySelection:);
+}
+}  // namespace
+
+bool HandleNativeWordNavigation(NSControl* control,
+                                NSTextView* editor,
+                                SEL command) {
+  if (!control || !editor || !IsWordNavigation(command) || editor.hasMarkedText) {
+    return false;
+  }
+  HeliumWordTextStorage* storage =
+      objc_getAssociatedObject(editor, &kWordStorageKey);
+  if (!storage || editor.textStorage != storage) {
+    return false;
+  }
+  // Invoke the native action directly, avoiding a second delegate dispatch.
+  // Enable the boundary override only for this command, including its selection
+  // update. Mouse selection, deletion and other controls keep native behavior.
+  [storage prepareForControl:control editor:editor wordNavigation:YES];
+  using WordAction = void (*)(id, SEL, id);
+  reinterpret_cast<WordAction>(objc_msgSend)(editor, command, nil);
+  [storage prepareForControl:nil editor:nil wordNavigation:NO];
+  return true;
+}
+}  // namespace helium
