+// The transparent child window hosts existing tab controls. Unhandled blank
+// space must still behave like the original browser sidebar, on either side.
+class FloatingSidebarContents : public views::View,
+                                public views::ContextMenuController {
+ public:
+  FloatingSidebarContents(BrowserView* browser, HeliumGlassDragRegion* drag)
+      : browser_(browser->GetAsWeakPtr()), drag_(drag) {
+    set_context_menu_controller(this);
+  }
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton() || !browser_) {
+      return false;
+    }
+    NSEvent* native = event.native_event().Get();
+    if (!native) {
+      // remote_cocoa can deliver a serialized Views event without its original
+      // NSEvent. Reconstruct this press, rather than using a later currentEvent.
+      gfx::Point screen = event.location();
+      views::View::ConvertPointToScreen(this, &screen);
+      NSWindow* window =
+          browser_->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+      native = [NSEvent mouseEventWithType:NSEventTypeLeftMouseDown
+          location:[window convertPointFromScreen:gfx::ScreenPointToNSPoint(screen)]
+          modifierFlags:NSEvent.modifierFlags
+          timestamp:NSProcessInfo.processInfo.systemUptime
+          windowNumber:window.windowNumber context:nil eventNumber:0
+          clickCount:event.GetClickCount() pressure:1];
+    }
+    [drag_ startWindowDrag:native];
+    return true;
+  }
+  void ShowContextMenuForViewImpl(views::View*, const gfx::Point& point,
+                                  ui::mojom::MenuSourceType source) override {
+    if (browser_) {
+      browser_->browser_widget()->ShowContextMenuForViewImpl(
+          browser_->GetSidebarView(), point, source);
+    }
+  }
+ private:
+  base::WeakPtr<BrowserView> browser_;
+  __weak HeliumGlassDragRegion* drag_;
+};
+}  // namespace
