+
+void ThemeColorPickerHandler::SetCustomColor(float hue,
+                                                float saturation,
+                                                bool is_drag) {
+#if BUILDFLAG(IS_MAC)
+  const auto current = GetCustomColorState();
+  if (!editing_session_ || !current || is_drag != drag_start_.has_value() ||
+      !std::isfinite(hue) || !std::isfinite(saturation) || hue < 0 ||
+      hue > 360 || saturation < 0 || saturation > 1) {
+    return;
+  }
+
+  // Store the point at appearance-independent lightness using the existing
+  // opaque RGB seed representation.
+  const CustomColorState next{
+      color_utils::HSLToSkColor(
+          {hue == 360 ? 0 : hue / 360.0, saturation, 0.5}, SK_AlphaOPAQUE),
+      ui::mojom::BrowserColorVariant::kCustomChroma, false, false};
+  if (*current == next) {
+    return;
+  }
+  if (!is_drag) {
+    SaveUndo(*current);
+  }
+  ApplyCustomColorState(next);
+  MaybeIncrementSeedColorChangeCount();
+#endif
+}
+
+void ThemeColorPickerHandler::SetEditingSession(bool active) {
+#if BUILDFLAG(IS_MAC)
+  if (editing_session_ == active) {
+    return;
+  }
+  editing_session_ = active;
+  auto drag_start = std::exchange(drag_start_, std::nullopt);
+  undo_.clear();
+  redo_.clear();
+  if (drag_start) {
+    ApplyCustomColorState(*drag_start);
+  }
+  opening_color_ = active ? GetCustomColorState() : std::nullopt;
+  UpdateTheme();
+#endif
+}
+
+void ThemeColorPickerHandler::EditCustomColor(
+    theme_color_picker::mojom::CustomColorAction action) {
+#if BUILDFLAG(IS_MAC)
+  using Action = theme_color_picker::mojom::CustomColorAction;
+  const auto current = GetCustomColorState();
+  if (!editing_session_ || !current) {
+    return;
+  }
+
+  switch (action) {
+    case Action::kBeginDrag:
+      if (!drag_start_) {
+        drag_start_ = current;
+      }
+      return;
+    case Action::kCommitDrag:
+      if (auto start = std::exchange(drag_start_, std::nullopt)) {
+        if (*start != *current) {
+          SaveUndo(*start);
+        }
+        UpdateTheme();
+      }
+      return;
+    case Action::kCancelDrag:
+      if (auto start = std::exchange(drag_start_, std::nullopt)) {
+        if (*start != *current) {
+          ApplyCustomColorState(*start);
+        } else {
+          UpdateTheme();
+        }
+      }
+      return;
+    case Action::kUndo:
+      if (!drag_start_) {
+        MoveHistory(undo_, redo_, *current);
+      }
+      return;
+    case Action::kRedo:
+      if (!drag_start_) {
+        MoveHistory(redo_, undo_, *current);
+      }
+      return;
+    case Action::kRestore:
+      if (!drag_start_ && opening_color_ && *opening_color_ != *current) {
+        SaveUndo(*current);
+        ApplyCustomColorState(*opening_color_);
+      }
+      return;
+  }
+#endif
+}
+
+#if BUILDFLAG(IS_MAC)
+std::optional<ThemeColorPickerHandler::CustomColorState>
+ThemeColorPickerHandler::GetCustomColorState() const {
+  if (!theme_service_->IsMacCustomTheme()) {
+    return std::nullopt;
+  }
+  return CustomColorState{
+      theme_service_->GetMacCustomThemeColor(),
+      theme_service_->GetBrowserColorVariant(),
+      theme_service_->GetIsGrayscale(),
+      theme_service_->UsingAutogeneratedTheme()};
+}
+
+void ThemeColorPickerHandler::ApplyCustomColorState(
+    const CustomColorState& state) {
+  if (theme_service_->UsingPolicyTheme()) {
+    return;
+  }
+  base::AutoReset<bool> applying(&applying_custom_color_, true);
+  if (state.grayscale) {
+    theme_service_->SetIsGrayscale(true);
+  } else if (state.autogenerated) {
+    theme_service_->BuildAutogeneratedThemeFromColor(state.color);
+  } else {
+    theme_service_->SetUserColorAndBrowserColorVariant(state.color,
+                                                      state.variant);
+  }
+}
+
+void ThemeColorPickerHandler::SaveUndo(const CustomColorState& state) {
+  constexpr size_t kMaxUndoEntries = 100;
+  if (undo_.size() >= kMaxUndoEntries) {
+    undo_.pop_front();
+  }
+  undo_.push_back(state);
+  redo_.clear();
+}
+
+void ThemeColorPickerHandler::MoveHistory(
+    std::deque<CustomColorState>& from,
+    std::deque<CustomColorState>& to,
+    const CustomColorState& current) {
+  if (from.empty()) {
+    return;
+  }
+  const auto state = from.back();
+  from.pop_back();
+  to.push_back(current);
+  ApplyCustomColorState(state);
+}
+#endif
