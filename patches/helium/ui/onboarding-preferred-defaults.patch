Index: src/chrome/browser/ui/webui/onboarding/onboarding_handler.cc
===================================================================
--- src.orig/chrome/browser/ui/webui/onboarding/onboarding_handler.cc
+++ src/chrome/browser/ui/webui/onboarding/onboarding_handler.cc
@@ -73,8 +73,15 @@ base::DictValue OnboardingMessageHandler
 
   // Explicitly allow this one non-Helium preference in onboarding. Keep the
   // general settings API restricted to its existing Helium namespace.
+  // Show the preferred choice without enabling requests merely by opening
+  // setup. Next on the search step persists it. Explicit choices, policy values
+  // and completed profiles keep their existing value when setup is revisited.
+  const bool recommend_suggestions =
+      !pref_service_->GetBoolean(prefs::kHeliumDidOnboarding) &&
+      pref_service_->FindPreference(prefs::kSearchSuggestEnabled)->IsDefaultValue();
   output.Set(prefs::kSearchSuggestEnabled,
-             pref_service_->GetBoolean(prefs::kSearchSuggestEnabled));
+             recommend_suggestions ||
+                 pref_service_->GetBoolean(prefs::kSearchSuggestEnabled));
   return output;
 }
 
