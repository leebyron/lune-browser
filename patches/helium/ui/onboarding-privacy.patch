+
+    const visible = $derived($currentPage === "Privacy");
+    const choices = [
+        { title: s.services.ublockEnabledTitle, desc: s.services.ublockEnabledDesc,
+          prefName: "ublock.enabled", available: !platform.is.android },
+        { title: s.privacy.trackingTitle, desc: s.privacy.trackingDesc,
+          prefName: "clean_tracking_links", available: true },
+        { title: s.privacy.fingerprintingTitle, desc: s.privacy.fingerprintingDesc,
+          prefName: "noise.enabled", available: true },
+        { title: s.privacy.globalPrivacyControlTitle, desc: s.privacy.globalPrivacyControlDesc,
+          prefName: "global_privacy_control", available: true },
+        { title: s.privacy.doNotTrackTitle, desc: s.privacy.doNotTrackDesc,
+          prefName: "enable_do_not_track", available: true },
+    ] as const;
+</script>
+
+<div id="privacy-page" class="onboarding-page" class:visible inert={!visible}>
+    <div class="scrollable-page">
+        <PageHeader title={s.privacy.title} subtitle={s.privacy.body} />
+        <div class="page-content">
+            {#each choices as choice (choice.prefName)}
+                {#if choice.available}
+                    <PreferenceToggle title={choice.title} desc={choice.desc}
