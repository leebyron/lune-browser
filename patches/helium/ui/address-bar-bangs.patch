+- (void)enterBang:(const std::string &)keyword
+            query:(const std::u16string &)query
+            typed:(BOOL)typed {
+  if (!_browserView)
+    return;
+  auto *service =
+      TemplateURLServiceFactory::GetForProfile(_browserView->GetProfile());
+  if (!keyword.starts_with("!") ||
+      !helium_command_bar_model::EngineOwnsKeyword(service, keyword))
+    return;
+  _scopeKeyword = keyword;
+  _scopeWasTyped = typed;
+  _scopePill.label.stringValue = base::SysUTF16ToNSString(
+      helium_command_bar_model::SiteScopeName(service, keyword));
+  _address.placeholderString =
+      [@"Search " stringByAppendingString:_scopePill.label.stringValue];
+  _address.stringValue = base::SysUTF16ToNSString(query);
+  [self layoutScope];
+  [self.window makeFirstResponder:_address];
+  [_address selectText:nil];
+  [self controlTextDidChange:nil];
+}
+
+- (void)leaveBangRestoringTrigger:(BOOL)restore {
+  const std::u16string keyword = restore && _scopeWasTyped
+                                     ? base::UTF8ToUTF16(_scopeKeyword)
+                                     : std::u16string();
+  const std::u16string query = base::SysNSStringToUTF16(_address.stringValue);
+  const std::u16string text =
+      keyword.empty() ? query : keyword + (query.empty() ? u"" : u" " + query);
+  _scopeKeyword.clear();
+  _scopeWasTyped = NO;
+  _scopePill.hidden = YES;
+  _address.frame = _addressContainer.bounds;
+  _address.placeholderString =
+      base::SysUTF16ToNSString(l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION));
+  _address.stringValue = base::SysUTF16ToNSString(text);
+  [_address selectText:nil];
+  _address.currentEditor.selectedRange = NSMakeRange(keyword.size(), 0);
+  [self controlTextDidChange:nil];
+}
