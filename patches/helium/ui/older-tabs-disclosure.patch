 TEST_P(TabCollectionAnimatingLayoutManagerTest,
+       SectionClipDoesNotFollowDraggedTab) {
+  if (animation_axis() !=
+      TabCollectionAnimatingLayoutManager::AnimationAxis::kVertical) {
+    GTEST_SKIP() << "Section disclosure uses vertical layout.";
+  }
+  gfx::ScopedAnimationDurationScaleMode normal_duration_mode(
+      gfx::ScopedAnimationDurationScaleMode::NORMAL_DURATION);
+  ON_CALL(*layout_manager_delegate(), ShouldClipChildToAnimatedHost)
+      .WillByDefault(testing::Return(true));
+  SetLayoutManager(std::make_unique<TabCollectionAnimatingLayoutManager>(
+      std::make_unique<TestLayoutManager>(animation_axis()),
+      *layout_manager_delegate(), animation_coordinator(), animation_axis(),
+      /*animate_host_size=*/true));
+
+  // Reproduce scroll contents filling a viewport taller than their content.
+  widget()->SetBounds(gfx::Rect(0, 0, 100, 500));
+  auto* child = host_view()->AddChildView(std::make_unique<views::View>());
+  child->SetPreferredSize(gfx::Size(100, 80));
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Milliseconds(50));
+  widget()->LayoutRootViewIfNecessary();
+  ASSERT_TRUE(layout_manager()->is_animating());
+  ASSERT_TRUE(host_view()->layer());
+  EXPECT_GT(host_view()->layer()->clip_rect().height(), 0);
+  EXPECT_LT(host_view()->layer()->clip_rect().height(), 80);
+  // A transformed tab must not inherit a viewport-dependent layer clip.
+  EXPECT_FALSE(child->GetClipLayerToVisibleBounds());
+
+  // Starting a drag removes the section clip before moving the tab layer.
+  ON_CALL(*layout_manager_delegate(), IsDragging)
+      .WillByDefault(testing::Return(true));
+  host_view()->InvalidateLayout();
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(host_view()->layer()->clip_rect().IsEmpty());
+  EXPECT_FALSE(child->GetClipLayerToVisibleBounds());
+
+  // Drop into the regular stack, where this tab no longer belongs to a section.
+  ON_CALL(*layout_manager_delegate(), IsDragging)
+      .WillByDefault(testing::Return(false));
+  ON_CALL(*layout_manager_delegate(), ShouldClipChildToAnimatedHost)
+      .WillByDefault(testing::Return(false));
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_FALSE(layout_manager()->is_animating());
+  EXPECT_TRUE(host_view()->layer()->clip_rect().IsEmpty());
+  EXPECT_FALSE(child->GetClipLayerToVisibleBounds());
+}
