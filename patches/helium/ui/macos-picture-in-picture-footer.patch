+#if BUILDFLAG(IS_MAC)
+void VideoOverlayWindowViews::LayoutMacPlaybackFooter(const gfx::Rect& bounds) {
+  constexpr int kControlGap = 6;
+  constexpr int kTimestampHeight = 16;
+  constexpr int kMinScrubberWidth = 44;
+  const int control_height = kActionButtonSize.height();
+  const int row_y = bounds.bottom() - kBottomControlsVerticalMargin -
+                    control_height;
+  const int text_y = row_y + (control_height - kTimestampHeight) / 2;
+  const int left = bounds.x() + kBottomControlsHorizontalMargin;
+  int right = bounds.right() - kBottomControlsHorizontalMargin;
+
+  if (toggle_mute_button_) {
+    right -= toggle_mute_button_->width();
+    toggle_mute_button_->SetPosition({right, row_y});
+    right -= kControlGap;
+  }
+  live_caption_button_->SetPosition(
+      {right - live_caption_button_->width(), row_y});
+  if (live_caption_button_->GetVisible()) {
+    right -= live_caption_button_->width() + kControlGap;
+  }
+
+  timestamp_->SetVisible(!is_live_);
+  remaining_timestamp_->SetVisible(!is_live_);
+  progress_view_->SetVisible(!is_live_);
+  live_status_->SetVisible(is_live_);
+  if (is_live_) {
+    live_status_->SetPosition({left, text_y});
+    live_status_->SetMaximumWidthSingleLine(std::max(0, right - left));
+    live_status_->SetSize(live_status_->GetPreferredSize(
+        {std::max(0, right - left), kTimestampHeight}));
+  } else {
+    // Reserve for the full duration so the rail stays put as the clocks tick.
+    const std::u16string duration =
+        global_media_controls::GetFormattedDuration(position_.duration());
+    constexpr int kClockPadding = 4;
+    const int max_clock_width =
+        std::max(0, (right - left - kMinScrubberWidth) / 2);
+    const int elapsed_width = std::min(
+        max_clock_width,
+        gfx::GetStringWidth(duration, timestamp_->font_list()) + kClockPadding);
+    const int remaining_width = std::min(
+        max_clock_width,
+        gfx::GetStringWidth(base::StrCat({u"−", duration}),
+                            remaining_timestamp_->font_list()) + kClockPadding);
+    timestamp_->SetBounds(left, text_y, elapsed_width, kTimestampHeight);
+    remaining_timestamp_->SetBounds(right - remaining_width, text_y,
+                                    remaining_width, kTimestampHeight);
+    const int scrubber_width =
+        std::max(0, right - left - elapsed_width - remaining_width);
+    progress_view_->SetBounds(left + elapsed_width, row_y, scrubber_width,
+                              control_height);
+  }
+  UpdateScrubberThumbVisibility(display::Screen::Get()->GetCursorScreenPoint());
+}
+#endif
