+// Glass supplies its own light/dark tone. Average the theme's two accents in
+// HSL so switching the browser scheme does not also change the glass tint.
+SkColor GlassTintMidpoint(SkColor light, SkColor dark) {
+  color_utils::HSL a, b;
+  color_utils::SkColorToHSL(light, &a);
+  color_utils::SkColorToHSL(dark, &b);
+  // An achromatic endpoint has no hue; retain the chromatic endpoint's hue.
+  if (a.s == 0) {
+    a.h = b.h;
+  }
+  if (b.s == 0) {
+    b.h = a.h;
+  }
+  // Take the shorter arc across the hue wrap, including reds around 0/1.
+  double delta = b.h - a.h;
+  if (delta > .5) {
+    delta -= 1;
+  } else if (delta < -.5) {
+    delta += 1;
+  }
+  const color_utils::HSL midpoint{
+      std::fmod(a.h + delta / 2 + 1, 1), (a.s + b.s) / 2, (a.l + b.l) / 2};
+  return color_utils::HSLToSkColor(midpoint, 255);
+}
