+NSColor* NativeGlassThemeTintColor(BrowserView* view) {
+  if (!view || ThemeServiceFactory::GetForProfile(view->GetProfile())->UsingDeviceTheme()) {
+    return nil;
+  }
+  // Frame theme notifications can precede BrowserView's widget attachment.
+  // Surface setup reapplies the tint once the owning color provider exists.
+  if (!view->GetColorProvider()) {
+    return nil;
+  }
+  auto key = view->browser_widget()->GetColorProviderKey();
+  auto& manager = ui::ColorProviderManager::Get();
+  key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+  const SkColor light =
+      manager.GetColorProviderFor(key)->GetColor(ui::kColorSysPrimary);
+  key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+  const SkColor dark =
+      manager.GetColorProviderFor(key)->GetColor(ui::kColorSysPrimary);
+  const SkColor color = GlassTintMidpoint(light, dark);
+  return [NSColor colorWithSRGBRed:SkColorGetR(color) / 255.0
+                            green:SkColorGetG(color) / 255.0
+                             blue:SkColorGetB(color) / 255.0
+                            alpha:.05];
+}
