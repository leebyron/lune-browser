+
+  const auto check_order = [&](bool has_existing_group) {
+    TabMenuModel menu(&delegate_, TabMenuModelDelegate::From(browser()),
+                      strip, 0);
+    size_t index = 0;
+    EXPECT_EQ(menu.GetCommandIdAt(index++), TabStripModel::CommandNewTabToRight);
+    EXPECT_FALSE(
+        menu.GetIndexOfCommandId(TabStripModel::CommandRemoveFromGroup));
+    EXPECT_EQ(menu.GetCommandIdAt(index), TabStripModel::CommandAddToNewGroup);
+    EXPECT_EQ(menu.GetLabelAt(index++), l10n_util::GetPluralStringFUTF16(
+                                           IDS_TAB_GROUP_ACTION, 2));
+    if (has_existing_group) {
+      EXPECT_EQ(menu.GetCommandIdAt(index++),
+                TabStripModel::CommandAddToExistingGroup);
+    } else {
+      EXPECT_FALSE(
+          menu.GetIndexOfCommandId(TabStripModel::CommandAddToExistingGroup));
+    }
+    EXPECT_EQ(menu.GetCommandIdAt(index), TabStripModel::CommandAddToSplit);
+    EXPECT_EQ(menu.GetLabelAt(index++), l10n_util::GetPluralStringFUTF16(
+                                           IDS_TAB_CXMENU_ADD_TABS_TO_SPLIT_VIEW,
+                                           2));
+    EXPECT_EQ(menu.GetCommandIdAt(index++),
+              TabStripModel::CommandMoveTabsToNewWindow);
+    EXPECT_EQ(menu.GetTypeAt(index), ui::MenuModel::TYPE_SEPARATOR);
+  };
+  check_order(false);
+  const auto other_group = strip->AddToNewGroup({3});
+  check_order(true);
+  strip->ExecuteContextMenuCommand(0, TabStripModel::CommandAddToNewGroup);
+  const auto new_group = strip->GetTabGroupForTab(0);
+  ASSERT_TRUE(new_group);
+  EXPECT_EQ(strip->GetTabGroupForTab(1), new_group);
+  EXPECT_NE(new_group, other_group);
+  EXPECT_FALSE(strip->GetTabGroupForTab(2));
+  EXPECT_EQ(strip->GetTabGroupForTab(3), other_group);
+
+  // A mixed selection still excludes the group of the clicked tab.
+  strip->ActivateTabAt(0);
+  strip->AddSelectionFromAnchorTo(2);
+  {
+    TabMenuModel menu(&delegate_, TabMenuModelDelegate::From(browser()),
+                      strip, 0);
+    EXPECT_FALSE(menu.GetIndexOfCommandId(TabStripModel::CommandAddToNewGroup));
+    EXPECT_EQ(menu.GetCommandIdAt(1), TabStripModel::CommandRemoveFromGroup);
+    EXPECT_EQ(menu.GetCommandIdAt(2), TabStripModel::CommandAddToExistingGroup);
+    EXPECT_EQ(menu.GetLabelAt(2), l10n_util::GetPluralStringFUTF16(
+                                     IDS_TAB_CXMENU_MOVE_TAB_TO_GROUP, 3));
+    EXPECT_EQ(menu.GetSubmenuModelAt(2)->GetItemCount(), 1u);
+  }
+  strip->RemoveFromGroup({3});
+  TabMenuModel menu(&delegate_, TabMenuModelDelegate::From(browser()), strip, 0);
+  EXPECT_FALSE(menu.GetIndexOfCommandId(TabStripModel::CommandAddToNewGroup));
+  EXPECT_FALSE(
+      menu.GetIndexOfCommandId(TabStripModel::CommandAddToExistingGroup));
+  EXPECT_EQ(menu.GetCommandIdAt(1), TabStripModel::CommandRemoveFromGroup);
+}
