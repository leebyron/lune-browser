+class FloatingSidebarHighlight : public views::Border {
+ public:
+  explicit FloatingSidebarHighlight(float radius) : radius_(radius) {}
+  void Paint(const views::View& view, gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(0.5f);
+    flags.setColor(SkColorSetA(SK_ColorWHITE, 0x60));
+    gfx::RectF bounds(view.GetLocalBounds());
+    bounds.Inset(0.25f);
+    canvas->DrawRoundRect(bounds, std::max(0.f, radius_ - 0.25f), flags);
+  }
+  gfx::Insets GetInsets() const override { return {}; }
+  gfx::Size GetMinimumSize() const override { return {}; }
+
+ private:
+  float radius_;
+};
