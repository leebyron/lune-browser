+// Focus-loss dismissal may precede delivery to the native button. Preserve
+// that dismissal across its tracking loop, including asynchronous destruction.
+class HeliumSiteInfoObserver : public views::WidgetObserver {
+ public:
+  HeliumSiteInfoObserver(HeliumFloatingAddressBar* owner, views::Widget* widget)
+      : owner_(owner) {
+    observation_.Observe(widget);
+  }
+  void OnWidgetVisibilityChanged(views::Widget*, bool visible) override {
+    if (!visible) {
+      [owner_ siteInfoClosing];
+    }
+  }
+  void OnWidgetDestroying(views::Widget*) override {
+    [owner_ siteInfoClosing];
+    observation_.Reset();
+  }
+ private:
+  HeliumFloatingAddressBar* __weak owner_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{this};
+};
