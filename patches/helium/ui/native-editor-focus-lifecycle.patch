===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ prepared-src/chrome/browser/ui/views/helium/native_text_field_mac.mm	2026-11-12 13:36:46.288291028 -0800
@@ -0,0 +1,135 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#import "chrome/browser/ui/views/helium/native_text_field_mac.h"
+
+@implementation HeliumNativeTextField {
+  BOOL _preservingFocus;
+  NSRange _savedSelection;
+  NSTimeInterval _activationTimestamp;
+}
+@synthesize restoresPopupKeyWindow = _restoresPopupKeyWindow;
+@synthesize onFocusTransferred = _onFocusTransferred;
+
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+    [center addObserver:self selector:@selector(applicationWillResign:)
+                   name:NSApplicationWillResignActiveNotification object:NSApp];
+    [center addObserver:self selector:@selector(applicationDidBecome:)
+                   name:NSApplicationDidBecomeActiveNotification object:NSApp];
+    [center addObserver:self selector:@selector(applicationDidResign:)
+                   name:NSApplicationDidResignActiveNotification object:NSApp];
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+}
+
+- (BOOL)preservingFocus {
+  return _preservingFocus;
+}
+
+- (BOOL)isApplicationActivationClick:(NSEvent*)event {
+  return !NSApp.active ||
+      (_activationTimestamp > 0 && event.timestamp > 0 &&
+       event.timestamp <= _activationTimestamp);
+}
+
+- (void)cancelFocusRestoration {
+  _preservingFocus = NO;
+}
+
+- (void)applicationWillResign:(NSNotification*)notification {
+  NSText* editor = self.currentEditor;
+  if (editor && self.window.firstResponder == editor) {
+    _savedSelection = editor.selectedRange;
+    _preservingFocus = YES;
+  }
+}
+
+- (void)applicationDidBecome:(NSNotification*)notification {
+  // NSEvent timestamps share system uptime. Delivery can occur after the app
+  // has become active, so retain the boundary rather than a dismissal delay.
+  _activationTimestamp = NSProcessInfo.processInfo.systemUptime;
+  [self noteFocusRingMaskChanged];
+  [self restoreFocusAfterActivation];
+}
+
+- (void)applicationDidResign:(NSNotification*)notification {
+  [self noteFocusRingMaskChanged];
+}
+
+- (void)windowDidResignKey:(NSNotification*)notification {
+  [self noteFocusRingMaskChanged];
+}
+
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  [center removeObserver:self name:NSWindowDidBecomeKeyNotification object:nil];
+  [center removeObserver:self name:NSWindowDidResignKeyNotification object:nil];
+  if (self.window) {
+    [center addObserver:self selector:@selector(windowDidBecomeKey:)
+                   name:NSWindowDidBecomeKeyNotification object:nil];
+    [center addObserver:self selector:@selector(windowDidResignKey:)
+                   name:NSWindowDidResignKeyNotification object:self.window];
+  } else {
+    [self cancelFocusRestoration];
+  }
+}
+
+- (void)windowDidBecomeKey:(NSNotification*)notification {
+  [self noteFocusRingMaskChanged];
+  if (NSApp.active && self.window && notification.object != self.window &&
+      self.onFocusTransferred) {
+    self.onFocusTransferred();
+  }
+  // Returning through the browser may make its window key before the command
+  // popup. Observe that handoff as well as the popup's own key notification.
+  if (notification.object == self.window ||
+      (self.restoresPopupKeyWindow &&
+       notification.object == self.window.parentWindow)) {
+    [self restoreFocusAfterActivation];
+  }
+}
+
+- (void)restoreFocusAfterActivation {
+  // Wait for NativeWidgetMac/FocusManager to finish restoring Views focus.
+  __weak HeliumNativeTextField* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    HeliumNativeTextField* field = weakSelf;
+    if (!field || !field->_preservingFocus || !NSApp.active) {
+      return;
+    }
+    // Wait until the parent has actually become key. Checking only its main
+    // status during app activation can miss the handoff or steal a dialog's
+    // focus. The parent-key notification also reaches this deferred path.
+    if (field.restoresPopupKeyWindow &&
+        field.window.parentWindow.isKeyWindow && !field.window.isKeyWindow) {
+      [field.window makeKeyWindow];
+      // Its key notification schedules editor restoration after Views has
+      // processed this second activation, too.
+      return;
+    }
+    if (!field.window.isKeyWindow) {
+      return;
+    }
+    const NSRange selection = field->_savedSelection;
+    if ([field.window makeFirstResponder:field]) {
+      NSText* editor = field.currentEditor;
+      if (editor) {
+        const NSUInteger length = field.stringValue.length;
+        const NSUInteger location = MIN(selection.location, length);
+        editor.selectedRange = NSMakeRange(
+            location, MIN(selection.length, length - location));
+        field->_preservingFocus = NO;
+        [field noteFocusRingMaskChanged];
+      }
+    }
+  });
+}
+@end
