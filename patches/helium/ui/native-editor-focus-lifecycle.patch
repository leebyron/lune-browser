--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ prepared-src/chrome/browser/ui/views/helium/native_text_field_mac.h	2026-11-12 13:36:46.288147069 -0800
@@ -0,0 +1,23 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_TEXT_FIELD_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_TEXT_FIELD_MAC_H_
+
+#import <AppKit/AppKit.h>
+
+// Views restores its own focused view when a window becomes key. Embedded
+// AppKit editors need their focus and selection restored after that step.
+@interface HeliumNativeTextField : NSTextField
+@property(nonatomic, readonly) BOOL preservingFocus;
+// A command popup may return through its owning browser window.
+@property(nonatomic) BOOL restoresPopupKeyWindow;
+// Explicit in-app ownership transfer, separate from temporary app deactivation.
+@property(nonatomic, copy) void (^onFocusTransferred)(void);
+// A click generated before activation only returns the app to the foreground.
+- (BOOL)isApplicationActivationClick:(NSEvent*)event;
+- (void)cancelFocusRestoration;
+@end
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_TEXT_FIELD_MAC_H_
