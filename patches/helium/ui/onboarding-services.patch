+void OnboardingMessageHandler::HandleSetUBlockEnabled(
+    const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) return;
+  AllowJavascript();
+  if (args.size() != 2 || !args[1].is_bool()) {
+    RejectJavascriptCallback(args[0], base::Value("Expected an enabled boolean"));
+    return;
+  }
+
+  // Only the bundled blocker is controllable here. Use the normal extension
+  // registrar so disable reasons, policy restrictions and persistence apply.
+  pref_service_->SetBoolean(prefs::kHeliumUBlockEnabled, args[1].GetBool());
+  auto* registrar = extensions::ExtensionRegistrar::Get(browser_context_);
+  if (args[1].GetBool()) {
+    pref_service_->SetBoolean(prefs::kHeliumUBlockInstallAllowed, true);
+    extensions::ComponentLoader::Get(browser_context_)->AddUBlock();
+    registrar->EnableExtension(helium::kUBlockOriginComponentId);
+  } else {
+    registrar->DisableExtension(helium::kUBlockOriginComponentId,
+                               {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+  const bool enabled = extensions::ExtensionRegistry::Get(browser_context_)
+      ->enabled_extensions().Contains(helium::kUBlockOriginComponentId);
+  ResolveJavascriptCallback(args[0], base::Value(enabled));
+}
