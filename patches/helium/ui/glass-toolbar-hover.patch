+// Use the same slots for measuring the child window and laying out its
+// controls. The widget can still have its previous bounds while a preference
+// or an animated action changes the width of the row.
+class FloatingToolbarLayout : public views::LayoutManagerBase {
+ protected:
+  views::ProposedLayout CalculateProposedLayout(
+      const views::SizeBounds&) const override {
+    views::ProposedLayout layout;
+    int x = 0;
+    for (views::View* child : host_view()->children()) {
+      if (!IsChildIncludedInLayout(child)) {
+        continue;
+      }
+      std::vector<views::View*> buttons;
+      CollectFloatingToolbarButtons(child, buttons);
+      if (buttons.empty()) {
+        layout.child_layouts.emplace_back(child, false);
+        continue;
+      }
+      int slots_width = 0;
+      for (const views::View* button : buttons) {
+        slots_width += std::max(helium::kNativeToolbarControlHeight,
+                                button->GetPreferredSize().width());
+      }
+      const int width = std::max(slots_width, child->GetPreferredSize().width());
+      layout.child_layouts.emplace_back(
+          child, true,
+          gfx::Rect(x, 0, width, helium::kNativeToolbarControlHeight));
+      x += width;
+    }
+    layout.host_size = gfx::Size(x, helium::kNativeToolbarControlHeight);
+    return layout;
+  }
+};
