+namespace {
+constexpr CGFloat kToolbarHoverDiameter = 30;
+constexpr NSTimeInterval kToolbarSymbolHoverDuration = .10;
+
+NSRect ToolbarHighlightRect(NSRect slot) {
+  const CGFloat inset =
+      std::max(CGFloat(0), (NSHeight(slot) - kToolbarHoverDiameter) / 2);
+  return NSInsetRect(slot, inset, inset);
+}
+
+void DrawToolbarHighlight(NSRect bounds, BOOL pressed) {
+  const BOOL dark = [[NSAppearance.currentDrawingAppearance
+      bestMatchFromAppearancesWithNames:@[NSAppearanceNameAqua,
+                                          NSAppearanceNameDarkAqua]]
+      isEqualToString:NSAppearanceNameDarkAqua];
+  const CGFloat opacity = dark ? (pressed ? .16 : .105)
+                               : (pressed ? .08 : .04);
+  NSColor* color = dark ? NSColor.whiteColor : NSColor.blackColor;
+  [[color colorWithAlphaComponent:opacity] setFill];
+  const CGFloat radius = std::min(NSWidth(bounds), NSHeight(bounds)) / 2;
+  [[NSBezierPath bezierPathWithRoundedRect:bounds xRadius:radius
+                                  yRadius:radius] fill];
+}
+
+bool WindowReceivesToolbarPointer(NSWindow* window, NSPoint screen_point) {
+  return window.isVisible && !window.ignoresMouseEvents &&
+         NSPointInRect(screen_point, window.frame) &&
+         [NSWindow windowNumberAtPoint:screen_point belowWindowWithWindowNumber:0]
+             == window.windowNumber;
+}
