+- (BOOL)resignFirstResponder {
+  if (![super resignFirstResponder]) {
+    return NO;
+  }
+  _focused = NO;
+  if (_onHoverOrFocusChanged) {
+    _onHoverOrFocusChanged();
+  }
+  return YES;
