+  [self addTrackingArea:_hoverTrackingArea];
+  [self refreshPointerHover];
+}
+- (void)refreshPointerHover {
+  [self setHovered:[self isPointerOverButton]];
+}
+- (BOOL)isPointerOverButton {
+  NSWindow* window = self.window;
+  if (!window.isKeyWindow || self.isHiddenOrHasHiddenAncestor) {
+    return NO;
+  }
+  const NSPoint pointer = NSEvent.mouseLocation;
+  const NSRect bounds = [window convertRectToScreen:
