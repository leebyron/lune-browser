+    _hoverAmount = hovered ? 1 : 0;
+    self.needsDisplay = YES;
+    return;
+  }
+  _hoverFadeFrom = _hoverAmount;
+  _hoverFadeStart = NSDate.timeIntervalSinceReferenceDate;
+  __weak HeliumGlassToolbarButton* weakSelf = self;
+  _hoverTimer = [NSTimer timerWithTimeInterval:1.0 / 60 repeats:YES
