+// The real actions live in a transparent Views child window. Paint their
+// feedback in the AppKit glass content directly below that window.
+@interface HeliumGlassToolbarActions : HeliumGlassSurface
+- (void)setButtons:(const std::vector<views::View*>&)buttons;
+@end
+@implementation HeliumGlassToolbarActions {
+  std::vector<base::WeakPtr<views::Button>> _buttons;
+  std::vector<base::CallbackListSubscription> _subscriptions;
+  HeliumToolbarHighlight* _highlight;
+}
+- (void)setButtons:(const std::vector<views::View*>&)buttons {
+  if (!std::ranges::equal(buttons, _buttons,
+                         [](views::View* view, const auto& button) {
+                           return view == button.get();
+                         })) {
+    _subscriptions.clear();
+    _buttons.clear();
+    __weak HeliumGlassToolbarActions* weakSelf = self;
+    for (auto* view : buttons) {
+      auto* button = views::Button::AsButton(view);
+      _buttons.push_back(button->GetWeakPtr());
+      _subscriptions.push_back(button->AddStateChangedCallback(
+          base::BindRepeating(^{ [weakSelf updateHighlight]; })));
+    }
+  }
+  [self updateHighlight];
+}
+- (void)updateHighlight {
+  NSWindow* window = self.controlsWindow;
+  if (_buttons.empty() ||
+      !WindowReceivesToolbarPointer(window, NSEvent.mouseLocation)) {
+    _highlight.hidden = YES;
+    return;
+  }
+  for (const auto& button : _buttons) {
+    if (!button || !button->IsDrawn() ||
+        button->GetState() == views::Button::STATE_DISABLED ||
+        !button->IsMouseHovered()) {
+      continue;
+    }
+    auto* contents = button->GetWidget()->GetContentsView();
+    const gfx::Rect bounds = views::View::ConvertRectToTarget(
+        button.get(), contents, button->GetLocalBounds());
+    const NSRect slot =
+        NSMakeRect(bounds.x(), NSHeight(_controls.bounds) - bounds.bottom(),
+                   bounds.width(), bounds.height());
+    const NSRect frame = _buttons.size() == 1
+        ? _controls.bounds : ToolbarHighlightRect(slot);
+    if (!_highlight) {
+      _highlight = [[HeliumToolbarHighlight alloc] initWithFrame:frame];
+      _highlight.wantsLayer = YES;
+      [_controls addSubview:_highlight];
+    }
+    _highlight.frame = frame;
+    _highlight.pressed = button->GetState() == views::Button::STATE_PRESSED;
+    _highlight.hidden = NO;
+    return;
+  }
+  _highlight.hidden = YES;
+}
+@end
