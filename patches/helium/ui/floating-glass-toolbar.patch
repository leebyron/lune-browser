+int BrowserFrameViewMac::FloatingToolbarWidth() {
+  auto* toolbar = GetBrowserView()->toolbar();
+  if (!HasFloatingAddressBar()) {
+    ResetFloatingToolbar();
+    return 0;
+  }
+  if (!floating_toolbar_widget_) {
+    floating_toolbar_owner_.SetView(toolbar);
+    floating_toolbar_widget_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_POPUP);
+    params.ownership = views::Widget::InitParams::CLIENT_OWNS_WIDGET;
+    params.parent = GetWidget()->GetNativeView();
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.name = "Floating browser actions";
+    floating_toolbar_widget_->Init(std::move(params));
+    auto root = std::make_unique<views::View>();
+    root->SetLayoutManager(std::make_unique<views::BoxLayout>(
+                               views::BoxLayout::Orientation::kHorizontal,
+                               gfx::Insets::VH(0, 4), 0))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kStretch);
+    floating_toolbar_widget_->SetContentsView(std::move(root));
+    NSView* native =
+        floating_toolbar_widget_->GetNativeView().GetNativeNSView();
+    floating_toolbar_material_ =
+        [[HeliumGlassSurface alloc] initWithFrame:native.frame];
+    floating_toolbar_material_.autoresizingMask =
+        NSViewWidthSizable | NSViewHeightSizable;
+    [native.superview addSubview:floating_toolbar_material_
+                      positioned:NSWindowBelow
+                      relativeTo:native];
+    [floating_toolbar_material_ setPresented:YES];
+    NSWindow* window = native.window;
+    native.superview.wantsLayer = YES;
+    native.superview.layer.cornerRadius = 18;
+    native.superview.layer.masksToBounds = YES;
+    window.hasShadow = YES;
+    window.opaque = NO;
+    window.backgroundColor = NSColor.clearColor;
+  }
+  toolbar->SetFloatingNavigation(true);
+  toolbar->SetFloatingControlsHost(floating_toolbar_widget_->GetContentsView());
+  return floating_toolbar_widget_->GetContentsView()
+      ->GetPreferredSize()
+      .width();
+}
+
+void BrowserFrameViewMac::ResetFloatingToolbar() {
+  if (auto* toolbar =
+          static_cast<ToolbarView*>(floating_toolbar_owner_.view())) {
+    toolbar->SetFloatingControlsHost(nullptr);
+    toolbar->SetFloatingNavigation(false);
+  }
+  floating_toolbar_owner_.SetView(nullptr);
+  if (floating_toolbar_widget_) {
+    floating_toolbar_widget_->CloseNow();
+    floating_toolbar_widget_.reset();
+  }
+  floating_toolbar_material_ = nil;
+  floating_toolbar_presented_ = false;
+  floating_toolbar_target_bounds_ = gfx::Rect();
+}
+
+void BrowserFrameViewMac::UpdateFloatingToolbar(const gfx::Rect& region,
+                                                bool presented) {
+  auto* view = GetBrowserView();
+  auto* nav =
+      static_cast<views::NativeViewHost*>(floating_navigation_host_.view());
+  auto* drag = static_cast<views::NativeViewHost*>(floating_drag_host_.view());
+  if (!HasFloatingAddressBar()) {
+    ResetFloatingToolbar();
+  }
+  if (presented && !nav) {
+    drag = view->AddChildView(std::make_unique<views::NativeViewHost>());
+    floating_drag_host_.SetView(drag);
+    floating_drag_region_ =
+        [[HeliumGlassDragRegion alloc] initWithFrame:NSZeroRect];
+    drag->Attach(gfx::NativeView(floating_drag_region_));
+    nav = view->AddChildView(std::make_unique<views::NativeViewHost>());
+    floating_navigation_host_.SetView(nav);
+    floating_navigation_ =
+        [[HeliumGlassNavigation alloc] initWithBrowserView:view];
+    nav->Attach(gfx::NativeView(floating_navigation_));
+  }
+  if (nav) {
+    [floating_navigation_ refresh];
+    [floating_navigation_ setPresented:presented];
+    nav->SetVisible(presented || !floating_navigation_.hidden);
+  }
+  if (drag) {
+    drag->SetVisible(presented);
+  }
+  if (!region.IsEmpty() && nav) {
+    nav->SetBoundsRect(gfx::Rect(region.x(), region.y(), 76, 36));
+    drag->SetBoundsRect(
+        gfx::Rect(region.x(), region.y() - 8, region.width(), 52));
+    floating_drag_region_.navigationBounds = NSMakeRect(0, 8, 76, 36);
+    floating_drag_region_.windowControlsBounds = NSZeroRect;
+    // Address bounds are updated after its editor and popup have laid out.
+  }
+  if (!floating_toolbar_widget_) {
+    return;
+  }
+  NSWindow* window =
+      floating_toolbar_widget_->GetNativeWindow().GetNativeNSWindow();
+  const BOOL reduceMotion =
+      NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion;
+  if (presented) {
+    const int width =
+        floating_toolbar_widget_->GetContentsView()->GetPreferredSize().width();
+    gfx::Rect bounds(region.right() - width, region.y(), width, 36);
+    views::View::ConvertRectToScreen(view, &bounds);
+    const bool layout_changed =
+        floating_toolbar_widget_->GetWindowBoundsInScreen().size() !=
+        bounds.size();
+    // Keep the native presentation animation intact between geometry updates.
+    if (bounds != floating_toolbar_target_bounds_ ||
+        !floating_toolbar_presented_) {
+      floating_toolbar_widget_->SetBounds(bounds);
+      floating_toolbar_target_bounds_ = bounds;
+    }
+    if (layout_changed || !floating_toolbar_presented_) {
+      view->toolbar()->AbortToolbarContainerAnimationsForZenReveal();
+      floating_toolbar_widget_->LayoutRootViewIfNecessary();
+    }
+    if (!floating_toolbar_presented_) {
+      window.alphaValue = 0;
+      floating_toolbar_widget_->ShowInactive();
+      NSRect target = window.frame;
+      NSRect start = target;
+      start.origin.y += reduceMotion ? 0 : 12;
+      [window setFrame:start display:YES];
+      [NSAnimationContext
+          runAnimationGroup:^(NSAnimationContext* context) {
+            context.duration = reduceMotion ? 0 : .18;
+            [window.animator setFrame:target display:YES];
+            window.animator.alphaValue = 1;
+          }
+          completionHandler:nil];
+    }
+  } else if (floating_toolbar_presented_) {
+    __weak NSWindow* weakWindow = window;
+    NSRect target = window.frame;
+    target.origin.y += reduceMotion ? 0 : 12;
+    [NSAnimationContext
+        runAnimationGroup:^(NSAnimationContext* context) {
+          context.duration = reduceMotion ? 0 : .18;
+          window.animator.alphaValue = 0;
+          [window.animator setFrame:target display:YES];
+        }
+        completionHandler:^{
+          if (weakWindow.alphaValue == 0) {
+            [weakWindow orderOut:nil];
+          }
+        }];
+  }
+  floating_toolbar_presented_ = presented;
+}
