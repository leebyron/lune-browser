+
+// Move the actual controls, including extension-owned buttons, so their models,
+// keyboard actions and popup anchors stay intact in the native glass window.
+void ToolbarView::SetFloatingControlsHost(views::View* host) {
+  if (!host) {
+    for (const auto& state : floating_controls_state_) {
+      if (state.view && state.view->parent() != this) {
+        AddChildViewAt(state.view->parent()->RemoveChildViewT(state.view.get()),
+                       std::min(state.original_index, children().size()));
+      }
+    }
+    floating_controls_state_.clear();
+    InvalidateLayout();
+    return;
+  }
+  if (!floating_controls_state_.empty() || !sidebar_controls_host_) {
+    return;
+  }
+  const auto controls = children();
+  for (size_t i = 0; i < controls.size(); ++i) {
+    views::View* control = controls[i];
+    TransferredControlState state;
+    state.view = control;
+    state.original_index = i;
+    floating_controls_state_.push_back(state);
+    host->AddChildView(RemoveChildViewT(control));
+  }
+  AbortToolbarContainerAnimationsForZenReveal();
+}
