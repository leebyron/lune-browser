+void ToolbarView::SetFloatingNavigation(bool floating) {
+  if (floating_navigation_ == floating) {
+    return;
+  }
+  floating_navigation_ = floating;
+  OnShowBackButtonChanged();
+  OnShowForwardButtonChanged();
+  OnShowReloadButtonChanged();
