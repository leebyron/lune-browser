+IN_PROC_BROWSER_TEST_F(TabMenuModelBrowserTest, HideHibernateForDiscardedTab) {
+  chrome::NewTab(browser(), NewTabTypes::kNoUserAction);
+  auto* tab_strip_model = browser()->tab_strip_model();
+  auto* contents = tab_strip_model->GetWebContentsAt(0);
+  {
+    TabMenuModel menu(&delegate_, TabMenuModelDelegate::From(browser()),
+                      tab_strip_model, 0);
+    EXPECT_TRUE(menu.GetIndexOfCommandId(TabStripModel::CommandDiscard));
+  }
+  contents->SetWasDiscarded(true);
+  TabMenuModel menu(&delegate_, TabMenuModelDelegate::From(browser()),
+                    tab_strip_model, 0);
+  EXPECT_FALSE(menu.GetIndexOfCommandId(TabStripModel::CommandDiscard));
+}
