+// One hover surface, including the trailing close control, like a tab row.
+class SidebarDefaultBrowserRow : public views::FlexLayoutView {
+  METADATA_HEADER(SidebarDefaultBrowserRow, views::FlexLayoutView)
+ public:
+  SidebarDefaultBrowserRow() {
+    SetOrientation(views::LayoutOrientation::kHorizontal);
+    SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    SetNotifyEnterExitOnChild(true);
+    action_ = AddChildView(std::make_unique<FooterButton>(
+        base::RepeatingClosure(), IDS_DEFAULT_BROWSER_INFOBAR_OK_BUTTON_LABEL,
+        omnibox::kProductChromeRefreshOldIcon, false));
+    action_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                                 views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    close_ = AddChildView(std::make_unique<TabCloseButton>(
+        base::RepeatingClosure(),
+        base::DoNothingAs<void(views::View*, const ui::MouseEvent&)>(), 4));
+    const int close_margin =
+        (GetLayoutConstant(LayoutConstant::kVerticalTabHeight) -
+         close_->GetPreferredSize().width()) /
+        2;
+    close_->SetProperty(views::kMarginsKey,
+                        gfx::Insets::TLBR(0, 0, 0, close_margin));
+    close_->SetVisible(false);
+  }
+  views::LabelButton* action() { return action_; }
+  views::LabelButton* close() { return close_; }
+  void SetCollapsed(bool collapsed) {
+    collapsed_ = collapsed;
+    close_->SetVisible(!collapsed_ && IsMouseHovered());
+  }
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    close_->SetVisible(!collapsed_);
+    SchedulePaint();
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    close_->SetVisible(false);
+    SchedulePaint();
+  }
+  void OnThemeChanged() override {
+    views::FlexLayoutView::OnThemeChanged();
+    TabStyle::TabColors colors;
+    colors.foreground_color = helium::NativeGlassControlColor(this).value_or(
+        GetColorProvider()->GetColor(kColorTabForegroundInactiveFrameActive));
+    colors.background_color = GetColorProvider()->GetColor(
+        kColorTabBackgroundInactiveHoverFrameActive);
+    close_->SetColors(colors);
+  }
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    if (!IsMouseHovered()) {
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(
+        helium::NativeGlassColor(this, helium::NativeGlassColorRole::kHover)
+            .value_or(GetColorProvider()->GetColor(
+                kColorTabBackgroundInactiveHoverFrameActive)));
+    canvas->DrawRoundRect(
+        gfx::RectF(GetLocalBounds()),
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+  }
+
+ private:
+  raw_ptr<views::LabelButton> action_;
+  raw_ptr<TabCloseButton> close_;
+  bool collapsed_ = false;
+};
+BEGIN_METADATA(SidebarDefaultBrowserRow)
+END_METADATA
