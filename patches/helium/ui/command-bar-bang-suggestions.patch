+std::vector<HeliumCommandBarItem> BangsForQuery(
+    TemplateURLService* template_urls,
+    const PrefService* pref_service,
+    const std::u16string& query) {
+  std::vector<HeliumCommandBarItem> items;
+  std::u16string text =
+      base::ToLowerASCII(base::CollapseWhitespace(query, true));
+  if (!template_urls || text.empty()) {
+    return items;
+  }
+  const bool explicit_bang = text.starts_with(u"!");
+  std::u16string remainder;
+  if (explicit_bang) {
+    // Match the trigger but retain original case/spacing of the search terms.
+    const auto trimmed = base::TrimWhitespace(query, base::TRIM_ALL);
+    const size_t end = trimmed.find_first_of(base::kWhitespaceUTF16);
+    text = base::ToLowerASCII(
+        trimmed.substr(1, end == std::u16string::npos ? end : end - 1));
+    if (end != std::u16string::npos) {
+      remainder = base::TrimWhitespace(trimmed.substr(end), base::TRIM_LEADING);
+    }
+  }
+  const auto& usage = pref_service->GetDict(prefs::kHeliumCommandBarBangUsage);
+  const auto now = base::Time::Now();
+  for (const auto& provider : template_urls->GetTemplateURLs()) {
+    const auto& keyword = provider->keyword();
+    if (!keyword.starts_with(u"!") || keyword.size() < 2) {
+      continue;
+    }
+    const int relevance =
+        text.empty()
+            ? 1
+            : std::max(ScoreBangText(keyword.substr(1), text),
+                       ScoreBangText(base::ToLowerASCII(provider->short_name()),
+                                     text));
+    if (!relevance ||
+        EngineForKeyword(template_urls, base::UTF16ToUTF8(keyword)) !=
+            provider) {
+      continue;
+    }
+    auto hint =
+        SiteSearchHintForQuery(template_urls, base::UTF16ToUTF8(keyword), u"");
+    if (!hint) {
+      continue;
+    }
+    hint->type = HeliumCommandBarItem::Type::kBang;
+    hint->title = provider->short_name();
+    hint->description = keyword;
+    hint->site_query = remainder;
+    const int usage_score = BangUsageScore(usage, hint->site_keyword, now);
+    // Text relevance always dominates personal use. On ordinary input,
+    // even an exact bang stays below a comparably relevant website or tab.
+    hint->score = explicit_bang ? 2000 + relevance * 10 + usage_score +
+                                      FamiliarBangScore(keyword)
+                                : relevance / 3 + std::min(usage_score / 10, 4);
+    items.push_back(std::move(*hint));
+  }
+  std::ranges::sort(items, [](const auto& a, const auto& b) {
+    return a.score != b.score ? a.score > b.score
+                              : a.site_keyword < b.site_keyword;
+  });
+  // Aliases compete on relevance and personal use, but a service gets one
+  // completion row. Keep its first ranked trigger before applying the cap.
+  std::set<std::u16string> services;
+  std::erase_if(items, [&services](const auto& item) {
+    const auto key = item.site_name.empty()
+        ? base::UTF8ToUTF16(item.site_keyword)
+        : base::ToLowerASCII(item.site_name);
+    return !services.insert(key).second;
+  });
+  if (items.size() > kMaxResults) {
+    items.resize(kMaxResults);
+  }
+  return items;
+}
+
+void RecordBangUse(Profile* profile, const std::string& keyword) {
+  if (profile->IsOffTheRecord() || !keyword.starts_with("!")) {
+    return;
+  }
+  ScopedDictPrefUpdate update(profile->GetPrefs(),
+                              prefs::kHeliumCommandBarBangUsage);
+  auto* entry = update->EnsureDict(keyword);
+  entry->Set("count",
+             std::clamp(entry->FindInt("count").value_or(0), 0, 999) + 1);
+  const auto now = base::Time::Now();
+  entry->Set("last_used", now.InSecondsFSinceUnixEpoch());
+  // Bound local history even if the user tries thousands of catalogue entries.
+  if (update->size() > 200) {
+    std::string oldest;
+    double oldest_time = now.InSecondsFSinceUnixEpoch();
+    for (const auto [key, value] : *update) {
+      const auto* dict = value.GetIfDict();
+      const double time = dict ? dict->FindDouble("last_used").value_or(0) : 0;
+      if (oldest.empty() || time < oldest_time) {
+        oldest = key;
+        oldest_time = time;
+      }
+    }
+    update->Remove(oldest);
+  }
+}
