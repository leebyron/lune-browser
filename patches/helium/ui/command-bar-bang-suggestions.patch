+int ScoreBangText(const std::u16string& text, const std::u16string& query) {
+  if (int score = ScoreText(text, query)) {
+    return score;
+  }
+  // One missing/extra/wrong character or adjacent transposition. Restrict
+  // fuzzy matching on short triggers and long input to avoid noisy results.
+  if (query.size() < 3 || query.size() > 64) {
+    return 0;
+  }
+  for (size_t length = query.size() - 1;
+       length <= query.size() + 1 && length <= text.size(); ++length) {
+    if (base::LevenshteinDistance(std::u16string_view(text).substr(0, length),
+                                  query, 1) <= 1) {
+      return 10;
+    }
+  }
+  if (text.size() >= query.size()) {
+    const auto prefix = text.substr(0, query.size());
+    for (size_t i = 0; i + 1 < query.size(); ++i) {
+      auto swapped = query;
+      std::swap(swapped[i], swapped[i + 1]);
+      if (prefix == swapped) {
+        return 10;
+      }
+    }
+  }
+  return 0;
+}
+
+int BangUsageScore(const base::DictValue& usage,
+                   const std::string& keyword,
+                   base::Time now) {
+  const auto* entry = usage.FindDict(keyword);
+  if (!entry) {
+    return 0;
+  }
+  const int count = std::clamp(entry->FindInt("count").value_or(0), 0, 20);
+  const double last = entry->FindDouble("last_used").value_or(0);
+  const double age_days =
+      std::max(0.0, (now.InSecondsFSinceUnixEpoch() - last) / 86400.0);
+  const int recency =
+      last > 0 ? std::max(0, 30 - static_cast<int>(std::min(age_days, 30.0)))
+               : 0;
+  return count + recency;
+}
+
+int FamiliarBangScore(const std::u16string& keyword) {
+  // The catalogue has no popularity metadata. Use familiar starting points
+  // only until this profile has its own usage; never invent global counts.
+  static constexpr std::u16string_view kFamiliar[] = {
+      u"!g", u"!w", u"!yt", u"!gh", u"!a", u"!r", u"!maps", u"!ddg", u"!so"};
+  for (size_t i = 0; i < std::size(kFamiliar); ++i) {
+    if (keyword == kFamiliar[i]) {
+      return static_cast<int>(std::size(kFamiliar) - i);
+    }
+  }
+  return 0;
+}
+
+}  // namespace
