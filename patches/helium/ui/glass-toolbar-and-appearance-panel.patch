+void BrowserFrameViewMac::UpdateFloatingCustomizeClose() {
+  auto* view = GetBrowserView();
+  auto* panel = view->side_panel();
+  auto* ui = SidePanelUI::From(view->browser());
+  const bool eligible =
+      panel && panel->GetVisible() && ui &&
+      ui->GetCurrentEntryId() == SidePanelEntryId::kCustomizeChrome;
+  auto* host = static_cast<views::NativeViewHost*>(
+      floating_customize_close_host_.view());
+  if (!eligible) {
+    if (host) {
+      host->SetVisible(false);
+    }
+    return;
+  }
+  if (!host) {
+    host = view->AddChildView(std::make_unique<views::NativeViewHost>());
+    floating_customize_close_host_.SetView(host);
+    floating_customize_close_ =
+        [[HeliumGlassCloseButton alloc] initWithBrowserView:view];
+    host->Attach(gfx::NativeView(floating_customize_close_));
+  }
+  const gfx::Rect bounds =
+      views::View::ConvertRectToTarget(panel, view, panel->GetLocalBounds());
+  host->SetBounds(bounds.right() - 44, bounds.y() + 8, 36, 36);
+  floating_customize_close_.appearance = FloatingChromeAppearance(view);
+  host->SetVisible(true);
+}
+
+bool BrowserFrameViewMac::IsPointInFloatingWindowControls(
+    const gfx::Point& point) const {
+  auto* host = floating_window_controls_host_.view();
+  return host && host->IsDrawn() && !floating_window_controls_.hidden &&
+         floating_window_controls_.alphaValue > 0 &&
+         views::View::ConvertRectToTarget(host, GetBrowserView(),
+                                          host->GetLocalBounds())
+             .Contains(point);
+}
