+#if BUILDFLAG(IS_MAC)
+bool ThemeService::IsMacCustomTheme() const {
+  return !UsingDeviceTheme() && !UsingPolicyTheme() &&
+         !UsingExtensionTheme() && (GetIsGrayscale() || !GetIsBaseline());
+}
+
+SkColor ThemeService::GetMacCustomThemeColor() const {
+  if (IsMacCustomTheme()) {
+    if (GetIsGrayscale()) {
+      return SkColorSetRGB(128, 128, 128);
+    }
+    if (auto color = GetUserColor()) {
+      return *color;
+    }
+    return GetAutogeneratedThemeColor();
+  }
+
+  const SkColor saved = profile_->GetPrefs()->GetInteger(kLastMacCustomThemeColor);
+  return saved == SK_ColorTRANSPARENT ? SkColorSetRGB(38, 217, 204) : saved;
+}
+
+void ThemeService::SetMacThemePreset(bool follow_device) {
+  if (UsingPolicyTheme()) {
+    return;
+  }
+  {
+    base::AutoReset<bool> resetter(&should_suppress_theme_updates_, true);
+    if (IsMacCustomTheme()) {
+      profile_->GetPrefs()->SetInteger(kLastMacCustomThemeColor,
+                                       GetMacCustomThemeColor());
+    }
+    ClearThemeData(/*reset_all_settings=*/false);
+    profile_->GetPrefs()->SetBoolean(prefs::kBrowserFollowsSystemThemeColors,
+                                     follow_device);
+  }
+  NotifyThemeChanged();
+}
+
+void ThemeService::SelectMacCustomTheme() {
+  if (!IsMacCustomTheme()) {
+    SetUserColorAndBrowserColorVariant(
+        GetMacCustomThemeColor(),
+        ui::mojom::BrowserColorVariant::kCustomChroma);
+  }
+}
