+// Copyright 2026 The Lune Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_subpage.js';
+
+import {PrefService} from '/shared/settings/prefs2/pref_service.js';
+import {PrefServiceObserverMixinLit} from '/shared/settings/prefs2/pref_service_observer_mixin_lit.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+import {getCss as getSettingsSharedCss} from '../settings_shared_lit.css.js';
+
+import {getHtml} from './tracking_parameters_page.html.js';
+
+const EXCLUDED_DOMAINS_PREF = 'helium.tracking_query_excluded_domains';
+
+const SettingsTrackingParametersPageElementBase =
+    SettingsViewMixinLit(I18nMixinLit(PrefServiceObserverMixinLit(CrLitElement)));
+
+export type TrackingParametersPageElement = SettingsTrackingParametersPageElement;
+
+export interface SettingsTrackingParametersPageElement {
+  $: {excludedDomainInput: CrInputElement};
+}
+
+export class SettingsTrackingParametersPageElement extends
+    SettingsTrackingParametersPageElementBase {
+  static get is() {
+    return 'settings-tracking-parameters-page';
+  }
+
+  static override get styles() {
+    return getSettingsSharedCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      domains_: {type: Array},
+      domain_: {type: String},
+      invalidDomain_: {type: Boolean},
+    };
+  }
+
+  protected accessor domains_: string[] = [];
+  protected accessor domain_: string = '';
+  protected accessor invalidDomain_: boolean = false;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addPrefObserver<string[]>(
+        EXCLUDED_DOMAINS_PREF, pref => this.domains_ = pref.value);
+  }
+
+  override focusBackButton() {
+    this.shadowRoot.querySelector('settings-subpage')!.focusBackButton();
+  }
+
+  protected onDomainValueChanged_(event: CustomEvent<{value: string}>) {
+    this.domain_ = event.detail.value;
+    this.invalidDomain_ = false;
+  }
+
+  protected onDomainKeydown_(event: KeyboardEvent) {
+    if (event.key === 'Enter' && this.domain_.trim() && !event.isComposing) {
+      event.preventDefault();
+      this.onAddDomainClick_();
+    }
+  }
+
+  protected async onAddDomainClick_() {
+    const domain = this.parseDomain_();
+    if (!domain) {
+      this.invalidDomain_ = true;
+      this.$.excludedDomainInput.focus();
+      return;
+    }
+    if (await PrefService.getInstance().appendPrefListItem(
+            EXCLUDED_DOMAINS_PREF, domain)) {
+      this.domain_ = '';
+      this.$.excludedDomainInput.focus();
+    }
+  }
+
+  protected async onRemoveDomainClick_(event: Event) {
+    const domain = (event.currentTarget as HTMLElement).dataset['domain'];
+    if (await PrefService.getInstance().setPrefValue(
+            EXCLUDED_DOMAINS_PREF,
+            this.domains_.filter(entry => entry !== domain))) {
+      this.$.excludedDomainInput.focus();
+    }
+  }
+
+  private parseDomain_(): string {
+    const input = this.domain_.trim();
+    if (!input || /[\s:\/?#@%\\]/u.test(input)) {
+      return '';
+    }
+    try {
+      const host = new URL('https://' + input).hostname.replace(/\.$/, '');
+      return host.split('.').every(
+                 label => /^[a-z\d](?:[a-z\d-]{0,61}[a-z\d])?$/.test(label)) ?
+          host : '';
+    } catch {
+      return '';
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-tracking-parameters-page': SettingsTrackingParametersPageElement;
+  }
+}
+
+customElements.define(SettingsTrackingParametersPageElement.is,
+                      SettingsTrackingParametersPageElement);
