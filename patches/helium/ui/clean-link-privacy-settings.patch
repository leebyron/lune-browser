+<style>
+  #domainControls {
+    align-items: center;
+    display: flex;
+    gap: 12px;
+    padding-block-start: 12px;
+  }
+
+  #excludedDomainInput {
+    flex: 1;
+  }
+
+  .excluded-domains-heading {
+    color: inherit;
+    font: inherit;
+  }
+
+  .excluded-domain {
+    flex: 1;
+    overflow-wrap: anywhere;
+  }
+</style>
+
+<settings-subpage page-title="$i18n{cleanTrackingLinks}"
+    route-path="${this.routePath}">
+  <settings-toggle-button id="cleanTrackingLinksToggle"
+      pref-key="helium.clean_tracking_links"
+      label="$i18n{cleanTrackingLinks}"
+      sub-label="$i18n{cleanTrackingLinksDescription}">
+  </settings-toggle-button>
+  <div class="cr-row hr">
+    <div>
+      <h2 class="excluded-domains-heading">$i18n{trackingExcludedDomains}</h2>
+      <div class="cr-secondary-text">$i18n{trackingExcludedDomainsDescription}</div>
+    </div>
+  </div>
+  <div id="domainControls" class="cr-row continuation">
+    <cr-input id="excludedDomainInput" label="$i18n{trackingExcludedDomainLabel}"
+        .value="${this.domain_}" ?invalid="${this.invalidDomain_}"
+        error-message="$i18n{trackingExcludedDomainInvalid}"
+        @value-changed="${this.onDomainValueChanged_}"
+        @keydown="${this.onDomainKeydown_}">
+    </cr-input>
+    <cr-button id="addExcludedDomain" ?disabled="${!this.domain_.trim()}"
+        @click="${this.onAddDomainClick_}">$i18n{add}</cr-button>
+  </div>
+  ${this.domains_.map(domain => html`
+    <div class="cr-row hr">
+      <div class="excluded-domain">${domain}</div>
+      <cr-icon-button iron-icon="cr:delete" class="remove-excluded-domain"
+          data-domain="${domain}"
+          aria-label="${this.i18n('trackingExcludedDomainRemove', domain)}"
+          @click="${this.onRemoveDomainClick_}">
+      </cr-icon-button>
+    </div>
+  `)}
+</settings-subpage>
