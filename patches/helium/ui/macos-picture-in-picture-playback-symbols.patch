+ui::ImageModel OverlayWindowImageButton::ControlImage(
+    const gfx::VectorIcon& fallback,
+    const char* symbol_name,
+    ui::ColorId color,
+    int size,
+    int symbol_point_size) {
+  auto vector_image = ui::ImageModel::FromVectorIcon(fallback, color, size);
+#if BUILDFLAG(IS_MAC)
+  if (size > 0) {
+    return ui::ImageModel::FromImageGenerator(
+        base::BindRepeating(
+            [](const char* symbol, ui::ColorId color, int size, int point_size,
+               const ui::ImageModel& fallback,
+               const ui::ColorProvider* provider) {
+              if (!provider) {
+                return gfx::ImageSkia();
+              }
+              auto image = helium::NativeToolbarSymbolForName(
+                  symbol, size, provider->GetColor(color), point_size);
+              return image.isNull() ? fallback.Rasterize(provider) : image;
+            },
+            symbol_name, color, size, symbol_point_size, std::move(vector_image)),
+        gfx::Size(size, size));
+  }
+#endif
+  return vector_image;
+}
+
