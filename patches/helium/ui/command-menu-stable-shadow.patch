-// Cast a diffuse shadow from the panel's rounded silhouette.
+namespace {
+
+constexpr CGFloat kCommandShadowBlur = 64;
+constexpr CGFloat kCommandShadowOffset = 32;
+constexpr int kShadowFalloffSamplesPerPoint = 2;
+constexpr int kShadowFalloffLimit = 160;
+constexpr int kShadowFalloffCenter =
+    kShadowFalloffLimit * kShadowFalloffSamplesPerPoint;
+
+const auto& CommandShadowFalloff() {
+  static const auto falloff = [] {
+    std::array<uint8_t, 2 * kShadowFalloffCenter + 1> result;
+    for (size_t i = 0; i < result.size(); ++i) {
+      const CGFloat distance =
+          (static_cast<CGFloat>(i) - kShadowFalloffCenter) /
+          kShadowFalloffSamplesPerPoint;
+      const CGFloat opacity =
+          .25 * .5 * std::erfc(distance / (std::sqrt(2.) * kCommandShadowBlur));
+      result[i] = std::lround(255 * opacity);
+    }
+    return result;
+  }();
+  return falloff;
+}
+
+CGImageRef CreateCommandShadowImage(CGSize panel, CGSize image_size) {
+  const size_t width = std::ceil(image_size.width);
+  const size_t height = std::ceil(image_size.height);
+  CGColorSpaceRef color_space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+  const CGBitmapInfo bitmap_info =
+      kCGBitmapByteOrder32Big |
+      static_cast<CGBitmapInfo>(kCGImageAlphaPremultipliedLast);
+  CGContextRef context = CGBitmapContextCreate(
+      nullptr, width, height, 8, 0, color_space, bitmap_info);
+  CGColorSpaceRelease(color_space);
+  if (!context) {
+    return nullptr;
+  }
+
+  auto* pixels = static_cast<uint8_t*>(CGBitmapContextGetData(context));
+  const size_t stride = CGBitmapContextGetBytesPerRow(context);
+  std::fill_n(pixels, stride * height, 0);
+  const CGFloat half_width = panel.width / 2;
+  const CGFloat half_height = panel.height / 2;
+  const CGFloat radius =
+      std::min({static_cast<CGFloat>(kGlassCornerRadius), half_width,
+                half_height});
+  const CGFloat center_x = kShadowSideInset + half_width;
+  const CGFloat center_y = kShadowTopInset + half_height + kCommandShadowOffset;
+  const auto& falloff = CommandShadowFalloff();
+
+  // Use one falloff from the rounded outline. The distance from the outline
+  // determines the shadow's strength, including on a short panel.
+  for (size_t y = 0; y < height; ++y) {
+    const CGFloat dy = std::abs(y + .5 - center_y) - half_height + radius;
+    const CGFloat outside_y = std::max<CGFloat>(dy, 0);
+    uint8_t* row = pixels + y * stride;
+    for (size_t x = 0; x < width; ++x) {
+      const CGFloat dx = std::abs(x + .5 - center_x) - half_width + radius;
+      const CGFloat outside_x = std::max<CGFloat>(dx, 0);
+      const CGFloat distance =
+          std::sqrt(outside_x * outside_x + outside_y * outside_y) +
+          std::min<CGFloat>(std::max(dx, dy), 0) - radius;
+      const int sample = std::clamp<int>(
+          static_cast<int>(distance * kShadowFalloffSamplesPerPoint +
+                           kShadowFalloffCenter + .5),
+          0, falloff.size() - 1);
+      row[4 * x + 3] = falloff[sample];
+    }
+  }
+
+  CGImageRef image = CGBitmapContextCreateImage(context);
+  CGContextRelease(context);
+  return image;
+}
+
+NSVisualEffectView* CreateCommandPopoverEffect(NSRect frame) {
+  NSVisualEffectView* effect = [[NSVisualEffectView alloc] initWithFrame:frame];
+  effect.material = NSVisualEffectMaterialPopover;
+  effect.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+  effect.state = NSVisualEffectStateActive;
+  effect.wantsLayer = YES;
+  effect.layer.cornerRadius = kGlassCornerRadius;
+  effect.layer.masksToBounds = YES;
+  effect.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  return effect;
+}
