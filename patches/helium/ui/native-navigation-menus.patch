+namespace {
+void ConfigureNativeToolbarMenu(HeliumHeaderSymbolButton* native_button,
+                                base::WeakPtr<BrowserView> browser,
+                                int view_id) {
+  native_button.canShowContextMenu = ^BOOL(NSView* sender) {
+    auto* button = NativeToolbarMenuButton(browser, view_id);
+    return sender.window && button && button->CanShowContextMenu();
+  };
+  native_button.onContextMenu = ^(NSView* sender) {
+    auto* button = NativeToolbarMenuButton(browser, view_id);
+    if (!sender.window || !button || !button->CanShowContextMenu()) {
+      return;
+    }
+    const NSRect anchor = [sender.window convertRectToScreen:
+        [sender convertRect:sender.bounds toView:nil]];
+    button->ShowContextMenuAtScreenBounds(
+        gfx::ScreenRectFromNSRect(anchor), ui::mojom::MenuSourceType::kMouse);
+  };
+}
