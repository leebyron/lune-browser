+namespace {
+ToolbarButton* NativeToolbarMenuButton(base::WeakPtr<BrowserView> browser,
+                                      int view_id) {
+  if (!browser || !browser->toolbar()) {
+    return nullptr;
+  }
+  // The original controls may be reparented into a sidebar; resolve them
+  // through their providers rather than searching the view hierarchy.
+  switch (view_id) {
+    case VIEW_ID_BACK_BUTTON:
+      return browser->toolbar_button_provider()->GetBackButton();
+    case VIEW_ID_FORWARD_BUTTON:
+      return browser->toolbar()->forward_button();
+    case VIEW_ID_RELOAD_BUTTON:
+      return browser->toolbar()->reload_button();
+    default:
+      return nullptr;
+  }
+}
+}  // namespace
