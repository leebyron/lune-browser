+NSCursor* GetWindowResizeCursor(NSWindow* window, NSPoint location) {
+  if (!window || !(window.styleMask & NSWindowStyleMaskResizable) ||
+      (window.styleMask & NSWindowStyleMaskFullScreen)) {
+    return nil;
+  }
