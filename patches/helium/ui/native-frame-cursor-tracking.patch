+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (!_resizeCursorTrackingArea) {
+    // The full-size content and floating chrome can invalidate their tracking
+    // regions while the pointer is on the frame. Give AppKit a persistent
+    // cursor owner to consult during its structural-region updates, rather
+    // than setting a resize cursor only until its next default-arrow reset.
+    // InVisibleRect follows frame resizing without recreating this area.
+    _resizeCursorTrackingArea = [[NSTrackingArea alloc]
+        initWithRect:NSZeroRect
+             options:NSTrackingCursorUpdate | NSTrackingActiveInKeyWindow |
+                     NSTrackingInVisibleRect
+               owner:self
+            userInfo:nil];
+    [self addTrackingArea:_resizeCursorTrackingArea];
+  }
+}
