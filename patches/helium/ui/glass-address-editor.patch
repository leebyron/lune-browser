+- (instancetype)initWithWindow:(NSWindow*)window {
+  self = [super initWithFrame:NSMakeRect(0, 0, 96, 36)];
+  if (!self) {
+    return nil;
+  }
+  _browserWindow = window;
+  _buttons = [[NSMutableArray alloc] init];
+  _originalHidden = [[NSMutableDictionary alloc] init];
+  const NSWindowStyleMask style =
+      window.styleMask & ~NSWindowStyleMaskFullScreen;
+  for (NSWindowButton type :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    NSButton* original = [window standardWindowButton:type];
+    if (original) {
+      _originalHidden[@(type)] = @(original.hidden);
+    }
+    NSButton* button = [NSWindow standardWindowButton:type forStyleMask:style];
+    if (!button) {
+      continue;
+    }
+    button.target = window;
+    button.action = type == NSWindowCloseButton ? @selector(performClose:)
+                    : type == NSWindowMiniaturizeButton
+                        ? @selector(performMiniaturize:)
+                        : @selector(toggleFullScreen:);
+    NSRect frame = button.frame;
+    frame.origin =
+        NSMakePoint(12 + 26 * _buttons.count, (36 - frame.size.height) / 2);
+    button.frame = frame;
+    [_buttons addObject:button];
+    [_controls addSubview:button];
+  }
+  return self;
+}
+- (void)refresh {
+  for (NSNumber* type in _originalHidden) {
+    [_browserWindow standardWindowButton:static_cast<NSWindowButton>(
+                                             type.unsignedIntegerValue)]
+        .hidden = YES;
+  }
+  if (_buttons.count > 1) {
+    _buttons[1].enabled =
+        !(_browserWindow.styleMask & NSWindowStyleMaskFullScreen);
+  }
+}
+- (void)restoreTitlebarButtons {
+  for (NSNumber* type in _originalHidden) {
+    NSButton* button =
+        [_browserWindow standardWindowButton:static_cast<NSWindowButton>(
+                                                 type.unsignedIntegerValue)];
+    button.hidden = _originalHidden[type].boolValue;
+  }
+}
+@end
